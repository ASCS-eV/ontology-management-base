# Per-domain generator flags, read by scripts/build_linkml_domain.sh.
#
# simulation-asset imports only ontology-header. --no-mergeimports /
# --exclude-imports keep the header profile's terms out of the artifacts, as
# for manifest. The defaults (--xsd-anyuri-as-iri) stay on: accessURL,
# downloadURL and mediaType are IRIs in DCAT 3, not xsd:anyURI literals.
# The classes are those of DCAT, PROV-O and SPDX: --skip-vacuous-* keeps
# gen-owl from restating, on them, a minimum cardinality of zero or a local
# range equal to the global one (G17).
IMPORTMAP="-im linkml/simulation-asset/importmap.json"
OWL_EXTRA_FLAGS="--xsd-anyuri-as-iri --skip-vacuous-local-range-axioms --skip-vacuous-min-zero-cardinality-axioms --no-mergeimports ${IMPORTMAP}"
SHACL_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
CONTEXT_EXTRA_FLAGS="--xsd-anyuri-as-iri --exclude-imports ${IMPORTMAP}"
