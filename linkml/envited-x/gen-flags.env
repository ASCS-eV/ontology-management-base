# Per-domain generator flags; see linkml/GAPS.md S1 and S3.
#
# envited-x imports manifest. The import is written as an absolute IRI so that
# gen-owl emits owl:imports <https://w3id.org/ascs-ev/envited-x/manifest/v5>
# rather than an IRI derived from the import statement text; importmap.json
# points that IRI at the local schema.
#
# --no-mergeimports keeps manifest's classes out of this ontology (only the
# cross-namespace rdfs:subClassOf axioms remain), and --exclude-imports stops
# gen-shacl minting a second copy of manifest's shapes here, which would merge
# with the real ones on load.
# All three generators need the importmap: the import is written as an absolute
# IRI, so without -im they try to fetch it over HTTP and fail (gen-shacl exits 0
# after a 404 traceback, leaving an EMPTY shapes file - the build script's
# 2>/dev/null hides it, so always check the output is non-empty).
IMPORTMAP="-im linkml/envited-x/importmap.json"
OWL_EXTRA_FLAGS="--no-mergeimports ${IMPORTMAP}"
SHACL_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
# --exclude-imports: a domain context carries only its own terms, as the
# committed contexts do; each instance lists the other domains' contexts itself.
CONTEXT_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
