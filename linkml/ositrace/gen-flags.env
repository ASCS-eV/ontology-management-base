# Per-domain generator flags; see linkml/GAPS.md S1 and S5.
#
# ositrace imports envited-x (which imports manifest and Gaia-X) and
# georeference. Transitive imports resolve relative to THIS schema, so the
# importmap lists every schema in the closure, and all three generators need it.
# --no-mergeimports / --exclude-imports keep other domains' classes and shapes
# out of the ositrace artifacts.
#
# --xsd-anyuri-as-iri is off, as for manifest: ositrace:validationReport is an
# xsd:anyURI literal in the committed ontology, context and instance data. The
# open question of literal versus IRI node is linkml/GAPS.md D5.
IMPORTMAP="-im linkml/ositrace/importmap.json"
OWL_EXTRA_FLAGS="--no-mergeimports ${IMPORTMAP}"
SHACL_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
# --exclude-imports: a domain context carries only its own terms, as the
# committed contexts do; each instance lists the other domains' contexts itself.
CONTEXT_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
