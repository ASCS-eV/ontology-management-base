# Per-domain generator flags; see linkml/GAPS.md S3.
#
# --xsd-anyuri-as-iri makes manifest:iri and sh:conformsTo IRI nodes in the OWL
# and the JSON-LD context, as gen-shacl already treats them. manifest:filePath is
# not affected: its range UriReference is derived from string, so it stays an
# xsd:anyURI literal in every artifact (relative paths must not be resolved
# against a document base).
OWL_EXTRA_FLAGS="--xsd-anyuri-as-iri"
SHACL_EXTRA_FLAGS=""
CONTEXT_EXTRA_FLAGS="--xsd-anyuri-as-iri"
