# Per-domain generator flags, read by scripts/build_linkml_domain.sh.
#
# --xsd-anyuri-as-iri makes manifest:iri and sh:conformsTo IRI nodes in the OWL
# and the JSON-LD context, as gen-shacl already treats them. manifest:filePath is
# not affected: its range UriReference is derived from string, so it stays an
# xsd:anyURI literal in every artifact (relative paths must not be resolved
# against a document base).
#
# manifest imports the ontology-header profile. --no-mergeimports keeps the
# profile's metaclass out of this ontology (gen-owl emits owl:imports instead),
# and --exclude-imports keeps it out of the shapes and the context.
IMPORTMAP="-im linkml/manifest/importmap.json"
OWL_EXTRA_FLAGS="--xsd-anyuri-as-iri --no-mergeimports ${IMPORTMAP}"
SHACL_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
CONTEXT_EXTRA_FLAGS="--xsd-anyuri-as-iri --exclude-imports ${IMPORTMAP}"
