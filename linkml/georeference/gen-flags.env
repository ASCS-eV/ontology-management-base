# Per-domain generator flags, read by scripts/build_linkml_domain.sh.
#
# georeference has no uri-ranged slots. It imports only the ontology-header
# profile: --no-mergeimports keeps the profile's metaclass out of this ontology
# (gen-owl emits owl:imports instead), and --exclude-imports keeps it out of the
# shapes and the context.
IMPORTMAP="-im linkml/georeference/importmap.json"
OWL_EXTRA_FLAGS="--no-mergeimports ${IMPORTMAP}"
SHACL_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
CONTEXT_EXTRA_FLAGS="--exclude-imports ${IMPORTMAP}"
