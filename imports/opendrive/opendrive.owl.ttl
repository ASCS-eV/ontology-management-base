odr:T_controller.control a owl:ObjectProperty ;
    rdfs:label "control"@en ;
    rdfs:domain odr:T_controller ;
    rdfs:range odr:T_controller_control .

odr:T_controller.id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:comment "Unique ID within database"@en ;
    rdfs:domain odr:T_controller ;
    rdfs:range xsd:string ;
    skos:definition "Unique ID within database"@en .

odr:T_controller.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of the controller. May be chosen freely."@en ;
    rdfs:domain odr:T_controller ;
    rdfs:range xsd:string ;
    skos:definition "Name of the controller. May be chosen freely."@en .

odr:T_controller.sequence a owl:DatatypeProperty ;
    rdfs:label "sequence"@en ;
    rdfs:comment "Sequence number (priority) of this controller with respect to other controllers of same logical level"@en ;
    rdfs:domain odr:T_controller ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Sequence number (priority) of this controller with respect to other controllers of same logical level"@en .

odr:T_controller_control.signalId a owl:DatatypeProperty ;
    rdfs:label "signalId"@en ;
    rdfs:comment "ID of the controlled signal"@en ;
    rdfs:domain odr:T_controller_control ;
    rdfs:range xsd:string ;
    skos:definition "ID of the controlled signal"@en .

odr:T_controller_control.type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:comment """Type of control.\r
Free Text, depends on the application."""@en ;
    rdfs:domain odr:T_controller_control ;
    rdfs:range xsd:string ;
    skos:definition """Type of control.\r
Free Text, depends on the application."""@en .

