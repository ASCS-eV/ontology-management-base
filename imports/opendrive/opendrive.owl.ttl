            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object.temporary ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_borders ;
            owl:onProperty odr:T_road_objects_object.borders ],
        [ a owl:Restriction ;
