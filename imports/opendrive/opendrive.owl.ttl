    rdfs:range xsd:positiveInteger ;
    skos:definition "ID of the lane"@en .

odr:T_road_lanes_laneSection_lr_lane.advisory a owl:DatatypeProperty ;
    rdfs:label "advisory"@en ;
    rdfs:comment "If true, lane can be used also by a neighboring lane. Advisory lane has priority, for example a bike lane, that can also be used by cars. If not specified, default value is none."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range odr:E_laneAdvisory ;
    skos:definition "If true, lane can be used also by a neighboring lane. Advisory lane has priority, for example a bike lane, that can also be used by cars. If not specified, default value is none."@en .

odr:T_road_lanes_laneSection_lr_lane.direction a owl:DatatypeProperty ;
    rdfs:label "direction"@en ;
    rdfs:comment "If not specified, direction is determined by the combination of <left> or <right> lane grouping and the values LHT or RHT of the @rule attribute of a road. The standard direction can be overwritten with this attribute."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range odr:E_lane_direction ;
    skos:definition "If not specified, direction is determined by the combination of <left> or <right> lane grouping and the values LHT or RHT of the @rule attribute of a road. The standard direction can be overwritten with this attribute."@en .

odr:T_road_lanes_laneSection_lr_lane.dynamicLaneDirection a owl:DatatypeProperty ;
    rdfs:label "dynamicLaneDirection"@en ;
    rdfs:comment "If true, lane direction can be changed dynamically by the scenario during the simulation. If not specified, default boolean value is false."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, lane direction can be changed dynamically by the scenario during the simulation. If not specified, default boolean value is false."@en .

odr:T_road_lanes_laneSection_lr_lane.dynamicLaneType a owl:DatatypeProperty ;
    rdfs:label "dynamicLaneType"@en ;
    rdfs:comment "If true, lane type can be changed dynamically by the scenario during the simulation. Typical example is a stop lane that can be changed by VMS boards to a driving lane. If not specified, default boolean value is false."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, lane type can be changed dynamically by the scenario during the simulation. Typical example is a stop lane that can be changed by VMS boards to a driving lane. If not specified, default boolean value is false."@en .

odr:T_road_lanes_laneSection_lr_lane.level a owl:DatatypeProperty ;
    rdfs:label "level"@en ;
    rdfs:comment """"true" = keep lane on level, that is, do not apply superelevation;\r
"false" = apply superelevation to this lane (default, also used if attribute level is missing)"""@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range xsd:boolean ;
    skos:definition """"true" = keep lane on level, that is, do not apply superelevation;\r
"false" = apply superelevation to this lane (default, also used if attribute level is missing)"""@en .

odr:T_road_lanes_laneSection_lr_lane.link a owl:ObjectProperty ;
    rdfs:label "link"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range odr:T_road_lanes_laneSection_lcr_lane_link .

odr:T_road_lanes_laneSection_lr_lane.roadWorks a owl:DatatypeProperty ;
    rdfs:label "roadWorks"@en ;
    rdfs:comment "If true, lane is under construction and access as well as the ability to drive on it are restricted."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, lane is under construction and access as well as the ability to drive on it are restricted."@en .

odr:T_road_lanes_laneSection_lr_lane.type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "Type of the lane"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane ;
    rdfs:range odr:E_laneType ;
    skos:definition "Type of the lane"@en .

odr:T_road_lanes_laneSection_lr_lane_access.restriction a owl:DatatypeProperty ;
    rdfs:label "restriction"@en ;
    rdfs:comment "Identifier of the participant to whom the restriction applies"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane_access ;
    rdfs:range odr:E_accessRestrictionType ;
    skos:definition "Identifier of the participant to whom the restriction applies"@en .

odr:T_road_lanes_laneSection_lr_lane_access.rule a owl:DatatypeProperty ;
    rdfs:label "rule"@en ;
    rdfs:comment "Specifies whether the participant given in the attribute @restriction is allowed or denied access to the given lane"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane_access ;
    rdfs:range odr:E_road_lanes_laneSection_lr_lane_access_rule ;
    skos:definition "Specifies whether the participant given in the attribute @restriction is allowed or denied access to the given lane"@en .

odr:T_road_lanes_laneSection_lr_lane_access.sOffset a owl:DatatypeProperty ;
    rdfs:label "sOffset"@en ;
    rdfs:comment "s-coordinate of start position, relative to the position of the preceding <laneSection> element"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane_access ;
    rdfs:range xsd:double ;
    skos:definition "s-coordinate of start position, relative to the position of the preceding <laneSection> element"@en .

odr:T_road_lanes_laneSection_lr_lane_access_restriction a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_access_restriction"@en ;
    rdfs:comment """Defines access restrictions for certain types of road users.\r
Each restriction element defines one type that is either allowed or denied according to the parent access element."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_accessRestrictionType ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_access_restriction.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Defines access restrictions for certain types of road users.\r
Each restriction element defines one type that is either allowed or denied according to the parent access element."""@en .

odr:T_road_lanes_laneSection_lr_lane_access_restriction.type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "Identifier of the participant to whom the restriction applies"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lr_lane_access_restriction ;
    rdfs:range odr:E_accessRestrictionType ;
    skos:definition "Identifier of the participant to whom the restriction applies"@en .

