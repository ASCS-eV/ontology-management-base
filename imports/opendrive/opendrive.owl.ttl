            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.aV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.cV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "A parametric cubic curve describing the road reference line."@en .

odr:T_junction_virtual a owl:Class ;
    rdfs:label "t_junction_virtual"@en ;
    rdfs:comment "Virtual junctions manage connections within an uninterrupted road, for example, entries and exits to parking lots, and pedestrian crossings."@en ;
