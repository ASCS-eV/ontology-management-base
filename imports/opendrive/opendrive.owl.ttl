            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal_paramPoly3.bU ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal_paramPoly3.aU ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal_paramPoly3.bV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "A parametric cubic curve describing the curve."@en .

odr:T_road_planView_geometry_paramPoly3 a owl:Class ;
    rdfs:label "t_road_planView_geometry_paramPoly3"@en ;
    rdfs:comment "A parametric cubic curve describing the road reference line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.bU ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.dU ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.bV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.cU ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_paramPoly3.dV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
