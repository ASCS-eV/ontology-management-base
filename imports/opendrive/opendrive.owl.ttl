        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal_paramPoly3.dV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal_paramPoly3.cU ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
