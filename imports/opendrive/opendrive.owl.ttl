            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.line ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.u ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.hdg ],
        odr:_OpenDriveElement ;
    skos:definition """Used to describe complex forms of objects.\r
Can be one of <line>, <arc>, or <paramPoly3>"""@en .

odr:T_road_planView_geometry a owl:Class ;
