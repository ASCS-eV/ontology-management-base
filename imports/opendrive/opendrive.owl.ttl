odr:T_road_lanes_laneSection_lcr_lane_roadMark.laneChange a owl:DatatypeProperty ;
    rdfs:label "laneChange"@en ;
    rdfs:comment "Allows a lane change in the indicated direction, taking into account that lanes are numbered in ascending order from right to left. If the attribute is missing, “both” is used as default."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lcr_lane_roadMark ;
    rdfs:range odr:E_road_lanes_laneSection_lcr_lane_roadMark_laneChange ;
    skos:definition "Allows a lane change in the indicated direction, taking into account that lanes are numbered in ascending order from right to left. If the attribute is missing, “both” is used as default."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark.material a owl:DatatypeProperty ;
    rdfs:label "material"@en ;
    rdfs:comment "Material of the road marking. Identifiers to be defined by the user, use \"standard\" as default value."@en ;
