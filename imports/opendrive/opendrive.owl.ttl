    skos:definition "A signal along the road or on a static board."@en .

odr:T_road_objects_object a owl:Class ;
    rdfs:label "t_road_objects_object"@en ;
    rdfs:comment """Objects influence a road by expanding, delimiting, or supplementing its course. Objects are elements that form the environment, for example, buildings, guard rails, poles, and trees. Objects are not mandatory to guide driver and traffic models, unlike signals.\r
There are two ways to describe the bounding volume of objects.\r
	- For an angular object: definition of the width, length and height.\r
	- For a circular object: definition of the radius and height."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_outlines_outline ;
            owl:onProperty odr:T_road_objects_object.outline ],
