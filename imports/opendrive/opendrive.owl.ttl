odr:T_road_lanes_laneSection_left.lane a owl:ObjectProperty ;
    rdfs:label "lane"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_left ;
    rdfs:range odr:T_road_lanes_laneSection_left_lane .

odr:T_road_lanes_laneSection_left_lane.id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
