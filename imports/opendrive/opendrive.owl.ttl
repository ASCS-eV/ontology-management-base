            owl:onClass odr:T_road_planView ;
            owl:onProperty odr:T_junction.planView ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction.name ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects ;
            owl:onProperty odr:T_junction.objects ],
        odr:_OpenDriveElement ;
    skos:definition "Junctions model intersections between roads."@en .

