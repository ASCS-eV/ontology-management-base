    skos:definition "Offset of start position of the <line> element, relative to the @sOffset  given in the <roadMark> element"@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.tOffset a owl:DatatypeProperty ;
    rdfs:label "tOffset"@en ;
    rdfs:comment """Lateral offset from the lane border.\r
If <sway> element is present, the lateral offset follows the sway."""@en ;
