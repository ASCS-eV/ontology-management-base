<http://code.asam.net/simulation/standard/opendrive> a owl:Ontology ;
    rdfs:label "Railroad"@en .

odr:E_countryCode_deprecated a rdfs:Datatype ;
    rdfs:label "e_countryCode_deprecated"@en ;
    owl:oneOf ( "OpenDRIVE" "Austria" "Brazil" "China" "France" "Germany" "Italy" "Switzerland" "USA" ) .

odr:E_maxSpeedString a rdfs:Datatype ;
    rdfs:label "e_maxSpeedString"@en ;
    owl:oneOf ( "no limit" "undefined" ) .

odr:E_unitMass a rdfs:Datatype ;
    rdfs:label "e_unitMass"@en ;
    owl:oneOf ( "kg" "t" ) .

odr:E_unitSlope a rdfs:Datatype ;
    rdfs:label "e_unitSlope"@en ;
    owl:oneOf ( "%" ) .

