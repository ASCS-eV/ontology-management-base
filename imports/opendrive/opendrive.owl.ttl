            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_virtual.sEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_virtual.mainRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_virtual.sStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects ;
            owl:onProperty odr:T_junction_virtual.objects ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_orientation ;
            owl:onProperty odr:T_junction_virtual.orientation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_planView ;
            owl:onProperty odr:T_junction_virtual.planView ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_junction_type ;
            owl:onProperty odr:T_junction_virtual.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_surface ;
            owl:onProperty odr:T_junction_virtual.surface ],
        odr:T_junction ;
    skos:definition "Virtual junctions manage connections within an uninterrupted road, for example, entries and exits to parking lots, and pedestrian crossings."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_roadMark"@en ;
    rdfs:comment "Defines the style of the line at the outer border of a lane. The style of the center line that separates left and right lanes is determined by the road mark element for the center lane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.height ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_roadMarkType ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_roadMarkWeight ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.weight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.width ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_roadMarkType ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.type ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_road_lanes_laneSection_lcr_lane_roadMark_laneChange ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.laneChange ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_roadMarkColor ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.color ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.explicit ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.material ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the style of the line at the outer border of a lane. The style of the center line that separates left and right lanes is determined by the road mark element for the center lane."@en .

odr:T_road_objects_object_markings_marking a owl:Class ;
