        odr:_OpenDriveElement ;
    skos:definition "Specifies a marking that is either attached to one side of the object bounding volume or referencing outline points."@en .

odr:T_road_objects_object_outlines_outline_curveLocal a owl:Class ;
    rdfs:label "t_road_objects_object_outlines_outline_curveLocal"@en ;
    rdfs:comment """Used to describe complex forms of objects.\r
Can be one of <line>, <arc>, or <paramPoly3>"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.length ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_objects_object_outlines_outline_curveLocal_arc ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.arc ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.height ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_objects_object_outlines_outline_curveLocal_paramPoly3 ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.paramPoly3 ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.v ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal.id ],
        [ a owl:Restriction ;
