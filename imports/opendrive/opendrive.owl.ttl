    owl:oneOf ( "standard" "underpass" ) .

odr:E_unit a owl:Class ;
    rdfs:label "e_unit"@en .

odr:E_unitDistance a rdfs:Datatype ;
    rdfs:label "e_unitDistance"@en ;
    owl:oneOf ( "m" "km" "ft" "mile" ) .

odr:E_vehicleCategory a rdfs:Datatype ;
    rdfs:label "e_vehicleCategory"@en ;
    rdfs:comment """Categories for entity objects of type vehicle. \r
It is recommended to use the most specific literal that fits whenever possible (e.g. 'heavyTruck' instead of 'car'). \r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en ;
    owl:oneOf ( "bicycle" "car" "semiTrailer" "trailer" "train" "tram" "van" "bus" "heavyTruck" "microMobilityDevice" "motorcycle" "other" "landVehicle" "semiTractor" "standupScooter" "workMachine" ) ;
    skos:definition """Categories for entity objects of type vehicle. \r
It is recommended to use the most specific literal that fits whenever possible (e.g. 'heavyTruck' instead of 'car'). \r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en .

odr:LaneGeometry a owl:Class ;
    rdfs:label "LaneGeometry"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lr_lane_width ;
            owl:onProperty odr:LaneGeometry.width ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lr_lane_border ;
            owl:onProperty odr:LaneGeometry.border ] .

odr:T_header_GeoReference a owl:Class ;
    rdfs:label "t_header_GeoReference"@en ;
    rdfs:comment """Spatial reference systems are standardized by the European Petroleum Survey Group Geodesy (EPSG) and are defined by parameters describing the geodetic datum. A geodetic datum is a coordinate reference system for a collection of positions that are relative to an ellipsoid model of the earth.\r
A geodetic datum is described by a projection string according to PROJ, that is, a format for the exchange of data between two coordinate systems. This data shall be marked as CDATA, because it may contain characters that interfere with the XML syntax of an element’s attribute."""@en ;
    skos:definition """Spatial reference systems are standardized by the European Petroleum Survey Group Geodesy (EPSG) and are defined by parameters describing the geodetic datum. A geodetic datum is a coordinate reference system for a collection of positions that are relative to an ellipsoid model of the earth.\r
A geodetic datum is described by a projection string according to PROJ, that is, a format for the exchange of data between two coordinate systems. This data shall be marked as CDATA, because it may contain characters that interfere with the XML syntax of an element’s attribute."""@en .

odr:T_include a owl:Class ;
    rdfs:label "t_include"@en ;
    rdfs:comment "Provides information about additional files that should be included while processing the ASAM OpenDRIVE file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_include.file ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Provides information about additional files that should be included while processing the ASAM OpenDRIVE file."@en .

odr:T_junction_connection_common a owl:Class ;
    rdfs:label "t_junction_connection_common"@en ;
    rdfs:comment "Provides information about a single connection within a common junction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_connection_common.connectingRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_junction_connection ;
    skos:definition "Provides information about a single connection within a common junction."@en .

odr:T_junction_connection_virtual_default a owl:Class ;
    rdfs:label "t_junction_connection_virtual_default"@en ;
    rdfs:comment "Provides information about a single connection within a virtual junction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_connection_type ;
            owl:onProperty odr:T_junction_connection_virtual_default.type ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_connection_virtual_default.connectingRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_junction_connection ;
    skos:definition "Provides information about a single connection within a virtual junction."@en .

odr:T_maxSpeed a owl:Class ;
    rdfs:label "t_maxSpeed"@en ;
    rdfs:subClassOf xsd:double .

odr:T_physicalPosition a owl:Class ;
    rdfs:label "t_physicalPosition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass odr:T_road_signals_signal_positionRoad ;
            owl:onProperty odr:T_physicalPosition.positionRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_signals_signal_positionInertial ;
            owl:onProperty odr:T_physicalPosition.positionInertial ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

odr:T_polyline_geometry a owl:Class ;
    rdfs:label "t_polyline_geometry"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_skeleton_polyline_vertexRoad ;
            owl:onProperty odr:T_polyline_geometry.vertexRoad ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_skeleton_polyline_vertexLocal ;
            owl:onProperty odr:T_polyline_geometry.vertexLocal ] .

odr:T_road.lanes a owl:ObjectProperty ;
    rdfs:label "lanes"@en ;
    rdfs:domain odr:T_road ;
    rdfs:range odr:T_road_lanes .

odr:T_road_lanes_laneSection_lcr_lane_roadMark.type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    rdfs:comment "Type of the road marking"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lcr_lane_roadMark ;
    rdfs:range odr:E_roadMarkType ;
    skos:definition "Type of the road marking"@en .

odr:T_road_lateralProfile_crossSectionSurface_surfaceStrip.strip a owl:ObjectProperty ;
    rdfs:label "strip"@en ;
    rdfs:domain odr:T_road_lateralProfile_crossSectionSurface_surfaceStrip ;
    rdfs:range odr:T_road_lateralProfile_crossSectionSurface_strip .

odr:T_road_objects_object_outlines_outline_curveLocal_line a owl:Class ;
    rdfs:label "t_road_objects_object_outlines_outline_curveLocal_line"@en ;
    rdfs:comment "A straight line is the simplest element. It contains no further attributes."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "A straight line is the simplest element. It contains no further attributes."@en .

odr:T_road_planView_geometry_line a owl:Class ;
    rdfs:label "t_road_planView_geometry_line"@en ;
    rdfs:comment "A straight line is the simplest geometry element. It contains no further attributes."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "A straight line is the simplest geometry element. It contains no further attributes."@en .

odr:T_road_signals_staticBoard a owl:Class ;
    rdfs:label "t_road_signals_staticBoard"@en ;
    rdfs:comment "A <signal> element that contains a <staticBoard> element. The signs that are displayed on a static board are defined as separate <sign> elements."@en ;
    rdfs:subClassOf odr:T_road_signals_board ;
    skos:definition "A <signal> element that contains a <staticBoard> element. The signs that are displayed on a static board are defined as separate <sign> elements."@en .

odr:T_signalGroup_vmsGroup a owl:Class ;
    rdfs:label "t_signalGroup_vmsGroup"@en ;
    rdfs:comment "On a gantry there can be one large variable message board or several smaller variable message boards. ASAM OpenSCENARIO requires to treat a gantry that has one large variable message board or several smaller variable message boards the same way. Therefore variable message boards that are on the same gantry shall be grouped and their indexes shall be redefined if not unique."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_signalGroup_vmsBoardReference ;
            owl:onProperty odr:T_signalGroup_vmsGroup.vmsBoardReference ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_signalGroup_vmsGroup.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "On a gantry there can be one large variable message board or several smaller variable message boards. ASAM OpenSCENARIO requires to treat a gantry that has one large variable message board or several smaller variable message boards the same way. Therefore variable message boards that are on the same gantry shall be grouped and their indexes shall be redefined if not unique."@en .

odr:T_signals_semantics_lane a owl:Class ;
    rdfs:label "t_signals_semantics_lane"@en ;
    rdfs:comment "Specifies lane regulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_signals_semantics_lane ;
            owl:onProperty odr:T_signals_semantics_lane.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies lane regulations."@en .

odr:T_signals_semantics_priority a owl:Class ;
    rdfs:label "t_signals_semantics_priority"@en ;
    rdfs:comment "Specifies priority regulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_signals_semantics_priority ;
            owl:onProperty odr:T_signals_semantics_priority.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies priority regulations."@en .

odr:T_signals_semantics_supplementaryEnvironment a owl:Class ;
    rdfs:label "t_signals_semantics_supplementaryEnvironment"@en ;
    rdfs:comment "This signal semantic has no meaning on its own. It specifies under which environmental conditions a sign is valid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_signals_semantics_supplementaryEnvironment ;
            owl:onProperty odr:T_signals_semantics_supplementaryEnvironment.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "This signal semantic has no meaning on its own. It specifies under which environmental conditions a sign is valid."@en .

odr:E_roadMarkType a rdfs:Datatype ;
    rdfs:label "e_roadMarkType"@en ;
    rdfs:comment "The known keywords for the simplified road marking type information are:"@en ;
    owl:oneOf ( "none" "solid" "broken" "solid solid" "solid broken" "broken solid" "broken broken" "botts dots" "grass" "curb" "custom" "edge" ) ;
    skos:definition "The known keywords for the simplified road marking type information are:"@en .

odr:G_additionalData a owl:Class ;
    rdfs:label "g_additionalData"@en ;
    rdfs:comment """ASAM OpenDRIVE offers the possibility to include external data. The processing of this data depends on the application.\r
Additional data may be placed at any position in ASAM OpenDRIVE."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_dataQuality ;
            owl:onProperty odr:G_additionalData.dataQuality ] ;
    skos:definition """ASAM OpenDRIVE offers the possibility to include external data. The processing of this data depends on the application.\r
Additional data may be placed at any position in ASAM OpenDRIVE."""@en .

odr:T_header_roadRegulation a owl:Class ;
    rdfs:label "t_header_roadRegulation"@en ;
    rdfs:comment "Defines the default regulations for different road types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_signals_semantics ;
            owl:onProperty odr:T_header_roadRegulation.semantics ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_roadType ;
            owl:onProperty odr:T_header_roadRegulation.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the default regulations for different road types."@en .

odr:T_junctionGroup_junctionReference a owl:Class ;
    rdfs:label "t_junctionGroup_junctionReference"@en ;
    rdfs:comment "References to existing <junction> elements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junctionGroup_junctionReference.junction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "References to existing <junction> elements."@en .

odr:T_junction_boundary a owl:Class ;
    rdfs:label "t_junction_boundary"@en ;
    rdfs:comment "Junction boundaries enclose the area intended for traffic. This also includes the sidewalks for pedestrians."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_boundary_segment ;
            owl:onProperty odr:T_junction_boundary.segment ],
        odr:_OpenDriveElement ;
    skos:definition "Junction boundaries enclose the area intended for traffic. This also includes the sidewalks for pedestrians."@en .

odr:T_junction_connection_direct a owl:Class ;
    rdfs:label "t_junction_connection_direct"@en ;
    rdfs:comment "Provides information about a single connection within a direct junction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_connection_direct.linkedRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_junction_connection ;
    skos:definition "Provides information about a single connection within a direct junction."@en .

odr:T_outline_geometry a owl:Class ;
    rdfs:label "t_outline_geometry"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_outlines_outline_cornerRoad ;
            owl:onProperty odr:T_outline_geometry.cornerRoad ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_outlines_outline_curveLocal ;
            owl:onProperty odr:T_outline_geometry.curveLocal ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_outlines_outline_cornerLocal ;
            owl:onProperty odr:T_outline_geometry.cornerLocal ] .

odr:T_road_elevationProfile a owl:Class ;
    rdfs:label "t_road_elevationProfile"@en ;
    rdfs:comment "Road elevation specifies the elevation along the road reference line, that is in s-direction."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Road elevation specifies the elevation along the road reference line, that is in s-direction."@en .

odr:T_road_lanes_laneSection_center a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_center"@en ;
    rdfs:comment "Contains the center lane, which must be defined for all roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass odr:T_road_lanes_laneSection_center_lane ;
            owl:onProperty odr:T_road_lanes_laneSection_center.lane ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Contains the center lane, which must be defined for all roads."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_roadMark_explicit"@en ;
    rdfs:comment """Irregular road markings that cannot be described by repetitive line patterns may be described by individual road marking elements. These explicit definitions also contain <line> elements for the line definition, however, these lines will not be repeated automatically as in repetitive road marking types. In ASAM OpenDRIVE, irregular road marking types and lines are represented by <explicit> elements within elements. The line definitions are contained in <line> elements within the <explicit> element.\r
The <explicit> element should specifically be used for measurement data."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit.line ],
        odr:_OpenDriveElement ;
    skos:definition """Irregular road markings that cannot be described by repetitive line patterns may be described by individual road marking elements. These explicit definitions also contain <line> elements for the line definition, however, these lines will not be repeated automatically as in repetitive road marking types. In ASAM OpenDRIVE, irregular road marking types and lines are represented by <explicit> elements within elements. The line definitions are contained in <line> elements within the <explicit> element.\r
The <explicit> element should specifically be used for measurement data."""@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_type a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_roadMark_type"@en ;
    rdfs:comment "Each type definition shall contain one or more line definitions with additional information about the lines that the road marking is composed of."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type.line ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type.width ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Each type definition shall contain one or more line definitions with additional information about the lines that the road marking is composed of."@en .

odr:T_road_lanes_laneSection_left a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_left"@en ;
    rdfs:comment "Contains all lanes left to the center lane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_left_lane ;
            owl:onProperty odr:T_road_lanes_laneSection_left.lane ],
        odr:_OpenDriveElement ;
    skos:definition "Contains all lanes left to the center lane."@en .

odr:T_road_lanes_laneSection_left_lane a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_left_lane"@en ;
    rdfs:comment "Left lanes numbered with positive IDs in ascending order from center lane to left border."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:positiveInteger ;
            owl:onProperty odr:T_road_lanes_laneSection_left_lane.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_road_lanes_laneSection_lr_lane ;
    skos:definition "Left lanes numbered with positive IDs in ascending order from center lane to left border."@en .

odr:T_road_lanes_laneSection_lr_lane_rule a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_rule"@en ;
    rdfs:comment "Used to add rules that are not covered by any of the other lane attributes that are described in this specification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_rule.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_rule.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Used to add rules that are not covered by any of the other lane attributes that are described in this specification."@en .

odr:T_road_lanes_laneSection_right a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_right"@en ;
    rdfs:comment "Contains all lanes right to the center lane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_right_lane ;
            owl:onProperty odr:T_road_lanes_laneSection_right.lane ],
        odr:_OpenDriveElement ;
    skos:definition "Contains all lanes right to the center lane."@en .

odr:T_road_lanes_laneSection_right_lane a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_right_lane"@en ;
    rdfs:comment "Right lanes numbered with negative IDs in descending order from center lane to right border."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:negativeInteger ;
            owl:onProperty odr:T_road_lanes_laneSection_right_lane.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_road_lanes_laneSection_lr_lane ;
    skos:definition "Right lanes numbered with negative IDs in descending order from center lane to right border."@en .

odr:T_road_lateralProfile_crossSectionSurface_strip_constant a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_strip_constant"@en ;
    rdfs:comment "Defines in t a constant height of the surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_coefficients ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip_constant.coefficients ],
        odr:_OpenDriveElement ;
    skos:definition "Defines in t a constant height of the surface."@en .

odr:T_road_lateralProfile_crossSectionSurface_strip_cubic a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_strip_cubic"@en ;
    rdfs:comment "Defines in t a cubic height of the surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_coefficients ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip_cubic.coefficients ],
        odr:_OpenDriveElement ;
    skos:definition "Defines in t a cubic height of the surface."@en .

odr:T_road_lateralProfile_crossSectionSurface_strip_linear a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_strip_linear"@en ;
    rdfs:comment "Defines in t a linear height of the surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_coefficients ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip_linear.coefficients ],
        odr:_OpenDriveElement ;
    skos:definition "Defines in t a linear height of the surface."@en .

odr:T_road_lateralProfile_crossSectionSurface_strip_quadratic a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_strip_quadratic"@en ;
    rdfs:comment "Defines in t a quadratic height of the surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_coefficients ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip_quadratic.coefficients ],
        odr:_OpenDriveElement ;
    skos:definition "Defines in t a quadratic height of the surface."@en .

odr:T_road_lateralProfile_crossSectionSurface_strip_width a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_strip_width"@en ;
    rdfs:comment "Defines the width of the inner strip."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_coefficients ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip_width.coefficients ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the width of the inner strip."@en .

odr:T_road_lateralProfile_crossSectionSurface_surfaceStrip a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_surfaceStrip"@en ;
    rdfs:comment "Surface strips contains the strips."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_surfaceStrip.strip ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "4"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_surfaceStrip.strip ],
        odr:_OpenDriveElement ;
    skos:definition "Surface strips contains the strips."@en .

odr:T_road_lateralProfile_crossSectionSurface_tOffset a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_tOffset"@en ;
    rdfs:comment "A t offset shifts all strips relative to the road reference line in t-direction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_coefficients ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_tOffset.coefficients ],
        odr:_OpenDriveElement ;
    skos:definition "A t offset shifts all strips relative to the road reference line in t-direction."@en .

odr:T_road_objects_object_borders a owl:Class ;
    rdfs:label "t_road_objects_object_borders"@en ;
    rdfs:comment """Object borders are frames with a defined width, for example, to describe traffic islands.\r
Different border types are available."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_borders_border ;
            owl:onProperty odr:T_road_objects_object_borders.border ],
        odr:_OpenDriveElement ;
    skos:definition """Object borders are frames with a defined width, for example, to describe traffic islands.\r
Different border types are available."""@en .

odr:T_road_objects_object_markings_marking_cornerReference a owl:Class ;
    rdfs:label "t_road_objects_object_markings_marking_cornerReference"@en ;
    rdfs:comment "Specifies a point by referencing an existing outline point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_road_objects_object_markings_marking_cornerReference.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies a point by referencing an existing outline point."@en .

odr:T_road_objects_object_outlines a owl:Class ;
    rdfs:label "t_road_objects_object_outlines"@en ;
    rdfs:comment "Wrapper for the different outline entries of an object, that can contain multiple outline definitions. If <outlines> is not used, an object can have only a single <outline> entry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_outlines_outline ;
            owl:onProperty odr:T_road_objects_object_outlines.outline ],
        odr:_OpenDriveElement ;
    skos:definition "Wrapper for the different outline entries of an object, that can contain multiple outline definitions. If <outlines> is not used, an object can have only a single <outline> entry."@en .

odr:T_road_objects_object_outlines_outline_curveLocal_arc a owl:Class ;
    rdfs:label "t_road_objects_object_outlines_outline_curveLocal_arc"@en ;
    rdfs:comment "Arcs describe curves with constant curvature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_curveLocal_arc.curvature ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Arcs describe curves with constant curvature."@en .

odr:T_road_objects_object_skeleton a owl:Class ;
    rdfs:label "t_road_objects_object_skeleton"@en ;
    rdfs:comment "Wrapper for the object polylines, that can be used to describe the actual shape inside the bounding volume more closely."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_skeleton_polyline ;
            owl:onProperty odr:T_road_objects_object_skeleton.polyline ] ;
    skos:definition "Wrapper for the object polylines, that can be used to describe the actual shape inside the bounding volume more closely."@en .

odr:T_road_objects_object_skeleton_polyline a owl:Class ;
    rdfs:label "t_road_objects_object_skeleton_polyline"@en ;
    rdfs:comment """Defines a series of points relative to the road reference line. \r
An <polyline> element shall be followed by either two or more <vertexRoad> elements or by two or more <vertexLocal> elements."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:positiveInteger ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline.id ] ;
    skos:definition """Defines a series of points relative to the road reference line. \r
An <polyline> element shall be followed by either two or more <vertexRoad> elements or by two or more <vertexLocal> elements."""@en .

odr:T_road_objects_object_surface a owl:Class ;
    rdfs:label "t_road_objects_object_surface"@en ;
    rdfs:comment "Used to describe the road surface elevation of an object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_surface_CRG ;
            owl:onProperty odr:T_road_objects_object_surface.cRG ],
        odr:_OpenDriveElement ;
    skos:definition "Used to describe the road surface elevation of an object."@en .

odr:T_road_planView_geometry_arc a owl:Class ;
    rdfs:label "t_road_planView_geometry_arc"@en ;
    rdfs:comment "Arcs describe road reference lines with constant curvature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_arc.curvature ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Arcs describe road reference lines with constant curvature."@en .

odr:T_road_railroad a owl:Class ;
    rdfs:label "t_road_railroad"@en ;
    rdfs:comment """Container for all railroad definitions that shall be applied along a road.\r
The available set of railroad elements is currently limited to the definition of switches. All other entries shall be covered with the existing elements, for example, track definition by <road>, signal definition by <signal>, etc. Railroad-specific elements are defined against the background of streetcar applications."""@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition """Container for all railroad definitions that shall be applied along a road.\r
The available set of railroad elements is currently limited to the definition of switches. All other entries shall be covered with the existing elements, for example, track definition by <road>, signal definition by <signal>, etc. Railroad-specific elements are defined against the background of streetcar applications."""@en .

odr:T_road_signals_board_sign a owl:Class ;
    rdfs:label "t_road_signals_board_sign"@en ;
    rdfs:comment "A <sign> element on a static board defined in the local coordinate system of the <signal> element. A <sign> element may have all attributes and child elements of a signal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_board_sign.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_board_sign.v ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_road_signals_signal ;
    skos:definition "A <sign> element on a static board defined in the local coordinate system of the <signal> element. A <sign> element may have all attributes and child elements of a signal."@en .

odr:T_signals_semantics_animal a owl:Class ;
    rdfs:label "t_signals_semantics_animal"@en ;
    rdfs:comment "Specifies an animal traffic participant."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Specifies an animal traffic participant."@en .

odr:T_signals_semantics_supplementaryTime a owl:Class ;
    rdfs:label "t_signals_semantics_supplementaryTime"@en ;
    rdfs:comment "This signal semantic has no meaning on its own. It specifies the time or date a sign is valid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_signals_semantics_supplementaryTime.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_signals_semantics_supplementaryTime ;
            owl:onProperty odr:T_signals_semantics_supplementaryTime.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "This signal semantic has no meaning on its own. It specifies the time or date a sign is valid."@en .

odr:T_userData a owl:Class ;
    rdfs:label "t_userData"@en ;
    rdfs:comment "Describes any additional information or data that is needed by an application for a specific reason."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_userData.code ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_userData.value ] ;
    skos:definition "Describes any additional information or data that is needed by an application for a specific reason."@en .

odr:E_accessRestrictionType a rdfs:Datatype ;
    rdfs:label "e_accessRestrictionType"@en ;
    owl:oneOf ( "simulator" "autonomousTraffic" "pedestrian" "passengerCar" "bus" "delivery" "emergency" "taxi" "throughTraffic" "truck" "bicycle" "motorcycle" "none" "trucks" "HOV" ) .

odr:E_connection_type a rdfs:Datatype ;
    rdfs:label "e_connection_type"@en ;
    owl:oneOf ( "default" "virtual" ) .

odr:E_countryCode a owl:Class ;
    rdfs:label "e_countryCode"@en ;
    rdfs:subClassOf odr:E_countryCode_iso3166alpha2,
        odr:E_countryCode_iso3166alpha3_deprecated .

odr:E_junction_segment_type a rdfs:Datatype ;
    rdfs:label "e_junction_segment_type"@en ;
    owl:oneOf ( "joint" "lane" ) .

odr:E_paramPoly3_pRange a rdfs:Datatype ;
    rdfs:label "e_paramPoly3_pRange"@en ;
    owl:oneOf ( "arcLength" "normalized" ) .

odr:E_roadMarkRule a rdfs:Datatype ;
    rdfs:label "e_roadMarkRule"@en ;
    owl:oneOf ( "no passing" "caution" "none" ) .

odr:E_roadMarkWeight a rdfs:Datatype ;
    rdfs:label "e_roadMarkWeight"@en ;
    owl:oneOf ( "standard" "bold" ) .

odr:E_roadType a rdfs:Datatype ;
    rdfs:label "e_roadType"@en ;
    rdfs:comment "The known keywords for the road type information are:"@en ;
    owl:oneOf ( "unknown" "rural" "motorway" "town" "lowSpeed" "pedestrian" "bicycle" "townExpressway" "townCollector" "townArterial" "townPrivate" "townLocal" "townPlayStreet" ) ;
    skos:definition "The known keywords for the road type information are:"@en .

odr:T_controller a owl:Class ;
    rdfs:label "t_controller"@en ;
    rdfs:comment "Controllers provide a signal program for a traffic signal or a signal group. The mapping of traffic signals to a signal group is done in t_controller. Dynamic content like the signal program itself is specified outside of this standard (i.e. in OpenSCENARIO)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_controller_control ;
            owl:onProperty odr:T_controller.control ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_controller.sequence ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_controller.name ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_controller.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Controllers provide a signal program for a traffic signal or a signal group. The mapping of traffic signals to a signal group is done in t_controller. Dynamic content like the signal program itself is specified outside of this standard (i.e. in OpenSCENARIO)."@en .

odr:T_controller_control a owl:Class ;
    rdfs:label "t_controller_control"@en ;
    rdfs:comment "Provides information about a single signal within a signal group controlled by the corresponding controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_controller_control.signalId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_controller_control.type ],
        odr:_OpenDriveElement ;
    skos:definition "Provides information about a single signal within a signal group controlled by the corresponding controller."@en .

odr:T_dataQuality a owl:Class ;
    rdfs:label "t_dataQuality"@en ;
    rdfs:comment "Describes the quality and accuracy of measurement data that is integrated into the ASAM OpenDRIVE file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_dataQuality_Error ;
            owl:onProperty odr:T_dataQuality.error ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_dataQuality_RawData ;
            owl:onProperty odr:T_dataQuality.rawData ] ;
    skos:definition "Describes the quality and accuracy of measurement data that is integrated into the ASAM OpenDRIVE file."@en .

odr:T_header_defaultRegulations a owl:Class ;
    rdfs:label "t_header_defaultRegulations"@en ;
    rdfs:comment """Defines the default regulations. In each country there are different speed limits to a rural road. For example a rural road has a speed limit of 100km/h in Germany and 80km/h in the Netherlands.\r
In some countries, one is allowed to turn right at a red traffic light; in others, one is not. Instead of writing this for each road or each signal, the default regulations can be specified once in the header for the entire {THIS_STANDARD} file. The default driving regulations can be overwritten with road, lane, or signal definitions."""@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition """Defines the default regulations. In each country there are different speed limits to a rural road. For example a rural road has a speed limit of 100km/h in Germany and 80km/h in the Netherlands.\r
In some countries, one is allowed to turn right at a red traffic light; in others, one is not. Instead of writing this for each road or each signal, the default regulations can be specified once in the header for the entire {THIS_STANDARD} file. The default driving regulations can be overwritten with road, lane, or signal definitions."""@en .

odr:T_header_signalRegulation a owl:Class ;
    rdfs:label "t_header_signalRegulation"@en ;
    rdfs:comment "Defines the default regulations for signs in different countries, for example, if it is allowed to turn right when a red traffic light appears."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_signals_semantics ;
            owl:onProperty odr:T_header_signalRegulation.semantics ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_header_signalRegulation.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_header_signalRegulation.subtype ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the default regulations for signs in different countries, for example, if it is allowed to turn right when a red traffic light appears."@en .

odr:T_junctionGroup a owl:Class ;
    rdfs:label "t_junctionGroup"@en ;
    rdfs:comment """Junction groups indicate for routing that the grouped junctions belong to the same node and are commonly seen as one big junction, for example roundabouts or highway interchanges.\r
The <junctionGroup> element is split into a header element and a series of member elements."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junctionGroup.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junctionGroup.name ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_junctionGroup_type ;
            owl:onProperty odr:T_junctionGroup.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junctionGroup_junctionReference ;
            owl:onProperty odr:T_junctionGroup.junctionReference ],
        odr:_OpenDriveElement ;
    skos:definition """Junction groups indicate for routing that the grouped junctions belong to the same node and are commonly seen as one big junction, for example roundabouts or highway interchanges.\r
The <junctionGroup> element is split into a header element and a series of member elements."""@en .

odr:T_junction_boundary_segment_lane a owl:Class ;
    rdfs:label "t_junction_boundary_segment_lane"@en ;
    rdfs:comment "A segment element with @type=\"lane\" goes along @boundaryLane for the given s range. It is the outmost edge of the lane  relative to the center of the junction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass odr:T_grEqZeroOrContactPoint ;
            owl:onProperty odr:T_junction_boundary_segment_lane.sEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_grEqZeroOrContactPoint ;
            owl:onProperty odr:T_junction_boundary_segment_lane.sStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_junction_segment_type ;
            owl:onProperty odr:T_junction_boundary_segment_lane.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_junction_boundary_segment_lane.boundaryLane ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_junction_boundary_segment ;
    skos:definition "A segment element with @type=\"lane\" goes along @boundaryLane for the given s range. It is the outmost edge of the lane  relative to the center of the junction."@en .

odr:T_junction_elevationGrid_elevation a owl:Class ;
    rdfs:label "t_junction_elevationGrid_elevation"@en ;
    rdfs:comment "Defines the z-values at the regular grid points along the junction reference line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass odr:T_junction_grid_position_list ;
            owl:onProperty odr:T_junction_elevationGrid_elevation.center ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_grid_position_list ;
            owl:onProperty odr:T_junction_elevationGrid_elevation.left ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_grid_position_list ;
            owl:onProperty odr:T_junction_elevationGrid_elevation.right ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the z-values at the regular grid points along the junction reference line."@en .

odr:T_road_lanes_laneSection_lcr_lane_link_predecessorSuccessor a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_link_predecessorSuccessor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_layerType ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_link_predecessorSuccessor.layer ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_link_predecessorSuccessor.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement .

odr:T_road_lanes_laneSection_lr_lane_access a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_access"@en ;
    rdfs:comment """Defines access restrictions for certain types of road users.\r
Each element is valid in direction of the increasing s coordinate until a new element is defined. If multiple elements are defined, they shall be listed in ascending order."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_road_lanes_laneSection_lr_lane_access_rule ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_access.rule ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_accessRestrictionType ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_access.restriction ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_access.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Defines access restrictions for certain types of road users.\r
Each element is valid in direction of the increasing s coordinate until a new element is defined. If multiple elements are defined, they shall be listed in ascending order."""@en .

odr:T_road_lanes_laneSection_lr_lane_height a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_height"@en ;
    rdfs:comment """Lane heights elevate lanes along the h-coordinate within a lane section independent from the road elevation. \r
Lane height is used to implement small-scale elevation such as raising pedestrian walkways. Lane height is specified as offset from the road (including elevation, superelevation, shape, cross section surface) in h-direction."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_height.inner ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_height.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_height.outer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Lane heights elevate lanes along the h-coordinate within a lane section independent from the road elevation. \r
Lane height is used to implement small-scale elevation such as raising pedestrian walkways. Lane height is specified as offset from the road (including elevation, superelevation, shape, cross section surface) in h-direction."""@en .

odr:T_road_lanes_laneSection_lr_lane_speed a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_speed"@en ;
    rdfs:comment "Defines the maximum allowed speed on a given lane. Each element is valid in direction of the increasing s-coordinate until a new element is defined."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_speed.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_speed.max ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_unitSpeed ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_speed.unit ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the maximum allowed speed on a given lane. Each element is valid in direction of the increasing s-coordinate until a new element is defined."@en .

odr:T_road_lateralProfile_crossSectionSurface a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface"@en ;
    rdfs:comment """A cross section surface defines the lateral profile by means of constant, linear, quadratic, and cubic polynomials in t-direction.\r
A cross section surface is valid for the full length of the road."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_surfaceStrip ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface.surfaceStrips ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_tOffset ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface.tOffset ],
        odr:_OpenDriveElement ;
    skos:definition """A cross section surface defines the lateral profile by means of constant, linear, quadratic, and cubic polynomials in t-direction.\r
A cross section surface is valid for the full length of the road."""@en .

odr:T_road_link a owl:Class ;
    rdfs:label "t_road_link"@en ;
    rdfs:comment "Follows the road header if the road is linked to a successor or a predecessor. Isolated roads may omit this element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_link_predecessorSuccessor ;
            owl:onProperty odr:T_road_link.successor ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_link_predecessorSuccessor ;
            owl:onProperty odr:T_road_link.predecessor ],
        odr:_OpenDriveElement ;
    skos:definition "Follows the road header if the road is linked to a successor or a predecessor. Isolated roads may omit this element."@en .

odr:T_road_objects_object_parkingSpace a owl:Class ;
    rdfs:label "t_road_objects_object_parkingSpace"@en ;
    rdfs:comment "Details for a parking space may be added to the <object> element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_object_parkingSpace.restrictions ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_road_objects_object_parkingSpace_access ;
            owl:onProperty odr:T_road_objects_object_parkingSpace.access ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Details for a parking space may be added to the <object> element."@en .

odr:T_road_planView_geometry_spiral a owl:Class ;
    rdfs:label "t_road_planView_geometry_spiral"@en ;
    rdfs:comment "Spirals or more specifically Euler spirals also known as clothoids. They describe road reference lines with constantly changing curvatures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_spiral.curvEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_spiral.curvStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Spirals or more specifically Euler spirals also known as clothoids. They describe road reference lines with constantly changing curvatures."@en .

odr:T_road_railroad_switch_partner a owl:Class ;
    rdfs:label "t_road_railroad_switch_partner"@en ;
    rdfs:comment "Partner switches are two consistently set switches linked by a side track."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_railroad_switch_partner.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_railroad_switch_partner.name ],
        odr:_OpenDriveElement ;
    skos:definition "Partner switches are two consistently set switches linked by a side track."@en .

odr:T_road_signals a owl:Class ;
    rdfs:label "t_road_signals"@en ;
    rdfs:comment """Signals are traffic signs, traffic lights, and specific road markings that guide driver and traffic models.\r
The <signals> element is the container for all signals along a road."""@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition """Signals are traffic signs, traffic lights, and specific road markings that guide driver and traffic models.\r
The <signals> element is the container for all signals along a road."""@en .

odr:T_road_signals_signal_dependency a owl:Class ;
    rdfs:label "t_road_signals_signal_dependency"@en ;
    rdfs:comment "Signal dependencies limit or extend the validity of one signal by an additional signal. For example, a speed limit sign of 60 km/h that is only valid for trucks, specified by a supplementary sign. One signal may have multiple dependencies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal_dependency.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal_dependency.type ],
        odr:_OpenDriveElement ;
    skos:definition "Signal dependencies limit or extend the validity of one signal by an additional signal. For example, a speed limit sign of 60 km/h that is only valid for trucks, specified by a supplementary sign. One signal may have multiple dependencies."@en .

odr:T_road_type_speed a owl:Class ;
    rdfs:label "t_road_type_speed"@en ;
    rdfs:comment "Defines the default maximum speed allowed in conjunction with the specified road type."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_unitSpeed ;
            owl:onProperty odr:T_road_type_speed.unit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_maxSpeed ;
            owl:onProperty odr:T_road_type_speed.max ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defines the default maximum speed allowed in conjunction with the specified road type."@en .

odr:T_signals_semantics_person a owl:Class ;
    rdfs:label "t_signals_semantics_person"@en ;
    rdfs:comment "Specifies a human traffic participant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_personCategory ;
            owl:onProperty odr:T_signals_semantics_person.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies a human traffic participant."@en .

odr:T_signals_semantics_prohibited a owl:Class ;
    rdfs:label "t_signals_semantics_prohibited"@en ;
    rdfs:comment "Specifies that certain types of traffic participants are not allowed to enter. See Section 14.8.2, “Traffic participants” for details."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Specifies that certain types of traffic participants are not allowed to enter. See Section 14.8.2, “Traffic participants” for details."@en .

odr:T_signals_semantics_speed a owl:Class ;
    rdfs:label "t_signals_semantics_speed"@en ;
    rdfs:comment "Specifies speed regulations."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_signals_semantics_speed.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_unitSpeed ;
            owl:onProperty odr:T_signals_semantics_speed.unit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_signals_semantics_speed ;
            owl:onProperty odr:T_signals_semantics_speed.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies speed regulations."@en .

odr:T_signals_semantics_supplementaryAllows a owl:Class ;
    rdfs:label "t_signals_semantics_supplementaryAllows"@en ;
    rdfs:comment "This signal semantic has no meaning on its own. It specifies the type of the traffic participant an exception is made for. See Section 14.8.2, “Traffic participants” for details."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "This signal semantic has no meaning on its own. It specifies the type of the traffic participant an exception is made for. See Section 14.8.2, “Traffic participants” for details."@en .

odr:T_signals_semantics_supplementaryDistance a owl:Class ;
    rdfs:label "t_signals_semantics_supplementaryDistance"@en ;
    rdfs:comment "This signal semantic has no meaning on its own. It specifies the distance after a sign becomes valid or the range in which the sign is valid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_signals_semantics_supplementaryDistance ;
            owl:onProperty odr:T_signals_semantics_supplementaryDistance.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_signals_semantics_supplementaryDistance.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_unitDistance ;
            owl:onProperty odr:T_signals_semantics_supplementaryDistance.unit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "This signal semantic has no meaning on its own. It specifies the distance after a sign becomes valid or the range in which the sign is valid."@en .

odr:T_signals_semantics_supplementaryProhibits a owl:Class ;
    rdfs:label "t_signals_semantics_supplementaryProhibits"@en ;
    rdfs:comment "This signal semantic has no meaning on its own. It specifies the type of the traffic participant a restriction is made for. See Section 14.8.2, “Traffic participants” for details."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "This signal semantic has no meaning on its own. It specifies the type of the traffic participant a restriction is made for. See Section 14.8.2, “Traffic participants” for details."@en .

odr:T_signals_semantics_vehicle a owl:Class ;
    rdfs:label "t_signals_semantics_vehicle"@en ;
    rdfs:comment "Specifies a vehicular traffic participant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_vehicleCategory ;
            owl:onProperty odr:T_signals_semantics_vehicle.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies a vehicular traffic participant."@en .

odr:T_station a owl:Class ;
    rdfs:label "t_station"@en ;
    rdfs:comment """Stations are places on the rail network where passengers enter and leave rail-bound vehicles at platforms.\r
May refer to multiple tracks and is therefore defined on the same level as junctions."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_station_platform ;
            owl:onProperty odr:T_station.platform ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_station_type ;
            owl:onProperty odr:T_station.type ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_station.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_station.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Stations are places on the rail network where passengers enter and leave rail-bound vehicles at platforms.\r
May refer to multiple tracks and is therefore defined on the same level as junctions."""@en .

odr:T_yesNo a rdfs:Datatype ;
    rdfs:label "t_yesNo"@en ;
    owl:oneOf ( "yes" "no" ) .

odr:E_contactPoint a rdfs:Datatype ;
    rdfs:label "e_contactPoint"@en ;
    owl:oneOf ( "start" "end" ) .

odr:T_junction_boundary_segment a owl:Class ;
    rdfs:label "t_junction_boundary_segment"@en ;
    rdfs:comment "Segments run counter clockwise around the junction and form a closed junction boundary."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_boundary_segment.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Segments run counter clockwise around the junction and form a closed junction boundary."@en .

odr:T_junction_boundary_segment_joint a owl:Class ;
    rdfs:label "t_junction_boundary_segment_joint"@en ;
    rdfs:comment "A segment element with @type=\"joint\" is perpendicular to the start or end of the given road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_junction_boundary_segment_joint.jointLaneEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_boundary_segment_joint.transitionLength ],
        [ a owl:Restriction ;
            owl:onClass odr:T_grEqZeroOrContactPoint ;
            owl:onProperty odr:T_junction_boundary_segment_joint.contactPoint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_junction_segment_type ;
            owl:onProperty odr:T_junction_boundary_segment_joint.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_junction_boundary_segment_joint.jointLaneStart ],
        odr:T_junction_boundary_segment ;
    skos:definition "A segment element with @type=\"joint\" is perpendicular to the start or end of the given road."@en .

odr:T_junction_connection_virtual a owl:Class ;
    rdfs:label "t_junction_connection_virtual"@en ;
    rdfs:comment "Virtual connections indicate possible connections between two roads or one or more lanes of two roads. Virtual connections do not specify connecting roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_connection_type ;
            owl:onProperty odr:T_junction_connection_virtual.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_connection_virtual.connectingRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_junction_predecessorSuccessor ;
            owl:onProperty odr:T_junction_connection_virtual.successor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_junction_predecessorSuccessor ;
            owl:onProperty odr:T_junction_connection_virtual.predecessor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_junction_connection ;
    skos:definition "Virtual connections indicate possible connections between two roads or one or more lanes of two roads. Virtual connections do not specify connecting roads."@en .

odr:T_junction_elevationGrid a owl:Class ;
    rdfs:label "t_junction_elevationGrid"@en ;
    rdfs:comment "An elevation grid is a coarse square grid with z-values at evenly spaced points. Elevation grids do not replace OpenCRG."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_elevationGrid.sStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_elevationGrid.gridSpacing ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "An elevation grid is a coarse square grid with z-values at evenly spaced points. Elevation grids do not replace OpenCRG."@en .

odr:T_road_lanes_laneSection_lr_lane_material a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_material"@en ;
    rdfs:comment "Stores information about the material of lanes. Each element is valid until a new element is defined. If multiple elements are defined, they must be listed in ascending order."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_material.roughness ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_material.surface ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_material.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_material.friction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Stores information about the material of lanes. Each element is valid until a new element is defined. If multiple elements are defined, they must be listed in ascending order."@en .

odr:T_road_lateralProfile a owl:Class ;
    rdfs:label "t_road_lateralProfile"@en ;
    rdfs:comment "Contains a series of lateral elevation elements that define the characteristics of the road surfaces banking along the road reference line. The lateral profile is defined relative to the elevation of the road reference line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface ;
            owl:onProperty odr:T_road_lateralProfile.crossSectionSurface ],
        odr:_OpenDriveElement ;
    skos:definition "Contains a series of lateral elevation elements that define the characteristics of the road surfaces banking along the road reference line. The lateral profile is defined relative to the elevation of the road reference line."@en .

odr:T_road_objects_object_markings a owl:Class ;
    rdfs:label "t_road_objects_object_markings"@en ;
    rdfs:comment "Object markings are road markings of any objects, for example, crosswalks and parking spaces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_markings_marking ;
            owl:onProperty odr:T_road_objects_object_markings.marking ],
        odr:_OpenDriveElement ;
    skos:definition "Object markings are road markings of any objects, for example, crosswalks and parking spaces."@en .

odr:T_road_objects_object_material a owl:Class ;
    rdfs:label "t_road_objects_object_material"@en ;
    rdfs:comment "Describes the material properties of objects, for example, patches that are part of the road surface but deviate from the standard road material. Supersedes the material specified in the <road material> element and is valid only within the outline of the parent road object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_material.friction ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_material.roughness ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_roadMarkColor ;
            owl:onProperty odr:T_road_objects_object_material.roadMarkColor ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_object_material.surface ],
        odr:_OpenDriveElement ;
    skos:definition "Describes the material properties of objects, for example, patches that are part of the road surface but deviate from the standard road material. Supersedes the material specified in the <road material> element and is valid only within the outline of the parent road object."@en .

odr:T_road_objects_object_surface_CRG a owl:Class ;
    rdfs:label "t_road_objects_object_surface_CRG"@en ;
    rdfs:comment "Elevation data described in {GLO_VAR_STA_ASAM_OpenCRG} are represented by the <CRG> element within the <surface> element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_surface_CRG.hideRoadSurfaceCRG ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_surface_CRG.zScale ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_object_surface_CRG.file ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Elevation data described in {GLO_VAR_STA_ASAM_OpenCRG} are represented by the <CRG> element within the <surface> element."@en .

odr:T_road_railroad_switch_mainTrack a owl:Class ;
    rdfs:label "t_road_railroad_switch_mainTrack"@en ;
    rdfs:comment "Main tracks form the primary course for rail bound traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_railroad_switch_mainTrack.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_elementDir ;
            owl:onProperty odr:T_road_railroad_switch_mainTrack.dir ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_railroad_switch_mainTrack.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Main tracks form the primary course for rail bound traffic."@en .

odr:T_road_railroad_switch_sideTrack a owl:Class ;
    rdfs:label "t_road_railroad_switch_sideTrack"@en ;
    rdfs:comment "Side tracks connect two switches that are placed on main tracks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_railroad_switch_sideTrack.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_elementDir ;
            owl:onProperty odr:T_road_railroad_switch_sideTrack.dir ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_railroad_switch_sideTrack.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Side tracks connect two switches that are placed on main tracks."@en .

odr:T_road_signals_board a owl:Class ;
    rdfs:label "t_road_signals_board"@en ;
    rdfs:comment "Signals are not always separate signs on a single sheet of metal. Several signs can be coupled on one board."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Signals are not always separate signs on a single sheet of metal. Several signs can be coupled on one board."@en .

odr:T_road_signals_signal_reference a owl:Class ;
    rdfs:label "t_road_signals_signal_reference"@en ;
    rdfs:comment "Signal references link a signal to another signal or object. One signal may have multiple signal references. The signal reference term should not to be confused with the `<signalReference>` element that is used to link a signal to multiple roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal_reference.type ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_road_signals_signal_reference_elementType ;
            owl:onProperty odr:T_road_signals_signal_reference.elementType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal_reference.elementId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Signal references link a signal to another signal or object. One signal may have multiple signal references. The signal reference term should not to be confused with the `<signalReference>` element that is used to link a signal to multiple roads."@en .

odr:T_road_type a owl:Class ;
    rdfs:label "t_road_type"@en ;
    rdfs:comment "A road type element is valid for the entire cross section of a road. It is valid until a new road type element is provided or until the road ends."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:E_countryCode ;
            owl:onProperty odr:T_road_type.country ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_type_speed ;
            owl:onProperty odr:T_road_type.speed ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_type.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_roadType ;
            owl:onProperty odr:T_road_type.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "A road type element is valid for the entire cross section of a road. It is valid until a new road type element is provided or until the road ends."@en .

odr:T_signalGroup_vmsBoardReference a owl:Class ;
    rdfs:label "t_signalGroup_vmsBoardReference"@en ;
    rdfs:comment "Variable message board references list all variable message boards that belong to the same gantry."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_signalGroup_vmsBoardReference.groupIndex ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_signalGroup_vmsBoardReference.vmsIndex ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_signalGroup_vmsBoardReference.signalId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Variable message board references list all variable message boards that belong to the same gantry."@en .

odr:T_station_platform a owl:Class ;
    rdfs:label "t_station_platform"@en ;
    rdfs:comment "Platforms are essential parts of stations for passengers to enter and leave rail-bound vehicles. One or more railroad tracks reference one platform."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_station_platform.name ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_station_platform_segment ;
            owl:onProperty odr:T_station_platform.segment ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_station_platform.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Platforms are essential parts of stations for passengers to enter and leave rail-bound vehicles. One or more railroad tracks reference one platform."@en .

odr:E_laneType a rdfs:Datatype ;
    rdfs:label "e_laneType"@en ;
    rdfs:comment "The lane type is defined per lane. A lane type defines the main purpose of a lane and its corresponding traffic rules."@en ;
    owl:oneOf ( "shoulder" "border" "driving" "stop" "none" "restricted" "parking" "median" "biking" "shared" "sidewalk" "curb" "exit" "entry" "onRamp" "offRamp" "connectingRamp" "bidirectional" "special1" "special2" "special3" "roadWorks" "tram" "rail" "bus" "taxi" "HOV" "mwyEntry" "mwyExit" "walking" "slipLane" ) ;
    skos:definition "The lane type is defined per lane. A lane type defines the main purpose of a lane and its corresponding traffic rules."@en .

odr:E_unitSpeed a rdfs:Datatype ;
    rdfs:label "e_unitSpeed"@en ;
    owl:oneOf ( "m/s" "mph" "km/h" ) .

odr:T_dataQuality_Error a owl:Class ;
    rdfs:label "t_dataQuality_Error"@en ;
    rdfs:comment "Describes the error range, given in [m], of measurement data that is integrated into the ASAM OpenDRIVE file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_dataQuality_Error.zRelative ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_dataQuality_Error.xyRelative ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_dataQuality_Error.xyAbsolute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_dataQuality_Error.zAbsolute ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Describes the error range, given in [m], of measurement data that is integrated into the ASAM OpenDRIVE file."@en .

odr:T_grEqZeroOrContactPoint a owl:Class ;
    rdfs:label "t_grEqZeroOrContactPoint"@en ;
    rdfs:subClassOf odr:E_contactPoint,
        xsd:double .

odr:T_header_Offset a owl:Class ;
    rdfs:label "t_header_Offset"@en ;
    rdfs:comment "To avoid large coordinates, an offset of the whole dataset may be applied using the <offset> element. It enables inertial relocation and re-orientation of datasets. The dataset is first translated by @x, @y, and @z. Afterwards, it is rotated by @hdg around the new origin. Rotation around the z-axis should be avoided."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header_Offset.x ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header_Offset.hdg ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header_Offset.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header_Offset.y ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "To avoid large coordinates, an offset of the whole dataset may be applied using the <offset> element. It enables inertial relocation and re-orientation of datasets. The dataset is first translated by @x, @y, and @z. Afterwards, it is rotated by @hdg around the new origin. Rotation around the z-axis should be avoided."@en .

odr:T_junction_connection_laneLink a owl:Class ;
    rdfs:label "t_junction_connection_laneLink"@en ;
    rdfs:comment "Provides information about the lanes that are linked between an incoming road and a connecting road. It is strongly recommended to provide this element. It is deprecated to omit the <laneLink> element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_junction_connection_laneLink.from ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_layerType ;
            owl:onProperty odr:T_junction_connection_laneLink.fromLayer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_layerType ;
            owl:onProperty odr:T_junction_connection_laneLink.toLayer ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_junction_connection_laneLink.to ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_connection_laneLink.overlapZone ],
        odr:_OpenDriveElement ;
    skos:definition "Provides information about the lanes that are linked between an incoming road and a connecting road. It is strongly recommended to provide this element. It is deprecated to omit the <laneLink> element."@en .

odr:T_junction_grid_position_list a owl:Class ;
    rdfs:label "t_junction_grid_position_list"@en .

odr:T_junction_roadSection a owl:Class ;
    rdfs:label "t_junction_roadSection"@en ;
    rdfs:comment "Define the s range of the crossing roads with possible crossing traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_roadSection.sEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_roadSection.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_roadSection.sStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_roadSection.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Define the s range of the crossing roads with possible crossing traffic."@en .

odr:T_license a owl:Class ;
    rdfs:label "t_license"@en ;
    rdfs:comment "Licensing information about the OpenDRIVE file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_license.spdxid ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_license.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_license.resource ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_license.text ],
        odr:_OpenDriveElement ;
    skos:definition "Licensing information about the OpenDRIVE file."@en .

odr:T_road_elevationProfile_elevation a owl:Class ;
    rdfs:label "t_road_elevationProfile_elevation"@en ;
    rdfs:comment "Defines an elevation element at a given position on the road reference line. Elements shall be defined in ascending order along the reference line. The s length does not change with the elevation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_elevationProfile_elevation.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_elevationProfile_elevation.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_elevationProfile_elevation.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_elevationProfile_elevation.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_elevationProfile_elevation.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defines an elevation element at a given position on the road reference line. Elements shall be defined in ascending order along the reference line. The s length does not change with the elevation."@en .

odr:T_road_lanes a owl:Class ;
    rdfs:label "t_road_lanes"@en ;
    rdfs:comment """Lanes are an essential part of all roads. Lanes are attached to the road reference line and are defined from inside to outside.\r
Lanes contain a series of lane section elements that define the characteristics of the road cross sections with respect to the lanes along the road reference line."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_layerType ;
            owl:onProperty odr:T_road_lanes.layer ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection ;
            owl:onProperty odr:T_road_lanes.laneSection ],
        odr:_OpenDriveElement ;
    skos:definition """Lanes are an essential part of all roads. Lanes are attached to the road reference line and are defined from inside to outside.\r
Lanes contain a series of lane section elements that define the characteristics of the road cross sections with respect to the lanes along the road reference line."""@en .

odr:T_road_lanes_laneOffset a owl:Class ;
    rdfs:label "t_road_lanes_laneOffset"@en ;
    rdfs:comment "Lane offsets shift the center lane away from the road reference line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneOffset.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneOffset.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneOffset.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneOffset.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneOffset.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Lane offsets shift the center lane away from the road reference line."@en .

odr:T_road_lanes_laneSection_lcr_lane_link a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_link"@en ;
    rdfs:comment """For links between lanes with an identical road reference line, the lane predecessor and successor information provide the IDs of lanes on the preceding or following lane section.\r
For links between lanes with different road reference line,  the lane predecessor and successor information provide the IDs of lanes on the first or last lane section of the other road reference line depending on the contact point of the road linkage.\r
This element may only be omitted, if lanes end at a junction or have no physical link."""@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition """For links between lanes with an identical road reference line, the lane predecessor and successor information provide the IDs of lanes on the preceding or following lane section.\r
For links between lanes with different road reference line,  the lane predecessor and successor information provide the IDs of lanes on the first or last lane section of the other road reference line depending on the contact point of the road linkage.\r
This element may only be omitted, if lanes end at a junction or have no physical link."""@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_sway a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_roadMark_sway"@en ;
    rdfs:comment "Relocates the lateral reference position for the following (explicit) type definition and thus defines an offset. The sway offset is relative to the nominal reference position of the lane marking, meaning the lane border."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_sway.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_sway.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_sway.ds ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_sway.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_sway.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Relocates the lateral reference position for the following (explicit) type definition and thus defines an offset. The sway offset is relative to the nominal reference position of the lane marking, meaning the lane border."@en .

odr:T_road_lateralProfile_superelevation a owl:Class ;
    rdfs:label "t_road_lateralProfile_superelevation"@en ;
    rdfs:comment """Superelevation specifies the transverse slope along the road reference line. Superelevation is constant in each cross section and can vary in road reference line direction.\r
Elements must be defined in ascending order along the reference line. The parameters of an element are valid until the next element starts or the road reference line ends. Per default, the superelevation of a road is zero."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_superelevation.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_superelevation.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_superelevation.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_superelevation.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_superelevation.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Superelevation specifies the transverse slope along the road reference line. Superelevation is constant in each cross section and can vary in road reference line direction.\r
Elements must be defined in ascending order along the reference line. The parameters of an element are valid until the next element starts or the road reference line ends. Per default, the superelevation of a road is zero."""@en .

odr:T_road_planView_geometry_poly3 a owl:Class ;
    rdfs:label "t_road_planView_geometry_poly3"@en ;
    rdfs:comment "A cubic polynom describing the road reference line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_poly3.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_poly3.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_poly3.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_planView_geometry_poly3.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "A cubic polynom describing the road reference line."@en .

odr:T_road_signals_displayArea a owl:Class ;
    rdfs:label "t_road_signals_displayArea"@en ;
    rdfs:comment "A display area is the recommended position of the signal to be visualized in the simulation. A display area is specified in the `<displayArea>` element. A `<displayArea>` element is defined in the local coordinate system of the `<signal>` element. The @index attribute can be used in ASAM OpenSCENARIO to reference the display area. In ASAM OpenSCENARIO a different local display area position may be specified."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_displayArea.width ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_displayArea.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_road_signals_displayArea.index ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_displayArea.v ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_displayArea.height ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "A display area is the recommended position of the signal to be visualized in the simulation. A display area is specified in the `<displayArea>` element. A `<displayArea>` element is defined in the local coordinate system of the `<signal>` element. The @index attribute can be used in ASAM OpenSCENARIO to reference the display area. In ASAM OpenSCENARIO a different local display area position may be specified."@en .

odr:T_road_signals_signalReference a owl:Class ;
    rdfs:label "t_road_signals_signalReference"@en ;
    rdfs:comment "Refers to the same, that is, identical signal from multiple roads. The referenced signals require a unique ID. The <signalReference> element consists of a main element and an optional lane validity element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_orientation ;
            owl:onProperty odr:T_road_signals_signalReference.orientation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signalReference.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signalReference.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signalReference.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Refers to the same, that is, identical signal from multiple roads. The referenced signals require a unique ID. The <signalReference> element consists of a main element and an optional lane validity element."@en .

odr:T_road_signals_signal_road a owl:Class ;
    rdfs:label "t_road_signals_signal_road"@en ;
    rdfs:comment "Used to provide information about signals along a road. Consists of a main element and an optional lane validity element. The element for a signal is <signal>."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_road.zOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_road.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_road.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_road_signals_signal ;
    skos:definition "Used to provide information about signals along a road. Consists of a main element and an optional lane validity element. The element for a signal is <signal>."@en .

odr:T_station_platform_segment a owl:Class ;
    rdfs:label "t_station_platform_segment"@en ;
    rdfs:comment """Segments are parts of platforms.\r
Each <platform> element is valid on one or more track segments. The <segment> element must be specified."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_station_platform_segment.sEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_station_platform_segment.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_station_platform_segment_side ;
            owl:onProperty odr:T_station_platform_segment.side ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_station_platform_segment.sStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Segments are parts of platforms.\r
Each <platform> element is valid on one or more track segments. The <segment> element must be specified."""@en .

odr:T_dataQuality_RawData a owl:Class ;
    rdfs:label "t_dataQuality_RawData"@en ;
    rdfs:comment "Describes some basic metadata containing information about the raw data."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_dataQuality_RawData.postProcessingComment ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_dataQuality_RawData_Source ;
            owl:onProperty odr:T_dataQuality_RawData.source ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_dataQuality_RawData.date ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_dataQuality_RawData_PostProcessing ;
            owl:onProperty odr:T_dataQuality_RawData.postProcessing ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_dataQuality_RawData.sourceComment ] ;
    skos:definition "Describes some basic metadata containing information about the raw data."@en .

odr:T_junction_crossPath_laneLink a owl:Class ;
    rdfs:label "t_junction_crossPath_laneLink"@en ;
    rdfs:comment "Define the links between the lanes of the <crossPath> to the lanes of other roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_junction_crossPath_laneLink.from ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_junction_crossPath_laneLink.to ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_crossPath_laneLink.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Define the links between the lanes of the <crossPath> to the lanes of other roads."@en .

odr:T_junction_crossing a owl:Class ;
    rdfs:label "t_junction_crossing"@en ;
    rdfs:comment "Crossings are junctions without connecting roads. They define sections where crossing traffic can appear. Traffic does not change roads at crossings, for example, at railway crossings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_planView ;
            owl:onProperty odr:T_junction_crossing.planView ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_surface ;
            owl:onProperty odr:T_junction_crossing.surface ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects ;
            owl:onProperty odr:T_junction_crossing.objects ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_roadSection ;
            owl:onProperty odr:T_junction_crossing.roadSection ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_junction_type ;
            owl:onProperty odr:T_junction_crossing.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:T_junction ;
    skos:definition "Crossings are junctions without connecting roads. They define sections where crossing traffic can appear. Traffic does not change roads at crossings, for example, at railway crossings."@en .

odr:T_junction_direct a owl:Class ;
    rdfs:label "t_junction_direct"@en ;
    rdfs:comment "Direct junctions are intended to model entries and exits where drivable lanes may overlap to split or merge, but traffic does not cross."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_junction_type ;
            owl:onProperty odr:T_junction_direct.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_planView ;
            owl:onProperty odr:T_junction_direct.planView ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects ;
            owl:onProperty odr:T_junction_direct.objects ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_connection_direct ;
            owl:onProperty odr:T_junction_direct.connection ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_surface ;
            owl:onProperty odr:T_junction_direct.surface ],
        odr:T_junction ;
    skos:definition "Direct junctions are intended to model entries and exits where drivable lanes may overlap to split or merge, but traffic does not cross."@en .

odr:T_junction_priority a owl:Class ;
    rdfs:label "t_junction_priority"@en ;
    rdfs:comment "The junction priority record provides information about the priority of one road over another road that are part of this junction. It is only required if priorities cannot be derived from signs or signals in a junction or on tracks leading to a junction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_priority.high ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_priority.low ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "The junction priority record provides information about the priority of one road over another road that are part of this junction. It is only required if priorities cannot be derived from signs or signals in a junction or on tracks leading to a junction."@en .

odr:T_road_lanes_laneSection_center_lane a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_center_lane"@en ;
    rdfs:comment "Center lane element with ID zero. Has no width attribute. Mainly used for road markings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_road_lanes_laneSection_center_lane.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_lanes_laneSection_center_lane.level ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lcr_lane_link ;
            owl:onProperty odr:T_road_lanes_laneSection_center_lane.link ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_laneType ;
            owl:onProperty odr:T_road_lanes_laneSection_center_lane.type ] ;
    skos:definition "Center lane element with ID zero. Has no width attribute. Mainly used for road markings."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_roadMark_explicit_line"@en ;
    rdfs:comment "Specifies a single line in an explicit road marking definition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.tOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_roadMarkRule ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.rule ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.width ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_explicit_line.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies a single line in an explicit road marking definition."@en .

odr:T_road_lanes_laneSection_lr_lane_border a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_border"@en ;
    rdfs:comment """Lane borders set the width of lanes. Lane borders describe the outer limits of lanes, independent of the parameters of their inner borders. In this case, inner lanes are defined as lanes which have the same sign for their ID as the lane currently defined, but with a smaller absolute value for their ID.\r
Especially when road data is derived from automatic measurements, this type of definition is easier than specifying the lane width because it avoids creating many lane sections.\r
Lane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application shall use the information from the <width> elements."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_border.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_border.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_border.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_border.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_border.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Lane borders set the width of lanes. Lane borders describe the outer limits of lanes, independent of the parameters of their inner borders. In this case, inner lanes are defined as lanes which have the same sign for their ID as the lane currently defined, but with a smaller absolute value for their ID.\r
Especially when road data is derived from automatic measurements, this type of definition is easier than specifying the lane width because it avoids creating many lane sections.\r
Lane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application shall use the information from the <width> elements."""@en .

odr:T_road_lanes_laneSection_lr_lane_width a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane_width"@en ;
    rdfs:comment """Lane widths widen or narrow lanes along the t-coordinate within lane sections.\r
Lane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application must use the information from the <width> elements."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_width.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_width.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_width.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_width.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane_width.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Lane widths widen or narrow lanes along the t-coordinate within lane sections.\r
Lane width and lane border elements are mutually exclusive within the same lane group. If both width and lane border elements are present for a lane section in the ASAM OpenDRIVE file, the application must use the information from the <width> elements."""@en .

odr:T_road_lateralProfile_shape a owl:Class ;
    rdfs:label "t_road_lateralProfile_shape"@en ;
    rdfs:comment "Defined as the road section’s surface relative to the reference plane. There may be several shape definitions at one s-position that have different t-values, thereby describing the curvy shape of the road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_shape.b ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_shape.d ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_shape.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_shape.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_shape.c ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_shape.a ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defined as the road section’s surface relative to the reference plane. There may be several shape definitions at one s-position that have different t-values, thereby describing the curvy shape of the road."@en .

odr:T_road_objects_bridge a owl:Class ;
    rdfs:label "t_road_objects_bridge"@en ;
    rdfs:comment "Bridges are modeled as objects in ASAM OpenDRIVE. The road with the bridge object leads over a bridge. Bridges are valid for a road’s complete cross section unless a lane validity record with further restrictions is provided as child element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_bridgeType ;
            owl:onProperty odr:T_road_objects_bridge.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_bridge.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_bridge.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_bridge.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_bridge.name ],
        odr:_OpenDriveElement ;
    skos:definition "Bridges are modeled as objects in ASAM OpenDRIVE. The road with the bridge object leads over a bridge. Bridges are valid for a road’s complete cross section unless a lane validity record with further restrictions is provided as child element."@en .

odr:T_road_objects_object_borders_border a owl:Class ;
    rdfs:label "t_road_objects_object_borders_border"@en ;
    rdfs:comment "Specifies a border along certain outline points."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_borderType ;
            owl:onProperty odr:T_road_objects_object_borders_border.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_road_objects_object_borders_border.outlineId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_borders_border.width ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_borders_border.useCompleteOutline ],
        odr:_OpenDriveElement ;
    skos:definition "Specifies a border along certain outline points."@en .

odr:T_road_objects_object_outlines_outline_cornerLocal a owl:Class ;
    rdfs:label "t_road_objects_object_outlines_outline_cornerLocal"@en ;
    rdfs:comment "Defines a corner point on the object’s outline relative to the object's origin in local u/v-coordinates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerLocal.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerLocal.u ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerLocal.height ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerLocal.id ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerLocal.v ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Defines a corner point on the object’s outline relative to the object's origin in local u/v-coordinates."@en .

odr:T_road_objects_object_outlines_outline_cornerRoad a owl:Class ;
    rdfs:label "t_road_objects_object_outlines_outline_cornerRoad"@en ;
    rdfs:comment "Defines a corner point on the object’s outline in road coordinates."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerRoad.height ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerRoad.dz ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerRoad.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerRoad.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_road_objects_object_outlines_outline_cornerRoad.id ],
        odr:_OpenDriveElement ;
    skos:definition "Defines a corner point on the object’s outline in road coordinates."@en .

odr:T_road_railroad_switch a owl:Class ;
    rdfs:label "t_road_railroad_switch"@en ;
    rdfs:comment "Switches change the tracks for rail-bound vehicles. Switches guide the vehicles into two directions only."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_road_railroad_switch_position ;
            owl:onProperty odr:T_road_railroad_switch.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_railroad_switch_mainTrack ;
            owl:onProperty odr:T_road_railroad_switch.mainTrack ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_railroad_switch.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_railroad_switch_sideTrack ;
            owl:onProperty odr:T_road_railroad_switch.sideTrack ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_railroad_switch.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_railroad_switch_partner ;
            owl:onProperty odr:T_road_railroad_switch.partner ],
        odr:_OpenDriveElement ;
    skos:definition "Switches change the tracks for rail-bound vehicles. Switches guide the vehicles into two directions only."@en .

odr:T_road_signals_vmsBoard a owl:Class ;
    rdfs:label "t_road_signals_vmsBoard"@en ;
    rdfs:comment """Variable message boards can change their values during the simulation in ASAM OpenSCENARIO.\r
Variable message boards are switched off if they are not specified in ASAM OpenSCENARIO."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_vmsBoard.displayWidth ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_vmsBoard.v ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_road_signals_displayType ;
            owl:onProperty odr:T_road_signals_vmsBoard.displayType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_vmsBoard.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_vmsBoard.displayHeight ],
        odr:T_road_signals_board ;
    skos:definition """Variable message boards can change their values during the simulation in ASAM OpenSCENARIO.\r
Variable message boards are switched off if they are not specified in ASAM OpenSCENARIO."""@en .

odr:E_elementDir a rdfs:Datatype ;
    rdfs:label "e_elementDir"@en ;
    owl:oneOf ( "+" "-" ) .

odr:E_junction_type a rdfs:Datatype ;
    rdfs:label "e_junction_type"@en ;
    owl:oneOf ( "default" "virtual" "direct" "crossing" ) .

odr:E_roadMarkColor a rdfs:Datatype ;
    rdfs:label "e_roadMarkColor"@en ;
    rdfs:comment "The known keywords for the road marking color information are:"@en ;
    owl:oneOf ( "standard" "blue" "green" "red" "white" "yellow" "black" "orange" "violet" ) ;
    skos:definition "The known keywords for the road marking color information are:"@en .

odr:T_junction_connection a owl:Class ;
    rdfs:label "t_junction_connection"@en ;
    rdfs:comment "Provides information about a single connection within a junction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_connection.incomingRoad ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_contactPoint ;
            owl:onProperty odr:T_junction_connection.contactPoint ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_connection.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Provides information about a single connection within a junction."@en .

odr:T_junction_controller a owl:Class ;
    rdfs:label "t_junction_controller"@en ;
    rdfs:comment "Lists the controllers that should be grouped in a sychronization group (limited to that particular junction)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_controller.type ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_controller.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_junction_controller.sequence ],
        odr:_OpenDriveElement ;
    skos:definition "Lists the controllers that should be grouped in a sychronization group (limited to that particular junction)."@en .

odr:T_junction_crossPath a owl:Class ;
    rdfs:label "t_junction_crossPath"@en ;
    rdfs:comment "Cross paths are intended for pedestrian crossings and are junctions elements where traffic of a lane can cross other lanes and continue on a different lane of the same or a different road. The cross path itself is a separate road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_crossPath.roadAtEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_junction_crossPath_laneLink ;
            owl:onProperty odr:T_junction_crossPath.endLaneLink ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_crossPath.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_crossPath.crossingRoad ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass odr:T_junction_crossPath_laneLink ;
            owl:onProperty odr:T_junction_crossPath.startLaneLink ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_crossPath.roadAtStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Cross paths are intended for pedestrian crossings and are junctions elements where traffic of a lane can cross other lanes and continue on a different lane of the same or a different road. The cross path itself is a separate road."@en .

odr:T_junction_predecessorSuccessor a owl:Class ;
    rdfs:label "t_junction_predecessorSuccessor"@en ;
    rdfs:comment "Provides detailed information about the predecessor / successor road of a virtual connection. Currently, only the @elementType “road” is allowed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_predecessorSuccessor.elementType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_junction_predecessorSuccessor.elementId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_junction_predecessorSuccessor.elementS ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_elementDir ;
            owl:onProperty odr:T_junction_predecessorSuccessor.elementDir ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Provides detailed information about the predecessor / successor road of a virtual connection. Currently, only the @elementType “road” is allowed."@en .

odr:T_road_lanes_laneSection a owl:Class ;
    rdfs:label "t_road_lanes_laneSection"@en ;
    rdfs:comment """A lane section splits a road into multiple parts whenever the number of lanes or their function changes.\r
The distance between two succeeding lane sections shall not be zero.\r
For easier navigation through an ASAM OpenDRIVE road description, the lanes within a lane section are grouped into left, center, and right lanes. Each lane section shall contain one <center> element and at least one <right> or <left> element."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_lanes_laneSection.singleSide ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_lanes_laneSection_center ;
            owl:onProperty odr:T_road_lanes_laneSection.center ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_left ;
            owl:onProperty odr:T_road_lanes_laneSection.left ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection.length ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_right ;
            owl:onProperty odr:T_road_lanes_laneSection.right ],
        odr:_OpenDriveElement ;
    skos:definition """A lane section splits a road into multiple parts whenever the number of lanes or their function changes.\r
The distance between two succeeding lane sections shall not be zero.\r
For easier navigation through an ASAM OpenDRIVE road description, the lanes within a lane section are grouped into left, center, and right lanes. Each lane section shall contain one <center> element and at least one <right> or <left> element."""@en .

odr:T_road_objects_objectReference a owl:Class ;
    rdfs:label "t_road_objects_objectReference"@en ;
    rdfs:comment "An object reference refers to one identical object from multiple roads. The referenced objects require a unique ID. The <objectReference> element consists of a main element and an optional lane validity element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_orientation ;
            owl:onProperty odr:T_road_objects_objectReference.orientation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_objectReference.validLength ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_objectReference.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_objectReference.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_objectReference.zOffset ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_objectReference.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "An object reference refers to one identical object from multiple roads. The referenced objects require a unique ID. The <objectReference> element consists of a main element and an optional lane validity element."@en .

odr:T_road_objects_object_skeleton_polyline_vertexLocal a owl:Class ;
    rdfs:label "t_road_objects_object_skeleton_polyline_vertexLocal"@en ;
    rdfs:comment "Defines a vertex point on the object polyline relative to the object's origin in local u/v-coordinates. The origin and the orientation of the object are given by the @s, @t, @zOffset and @hdg attributes of the element. <vertexLocal> can use either radius or length/width within one <polyline> element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexLocal.radius ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexLocal.intersectionPoint ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexLocal.u ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexLocal.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexLocal.v ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:positiveInteger ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexLocal.id ] ;
    skos:definition "Defines a vertex point on the object polyline relative to the object's origin in local u/v-coordinates. The origin and the orientation of the object are given by the @s, @t, @zOffset and @hdg attributes of the element. <vertexLocal> can use either radius or length/width within one <polyline> element."@en .

odr:T_road_objects_object_skeleton_polyline_vertexRoad a owl:Class ;
    rdfs:label "t_road_objects_object_skeleton_polyline_vertexRoad"@en ;
    rdfs:comment "Defines a point on the object’s polyline in road coordinates. <vertexRoad> can use either radius or length/width within one <polyline> element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:positiveInteger ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexRoad.id ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexRoad.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexRoad.intersectionPoint ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexRoad.dz ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexRoad.radius ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_skeleton_polyline_vertexRoad.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a point on the object’s polyline in road coordinates. <vertexRoad> can use either radius or length/width within one <polyline> element."@en .

odr:T_road_signals_signal_positionInertial a owl:Class ;
    rdfs:label "t_road_signals_signal_positionInertial"@en ;
    rdfs:comment "Describes the reference point of the physical position in inertial coordinates in cases where it deviates from the logical position. Defines the inertial position."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionInertial.x ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionInertial.pitch ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionInertial.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionInertial.y ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionInertial.roll ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionInertial.hdg ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Describes the reference point of the physical position in inertial coordinates in cases where it deviates from the logical position. Defines the inertial position."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lcr_lane_roadMark_type_line"@en ;
    rdfs:comment "A road marking may consist of one or more elements. Multiple elements are usually positioned side-by-side. A line definition is valid for a given length of the lane and will be repeated automatically."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.tOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.space ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.sOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_roadMarkColor ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.color ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_roadMarkRule ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.rule ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.width ],
        odr:_OpenDriveElement ;
    skos:definition "A road marking may consist of one or more elements. Multiple elements are usually positioned side-by-side. A line definition is valid for a given length of the lane and will be repeated automatically."@en .

odr:T_road_link_predecessorSuccessor a owl:Class ;
    rdfs:label "t_road_link_predecessorSuccessor"@en ;
    rdfs:comment "Successors and predecessors can be junctions or roads. For each, different attribute sets shall be used."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_road_link_elementType ;
            owl:onProperty odr:T_road_link_predecessorSuccessor.elementType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_contactPoint ;
            owl:onProperty odr:T_road_link_predecessorSuccessor.contactPoint ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_link_predecessorSuccessor.elementS ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_elementDir ;
            owl:onProperty odr:T_road_link_predecessorSuccessor.elementDir ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_link_predecessorSuccessor.elementId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Successors and predecessors can be junctions or roads. For each, different attribute sets shall be used."@en .

odr:T_road_objects_tunnel a owl:Class ;
    rdfs:label "t_road_objects_tunnel"@en ;
    rdfs:comment """Tunnels are modeled as objects in ASAM OpenDRIVE. The road with the tunnel object defines the part of the road that is the tunnel or the underpass.\r
Tunnels are valid for the complete cross section of a road unless a lane validity element with further restrictions is provided as child element"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_tunnel.daylight ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_tunnel.lighting ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_tunnel.name ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_tunnel.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_objects_tunnel.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_tunnelType ;
            owl:onProperty odr:T_road_objects_tunnel.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_tunnel.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Tunnels are modeled as objects in ASAM OpenDRIVE. The road with the tunnel object defines the part of the road that is the tunnel or the underpass.\r
Tunnels are valid for the complete cross section of a road unless a lane validity element with further restrictions is provided as child element"""@en .

odr:T_road_signals_signal_positionRoad a owl:Class ;
    rdfs:label "t_road_signals_signal_positionRoad"@en ;
    rdfs:comment "Describes the reference point of the physical position road coordinates in cases where it deviates from the logical position. Defines the position on the road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.roll ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.hOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.pitch ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.zOffset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal_positionRoad.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Describes the reference point of the physical position road coordinates in cases where it deviates from the logical position. Defines the position on the road."@en .

odr:E_layerType a rdfs:Datatype ;
    rdfs:label "e_layerType"@en ;
    owl:oneOf ( "temporary" "permanent" ) .

odr:E_orientation a rdfs:Datatype ;
    rdfs:label "e_orientation"@en ;
    owl:oneOf ( "+" "-" "none" ) .

odr:T_junction_common a owl:Class ;
    rdfs:label "t_junction_common"@en ;
    rdfs:comment "Common junctions are the default type of junction in ASAM OpenDRIVE and specify areas where drivable lanes may overlap and traffic may cross."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_elevationGrid ;
            owl:onProperty odr:T_junction_common.elevationGrid ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_junction_type ;
            owl:onProperty odr:T_junction_common.type ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects ;
            owl:onProperty odr:T_junction_common.objects ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_planView ;
            owl:onProperty odr:T_junction_common.planView ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_junction_boundary ;
            owl:onProperty odr:T_junction_common.boundary ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_surface ;
            owl:onProperty odr:T_junction_common.surface ],
        odr:T_junction ;
    skos:definition "Common junctions are the default type of junction in ASAM OpenDRIVE and specify areas where drivable lanes may overlap and traffic may cross."@en .

odr:T_road_lateralProfile_crossSectionSurface_strip a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_strip"@en ;
    rdfs:comment "A strip defines the lateral profile in t- and s-direction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip_width ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.width ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip_cubic ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.cubic ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip_constant ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.constant ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_strip_mode ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.mode ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip_linear ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.linear ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile_crossSectionSurface_strip_quadratic ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_strip.quadratic ],
        odr:_OpenDriveElement ;
    skos:definition "A strip defines the lateral profile in t- and s-direction."@en .

odr:T_road_objects_object_laneValidity a owl:Class ;
    rdfs:label "t_road_objects_object_laneValidity"@en ;
    rdfs:comment "Lane validities restrict signals and objects to specific lanes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_layerType ;
            owl:onProperty odr:T_road_objects_object_laneValidity.layer ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_road_objects_object_laneValidity.fromLane ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_road_objects_object_laneValidity.toLane ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition "Lane validities restrict signals and objects to specific lanes."@en .

odr:T_road_objects_object_outlines_outline a owl:Class ;
    rdfs:label "t_road_objects_object_outlines_outline"@en ;
    rdfs:comment """Defines a series of corner points, including the height of the object relative to the road reference line. For areas, the points should be listed in counter-clockwise order. The inner area of the described outline may be filled with a filling type, such as grass, concrete, asphalt, or pavement.\r
An element shall be followed by two or more <cornerRoad> elements, by two or more <cornerLocal> elements, or by one or more <curveLocal> elements.\r
ASAM OpenDRIVE 1.4 outline definitions (without <outlines> parent element) shall still be supported."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_laneType ;
            owl:onProperty odr:T_road_objects_object_outlines_outline.laneType ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_outlineFillType ;
            owl:onProperty odr:T_road_objects_object_outlines_outline.fillType ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects_object_markings ;
            owl:onProperty odr:T_road_objects_object_outlines_outline.markings ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_outlines_outline.outer ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:nonNegativeInteger ;
            owl:onProperty odr:T_road_objects_object_outlines_outline.id ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_outlines_outline.closed ],
        odr:_OpenDriveElement ;
    skos:definition """Defines a series of corner points, including the height of the object relative to the road reference line. For areas, the points should be listed in counter-clockwise order. The inner area of the described outline may be filled with a filling type, such as grass, concrete, asphalt, or pavement.\r
An element shall be followed by two or more <cornerRoad> elements, by two or more <cornerLocal> elements, or by one or more <curveLocal> elements.\r
ASAM OpenDRIVE 1.4 outline definitions (without <outlines> parent element) shall still be supported."""@en .

odr:T_junction a owl:Class ;
    rdfs:label "t_junction"@en ;
    rdfs:comment "Junctions model intersections between roads."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
