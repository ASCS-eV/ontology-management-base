    owl:oneOf ( "for" "in" ) .

odr:E_signals_semantics_supplementaryEnvironment a rdfs:Datatype ;
    rdfs:label "e_signals_semantics_supplementaryEnvironment"@en ;
    owl:oneOf ( "fog" "rain" "snow" ) .

odr:E_signals_semantics_supplementaryTime a rdfs:Datatype ;
    rdfs:label "e_signals_semantics_supplementaryTime"@en ;
    owl:oneOf ( "day" "time" ) .

odr:E_station_platform_segment_side a rdfs:Datatype ;
    rdfs:label "e_station_platform_segment_side"@en ;
    owl:oneOf ( "left" "right" ) .

odr:E_station_type a rdfs:Datatype ;
