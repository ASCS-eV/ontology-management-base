    owl:oneOf ( "attached" "attached0" "genuine" "global" ) .

odr:E_road_surface_CRG_purpose a rdfs:Datatype ;
    rdfs:label "e_road_surface_CRG_purpose"@en ;
    owl:oneOf ( "elevation" "friction" ) .

odr:E_sideType a rdfs:Datatype ;
