    rdfs:comment "Accumulated width of the road marking. In case of several <line> elements this @width is the sum of all @width of <line> elements and spaces in between, necessary to form the road marking. This attribute supersedes the definition in the <roadMark> element."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lcr_lane_roadMark_type ;
    rdfs:range xsd:double ;
    skos:definition "Accumulated width of the road marking. In case of several <line> elements this @width is the sum of all @width of <line> elements and spaces in between, necessary to form the road marking. This attribute supersedes the definition in the <roadMark> element."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.color a owl:DatatypeProperty ;
    rdfs:label "color"@en ;
    rdfs:comment "Line color. If given, this attribute supersedes the definition in the <roadMark> element."@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line ;
    rdfs:range odr:E_roadMarkColor ;
    skos:definition "Line color. If given, this attribute supersedes the definition in the <roadMark> element."@en .

odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line.length a owl:DatatypeProperty ;
    rdfs:label "length"@en ;
    rdfs:comment "Length of the visible part"@en ;
    rdfs:domain odr:T_road_lanes_laneSection_lcr_lane_roadMark_type_line ;
