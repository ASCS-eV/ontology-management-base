odr:T_road_lanes_laneSection_lcr_lane_roadMark.width a owl:DatatypeProperty ;
    rdfs:label "width"@en ;
    rdfs:comment "Width of the road marking. This attribute is optional if detailed definition is given by <line> element. "@en ;
