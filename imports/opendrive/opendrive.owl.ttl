    rdfs:label "orientation"@en ;
    rdfs:comment """"+" = valid in positive s-direction\r
"-" = valid in negative s-direction\r
"none" = valid in both directions"""@en ;
    rdfs:domain odr:T_road_objects_objectReference ;
    rdfs:range odr:E_orientation ;
    skos:definition """"+" = valid in positive s-direction\r
"-" = valid in negative s-direction\r
"none" = valid in both directions"""@en .

