    rdfs:comment "Alternative to @pitch and @roll. If true, the object is vertically perpendicular to the road surface at all points and @pitch and @roll are ignored. Default is false."@en ;
    rdfs:domain odr:T_road_objects_object ;
    rdfs:range xsd:boolean ;
    skos:definition "Alternative to @pitch and @roll. If true, the object is vertically perpendicular to the road surface at all points and @pitch and @roll are ignored. Default is false."@en .

odr:T_road_objects_object.pitch a owl:DatatypeProperty ;
    rdfs:label "pitch"@en ;
    rdfs:comment "Pitch angle relative to the x/y-plane"@en ;
    rdfs:domain odr:T_road_objects_object ;
    rdfs:range xsd:double ;
    skos:definition "Pitch angle relative to the x/y-plane"@en .

odr:T_road_objects_object.radius a owl:DatatypeProperty ;
    rdfs:label "radius"@en ;
    rdfs:comment "radius of the circular object's bounding box, alternative to @length and @width. @radius is defined in the local coordinate system u/v"@en ;
    rdfs:domain odr:T_road_objects_object ;
    rdfs:range xsd:double ;
    skos:definition "radius of the circular object's bounding box, alternative to @length and @width. @radius is defined in the local coordinate system u/v"@en .

odr:T_road_objects_object.roll a owl:DatatypeProperty ;
    rdfs:label "roll"@en ;
    rdfs:comment "Roll angle relative to the x/y-plane"@en ;
    rdfs:domain odr:T_road_objects_object ;
    rdfs:range xsd:double ;
    skos:definition "Roll angle relative to the x/y-plane"@en .

