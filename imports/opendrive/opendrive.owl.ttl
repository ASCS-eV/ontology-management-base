    rdfs:domain odr:T_road_surface_CRG ;
    rdfs:range xsd:double ;
    skos:definition "Heading offset between CRG center line and reference line of the road (for mode genuine) or global coordinate system (for mode global). Not allowed in other modes. (default = 0.0)."@en .

