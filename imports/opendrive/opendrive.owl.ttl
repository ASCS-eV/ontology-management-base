odr:T_road_planView a owl:Class ;
    rdfs:label "t_road_planView"@en ;
    rdfs:comment "Contains geometry elements that define the layout of the road reference line in the x/y-plane (plan view)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_planView_geometry ;
            owl:onProperty odr:T_road_planView.geometry ],
        odr:_OpenDriveElement ;
    skos:definition "Contains geometry elements that define the layout of the road reference line in the x/y-plane (plan view)."@en .

odr:T_road_surface a owl:Class ;
    rdfs:label "t_road_surface"@en ;
    rdfs:comment "Contains a series of elements describing a surface."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Contains a series of elements describing a surface."@en .

odr:T_header a owl:Class ;
    rdfs:label "t_header"@en ;
    rdfs:comment "Contains general information about the ASAM OpenDRIVE file"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_header.revMajor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:integer ;
            owl:onProperty odr:T_header.revMinor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_license ;
            owl:onProperty odr:T_header.license ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_header.vendor ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header.south ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header.east ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_header.version ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_header_GeoReference ;
            owl:onProperty odr:T_header.geoReference ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_header.name ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header.north ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_header_Offset ;
            owl:onProperty odr:T_header.offset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_header.west ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_header.date ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_header_defaultRegulations ;
            owl:onProperty odr:T_header.defaultRegulations ],
        odr:_OpenDriveElement ;
    skos:definition "Contains general information about the ASAM OpenDRIVE file"@en .

odr:T_road_surface_CRG a owl:Class ;
    rdfs:label "t_road_surface_CRG"@en ;
    rdfs:comment "Links road surface data defined according to ASAM OpenCRG format."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange odr:E_road_surface_CRG_mode ;
            owl:onProperty odr:T_road_surface_CRG.mode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_direction ;
            owl:onProperty odr:T_road_surface_CRG.orientation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.sOffset ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.sEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.zOffset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.yOffset ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.sStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_surface_CRG.file ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.hOffset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.xOffset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.tOffset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_road_surface_CRG_purpose ;
            owl:onProperty odr:T_road_surface_CRG.purpose ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_surface_CRG.zScale ],
        odr:_OpenDriveElement ;
    skos:definition "Links road surface data defined according to ASAM OpenCRG format."@en .

odr:T_road a owl:Class ;
    rdfs:label "t_road"@en ;
    rdfs:comment """Roads are the core elements for any road network in ASAM OpenDRIVE. Each road runs along one road reference line.\r
A road shall have at least the center lane. Vehicles may drive in both directions of the road reference line. The standard driving direction is defined by the value which is assigned to the @rule attribute (RHT=right-hand traffic, LHT=left-han traffic).\r
ASAM OpenDRIVE roads may be roads in the real road network or artificial road network created for application use. Each road is described by one or more <road> elements. One <road> element may cover a long stretch of a road, shorter stretches between junctions, or even several roads. A new <road> element should only start if the properties of the road cannot be described within the previous <road> element or if a junction is required.d"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_link ;
            owl:onProperty odr:T_road.link ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes ;
            owl:onProperty odr:T_road.lanes ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_elevationProfile ;
            owl:onProperty odr:T_road.elevationProfile ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_railroad ;
            owl:onProperty odr:T_road.railroad ],
        [ a owl:Restriction ;
            owl:onClass odr:T_road_planView ;
            owl:onProperty odr:T_road.planView ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_surface ;
            owl:onProperty odr:T_road.surface ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road.name ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes ;
            owl:onProperty odr:T_road.lanes ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_trafficRule ;
            owl:onProperty odr:T_road.rule ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_objects ;
            owl:onProperty odr:T_road.objects ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road.junction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_signals ;
            owl:onProperty odr:T_road.signals ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lateralProfile ;
            owl:onProperty odr:T_road.lateralProfile ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        odr:_OpenDriveElement ;
    skos:definition """Roads are the core elements for any road network in ASAM OpenDRIVE. Each road runs along one road reference line.\r
A road shall have at least the center lane. Vehicles may drive in both directions of the road reference line. The standard driving direction is defined by the value which is assigned to the @rule attribute (RHT=right-hand traffic, LHT=left-han traffic).\r
ASAM OpenDRIVE roads may be roads in the real road network or artificial road network created for application use. Each road is described by one or more <road> elements. One <road> element may cover a long stretch of a road, shorter stretches between junctions, or even several roads. A new <road> element should only start if the properties of the road cannot be described within the previous <road> element or if a junction is required.d"""@en .

odr:T_road_lanes_laneSection_lr_lane a owl:Class ;
    rdfs:label "t_road_lanes_laneSection_lr_lane"@en ;
    rdfs:comment "Lane elements are included in left/center/right elements. Lane elements should represent the lanes from left to right, that is, with descending ID."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.roadWorks ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_laneAdvisory ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.advisory ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass odr:T_road_lanes_laneSection_lcr_lane_link ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.link ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.dynamicLaneDirection ],
        [ a owl:Restriction ;
            owl:onDataRange odr:E_laneType ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange odr:E_lane_direction ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.direction ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.dynamicLaneType ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_lanes_laneSection_lr_lane.level ],
        odr:_OpenDriveElement ;
    skos:definition "Lane elements are included in left/center/right elements. Lane elements should represent the lanes from left to right, that is, with descending ID."@en .

odr:T_road_objects a owl:Class ;
    rdfs:label "t_road_objects"@en ;
    rdfs:comment "Container for all objects along a road."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Container for all objects along a road."@en .

odr:T_road_lateralProfile_crossSectionSurface_coefficients a owl:Class ;
    rdfs:label "t_road_lateralProfile_crossSectionSurface_coefficients"@en ;
    rdfs:comment """Defines the coefficients of a cubic polynomial in s-direction.\r
The first <coefficients> element shall start at the beginning of the road reference line with @s="0"."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_coefficients.d ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_coefficients.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_coefficients.a ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_coefficients.c ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_lateralProfile_crossSectionSurface_coefficients.b ],
        odr:_OpenDriveElement ;
    skos:definition """Defines the coefficients of a cubic polynomial in s-direction.\r
The first <coefficients> element shall start at the beginning of the road reference line with @s="0"."""@en .

odr:T_road_objects_object_repeat a owl:Class ;
    rdfs:label "t_road_objects_object_repeat"@en ;
    rdfs:comment "To avoid lengthy XML code, objects of the same type may be repeated. Attributes of the repeated object shall overrule the attributes from the original object. If attributes are omitted in the repeated objects, the attributes from the original object apply."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.tEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.zOffsetEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty odr:T_road_objects_object_repeat.detachFromReferenceLine ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.distance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.lengthStart ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.heightEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.radiusStart ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.bT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.cT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.lengthEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.widthStart ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.dT ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.widthEnd ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.zOffsetStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.tStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.heightStart ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_objects_object_repeat.radiusEnd ],
        odr:_OpenDriveElement ;
    skos:definition "To avoid lengthy XML code, objects of the same type may be repeated. Attributes of the repeated object shall overrule the attributes from the original object. If attributes are omitted in the repeated objects, the attributes from the original object apply."@en .

odr:T_signals_semantics a owl:Class ;
    rdfs:label "t_signals_semantics"@en ;
    rdfs:comment "Semantics are limited to traffic behavior that is specified just by signals in ASAM OpenDRIVE. Each traffic behavior is specified by a specific element."@en ;
    rdfs:subClassOf odr:_OpenDriveElement ;
    skos:definition "Semantics are limited to traffic behavior that is specified just by signals in ASAM OpenDRIVE. Each traffic behavior is specified by a specific element."@en .

odr:T_road_signals_signal a owl:Class ;
    rdfs:label "t_road_signals_signal"@en ;
    rdfs:comment "A signal along the road or on a static board."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty odr:T_road_signals_signal.width ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal.subtype ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty odr:T_road_signals_signal.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
