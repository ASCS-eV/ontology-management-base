    rdfs:domain odr:T_road_objects_object ;
    rdfs:range xsd:double ;
    skos:definition "t-coordinate of object's origin"@en .

odr:T_road_objects_object.temporary a owl:DatatypeProperty ;
    rdfs:label "temporary"@en ;
    rdfs:comment "Indicates whether the object is temporary or permanent. Example: temporary speed limit sign in road works situation."@en ;
    rdfs:domain odr:T_road_objects_object ;
