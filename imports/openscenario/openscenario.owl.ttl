    rdfs:domain osc:RelativeDistanceCondition ;
    rdfs:range xsd:double ;
    skos:definition "The distance value. Unit: [m]. Range: [0..inf[."@en .

osc:RelativeLanePosition.dLane a owl:DatatypeProperty ;
    rdfs:label "dLane"@en ;
    rdfs:comment "The deviation value between the laneId of the lane, where the reference entity is located, and the target laneId."@en ;
    rdfs:domain osc:RelativeLanePosition ;
    rdfs:range xsd:int ;
    skos:definition "The deviation value between the laneId of the lane, where the reference entity is located, and the target laneId."@en .

osc:RelativeLanePosition.ds a owl:DatatypeProperty ;
    rdfs:label "ds"@en ;
    rdfs:comment "The offset along the road's reference line relative to the s-coordinate of the reference entity. Mutually exclusive with dsLane. Unit: [m]."@en ;
    rdfs:domain osc:RelativeLanePosition ;
    rdfs:range xsd:double ;
    skos:definition "The offset along the road's reference line relative to the s-coordinate of the reference entity. Mutually exclusive with dsLane. Unit: [m]."@en .

osc:RelativeLanePosition.dsLane a owl:DatatypeProperty ;
    rdfs:label "dsLane"@en ;
    rdfs:comment "The offset along the center line of the lane, where the reference entity is located. Mutually exclusive with ds. Unit: [m]."@en ;
    rdfs:domain osc:RelativeLanePosition ;
    rdfs:range xsd:double ;
    skos:definition "The offset along the center line of the lane, where the reference entity is located. Mutually exclusive with ds. Unit: [m]."@en .

osc:RelativeLanePosition.entityRef a owl:ObjectProperty ;
    rdfs:label "entityRef"@en ;
    rdfs:comment "Reference entity."@en ;
    rdfs:domain osc:RelativeLanePosition ;
