osc:RelativeTargetSpeed.speedTargetValueType a owl:DatatypeProperty ;
    rdfs:label "speedTargetValueType"@en ;
    rdfs:comment "The value is either a delta (Unit: [m/s]) or a factor (no Unit)."@en ;
    rdfs:domain osc:RelativeTargetSpeed ;
    rdfs:range osc:SpeedTargetValueType ;
    skos:definition "The value is either a delta (Unit: [m/s]) or a factor (no Unit)."@en .

osc:RelativeTargetSpeed.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Value of the relative speed. This value is either given as a delta or as a factor. E.g. value=10 together with valueType=delta means the entity/entities are supposed to drive 10m/s faster than the target reference entity. E.g. value=1.1 together with valueType=factor means that the entity/entities are supposed to drive 10% faster than the target reference entity. Unit: [m/s] or [1]."@en ;
    rdfs:domain osc:RelativeTargetSpeed ;
    rdfs:range xsd:double ;
    skos:definition "Value of the relative speed. This value is either given as a delta or as a factor. E.g. value=10 together with valueType=delta means the entity/entities are supposed to drive 10m/s faster than the target reference entity. E.g. value=1.1 together with valueType=factor means that the entity/entities are supposed to drive 10% faster than the target reference entity. Unit: [m/s] or [1]."@en .

