    rdfs:domain osc:RelativeSpeedCondition ;
    rdfs:range xsd:double ;
    skos:definition "Relative speed value. Unit: [m/s]. Range: ]-inf..inf[. Relative speed is defined as speed_rel = speed(triggering entity) - speed(reference entity)"@en .

