osc:Wind.direction a owl:DatatypeProperty ;
    rdfs:label "direction"@en ;
    rdfs:comment "The target direction of the wind (not the origin direction) in the ground/xy-plane of the world coordinate system. Corresponds to the heading/yaw angle. x-axis-direction is 0 rad. Unit: [rad]. Range: [0..2*PI[."@en ;
    rdfs:domain osc:Wind ;
    rdfs:range xsd:double ;
    skos:definition "The target direction of the wind (not the origin direction) in the ground/xy-plane of the world coordinate system. Corresponds to the heading/yaw angle. x-axis-direction is 0 rad. Unit: [rad]. Range: [0..2*PI[."@en .

osc:Wind.speed a owl:DatatypeProperty ;
    rdfs:label "speed"@en ;
    rdfs:comment "The wind speed. Unit: [m/s]. Range: [0..inf["@en ;
    rdfs:domain osc:Wind ;
    rdfs:range xsd:double ;
    skos:definition "The wind speed. Unit: [m/s]. Range: [0..inf["@en .

osc:WorldPosition.h a owl:DatatypeProperty ;
    rdfs:label "h"@en ;
    rdfs:comment "The heading angle of the object, defining a mathematically positive rotation about the z-axis (see ISO 8855:2011). Missing value is interpreted as 0. Unit: [rad]."@en ;
    rdfs:domain osc:WorldPosition ;
    rdfs:range xsd:double ;
    skos:definition "The heading angle of the object, defining a mathematically positive rotation about the z-axis (see ISO 8855:2011). Missing value is interpreted as 0. Unit: [rad]."@en .

osc:WorldPosition.p a owl:DatatypeProperty ;
    rdfs:label "p"@en ;
    rdfs:comment "The pitch angle of the object, defining a mathematically positive rotation about the y-axis (see ISO 8855:2011). Missing value is interpreted as 0. Unit: [rad]."@en ;
    rdfs:domain osc:WorldPosition ;
    rdfs:range xsd:double ;
    skos:definition "The pitch angle of the object, defining a mathematically positive rotation about the y-axis (see ISO 8855:2011). Missing value is interpreted as 0. Unit: [rad]."@en .

osc:WorldPosition.r a owl:DatatypeProperty ;
    rdfs:label "r"@en ;
    rdfs:comment "The roll angle of the object, defining a mathematically positive rotation about the x-axis (see ISO 8855:2011). Missing value is interpreted as 0. Unit: [rad]."@en ;
    rdfs:domain osc:WorldPosition ;
    rdfs:range xsd:double ;
    skos:definition "The roll angle of the object, defining a mathematically positive rotation about the x-axis (see ISO 8855:2011). Missing value is interpreted as 0. Unit: [rad]."@en .

osc:WorldPosition.x a owl:DatatypeProperty ;
    rdfs:label "x"@en ;
    rdfs:comment "The x coordinate value. Missing value is interpreted as 0. Unit: [m]."@en ;
    rdfs:domain osc:WorldPosition ;
    rdfs:range xsd:double ;
    skos:definition "The x coordinate value. Missing value is interpreted as 0. Unit: [m]."@en .

osc:WorldPosition.y a owl:DatatypeProperty ;
