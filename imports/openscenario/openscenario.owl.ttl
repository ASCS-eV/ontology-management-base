osc:TrafficSignalControllerAction.phaseRef a owl:ObjectProperty ;
    rdfs:label "phaseRef"@en ;
    rdfs:comment """\r
The reference to the semantic phase (phase is the referential key in the referenced TrafficSignalController)."""@en ;
    rdfs:domain osc:TrafficSignalControllerAction ;
    rdfs:range osc:Phase ;
    skos:definition "The reference to the semantic phase (phase is the referential key in the referenced TrafficSignalController)."@en .

