osc:RelativeTargetSpeed.continuous a owl:DatatypeProperty ;
    rdfs:label "continuous"@en ;
    rdfs:comment "By setting continuous to true a controller comes into place and tries to maintain a continuous relative speed. This may not be used together with Dynamics.time or Dynamics.distance."@en ;
    rdfs:domain osc:RelativeTargetSpeed ;
    rdfs:range xsd:boolean ;
    skos:definition "By setting continuous to true a controller comes into place and tries to maintain a continuous relative speed. This may not be used together with Dynamics.time or Dynamics.distance."@en .

osc:RelativeTargetSpeed.entityRef a owl:ObjectProperty ;
    rdfs:label "entityRef"@en ;
    rdfs:comment "Reference entity."@en ;
