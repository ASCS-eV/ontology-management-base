    rdfs:domain osc:AbsoluteSpeed ;
    rdfs:range osc:SteadyState .

osc:AbsoluteSpeed.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Absolute speed. Unit: [m/s]. Range: [0..inf[."@en ;
    rdfs:domain osc:AbsoluteSpeed ;
    rdfs:range xsd:double ;
    skos:definition "Absolute speed. Unit: [m/s]. Range: [0..inf[."@en .

osc:AbsoluteTargetLane.layer a owl:DatatypeProperty ;
    rdfs:label "layer"@en ;
    rdfs:comment """Which layer to consider: "permanent" or "temporary".\r
If not provided, the entity stays on its current lane layer, if possible."""@en ;
    rdfs:domain osc:AbsoluteTargetLane ;
    rdfs:range osc:LaneLayerType ;
    skos:definition """Which layer to consider: "permanent" or "temporary".\r
If not provided, the entity stays on its current lane layer, if possible."""@en .

osc:AbsoluteTargetLane.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Number (ID) of the target lane the entity will change to."@en ;
    rdfs:domain osc:AbsoluteTargetLane ;
    rdfs:range xsd:string ;
    skos:definition "Number (ID) of the target lane the entity will change to."@en .

osc:AbsoluteTargetLaneOffset.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Signed number in meters the vehicle should respect as an offset from the center of the current lane."@en ;
    rdfs:domain osc:AbsoluteTargetLaneOffset ;
    rdfs:range xsd:double ;
    skos:definition "Signed number in meters the vehicle should respect as an offset from the center of the current lane."@en .

osc:AbsoluteTargetSpeed.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Target speed the vehicle should change to. Unit: [m/s]."@en ;
    rdfs:domain osc:AbsoluteTargetSpeed ;
    rdfs:range xsd:double ;
    skos:definition "Target speed the vehicle should change to. Unit: [m/s]."@en .

osc:AccelerationCondition.direction a owl:DatatypeProperty ;
    rdfs:label "direction"@en ;
    rdfs:comment "Direction of the acceleration (if not given, the total acceleration is considered)."@en ;
    rdfs:domain osc:AccelerationCondition ;
    rdfs:range osc:DirectionalDimension ;
    skos:definition "Direction of the acceleration (if not given, the total acceleration is considered)."@en .

osc:AccelerationCondition.rule a owl:DatatypeProperty ;
    rdfs:label "rule"@en ;
    rdfs:comment "The operator (less, greater, equal)."@en ;
    rdfs:domain osc:AccelerationCondition ;
    rdfs:range osc:Rule ;
    skos:definition "The operator (less, greater, equal)."@en .

osc:AccelerationCondition.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "Acceleration value. Unit: [m/s²]."@en ;
    rdfs:domain osc:AccelerationCondition ;
    rdfs:range xsd:double ;
    skos:definition "Acceleration value. Unit: [m/s²]."@en .

osc:AcquirePositionAction.position a owl:ObjectProperty ;
    rdfs:label "position"@en ;
    rdfs:domain osc:AcquirePositionAction ;
