osc:TrailerCoupler.dx a owl:DatatypeProperty ;
    rdfs:label "dx"@en ;
    rdfs:comment "Relative position of the trailerCoupler in the x axis, using the coordinate system of the vehicle."@en ;
    rdfs:domain osc:TrailerCoupler ;
    rdfs:range xsd:double ;
    skos:definition "Relative position of the trailerCoupler in the x axis, using the coordinate system of the vehicle."@en .

osc:TrailerCoupler.dz a owl:DatatypeProperty ;
    rdfs:label "dz"@en ;
    rdfs:comment "Relative position in the z axis, using the coordinate system of the vehicle. If omitted, z of the towing vehicle's hitch will be applied. If neither hitch nor coupler has a z value, a 2D connection will be applied, constrained to rotation in the XY-plane."@en ;
    rdfs:domain osc:TrailerCoupler ;
    rdfs:range xsd:double ;
    skos:definition "Relative position in the z axis, using the coordinate system of the vehicle. If omitted, z of the towing vehicle's hitch will be applied. If neither hitch nor coupler has a z value, a 2D connection will be applied, constrained to rotation in the XY-plane."@en .

osc:TrailerHitch.dx a owl:DatatypeProperty ;
    rdfs:label "dx"@en ;
    rdfs:comment "Relative position in the x axis, using the coordinate system of the vehicle."@en ;
    rdfs:domain osc:TrailerHitch ;
    rdfs:range xsd:double ;
    skos:definition "Relative position in the x axis, using the coordinate system of the vehicle."@en .

osc:TrailerHitch.dz a owl:DatatypeProperty ;
    rdfs:label "dz"@en ;
    rdfs:comment "Relative position in the z axis, using the coordinate system of the vehicle. If omitted, z of the trailer's coupler will be applied. If neither hitch nor coupler has a z value, a 2D connection will be applied, constrained to rotation in the XY-plane."@en ;
    rdfs:domain osc:TrailerHitch ;
    rdfs:range xsd:double ;
    skos:definition "Relative position in the z axis, using the coordinate system of the vehicle. If omitted, z of the trailer's coupler will be applied. If neither hitch nor coupler has a z value, a 2D connection will be applied, constrained to rotation in the XY-plane."@en .

osc:Trajectory.closed a owl:DatatypeProperty ;
    rdfs:label "closed"@en ;
    rdfs:comment "If 'true', then the trajectory forms a loop, where the end of the trajectory is connected to the start of the trajectory by a straight line. For continuous derivatives of this segment, end and start point can also be at the same position and form a zero-length segment. A FollowTrajectoryAction with a closed trajectory doesn't end regularly but has to be stopped. If 'true' then the timing information in the trajectory cannot be used as absolute values."@en ;
    rdfs:domain osc:Trajectory ;
    rdfs:range xsd:boolean ;
    skos:definition "If 'true', then the trajectory forms a loop, where the end of the trajectory is connected to the start of the trajectory by a straight line. For continuous derivatives of this segment, end and start point can also be at the same position and form a zero-length segment. A FollowTrajectoryAction with a closed trajectory doesn't end regularly but has to be stopped. If 'true' then the timing information in the trajectory cannot be used as absolute values."@en .

osc:Trajectory.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of the trajectory type. Required if used in catalog."@en ;
    rdfs:domain osc:Trajectory ;
    rdfs:range xsd:string ;
    skos:definition "Name of the trajectory type. Required if used in catalog."@en .

osc:Trajectory.shape a owl:ObjectProperty ;
    rdfs:label "shape"@en ;
    rdfs:domain osc:Trajectory ;
    rdfs:range osc:Shape .

osc:TrajectoryCatalogLocation.directory a owl:ObjectProperty ;
    rdfs:label "directory"@en ;
    rdfs:domain osc:TrajectoryCatalogLocation ;
    rdfs:range osc:Directory .

osc:TrajectoryFollowingMode.followingMode a owl:DatatypeProperty ;
    rdfs:label "followingMode"@en ;
    rdfs:comment "Defines the (lateral) trajectory following behavior of the actor: Mode 'position' forces the actor to strictly adhere to the trajectory. In contrast, mode 'follow' hands over control to the actor. In this mode, the actor tries to follow the trajectory as best as he can. This may be restricted by dynamics constraints and/or control loop implementation. In mode 'follow' the resulting path of the entity is not guaranteed to be identical for every simulation environment."@en ;
    rdfs:domain osc:TrajectoryFollowingMode ;
    rdfs:range osc:FollowingMode ;
    skos:definition "Defines the (lateral) trajectory following behavior of the actor: Mode 'position' forces the actor to strictly adhere to the trajectory. In contrast, mode 'follow' hands over control to the actor. In this mode, the actor tries to follow the trajectory as best as he can. This may be restricted by dynamics constraints and/or control loop implementation. In mode 'follow' the resulting path of the entity is not guaranteed to be identical for every simulation environment."@en .

osc:TrajectoryPosition.orientation a owl:ObjectProperty ;
    rdfs:label "orientation"@en ;
    rdfs:domain osc:TrajectoryPosition ;
    rdfs:range osc:Orientation .

osc:TrajectoryPosition.s a owl:DatatypeProperty ;
    rdfs:label "s"@en ;
    rdfs:comment "Represents the s coordinate from the start of the trajectory. Unit: [m]. Range: [0..arclength of the trajectory]."@en ;
    rdfs:domain osc:TrajectoryPosition ;
    rdfs:range xsd:double ;
    skos:definition "Represents the s coordinate from the start of the trajectory. Unit: [m]. Range: [0..arclength of the trajectory]."@en .

osc:TrajectoryPosition.t a owl:DatatypeProperty ;
    rdfs:label "t"@en ;
    rdfs:comment "Represents the t coordinate orthogonal to the arclength of the trajectory. Missing value is interpreted as 0. Unit: [m]."@en ;
    rdfs:domain osc:TrajectoryPosition ;
    rdfs:range xsd:double ;
    skos:definition "Represents the t coordinate orthogonal to the arclength of the trajectory. Missing value is interpreted as 0. Unit: [m]."@en .

osc:TrajectoryPosition.trajectoryRef a owl:ObjectProperty ;
    rdfs:label "trajectoryRef"@en ;
    rdfs:domain osc:TrajectoryPosition ;
    rdfs:range osc:TrajectoryRef .

osc:TransitionDynamics.dynamicsDimension a owl:DatatypeProperty ;
    rdfs:label "dynamicsDimension"@en ;
    rdfs:comment "The semantics of the value: 'rate', 'time' or 'distance'."@en ;
    rdfs:domain osc:TransitionDynamics ;
    rdfs:range osc:DynamicsDimension ;
    skos:definition "The semantics of the value: 'rate', 'time' or 'distance'."@en .

osc:TransitionDynamics.dynamicsShape a owl:DatatypeProperty ;
    rdfs:label "dynamicsShape"@en ;
    rdfs:comment "The shape of the transition function f(x) between current and target value."@en ;
    rdfs:domain osc:TransitionDynamics ;
    rdfs:range osc:DynamicsShape ;
    skos:definition "The shape of the transition function f(x) between current and target value."@en .

osc:TransitionDynamics.followingMode a owl:DatatypeProperty ;
    rdfs:label "followingMode"@en ;
    rdfs:comment "Defines the shape following behavior of the actor: Mode 'position' forces the actor to strictly adhere to a given shape. In contrast, in mode 'follow' the actor tries to follow the shape as best as it can. This may be restricted by the 'Performance' properties (for vehicles), dynamic constraints of an external agent (if the actor is not controlled by the default controller) and/or control loop implementation. In mode 'follow' the resulting path of the entity is not guaranteed to be identical for every simulation environment. Default value if omitted: position"@en ;
    rdfs:domain osc:TransitionDynamics ;
    rdfs:range osc:FollowingMode ;
    skos:definition "Defines the shape following behavior of the actor: Mode 'position' forces the actor to strictly adhere to a given shape. In contrast, in mode 'follow' the actor tries to follow the shape as best as it can. This may be restricted by the 'Performance' properties (for vehicles), dynamic constraints of an external agent (if the actor is not controlled by the default controller) and/or control loop implementation. In mode 'follow' the resulting path of the entity is not guaranteed to be identical for every simulation environment. Default value if omitted: position"@en .

osc:TransitionDynamics.value a owl:DatatypeProperty ;
    rdfs:label "value"@en ;
    rdfs:comment "The value for a predefined rate (Unit: [delta/s]), time (Unit: [s]) or distance (Unit: [m]) to acquire the target value. Range: [0..inf[."@en ;
    rdfs:domain osc:TransitionDynamics ;
    rdfs:range xsd:double ;
    skos:definition "The value for a predefined rate (Unit: [delta/s]), time (Unit: [s]) or distance (Unit: [m]) to acquire the target value. Range: [0..inf[."@en .

