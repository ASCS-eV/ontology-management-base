    rdfs:domain osc:FinalSpeed ;
    rdfs:range osc:AbsoluteSpeed .

osc:FinalSpeed.relativeSpeedToMaster a owl:ObjectProperty ;
    rdfs:label "relativeSpeedToMaster"@en ;
    rdfs:domain osc:FinalSpeed ;
    rdfs:range osc:RelativeSpeedToMaster .

osc:FractionalCloudCover a rdfs:Datatype ;
    rdfs:label "FractionalCloudCover"@en ;
    rdfs:comment "Definition of cloud states using the fractional cloud cover in oktas."@en ;
    owl:oneOf ( "zeroOktas" "oneOktas" "twoOktas" "threeOktas" "fourOktas" "fiveOktas" "sixOktas" "sevenOktas" "eightOktas" "nineOktas" ) ;
    skos:definition "Definition of cloud states using the fractional cloud cover in oktas."@en .

osc:Gear.automaticGear a owl:ObjectProperty ;
    rdfs:label "automaticGear"@en ;
    rdfs:domain osc:Gear ;
    rdfs:range osc:AutomaticGear .

osc:Gear.manualGear a owl:ObjectProperty ;
    rdfs:label "manualGear"@en ;
    rdfs:domain osc:Gear ;
    rdfs:range osc:ManualGear .

osc:Interpolation a owl:Class ;
    rdfs:label "Interpolation"@en ;
    rdfs:comment """Custom interpolation instructions for the parent shape element.\r
If present, indicates that the interpolation is up to the tool and not specified by ASAM OpenSCENARIO.\r
If absent, the default interpolation rules of ASAM OpenSCENARIO apply."""@en ;
    skos:definition """Custom interpolation instructions for the parent shape element.\r
If present, indicates that the interpolation is up to the tool and not specified by ASAM OpenSCENARIO.\r
If absent, the default interpolation rules of ASAM OpenSCENARIO apply."""@en .

osc:Lane a owl:Class ;
    rdfs:label "Lane"@en ;
    rdfs:comment "Specifies a lane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:Lane.id ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Specifies a lane."@en .

osc:LaneChangeTarget.absoluteTargetLane a owl:ObjectProperty ;
    rdfs:label "absoluteTargetLane"@en ;
    rdfs:domain osc:LaneChangeTarget ;
    rdfs:range osc:AbsoluteTargetLane .

osc:LaneChangeTarget.relativeTargetLane a owl:ObjectProperty ;
    rdfs:label "relativeTargetLane"@en ;
    rdfs:domain osc:LaneChangeTarget ;
    rdfs:range osc:RelativeTargetLane .

osc:LaneOffsetTarget.absoluteTargetLaneOffset a owl:ObjectProperty ;
    rdfs:label "absoluteTargetLaneOffset"@en ;
    rdfs:domain osc:LaneOffsetTarget ;
    rdfs:range osc:AbsoluteTargetLaneOffset .

osc:LaneOffsetTarget.relativeTargetLaneOffset a owl:ObjectProperty ;
    rdfs:label "relativeTargetLaneOffset"@en ;
    rdfs:domain osc:LaneOffsetTarget ;
    rdfs:range osc:RelativeTargetLaneOffset .

osc:LateralDisplacement a rdfs:Datatype ;
    rdfs:label "LateralDisplacement"@en ;
    rdfs:comment "A displacement relative to an entity along a lateral axis (e.g. the y axis of the entity coordinate system)"@en ;
    owl:oneOf ( "any" "leftToReferencedEntity" "rightToReferencedEntity" ) ;
    skos:definition "A displacement relative to an entity along a lateral axis (e.g. the y axis of the entity coordinate system)"@en .

osc:LightMode a rdfs:Datatype ;
    rdfs:label "LightMode"@en ;
    rdfs:comment "Definition of the light mode."@en ;
    owl:oneOf ( "on" "off" "flashing" ) ;
    skos:definition "Definition of the light mode."@en .

osc:LightType.userDefinedLight a owl:ObjectProperty ;
    rdfs:label "userDefinedLight"@en ;
    rdfs:domain osc:LightType ;
    rdfs:range osc:UserDefinedLight .

osc:LightType.vehicleLight a owl:ObjectProperty ;
    rdfs:label "vehicleLight"@en ;
    rdfs:domain osc:LightType ;
    rdfs:range osc:VehicleLight .

osc:LongitudinalDisplacement a rdfs:Datatype ;
    rdfs:label "LongitudinalDisplacement"@en ;
    rdfs:comment "A displacement relative to an entity along a longitudinal axis (e.g. the x axis of the entity coordinate system)"@en ;
    owl:oneOf ( "any" "trailingReferencedEntity" "leadingReferencedEntity" ) ;
    skos:definition "A displacement relative to an entity along a longitudinal axis (e.g. the x axis of the entity coordinate system)"@en .

osc:MiscObjectCategory a rdfs:Datatype ;
    rdfs:label "MiscObjectCategory"@en ;
    rdfs:comment "Categories for entity objects which are not pedestrians or vehicles."@en ;
    owl:oneOf ( "barrier" "building" "crosswalk" "gantry" "none" "obstacle" "parkingSpace" "patch" "pole" "railing" "roadMark" "soundBarrier" "streetLamp" "trafficIsland" "tree" "vegetation" "wind" ) ;
    skos:definition "Categories for entity objects which are not pedestrians or vehicles."@en .

osc:ModifyRule.addValue a owl:ObjectProperty ;
    rdfs:label "addValue"@en ;
    rdfs:domain osc:ModifyRule ;
    rdfs:range osc:ParameterAddValueRule .

osc:ModifyRule.multiplyByValue a owl:ObjectProperty ;
    rdfs:label "multiplyByValue"@en ;
    rdfs:domain osc:ModifyRule ;
    rdfs:range osc:ParameterMultiplyByValueRule .

osc:None a owl:Class ;
    rdfs:label "None"@en ;
    rdfs:comment "Empty container, indicating unused controlling behavior or dynamics limitations for specific axis."@en ;
    skos:definition "Empty container, indicating unused controlling behavior or dynamics limitations for specific axis."@en .

osc:OpenScenario a owl:Class ;
    rdfs:label "OpenScenario"@en ;
    rdfs:comment "Top level container for scenarios or catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:OpenScenarioCategory ;
            owl:onProperty osc:OpenScenario.openScenarioCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:FileHeader ;
            owl:onProperty osc:OpenScenario.fileHeader ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Top level container for scenarios or catalogs."@en .

osc:PedestrianCategory a rdfs:Datatype ;
    rdfs:label "PedestrianCategory"@en ;
    rdfs:comment """Categories for entity objects of type pedestrian.\r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en ;
    owl:oneOf ( "animal" "pedestrian" "wheelchair" ) ;
    skos:definition """Categories for entity objects of type pedestrian.\r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en .

osc:PedestrianGesture a owl:Class ;
    rdfs:label "PedestrianGesture"@en ;
    rdfs:comment "Defines a pedestrian's gesture. A conflicting gesture will override currently active gestures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:PedestrianGestureType ;
            owl:onProperty osc:PedestrianGesture.gesture ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a pedestrian's gesture. A conflicting gesture will override currently active gestures."@en .

osc:PedestrianGestureType a rdfs:Datatype ;
    rdfs:label "PedestrianGestureType"@en ;
    rdfs:comment "Definition of a pedestrian's gesture."@en ;
    owl:oneOf ( "phoneCallRightHand" "phoneCallLeftHand" "phoneTextRightHand" "phoneTextLeftHand" "wavingRightArm" "wavingLeftArm" "umbrellaRightHand" "umbrellaLeftHand" "crossArms" "coffeeRightHand" "coffeeLeftHand" "sandwichRightHand" "sandwichLeftHand" ) ;
    skos:definition "Definition of a pedestrian's gesture."@en .

osc:PedestrianMotionType a rdfs:Datatype ;
    rdfs:label "PedestrianMotionType"@en ;
    rdfs:comment "Definition of a pedestrian's motion."@en ;
    owl:oneOf ( "standing" "sitting" "lying" "squatting" "walking" "running" "reeling" "crawling" "cycling" "jumping" "ducking" "bendingDown" ) ;
    skos:definition "Definition of a pedestrian's motion."@en .

osc:PrecipitationType a rdfs:Datatype ;
    rdfs:label "PrecipitationType"@en ;
    rdfs:comment "Types of precipitation."@en ;
    owl:oneOf ( "dry" "rain" "snow" ) ;
    skos:definition "Types of precipitation."@en .

osc:Priority a rdfs:Datatype ;
    rdfs:label "Priority"@en ;
    rdfs:comment "Rules that govern interaction between events that belong to the same maneuver."@en ;
    owl:oneOf ( "overwrite" "override" "parallel" "skip" ) ;
    skos:definition "Rules that govern interaction between events that belong to the same maneuver."@en .

osc:RandomRouteAction a owl:Class ;
    rdfs:label "RandomRouteAction"@en ;
    rdfs:comment "If an entity approaches a junction, the road to follow is selected randomly from the available options."@en ;
    skos:definition "If an entity approaches a junction, the road to follow is selected randomly from the available options."@en .

osc:RouteRef.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:RouteRef ;
    rdfs:range osc:CatalogReference .

osc:RouteRef.route a owl:ObjectProperty ;
    rdfs:label "route"@en ;
    rdfs:domain osc:RouteRef ;
    rdfs:range osc:Route .

osc:RouteStrategy a rdfs:Datatype ;
    rdfs:label "RouteStrategy"@en ;
    rdfs:comment "Strategy for path selection between waypoints in a route."@en ;
    owl:oneOf ( "fastest" "leastIntersections" "random" "shortest" ) ;
    skos:definition "Strategy for path selection between waypoints in a route."@en .

osc:SelectedEntities.byType a owl:ObjectProperty ;
    rdfs:label "byType"@en ;
    rdfs:domain osc:SelectedEntities ;
    rdfs:range osc:ByType .

osc:SelectedEntities.entityRef a owl:ObjectProperty ;
    rdfs:label "entityRef"@en ;
    rdfs:domain osc:SelectedEntities ;
    rdfs:range osc:EntityRef .

osc:SpeedActionTarget.absoluteTargetSpeed a owl:ObjectProperty ;
    rdfs:label "absoluteTargetSpeed"@en ;
    rdfs:domain osc:SpeedActionTarget ;
    rdfs:range osc:AbsoluteTargetSpeed .

osc:SpeedActionTarget.relativeTargetSpeed a owl:ObjectProperty ;
    rdfs:label "relativeTargetSpeed"@en ;
    rdfs:domain osc:SpeedActionTarget ;
    rdfs:range osc:RelativeTargetSpeed .

osc:SteadyState.targetDistanceSteadyState a owl:ObjectProperty ;
    rdfs:label "targetDistanceSteadyState"@en ;
    rdfs:domain osc:SteadyState ;
    rdfs:range osc:TargetDistanceSteadyState .

osc:SteadyState.targetTimeSteadyState a owl:ObjectProperty ;
    rdfs:label "targetTimeSteadyState"@en ;
    rdfs:domain osc:SteadyState ;
    rdfs:range osc:TargetTimeSteadyState .

osc:StoryboardElement a owl:Class ;
    rdfs:label "StoryboardElement"@en ;
    rdfs:comment "Instances of the types Story, Act, Action, Event and Maneuver are considered to be instances of type StoryboardElement. Or less formal: story, acts, actions, events, maneuvers are storyboard elements. A storyboard element is either a story, an act, an event, an action or a maneuver."@en ;
    skos:definition "Instances of the types Story, Act, Action, Event and Maneuver are considered to be instances of type StoryboardElement. Or less formal: story, acts, actions, events, maneuvers are storyboard elements. A storyboard element is either a story, an act, an event, an action or a maneuver."@en .

osc:StoryboardElementState a rdfs:Datatype ;
    rdfs:label "StoryboardElementState"@en ;
    rdfs:comment "The states and the transitions that can be used to define a StoryboardElementStateCondition."@en ;
    owl:oneOf ( "completeState" "endTransition" "runningState" "skipTransition" "standbyState" "startTransition" "stopTransition" ) ;
    skos:definition "The states and the transitions that can be used to define a StoryboardElementStateCondition."@en .

osc:StoryboardElementType a rdfs:Datatype ;
    rdfs:label "StoryboardElementType"@en ;
    rdfs:comment "Types of storyboard elements in a scenario."@en ;
    owl:oneOf ( "act" "action" "event" "maneuver" "maneuverGroup" "story" ) ;
    skos:definition "Types of storyboard elements in a scenario."@en .

osc:TimeReference.none a owl:ObjectProperty ;
    rdfs:label "none"@en ;
    rdfs:domain osc:TimeReference ;
    rdfs:range osc:None .

osc:TimeReference.timing a owl:ObjectProperty ;
    rdfs:label "timing"@en ;
    rdfs:domain osc:TimeReference ;
    rdfs:range osc:Timing .

osc:TimeToCollisionConditionTarget.entityRef a owl:ObjectProperty ;
    rdfs:label "entityRef"@en ;
    rdfs:domain osc:TimeToCollisionConditionTarget ;
    rdfs:range osc:EntityRef .

osc:TimeToCollisionConditionTarget.position a owl:ObjectProperty ;
    rdfs:label "position"@en ;
    rdfs:domain osc:TimeToCollisionConditionTarget ;
    rdfs:range osc:Position .

osc:TrafficSignalAction.trafficSignalControllerAction a owl:ObjectProperty ;
    rdfs:label "trafficSignalControllerAction"@en ;
    rdfs:domain osc:TrafficSignalAction ;
    rdfs:range osc:TrafficSignalControllerAction .

osc:TrafficSignalAction.trafficSignalStateAction a owl:ObjectProperty ;
    rdfs:label "trafficSignalStateAction"@en ;
    rdfs:domain osc:TrafficSignalAction ;
    rdfs:range osc:TrafficSignalStateAction .

osc:TrafficSignalSemantics a rdfs:Datatype ;
    rdfs:label "TrafficSignalSemantics"@en ;
    rdfs:comment """Semantic states of a traffic light, i.e. the meaning of the traffic light state and the rules imposed on traffic obeying the signal in that state.\r
'Traffic' in the enum literals always refers to the obeying traffic. The description of each literal also contains the expected behavior for the obeying traffic. An example of a real life situation is provided as well."""@en ;
    owl:oneOf ( "attention_go" "attention_stop" "caution" "fallback" "go" "stop" ) ;
    skos:definition """Semantic states of a traffic light, i.e. the meaning of the traffic light state and the rules imposed on traffic obeying the signal in that state.\r
'Traffic' in the enum literals always refers to the obeying traffic. The description of each literal also contains the expected behavior for the obeying traffic. An example of a real life situation is provided as well."""@en .

osc:TrafficStopAction a owl:Class ;
    rdfs:label "TrafficStopAction"@en ;
    rdfs:comment "This action stops one or more  traffic instances. The instances to be stopped are identified by their name. All active traffic instances with this name are stopped."@en ;
    skos:definition "This action stops one or more  traffic instances. The instances to be stopped are identified by their name. All active traffic instances with this name are stopped."@en .

osc:TrajectoryRef.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:TrajectoryRef ;
    rdfs:range osc:CatalogReference .

osc:TrajectoryRef.trajectory a owl:ObjectProperty ;
    rdfs:label "trajectory"@en ;
    rdfs:domain osc:TrajectoryRef ;
    rdfs:range osc:Trajectory .

osc:TriggeringEntitiesRule a rdfs:Datatype ;
    rdfs:label "TriggeringEntitiesRule"@en ;
    rdfs:comment "Rules which determine how triggering entities are used to verify a given condition."@en ;
    owl:oneOf ( "all" "any" ) ;
    skos:definition "Rules which determine how triggering entities are used to verify a given condition."@en .

osc:ValueConstraintGroup a owl:Class ;
    rdfs:label "ValueConstraintGroup"@en ;
    rdfs:comment """A ValueConstraintGroup represents a set of logical constraints which need to evaluate to true for a defined parameter value to start the simulation. A constraint group needs to have at least one constraint.\r
Multiple constraint groups are combined by an OR."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ValueConstraint ;
            owl:onProperty osc:ValueConstraintGroup.constraints ] ;
    skos:definition """A ValueConstraintGroup represents a set of logical constraints which need to evaluate to true for a defined parameter value to start the simulation. A constraint group needs to have at least one constraint.\r
Multiple constraint groups are combined by an OR."""@en .

osc:VariableModifyRule.addValue a owl:ObjectProperty ;
    rdfs:label "addValue"@en ;
    rdfs:domain osc:VariableModifyRule ;
    rdfs:range osc:VariableAddValueRule .

osc:VariableModifyRule.multiplyByValue a owl:ObjectProperty ;
    rdfs:label "multiplyByValue"@en ;
    rdfs:domain osc:VariableModifyRule ;
    rdfs:range osc:VariableMultiplyByValueRule .

osc:VehicleComponentType a rdfs:Datatype ;
    rdfs:label "VehicleComponentType"@en ;
    rdfs:comment "Definition of vehicle component types."@en ;
    owl:oneOf ( "hood" "trunk" "doorFrontRight" "doorFrontLeft" "doorRearRight" "doorRearLeft" "windowFrontRight" "windowFrontLeft" "windowRearRight" "windowRearLeft" "sideMirrors" "sideMirrorRight" "sideMirrorLeft" ) ;
    skos:definition "Definition of vehicle component types."@en .

osc:VehicleLightType a rdfs:Datatype ;
    rdfs:label "VehicleLightType"@en ;
    rdfs:comment "Definition of vehicle light types."@en ;
    owl:oneOf ( "daytimeRunningLights" "lowBeam" "highBeam" "fogLights" "fogLightsFront" "fogLightsRear" "brakeLights" "warningLights" "indicatorLeft" "indicatorRight" "reversingLights" "licensePlateIllumination" "specialPurposeLights" "tailLights" ) ;
    skos:definition "Definition of vehicle light types."@en .

osc:Wetness a rdfs:Datatype ;
    rdfs:label "Wetness"@en ;
    rdfs:comment "Definition of the wetness of the road."@en ;
    owl:oneOf ( "dry" "moist" "wetWithPuddles" "lowFlooded" "highFlooded" ) ;
    skos:definition "Definition of the wetness of the road."@en .

osc:AbsoluteTargetLaneOffset a owl:Class ;
    rdfs:label "AbsoluteTargetLaneOffset"@en ;
    rdfs:comment "Lane offset with respect to the entity's current lane's center line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AbsoluteTargetLaneOffset.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Lane offset with respect to the entity's current lane's center line."@en .

osc:AbsoluteTargetSpeed a owl:Class ;
    rdfs:label "AbsoluteTargetSpeed"@en ;
    rdfs:comment "Absolute speed defined as a target for a SpeedAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AbsoluteTargetSpeed.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Absolute speed defined as a target for a SpeedAction."@en .

osc:AcquirePositionAction a owl:Class ;
    rdfs:label "AcquirePositionAction"@en ;
    rdfs:comment "Controls the entity to acquire a target position."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:AcquirePositionAction.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Controls the entity to acquire a target position."@en .

osc:AddEntityAction a owl:Class ;
    rdfs:label "AddEntityAction"@en ;
    rdfs:comment """Adds an entity to the scenario, at a predefined position.\r
This action follows the layer prioritization hierarchy defined in 7.4 Actions."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:AddEntityAction.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Adds an entity to the scenario, at a predefined position.\r
This action follows the layer prioritization hierarchy defined in 7.4 Actions."""@en .

osc:AnimationState a owl:Class ;
    rdfs:label "AnimationState"@en ;
    rdfs:comment "Definition of the animation state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AnimationState.state ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of the animation state."@en .

osc:AutomaticGear a owl:Class ;
    rdfs:label "AutomaticGear"@en ;
    rdfs:comment "Automatic  gear description."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:AutomaticGearType ;
            owl:onProperty osc:AutomaticGear.gear ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Automatic  gear description."@en .

osc:ByObjectType a owl:Class ;
    rdfs:label "ByObjectType"@en ;
    rdfs:comment "Defines an object type to select entities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:ObjectType ;
            owl:onProperty osc:ByObjectType.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines an object type to select entities."@en .

osc:ByType a owl:Class ;
    rdfs:label "ByType"@en ;
    rdfs:comment "A definition of a type, e. g. to be used to define members in an entity selection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:ObjectType ;
            owl:onProperty osc:ByType.objectType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A definition of a type, e. g. to be used to define members in an entity selection."@en .

osc:CatalogDefinition a owl:Class ;
    rdfs:label "CatalogDefinition"@en ;
    rdfs:comment "A marker stating that the OpenSCENARIO file is a catalog."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Catalog ;
            owl:onProperty osc:CatalogDefinition.catalog ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A marker stating that the OpenSCENARIO file is a catalog."@en .

osc:CentralSwarmObject a owl:Class ;
    rdfs:label "CentralSwarmObject"@en ;
    rdfs:comment "The entity that represents the center of a swarm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:CentralSwarmObject.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The entity that represents the center of a swarm."@en .

osc:Color.colorCmyk a owl:ObjectProperty ;
    rdfs:label "colorCmyk"@en ;
    rdfs:domain osc:Color ;
    rdfs:range osc:ColorCmyk .

osc:Color.colorRgb a owl:ObjectProperty ;
    rdfs:label "colorRgb"@en ;
    rdfs:domain osc:Color ;
    rdfs:range osc:ColorRgb .

osc:Color.colorType a owl:DatatypeProperty ;
    rdfs:label "colorType"@en ;
    rdfs:comment "Semantic value of the color."@en ;
    rdfs:domain osc:Color ;
    rdfs:range osc:ColorType ;
    skos:definition "Semantic value of the color."@en .

osc:ConnectTrailerAction a owl:Class ;
    rdfs:label "ConnectTrailerAction"@en ;
    rdfs:comment "Connect trailer to entity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:ConnectTrailerAction.trailerRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Connect trailer to entity."@en .

osc:ControllerCatalogLocation a owl:Class ;
    rdfs:label "ControllerCatalogLocation"@en ;
    rdfs:comment "The directory where to look up controller catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:ControllerCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up controller catalogs."@en .

osc:ControllerDistribution a owl:Class ;
    rdfs:label "ControllerDistribution"@en ;
    rdfs:comment "Defines a distribution which controller should be used in a traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ControllerDistributionEntry ;
            owl:onProperty osc:ControllerDistribution.controllerDistributionEntries ] ;
    skos:definition "Defines a distribution which controller should be used in a traffic."@en .

osc:ControllerDistributionEntry.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:ControllerDistributionEntry ;
    rdfs:range osc:CatalogReference .

osc:ControllerDistributionEntry.controller a owl:ObjectProperty ;
    rdfs:label "controller"@en ;
    rdfs:domain osc:ControllerDistributionEntry ;
    rdfs:range osc:Controller .

osc:ControllerDistributionEntry.weight a owl:DatatypeProperty ;
    rdfs:label "weight"@en ;
    rdfs:comment "The weight of the entry. Range: ]0..inf[."@en ;
    rdfs:domain osc:ControllerDistributionEntry ;
    rdfs:range xsd:double ;
    skos:definition "The weight of the entry. Range: ]0..inf[."@en .

osc:Deterministic a owl:Class ;
    rdfs:label "Deterministic"@en ;
    rdfs:comment "Top level container containing all deterministic distribution elements."@en ;
    skos:definition "Top level container containing all deterministic distribution elements."@en .

osc:DeterministicMultiParameterDistribution a owl:Class ;
    rdfs:label "DeterministicMultiParameterDistribution"@en ;
    rdfs:comment "Container for a deterministic distribution which is applied to multiple parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:DeterministicMultiParameterDistributionType ;
            owl:onProperty osc:DeterministicMultiParameterDistribution.deterministicMultiParameterDistributionType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Container for a deterministic distribution which is applied to multiple parameters."@en .

osc:DeterministicMultiParameterDistributionType a owl:Class ;
    rdfs:label "DeterministicMultiParameterDistributionType"@en ;
    rdfs:comment "A deterministic distribution type which can be applied to multiple parameters."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ValueSetDistribution ;
            owl:onProperty osc:DeterministicMultiParameterDistributionType.valueSetDistribution ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A deterministic distribution type which can be applied to multiple parameters."@en .

osc:DeterministicParameterDistribution a owl:Class ;
    rdfs:label "DeterministicParameterDistribution"@en ;
    rdfs:comment "Either a DeterministicMultiParameterDistribution or a DeterministicSingleParameterDistribution"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:DeterministicMultiParameterDistribution ;
                                    owl:onProperty osc:DeterministicParameterDistribution.deterministicMultiParameterDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicParameterDistribution.deterministicSingleParameterDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicParameterDistribution.deterministicMultiParameterDistribution ] [ a owl:Restriction ;
                                    owl:onClass osc:DeterministicSingleParameterDistribution ;
                                    owl:onProperty osc:DeterministicParameterDistribution.deterministicSingleParameterDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Either a DeterministicMultiParameterDistribution or a DeterministicSingleParameterDistribution"@en .

osc:DeterministicSingleParameterDistributionType.distributionRange a owl:ObjectProperty ;
    rdfs:label "distributionRange"@en ;
    rdfs:domain osc:DeterministicSingleParameterDistributionType ;
    rdfs:range osc:DistributionRange .

osc:DeterministicSingleParameterDistributionType.distributionSet a owl:ObjectProperty ;
    rdfs:label "distributionSet"@en ;
    rdfs:domain osc:DeterministicSingleParameterDistributionType ;
    rdfs:range osc:DistributionSet .

osc:DeterministicSingleParameterDistributionType.userDefinedDistribution a owl:ObjectProperty ;
    rdfs:label "userDefinedDistribution"@en ;
    rdfs:domain osc:DeterministicSingleParameterDistributionType ;
    rdfs:range osc:UserDefinedDistribution .

osc:DistributionSet a owl:Class ;
    rdfs:label "DistributionSet"@en ;
    rdfs:comment "A set of possible values which can occur in a deterministic distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:DistributionSetElement ;
            owl:onProperty osc:DistributionSet.elements ] ;
    skos:definition "A set of possible values which can occur in a deterministic distribution."@en .

osc:DistributionSetElement a owl:Class ;
    rdfs:label "DistributionSetElement"@en ;
    rdfs:comment "Indicates an element for a deterministic distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:DistributionSetElement.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Indicates an element for a deterministic distribution."@en .

osc:EndOfRoadCondition a owl:Class ;
    rdfs:label "EndOfRoadCondition"@en ;
    rdfs:comment "Condition becomes true after the triggering entity/entities has reached the end of a road network for a given amount of time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:EndOfRoadCondition.duration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Condition becomes true after the triggering entity/entities has reached the end of a road network for a given amount of time."@en .

osc:EntityAction.addEntityAction a owl:ObjectProperty ;
    rdfs:label "addEntityAction"@en ;
    rdfs:domain osc:EntityAction ;
    rdfs:range osc:AddEntityAction .

osc:EntityAction.deleteEntityAction a owl:ObjectProperty ;
    rdfs:label "deleteEntityAction"@en ;
    rdfs:domain osc:EntityAction ;
    rdfs:range osc:DeleteEntityAction .

osc:EntityAction.entityRef a owl:ObjectProperty ;
    rdfs:label "entityRef"@en ;
    rdfs:comment "Name of the reference entity."@en ;
    rdfs:domain osc:EntityAction ;
    rdfs:range osc:Entity ;
    skos:definition "Name of the reference entity."@en .

osc:EntityDistribution a owl:Class ;
    rdfs:label "EntityDistribution"@en ;
    rdfs:comment "An entity group within a traffic distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:EntityDistributionEntry ;
            owl:onProperty osc:EntityDistribution.entityDistributionEntry ] ;
    skos:definition "An entity group within a traffic distribution."@en .

osc:EntitySelection a owl:Class ;
    rdfs:label "EntitySelection"@en ;
    rdfs:comment "Grouping of scenario objects by name and/or type. An instance of EntitySelection is considered also an instance of Entity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:SelectedEntities ;
            owl:onProperty osc:EntitySelection.members ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:EntitySelection.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Grouping of scenario objects by name and/or type. An instance of EntitySelection is considered also an instance of Entity."@en .

osc:EnvironmentCatalogLocation a owl:Class ;
    rdfs:label "EnvironmentCatalogLocation"@en ;
    rdfs:comment "The directory where to look up environment catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:EnvironmentCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up environment catalogs."@en .

osc:ExternalObjectReference a owl:Class ;
    rdfs:label "ExternalObjectReference"@en ;
    rdfs:comment "Reference to an external object that is defined beyond  OpenSCENARIO files and catalogs, i.e. in the road network (= road object or traffic signal)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ExternalObjectReference.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Reference to an external object that is defined beyond  OpenSCENARIO files and catalogs, i.e. in the road network (= road object or traffic signal)."@en .

osc:Histogram a owl:Class ;
    rdfs:label "Histogram"@en ;
    rdfs:comment "Histogram which can be applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:HistogramBin ;
            owl:onProperty osc:Histogram.bins ] ;
    skos:definition "Histogram which can be applied to a single parameter."@en .

osc:InRoutePosition.fromCurrentEntity a owl:ObjectProperty ;
    rdfs:label "fromCurrentEntity"@en ;
    rdfs:domain osc:InRoutePosition ;
    rdfs:range osc:PositionOfCurrentEntity .

osc:InRoutePosition.fromLaneCoordinates a owl:ObjectProperty ;
    rdfs:label "fromLaneCoordinates"@en ;
    rdfs:domain osc:InRoutePosition ;
    rdfs:range osc:PositionInLaneCoordinates .

osc:InRoutePosition.fromRoadCoordinates a owl:ObjectProperty ;
    rdfs:label "fromRoadCoordinates"@en ;
    rdfs:domain osc:InRoutePosition ;
    rdfs:range osc:PositionInRoadCoordinates .

osc:InfrastructureAction a owl:Class ;
    rdfs:label "InfrastructureAction"@en ;
    rdfs:comment "Defines an action which changes a state of a traffic signal or a traffic signal controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:TrafficSignalAction ;
            owl:onProperty osc:InfrastructureAction.trafficSignalAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines an action which changes a state of a traffic signal or a traffic signal controller."@en .

osc:Init a owl:Class ;
    rdfs:label "Init"@en ;
    rdfs:comment "Defines the actions which are executed during the initialization phase of a scenario."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:InitActions ;
            owl:onProperty osc:Init.actions ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines the actions which are executed during the initialization phase of a scenario."@en .

osc:Knot a owl:Class ;
    rdfs:label "Knot"@en ;
    rdfs:comment "Specification of one value of the knot vector of a NURBS trajectory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Knot.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Specification of one value of the knot vector of a NURBS trajectory."@en .

osc:LateralAction.laneChangeAction a owl:ObjectProperty ;
    rdfs:label "laneChangeAction"@en ;
    rdfs:domain osc:LateralAction ;
    rdfs:range osc:LaneChangeAction .

osc:LateralAction.laneOffsetAction a owl:ObjectProperty ;
    rdfs:label "laneOffsetAction"@en ;
    rdfs:domain osc:LateralAction ;
    rdfs:range osc:LaneOffsetAction .

osc:LateralAction.lateralDistanceAction a owl:ObjectProperty ;
    rdfs:label "lateralDistanceAction"@en ;
    rdfs:domain osc:LateralAction ;
    rdfs:range osc:LateralDistanceAction .

osc:LongitudinalAction.longitudinalDistanceAction a owl:ObjectProperty ;
    rdfs:label "longitudinalDistanceAction"@en ;
    rdfs:domain osc:LongitudinalAction ;
    rdfs:range osc:LongitudinalDistanceAction .

osc:LongitudinalAction.speedAction a owl:ObjectProperty ;
    rdfs:label "speedAction"@en ;
    rdfs:domain osc:LongitudinalAction ;
    rdfs:range osc:SpeedAction .

osc:LongitudinalAction.speedProfileAction a owl:ObjectProperty ;
    rdfs:label "speedProfileAction"@en ;
    rdfs:domain osc:LongitudinalAction ;
    rdfs:range osc:SpeedProfileAction .

osc:ManeuverCatalogLocation a owl:Class ;
    rdfs:label "ManeuverCatalogLocation"@en ;
    rdfs:comment "The directory where to look up maneuver catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:ManeuverCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up maneuver catalogs."@en .

osc:ManualGear a owl:Class ;
    rdfs:label "ManualGear"@en ;
    rdfs:comment "Manual gear description."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:ManualGear.number ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Manual gear description."@en .

osc:MiscObjectCatalogLocation a owl:Class ;
    rdfs:label "MiscObjectCatalogLocation"@en ;
    rdfs:comment "The directory where to look up miscellaneous object catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:MiscObjectCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up miscellaneous object catalogs."@en .

osc:ObjectController.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:ObjectController ;
    rdfs:range osc:CatalogReference .

osc:ObjectController.controller a owl:ObjectProperty ;
    rdfs:label "controller"@en ;
    rdfs:domain osc:ObjectController ;
    rdfs:range osc:Controller .

osc:ObjectController.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Identifier of the ObjectController."@en ;
    rdfs:domain osc:ObjectController ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of the ObjectController."@en .

osc:OffroadCondition a owl:Class ;
    rdfs:label "OffroadCondition"@en ;
    rdfs:comment "Checks if an entity is off the road. The logical expression returns true after the entity has been offroad for a specific duration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OffroadCondition.duration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Checks if an entity is off the road. The logical expression returns true after the entity has been offroad for a specific duration."@en .

osc:OpenScenarioCategory.catalogDefinition a owl:ObjectProperty ;
    rdfs:label "catalogDefinition"@en ;
    rdfs:domain osc:OpenScenarioCategory ;
    rdfs:range osc:CatalogDefinition .

osc:OpenScenarioCategory.parameterValueDistributionDefinition a owl:ObjectProperty ;
    rdfs:label "parameterValueDistributionDefinition"@en ;
    rdfs:domain osc:OpenScenarioCategory ;
    rdfs:range osc:ParameterValueDistributionDefinition .

osc:OpenScenarioCategory.scenarioDefinition a owl:ObjectProperty ;
    rdfs:label "scenarioDefinition"@en ;
    rdfs:domain osc:OpenScenarioCategory ;
    rdfs:range osc:ScenarioDefinition .

osc:ParameterAction.modifyAction a owl:ObjectProperty ;
    rdfs:label "modifyAction"@en ;
    rdfs:domain osc:ParameterAction ;
    rdfs:range osc:ParameterModifyAction .

osc:ParameterAction.parameterRef a owl:ObjectProperty ;
    rdfs:label "parameterRef"@en ;
    rdfs:comment "Name of the parameter."@en ;
    rdfs:domain osc:ParameterAction ;
    rdfs:range osc:ParameterDeclaration ;
    skos:definition "Name of the parameter."@en .

osc:ParameterAction.setAction a owl:ObjectProperty ;
    rdfs:label "setAction"@en ;
    rdfs:domain osc:ParameterAction ;
    rdfs:range osc:ParameterSetAction .

osc:ParameterAddValueRule a owl:Class ;
    rdfs:label "ParameterAddValueRule"@en ;
    rdfs:comment "Defines an addition of a value to a parameter as part of a ModifyRule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ParameterAddValueRule.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines an addition of a value to a parameter as part of a ModifyRule."@en .

osc:ParameterModifyAction a owl:Class ;
    rdfs:label "ParameterModifyAction"@en ;
    rdfs:comment "Modify a global parameter according to given rules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ModifyRule ;
            owl:onProperty osc:ParameterModifyAction.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Modify a global parameter according to given rules."@en .

osc:ParameterMultiplyByValueRule a owl:Class ;
    rdfs:label "ParameterMultiplyByValueRule"@en ;
    rdfs:comment "Multiply a parameter by a value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ParameterMultiplyByValueRule.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Multiply a parameter by a value."@en .

osc:ParameterSetAction a owl:Class ;
    rdfs:label "ParameterSetAction"@en ;
    rdfs:comment "Setting a parameter to a given value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ParameterSetAction.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Setting a parameter to a given value."@en .

osc:ParameterValueDistributionDefinition a owl:Class ;
    rdfs:label "ParameterValueDistributionDefinition"@en ;
    rdfs:comment "A marker stating that the OpenSCENARIO file is a parameter value distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ParameterValueDistribution ;
            owl:onProperty osc:ParameterValueDistributionDefinition.parameterValueDistribution ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A marker stating that the OpenSCENARIO file is a parameter value distribution."@en .

osc:ParameterValueSet a owl:Class ;
    rdfs:label "ParameterValueSet"@en ;
    rdfs:comment "Set of parameter values that have to be assigned for a single concrete scenario."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ParameterAssignment ;
            owl:onProperty osc:ParameterValueSet.parameterAssignments ] ;
    skos:definition "Set of parameter values that have to be assigned for a single concrete scenario."@en .

osc:PedestrianCatalogLocation a owl:Class ;
    rdfs:label "PedestrianCatalogLocation"@en ;
    rdfs:comment "The directory where to look up pedestrian catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:PedestrianCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up pedestrian catalogs."@en .

osc:Polygon a owl:Class ;
    rdfs:label "Polygon"@en ;
    rdfs:comment "Defines an area by a polygon."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Position ;
            owl:onProperty osc:Polygon.positions ] ;
    skos:definition "Defines an area by a polygon."@en .

osc:PositionOfCurrentEntity a owl:Class ;
    rdfs:label "PositionOfCurrentEntity"@en ;
    rdfs:comment "Reference to the current Entity. The position in a route is defined through the position of this entity (used in RoutePosition)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:PositionOfCurrentEntity.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Reference to the current Entity. The position in a route is defined through the position of this entity (used in RoutePosition)."@en .

osc:PreferredLaneLayerAction a owl:Class ;
    rdfs:label "PreferredLaneLayerAction"@en ;
    rdfs:comment """Specifies a preferred lane layer that is used in case of ambiguity when choosing a lane.\r
Is overruled if the lane layer is explicitly specified, e.g. in AbsoluteTargetLane."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:LaneLayerType ;
            owl:onProperty osc:PreferredLaneLayerAction.layer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Specifies a preferred lane layer that is used in case of ambiguity when choosing a lane.\r
Is overruled if the lane layer is explicitly specified, e.g. in AbsoluteTargetLane."""@en .

osc:Private a owl:Class ;
    rdfs:label "Private"@en ;
    rdfs:comment "Container for private actions assigned to one specific entity and used in the initialization phase of a scenario."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:Private.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:PrivateAction ;
            owl:onProperty osc:Private.privateActions ] ;
    skos:definition "Container for private actions assigned to one specific entity and used in the initialization phase of a scenario."@en .

osc:ProbabilityDistributionSet a owl:Class ;
    rdfs:label "ProbabilityDistributionSet"@en ;
    rdfs:comment "Container for a set of single values with a defined probability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ProbabilityDistributionSetElement ;
            owl:onProperty osc:ProbabilityDistributionSet.elements ] ;
    skos:definition "Container for a set of single values with a defined probability."@en .

osc:Property a owl:Class ;
    rdfs:label "Property"@en ;
    rdfs:comment "Definition of a property by name and value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Property.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Property.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of a property by name and value."@en .

osc:RelativeLaneRange a owl:Class ;
    rdfs:label "RelativeLaneRange"@en ;
    rdfs:comment "A range of lanes to the left and/or right of a referenced entity. The properties \"from\" and \"to\" define the signed numbers of lanes that are offset the referenced entity's current lane. (0 is the entity's current lane, positive is left of the entity, negative is right of the entity). Set \"from\" and \"to\" to the same number in order to check clearance for only one lane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:RelativeLaneRange.from ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:RelativeLaneRange.to ] ;
    skos:definition "A range of lanes to the left and/or right of a referenced entity. The properties \"from\" and \"to\" define the signed numbers of lanes that are offset the referenced entity's current lane. (0 is the entity's current lane, positive is left of the entity, negative is right of the entity). Set \"from\" and \"to\" to the same number in order to check clearance for only one lane."@en .

osc:RouteCatalogLocation a owl:Class ;
    rdfs:label "RouteCatalogLocation"@en ;
    rdfs:comment "The directory where to look up route catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:RouteCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up route catalogs."@en .

osc:SensorReference a owl:Class ;
    rdfs:label "SensorReference"@en ;
    rdfs:comment "Reference to a sensor, whose definition is beyond OpenSCENARIO files and catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:SensorReference.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Reference to a sensor, whose definition is beyond OpenSCENARIO files and catalogs."@en .

osc:SensorReferenceSet a owl:Class ;
    rdfs:label "SensorReferenceSet"@en ;
    rdfs:comment "Set of references to sensors, whose definition is beyond OpenSCENARIO files and catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:SensorReference ;
            owl:onProperty osc:SensorReferenceSet.sensorReferences ] ;
    skos:definition "Set of references to sensors, whose definition is beyond OpenSCENARIO files and catalogs."@en .

osc:StandStillCondition a owl:Class ;
    rdfs:label "StandStillCondition"@en ;
    rdfs:comment "Logical expression in condition becomes true if the triggering entity/entities stands still for a given amount of time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:StandStillCondition.duration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Logical expression in condition becomes true if the triggering entity/entities stands still for a given amount of time."@en .

osc:TargetDistanceSteadyState a owl:Class ;
    rdfs:label "TargetDistanceSteadyState"@en ;
    rdfs:comment "The distance between object and target position."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TargetDistanceSteadyState.distance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The distance between object and target position."@en .

osc:TargetTimeSteadyState a owl:Class ;
    rdfs:label "TargetTimeSteadyState"@en ;
    rdfs:comment "The remaining time for object to reach target position."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TargetTimeSteadyState.time ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The remaining time for object to reach target position."@en .

osc:TeleportAction a owl:Class ;
    rdfs:label "TeleportAction"@en ;
    rdfs:comment """Specifying a target position an entity is teleported to.\r
This action follows the layer prioritization hierarchy defined in 7.4 Actions."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:TeleportAction.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Specifying a target position an entity is teleported to.\r
This action follows the layer prioritization hierarchy defined in 7.4 Actions."""@en .

osc:TrafficDistributionEntryCatalogLocation a owl:Class ;
    rdfs:label "TrafficDistributionEntryCatalogLocation"@en ;
    rdfs:comment "The directory where to look up traffic distribution entry catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:TrafficDistributionEntryCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up traffic distribution entry catalogs."@en .

osc:TrafficSignalGroupState a owl:Class ;
    rdfs:label "TrafficSignalGroupState"@en ;
    rdfs:comment "Each phase can have one TrafficSignalGroupState to provide the observable state for all traffic signals that are controlled by the controller if they share the same state. E.g. semantics=\"go\" (\"off;off;on\")."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalGroupState.state ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Each phase can have one TrafficSignalGroupState to provide the observable state for all traffic signals that are controlled by the controller if they share the same state. E.g. semantics=\"go\" (\"off;off;on\")."@en .

osc:TrafficSignalState a owl:Class ;
    rdfs:label "TrafficSignalState"@en ;
    rdfs:comment "Each phase can have multiple TrafficSignalStates to provide the observable state for all traffic signals individually that are controlled by the controller. One for each TrafficSignal. E.g. semantics=\"go\" (trafficSignal1:\"off;off;on\", trafficSignal2:\"off;off;on\")."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalState.trafficSignalId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalState.state ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Each phase can have multiple TrafficSignalStates to provide the observable state for all traffic signals individually that are controlled by the controller. One for each TrafficSignal. E.g. semantics=\"go\" (trafficSignal1:\"off;off;on\", trafficSignal2:\"off;off;on\")."@en .

osc:TrajectoryCatalogLocation a owl:Class ;
    rdfs:label "TrajectoryCatalogLocation"@en ;
    rdfs:comment "The directory where to look up trajectory catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:TrajectoryCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up trajectory catalogs."@en .

osc:TrajectoryFollowingMode a owl:Class ;
    rdfs:label "TrajectoryFollowingMode"@en ;
    rdfs:comment "Used to define a steering trajectory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:FollowingMode ;
            owl:onProperty osc:TrajectoryFollowingMode.followingMode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Used to define a steering trajectory."@en .

osc:TraveledDistanceCondition a owl:Class ;
    rdfs:label "TraveledDistanceCondition"@en ;
    rdfs:comment "Logical expression in condition becomes true after the triggering entity/entities have traveled the given distance."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TraveledDistanceCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Logical expression in condition becomes true after the triggering entity/entities have traveled the given distance."@en .

osc:UniformDistribution a owl:Class ;
    rdfs:label "UniformDistribution"@en ;
    rdfs:comment "Uniform distribution which can be applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Range ;
            owl:onProperty osc:UniformDistribution.range ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Uniform distribution which can be applied to a single parameter."@en .

osc:UsedArea a owl:Class ;
    rdfs:label "UsedArea"@en ;
    rdfs:comment "The area that is used by the entities. When using big road network and/or scene files (several GB, e.g. for whole Europe), a simulator shall not load the whole road network for performance reasons."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Position ;
            owl:onProperty osc:UsedArea.positions ] ;
    skos:definition "The area that is used by the entities. When using big road network and/or scene files (several GB, e.g. for whole Europe), a simulator shall not load the whole road network for performance reasons."@en .

osc:UserDefinedAnimation a owl:Class ;
    rdfs:label "UserDefinedAnimation"@en ;
    rdfs:comment "Definition of user defined animation types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedAnimation.userDefinedAnimationType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of user defined animation types."@en .

osc:UserDefinedComponent a owl:Class ;
    rdfs:label "UserDefinedComponent"@en ;
    rdfs:comment "Type of the user defined component."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedComponent.userDefinedComponentType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Type of the user defined component."@en .

osc:UserDefinedLight a owl:Class ;
    rdfs:label "UserDefinedLight"@en ;
    rdfs:comment "Definition of user defined light types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedLight.userDefinedLightType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of user defined light types."@en .

osc:ValueSetDistribution a owl:Class ;
    rdfs:label "ValueSetDistribution"@en ;
    rdfs:comment "Deterministic multi-parameter distribution, where one or multiple sets of parameter values can be defined."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ParameterValueSet ;
            owl:onProperty osc:ValueSetDistribution.parameterValueSets ] ;
    skos:definition "Deterministic multi-parameter distribution, where one or multiple sets of parameter values can be defined."@en .

osc:VariableAction.modifyAction a owl:ObjectProperty ;
    rdfs:label "modifyAction"@en ;
    rdfs:domain osc:VariableAction ;
    rdfs:range osc:VariableModifyAction .

osc:VariableAction.setAction a owl:ObjectProperty ;
    rdfs:label "setAction"@en ;
    rdfs:domain osc:VariableAction ;
    rdfs:range osc:VariableSetAction .

osc:VariableAction.variableRef a owl:ObjectProperty ;
    rdfs:label "variableRef"@en ;
    rdfs:comment "Name of the variable."@en ;
    rdfs:domain osc:VariableAction ;
    rdfs:range osc:VariableDeclaration ;
    skos:definition "Name of the variable."@en .

osc:VariableAddValueRule a owl:Class ;
    rdfs:label "VariableAddValueRule"@en ;
    rdfs:comment "Defines an addition of a value to a variable as part of a ModifyRule."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:VariableAddValueRule.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines an addition of a value to a variable as part of a ModifyRule."@en .

osc:VariableModifyAction a owl:Class ;
    rdfs:label "VariableModifyAction"@en ;
    rdfs:comment "Modify a variable according to given rules."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:VariableModifyRule ;
            owl:onProperty osc:VariableModifyAction.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Modify a variable according to given rules."@en .

osc:VariableMultiplyByValueRule a owl:Class ;
    rdfs:label "VariableMultiplyByValueRule"@en ;
    rdfs:comment "Multiply a variable by a value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:VariableMultiplyByValueRule.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Multiply a variable by a value."@en .

osc:VariableSetAction a owl:Class ;
    rdfs:label "VariableSetAction"@en ;
    rdfs:comment "Setting a variable to a given value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:VariableSetAction.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Setting a variable to a given value."@en .

osc:VehicleCatalogLocation a owl:Class ;
    rdfs:label "VehicleCatalogLocation"@en ;
    rdfs:comment "The directory where to look up vehicle catalogs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Directory ;
            owl:onProperty osc:VehicleCatalogLocation.directory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The directory where to look up vehicle catalogs."@en .

osc:VehicleCategoryDistribution a owl:Class ;
    rdfs:label "VehicleCategoryDistribution"@en ;
    rdfs:comment "A distribution for vehicle in traffic. Category of vehicles and their weight (measure of relative likelihood, check VehicleCategoryDistributionEntry)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:VehicleCategoryDistributionEntry ;
            owl:onProperty osc:VehicleCategoryDistribution.vehicleCategoryDistributionEntries ] ;
    skos:definition "A distribution for vehicle in traffic. Category of vehicles and their weight (measure of relative likelihood, check VehicleCategoryDistributionEntry)."@en .

osc:VehicleComponent a owl:Class ;
    rdfs:label "VehicleComponent"@en ;
    rdfs:comment "Type of the vehicle component."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:VehicleComponentType ;
            owl:onProperty osc:VehicleComponent.vehicleComponentType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Type of the vehicle component."@en .

osc:VehicleLight a owl:Class ;
    rdfs:label "VehicleLight"@en ;
    rdfs:comment "Type of the vehicle light."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:VehicleLightType ;
            owl:onProperty osc:VehicleLight.vehicleLightType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Type of the vehicle light."@en .

osc:VehicleRoleDistribution a owl:Class ;
    rdfs:label "VehicleRoleDistribution"@en ;
    rdfs:comment "A distribution for vehicle in traffic. Roles of vehicles and their weight (measure of relative likelihood, check VehicleRoleDistributionEntry)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:VehicleRoleDistributionEntry ;
            owl:onProperty osc:VehicleRoleDistribution.vehicleRoleDistributionEntries ] ;
    skos:definition "A distribution for vehicle in traffic. Roles of vehicles and their weight (measure of relative likelihood, check VehicleRoleDistributionEntry)."@en .

osc:AbsoluteSpeed a owl:Class ;
    rdfs:label "AbsoluteSpeed"@en ;
    rdfs:comment "Absolute speed definition."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AbsoluteSpeed.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:SteadyState ;
            owl:onProperty osc:AbsoluteSpeed.steadyState ] ;
    skos:definition "Absolute speed definition."@en .

osc:AbsoluteTargetLane a owl:Class ;
    rdfs:label "AbsoluteTargetLane"@en ;
    rdfs:comment "Defines the number (ID) and (optionally) the layer of the target lane."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:AbsoluteTargetLane.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:LaneLayerType ;
            owl:onProperty osc:AbsoluteTargetLane.layer ] ;
    skos:definition "Defines the number (ID) and (optionally) the layer of the target lane."@en .

osc:Action.globalAction a owl:ObjectProperty ;
    rdfs:label "globalAction"@en ;
    rdfs:domain osc:Action ;
    rdfs:range osc:GlobalAction .

osc:Action.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of this action."@en ;
    rdfs:domain osc:Action ;
    rdfs:range xsd:string ;
    skos:definition "Name of this action."@en .

osc:Action.privateAction a owl:ObjectProperty ;
    rdfs:label "privateAction"@en ;
    rdfs:domain osc:Action ;
    rdfs:range osc:PrivateAction .

osc:Action.userDefinedAction a owl:ObjectProperty ;
    rdfs:label "userDefinedAction"@en ;
    rdfs:domain osc:Action ;
    rdfs:range osc:UserDefinedAction .

osc:Actors a owl:Class ;
    rdfs:label "Actors"@en ;
    rdfs:comment "A set of entities representing the actors in a maneuver group."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:Actors.selectTriggeringEntities ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A set of entities representing the actors in a maneuver group."@en .

osc:AngleType a rdfs:Datatype ;
    rdfs:label "AngleType"@en ;
    rdfs:comment "Angular coordinate."@en ;
    owl:oneOf ( "heading" "pitch" "roll" ) ;
    skos:definition "Angular coordinate."@en .

osc:AnimationFile a owl:Class ;
    rdfs:label "AnimationFile"@en ;
    rdfs:comment "Reference to a file which contains an animation / motion definition (e.g. an fbx file containing a motion from motion capturing)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:File ;
            owl:onProperty osc:AnimationFile.file ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AnimationFile.timeOffset ] ;
    skos:definition "Reference to a file which contains an animation / motion definition (e.g. an fbx file containing a motion from motion capturing)."@en .

osc:AnimationType.animationFile a owl:ObjectProperty ;
    rdfs:label "animationFile"@en ;
    rdfs:domain osc:AnimationType ;
    rdfs:range osc:AnimationFile .

osc:AnimationType.componentAnimation a owl:ObjectProperty ;
    rdfs:label "componentAnimation"@en ;
    rdfs:domain osc:AnimationType ;
    rdfs:range osc:ComponentAnimation .

osc:AnimationType.pedestrianAnimation a owl:ObjectProperty ;
    rdfs:label "pedestrianAnimation"@en ;
    rdfs:domain osc:AnimationType ;
    rdfs:range osc:PedestrianAnimation .

osc:AnimationType.userDefinedAnimation a owl:ObjectProperty ;
    rdfs:label "userDefinedAnimation"@en ;
    rdfs:domain osc:AnimationType ;
    rdfs:range osc:UserDefinedAnimation .

osc:AppearanceAction a owl:Class ;
    rdfs:label "AppearanceAction"@en ;
    rdfs:comment "Actions defining the behaviour of an entity without moving it in the world, e.g. turning on a light or opening a door."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:LightStateAction ;
                                    owl:onProperty osc:AppearanceAction.lightStateAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AppearanceAction.animationAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AppearanceAction.lightStateAction ] [ a owl:Restriction ;
                                    owl:onClass osc:AnimationAction ;
                                    owl:onProperty osc:AppearanceAction.animationAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Actions defining the behaviour of an entity without moving it in the world, e.g. turning on a light or opening a door."@en .

osc:AssignRouteAction a owl:Class ;
    rdfs:label "AssignRouteAction"@en ;
    rdfs:comment "Controls an entity to follow a route using waypoints on the road network. The corresponding route can be instantiated from a catalog type, or defined within this declaration. This action does not override any action that controls either lateral or longitudinal domain."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Route ;
                                    owl:onProperty osc:AssignRouteAction.route ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignRouteAction.catalogReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignRouteAction.route ] [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:AssignRouteAction.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Controls an entity to follow a route using waypoints on the road network. The corresponding route can be instantiated from a catalog type, or defined within this declaration. This action does not override any action that controls either lateral or longitudinal domain."@en .

osc:ByEntityCondition a owl:Class ;
    rdfs:label "ByEntityCondition"@en ;
    rdfs:comment "Conditions referring an entity need to know which entity shall trigger the condition. TriggeringEntities is a collection of entities whose states are used to verify the given condition. An additional attribute needs to specify if one of the entities is enough for the condition to become true, or if all of them are required."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:TriggeringEntities ;
            owl:onProperty osc:ByEntityCondition.triggeringEntities ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:EntityCondition ;
            owl:onProperty osc:ByEntityCondition.entityCondition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Conditions referring an entity need to know which entity shall trigger the condition. TriggeringEntities is a collection of entities whose states are used to verify the given condition. An additional attribute needs to specify if one of the entities is enough for the condition to become true, or if all of them are required."@en .

osc:CollisionCondition a owl:Class ;
    rdfs:label "CollisionCondition"@en ;
    rdfs:comment "Condition becomes true when the triggering entity/entities collide with another given entity or any entity of a specific type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:EntityRef ;
                                    owl:onProperty osc:CollisionCondition.entityRef ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:CollisionCondition.byType ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:CollisionCondition.entityRef ] [ a owl:Restriction ;
                                    owl:onClass osc:ByObjectType ;
                                    owl:onProperty osc:CollisionCondition.byType ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Condition becomes true when the triggering entity/entities collide with another given entity or any entity of a specific type."@en .

osc:ComponentAnimation a owl:Class ;
    rdfs:label "ComponentAnimation"@en ;
    rdfs:comment "Defines an animation of a component along or around one axis. Field animationState in AnimationAction is required."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:VehicleComponent ;
                                    owl:onProperty osc:ComponentAnimation.vehicleComponent ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ComponentAnimation.userDefinedComponent ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ComponentAnimation.vehicleComponent ] [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedComponent ;
                                    owl:onProperty osc:ComponentAnimation.userDefinedComponent ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines an animation of a component along or around one axis. Field animationState in AnimationAction is required."@en .

osc:CustomCommandAction a owl:Class ;
    rdfs:label "CustomCommandAction"@en ;
    rdfs:comment "Used to activate a custom action native to the specific user environment. By using this action, the executability of the scenario will be dependent on a specific user environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:CustomCommandAction.content ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:CustomCommandAction.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Used to activate a custom action native to the specific user environment. By using this action, the executability of the scenario will be dependent on a specific user environment."@en .

osc:DeterministicSingleParameterDistribution a owl:Class ;
    rdfs:label "DeterministicSingleParameterDistribution"@en ;
    rdfs:comment "Container for a deterministic distribution which is applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:DeterministicSingleParameterDistribution.parameterName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:DeterministicSingleParameterDistributionType ;
            owl:onProperty osc:DeterministicSingleParameterDistribution.deterministicSingleParameterDistributionType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Container for a deterministic distribution which is applied to a single parameter."@en .

osc:DirectionOfTravelDistribution a owl:Class ;
    rdfs:label "DirectionOfTravelDistribution"@en ;
    rdfs:comment """Defines a distribution, which direction of travel of the swarm traffic relative to the central object should be used.\r
Represents the weight of a given direction of travel. The relative probability for the occurence of this direction of travel is defined by the weight devided by the sum of all weights of this distribution."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DirectionOfTravelDistribution.opposite ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DirectionOfTravelDistribution.same ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Defines a distribution, which direction of travel of the swarm traffic relative to the central object should be used.\r
Represents the weight of a given direction of travel. The relative probability for the occurence of this direction of travel is defined by the weight devided by the sum of all weights of this distribution."""@en .

osc:DistributionDefinition a owl:Class ;
    rdfs:label "DistributionDefinition"@en ;
    rdfs:comment "Indicates whether the content defines a deterministic or stochastic parameter distribution."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Deterministic ;
                                    owl:onProperty osc:DistributionDefinition.deterministic ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DistributionDefinition.stochastic ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DistributionDefinition.deterministic ] [ a owl:Restriction ;
                                    owl:onClass osc:Stochastic ;
                                    owl:onProperty osc:DistributionDefinition.stochastic ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Indicates whether the content defines a deterministic or stochastic parameter distribution."@en .

osc:DistributionRange a owl:Class ;
    rdfs:label "DistributionRange"@en ;
    rdfs:comment "A range of values used for a deterministic distribution. The range starts with lower limit, Each additional value is defined by adding the step value to the previous value until the value is greater than upper limit. Upper limit can be part of the range."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DistributionRange.stepWidth ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Range ;
            owl:onProperty osc:DistributionRange.range ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A range of values used for a deterministic distribution. The range starts with lower limit, Each additional value is defined by adding the step value to the previous value until the value is greater than upper limit. Upper limit can be part of the range."@en .

osc:DomeImage a owl:Class ;
    rdfs:label "DomeImage"@en ;
    rdfs:comment "Image reference to represent the sky and optionally the lighting if the image also contains lighting information."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:File ;
            owl:onProperty osc:DomeImage.domeFile ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DomeImage.azimuthOffset ] ;
    skos:definition "Image reference to represent the sky and optionally the lighting if the image also contains lighting information."@en .

osc:DynamicsShape a rdfs:Datatype ;
    rdfs:label "DynamicsShape"@en ;
    rdfs:comment "Function type used to represent the change of a given variable over time or distance."@en ;
    owl:oneOf ( "cubic" "linear" "sinusoidal" "step" ) ;
    skos:definition "Function type used to represent the change of a given variable over time or distance."@en .

osc:Entities a owl:Class ;
    rdfs:label "Entities"@en ;
    rdfs:comment "Definition of entities (scenario objects or entity selections) in a scenario."@en ;
    skos:definition "Definition of entities (scenario objects or entity selections) in a scenario."@en .

osc:EntityDistributionEntry a owl:Class ;
    rdfs:label "EntityDistributionEntry"@en ;
    rdfs:comment "Defines one weighted specific vehicle/pedestrian entity profile as part of an entity group."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:EntityDistributionEntry.weight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:ScenarioObjectTemplate ;
            owl:onProperty osc:EntityDistributionEntry.scenarioObjectTemplate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines one weighted specific vehicle/pedestrian entity profile as part of an entity group."@en .

osc:EnvironmentAction a owl:Class ;
    rdfs:label "EnvironmentAction"@en ;
    rdfs:comment "Setting weather state, road conditions, and time of the day. An environment can be defined or an environment type from a catalog can be used to instantiate an environment."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Environment ;
                                    owl:onProperty osc:EnvironmentAction.environment ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EnvironmentAction.catalogReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EnvironmentAction.environment ] [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:EnvironmentAction.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Setting weather state, road conditions, and time of the day. An environment can be defined or an environment type from a catalog can be used to instantiate an environment."@en .

osc:FinalSpeed a owl:Class ;
    rdfs:label "FinalSpeed"@en ;
    rdfs:comment "Final speed definition for a SynchronizeAction."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:RelativeSpeedToMaster ;
                                    owl:onProperty osc:FinalSpeed.relativeSpeedToMaster ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:FinalSpeed.absoluteSpeed ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:FinalSpeed.relativeSpeedToMaster ] [ a owl:Restriction ;
                                    owl:onClass osc:AbsoluteSpeed ;
                                    owl:onProperty osc:FinalSpeed.absoluteSpeed ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Final speed definition for a SynchronizeAction."@en .

osc:Fog a owl:Class ;
    rdfs:label "Fog"@en ;
    rdfs:comment "Defines fog at simulation runtime."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Fog.visualRange ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:BoundingBox ;
            owl:onProperty osc:Fog.boundingBox ] ;
    skos:definition "Defines fog at simulation runtime."@en .

osc:Gear a owl:Class ;
    rdfs:label "Gear"@en ;
    rdfs:comment "Gear description."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:AutomaticGear ;
                                    owl:onProperty osc:Gear.automaticGear ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Gear.manualGear ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Gear.automaticGear ] [ a owl:Restriction ;
                                    owl:onClass osc:ManualGear ;
                                    owl:onProperty osc:Gear.manualGear ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Gear description."@en .

osc:HistogramBin a owl:Class ;
    rdfs:label "HistogramBin"@en ;
    rdfs:comment "A bin in a histogram."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Range ;
            owl:onProperty osc:HistogramBin.range ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:HistogramBin.weight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A bin in a histogram."@en .

osc:LaneChangeTarget a owl:Class ;
    rdfs:label "LaneChangeTarget"@en ;
    rdfs:comment "Defines the target lane of the LaneChangeAction."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:RelativeTargetLane ;
                                    owl:onProperty osc:LaneChangeTarget.relativeTargetLane ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LaneChangeTarget.absoluteTargetLane ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LaneChangeTarget.relativeTargetLane ] [ a owl:Restriction ;
                                    owl:onClass osc:AbsoluteTargetLane ;
                                    owl:onProperty osc:LaneChangeTarget.absoluteTargetLane ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines the target lane of the LaneChangeAction."@en .

osc:LaneOffsetActionDynamics a owl:Class ;
    rdfs:label "LaneOffsetActionDynamics"@en ;
    rdfs:comment "Defines shape and lateral acceleration which are used to do the lane offset action."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:DynamicsShape ;
            owl:onProperty osc:LaneOffsetActionDynamics.dynamicsShape ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LaneOffsetActionDynamics.maxLateralAcc ] ;
    skos:definition "Defines shape and lateral acceleration which are used to do the lane offset action."@en .

osc:LaneOffsetTarget a owl:Class ;
    rdfs:label "LaneOffsetTarget"@en ;
    rdfs:comment "Defines the target lane offset of the LaneOffsetAction."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:AbsoluteTargetLaneOffset ;
                                    owl:onProperty osc:LaneOffsetTarget.absoluteTargetLaneOffset ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LaneOffsetTarget.relativeTargetLaneOffset ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LaneOffsetTarget.absoluteTargetLaneOffset ] [ a owl:Restriction ;
                                    owl:onClass osc:RelativeTargetLaneOffset ;
                                    owl:onProperty osc:LaneOffsetTarget.relativeTargetLaneOffset ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines the target lane offset of the LaneOffsetAction."@en .

osc:LightType a owl:Class ;
    rdfs:label "LightType"@en ;
    rdfs:comment "Definition of light types."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:VehicleLight ;
                                    owl:onProperty osc:LightType.vehicleLight ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LightType.userDefinedLight ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LightType.vehicleLight ] [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedLight ;
                                    owl:onProperty osc:LightType.userDefinedLight ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Definition of light types."@en .

osc:ModifyRule a owl:Class ;
    rdfs:label "ModifyRule"@en ;
    rdfs:comment "Enclosing type for either adding a value to a parameter or multiply the parameter by a value. Has to be match the parameter type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:ParameterMultiplyByValueRule ;
                                    owl:onProperty osc:ModifyRule.multiplyByValue ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ModifyRule.addValue ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ModifyRule.multiplyByValue ] [ a owl:Restriction ;
                                    owl:onClass osc:ParameterAddValueRule ;
                                    owl:onProperty osc:ModifyRule.addValue ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Enclosing type for either adding a value to a parameter or multiply the parameter by a value. Has to be match the parameter type."@en .

osc:ObjectType a rdfs:Datatype ;
    rdfs:label "ObjectType"@en ;
    rdfs:comment "Types of entity objects available in a scenario."@en ;
    owl:oneOf ( "miscellaneous" "pedestrian" "vehicle" "external" ) ;
    skos:definition "Types of entity objects available in a scenario."@en .

osc:ParameterType a rdfs:Datatype ;
    rdfs:label "ParameterType"@en ;
    rdfs:comment "Allowed data types for parameters defined in a parameter declaration. The types mentioned here match the corresponding datatypes the W3C XML Schema defines."@en ;
    owl:oneOf ( "boolean" "dateTime" "double" "integer" "string" "unsignedInt" "unsignedShort" "int" ) ;
    skos:definition "Allowed data types for parameters defined in a parameter declaration. The types mentioned here match the corresponding datatypes the W3C XML Schema defines."@en .

osc:ParameterValueDistribution a owl:Class ;
    rdfs:label "ParameterValueDistribution"@en ;
    rdfs:comment "The ParameterValueDistribution represents the top level container of a parameter distribution file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:DistributionDefinition ;
            owl:onProperty osc:ParameterValueDistribution.distributionDefinition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:File ;
            owl:onProperty osc:ParameterValueDistribution.scenarioFile ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The ParameterValueDistribution represents the top level container of a parameter distribution file."@en .

osc:PoissonDistribution a owl:Class ;
    rdfs:label "PoissonDistribution"@en ;
    rdfs:comment "Poisson distribution which can be applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Range ;
            owl:onProperty osc:PoissonDistribution.range ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:PoissonDistribution.expectedValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Poisson distribution which can be applied to a single parameter."@en .

osc:Polyline a owl:Class ;
    rdfs:label "Polyline"@en ;
    rdfs:comment "Polygonal chain (polyline) trajectory specification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Vertex ;
            owl:onProperty osc:Polyline.vertices ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Interpolation ;
            owl:onProperty osc:Polyline.interpolation ] ;
    skos:definition "Polygonal chain (polyline) trajectory specification."@en .

osc:PositionInRoadCoordinates a owl:Class ;
    rdfs:label "PositionInRoadCoordinates"@en ;
    rdfs:comment "Position defined in terms of distance along  a route (pathS) and lateral offset from the route's reference line (t) at that point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:PositionInRoadCoordinates.pathS ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:PositionInRoadCoordinates.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Position defined in terms of distance along  a route (pathS) and lateral offset from the route's reference line (t) at that point."@en .

osc:ProbabilityDistributionSetElement a owl:Class ;
    rdfs:label "ProbabilityDistributionSetElement"@en ;
    rdfs:comment "Indicates a value and probability in a stochastic distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ProbabilityDistributionSetElement.weight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ProbabilityDistributionSetElement.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Indicates a value and probability in a stochastic distribution."@en .

osc:ReachPositionCondition a owl:Class ;
    rdfs:label "ReachPositionCondition"@en ;
    rdfs:comment "Checks if a triggering entity/entities has reached a given position, within some user specified tolerance. "@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ReachPositionCondition.tolerance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:ReachPositionCondition.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Checks if a triggering entity/entities has reached a given position, within some user specified tolerance."@en .

osc:ReferenceContext a rdfs:Datatype ;
    rdfs:label "ReferenceContext"@en ;
    rdfs:comment "Definition of the nature for a given signal, or variable, in terms of absolute or relative."@en ;
    owl:oneOf ( "absolute" "relative" ) ;
    skos:definition "Definition of the nature for a given signal, or variable, in terms of absolute or relative."@en .

osc:RelativeTargetLaneOffset a owl:Class ;
    rdfs:label "RelativeTargetLaneOffset"@en ;
    rdfs:comment "Defines the relative lane offset from a triggering entity/entities to a reference entity as a target for a LaneOffsetTarget."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeTargetLaneOffset.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeTargetLaneOffset.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines the relative lane offset from a triggering entity/entities to a reference entity as a target for a LaneOffsetTarget."@en .

osc:RoadRange a owl:Class ;
    rdfs:label "RoadRange"@en ;
    rdfs:comment "Defines an area by a range on a specific road."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass osc:RoadCursor ;
            owl:onProperty osc:RoadRange.roadCursor ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RoadRange.length ] ;
    skos:definition "Defines an area by a range on a specific road."@en .

osc:RouteRef a owl:Class ;
    rdfs:label "RouteRef"@en ;
    rdfs:comment "Defines a reference to a route. Either an inline definition of a route or a route in a catalog."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:RouteRef.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RouteRef.route ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RouteRef.catalogReference ] [ a owl:Restriction ;
                                    owl:onClass osc:Route ;
                                    owl:onProperty osc:RouteRef.route ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines a reference to a route. Either an inline definition of a route or a route in a catalog."@en .

osc:ScenarioObjectTemplate a owl:Class ;
    rdfs:label "ScenarioObjectTemplate"@en ;
    rdfs:comment "An entity profile that shall appear in an entity group."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:EntityObject ;
            owl:onProperty osc:ScenarioObjectTemplate.entitiyObject ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "An entity profile that shall appear in an entity group."@en .

osc:SelectedEntities a owl:Class ;
    rdfs:label "SelectedEntities"@en ;
    rdfs:comment "Collection of entities that includes entities explicitly by their reference or includes the entities by their type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass osc:EntityRef ;
                                    owl:onProperty osc:SelectedEntities.entityRef ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:SelectedEntities.byType ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:SelectedEntities.entityRef ] [ a owl:Restriction ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass osc:ByType ;
                                    owl:onProperty osc:SelectedEntities.byType ] ) ] ) ] ;
    skos:definition "Collection of entities that includes entities explicitly by their reference or includes the entities by their type."@en .

osc:SetMonitorAction a owl:Class ;
    rdfs:label "SetMonitorAction"@en ;
    rdfs:comment "Action used to set the value of a monitor. If it is set to false by this action, that indicates the scenario was not executed as expected."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:SetMonitorAction.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:MonitorDeclaration ;
            owl:onProperty osc:SetMonitorAction.monitorRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Action used to set the value of a monitor. If it is set to false by this action, that indicates the scenario was not executed as expected."@en .

osc:Shape.clothoid a owl:ObjectProperty ;
    rdfs:label "clothoid"@en ;
    rdfs:domain osc:Shape ;
    rdfs:range osc:Clothoid .

osc:Shape.clothoidSpline a owl:ObjectProperty ;
    rdfs:label "clothoidSpline"@en ;
    rdfs:domain osc:Shape ;
    rdfs:range osc:ClothoidSpline .

osc:Shape.nurbs a owl:ObjectProperty ;
    rdfs:label "nurbs"@en ;
    rdfs:domain osc:Shape ;
    rdfs:range osc:Nurbs .

osc:Shape.polyline a owl:ObjectProperty ;
    rdfs:label "polyline"@en ;
    rdfs:domain osc:Shape ;
    rdfs:range osc:Polyline .

osc:SimulationTimeCondition a owl:Class ;
    rdfs:label "SimulationTimeCondition"@en ;
    rdfs:comment "Compares the simulation time to the specified value. The logical operator is defined by the rule attribute."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:SimulationTimeCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:SimulationTimeCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Compares the simulation time to the specified value. The logical operator is defined by the rule attribute."@en .

osc:SpeedAction a owl:Class ;
    rdfs:label "SpeedAction"@en ;
    rdfs:comment "This action describes the transition of an entity's speed to a target speed. SpeedActionDynamics specifies the transition with respects to time or distance combined with a shape."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:TransitionDynamics ;
            owl:onProperty osc:SpeedAction.speedActionDynamics ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:SpeedActionTarget ;
            owl:onProperty osc:SpeedAction.speedActionTarget ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "This action describes the transition of an entity's speed to a target speed. SpeedActionDynamics specifies the transition with respects to time or distance combined with a shape."@en .

osc:SpeedActionTarget a owl:Class ;
    rdfs:label "SpeedActionTarget"@en ;
    rdfs:comment "Specifies the target speed of a SpeedAction. Can be either an absolute speed value or a speed value relative to another entity."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:AbsoluteTargetSpeed ;
                                    owl:onProperty osc:SpeedActionTarget.absoluteTargetSpeed ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:SpeedActionTarget.relativeTargetSpeed ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:SpeedActionTarget.absoluteTargetSpeed ] [ a owl:Restriction ;
                                    owl:onClass osc:RelativeTargetSpeed ;
                                    owl:onProperty osc:SpeedActionTarget.relativeTargetSpeed ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Specifies the target speed of a SpeedAction. Can be either an absolute speed value or a speed value relative to another entity."@en .

osc:SpeedProfileEntry a owl:Class ;
    rdfs:label "SpeedProfileEntry"@en ;
    rdfs:comment "Describes a speed target for a SpeedProfileAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:SpeedProfileEntry.speed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:SpeedProfileEntry.time ] ;
    skos:definition "Describes a speed target for a SpeedProfileAction."@en .

osc:SpeedTargetValueType a rdfs:Datatype ;
    rdfs:label "SpeedTargetValueType"@en ;
    rdfs:comment "Type definition that relates a speed value relative to another one."@en ;
    owl:oneOf ( "delta" "factor" ) ;
    skos:definition "Type definition that relates a speed value relative to another one."@en .

osc:StochasticDistribution a owl:Class ;
    rdfs:label "StochasticDistribution"@en ;
    rdfs:comment "Container for a stochastic distribution which applies to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:StochasticDistributionType ;
            owl:onProperty osc:StochasticDistribution.stochasticDistributionType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:StochasticDistribution.parameterName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Container for a stochastic distribution which applies to a single parameter."@en .

osc:Story a owl:Class ;
    rdfs:label "Story"@en ;
    rdfs:comment "Grouping of independent executable parts of a scenario. The name of a story must be unique within an OpenSCENARIO file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Act ;
            owl:onProperty osc:Story.acts ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Story.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Grouping of independent executable parts of a scenario. The name of a story must be unique within an OpenSCENARIO file."@en .

osc:TimeOfDay a owl:Class ;
    rdfs:label "TimeOfDay"@en ;
    rdfs:comment "Defines the day and time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty osc:TimeOfDay.dateTime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:TimeOfDay.animation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines the day and time."@en .

osc:TimeOfDayCondition a owl:Class ;
    rdfs:label "TimeOfDayCondition"@en ;
    rdfs:comment "The logical expression is considered true if the simulated time and date verifies the specified relation rule (bigger than, smaller than, or equal to) relatively to a given time and date value."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:TimeOfDayCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty osc:TimeOfDayCondition.dateTime ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The logical expression is considered true if the simulated time and date verifies the specified relation rule (bigger than, smaller than, or equal to) relatively to a given time and date value."@en .

osc:TimeReference a owl:Class ;
    rdfs:label "TimeReference"@en ;
    rdfs:comment "Defines whether time information present in trajectories should be considered. If considered, it may be used as either absolute or relative time values. Moreover, a time offset or time scaling may be applied."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Timing ;
                                    owl:onProperty osc:TimeReference.timing ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TimeReference.none ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TimeReference.timing ] [ a owl:Restriction ;
                                    owl:onClass osc:None ;
                                    owl:onProperty osc:TimeReference.none ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines whether time information present in trajectories should be considered. If considered, it may be used as either absolute or relative time values. Moreover, a time offset or time scaling may be applied."@en .

osc:TimeToCollisionConditionTarget a owl:Class ;
    rdfs:label "TimeToCollisionConditionTarget"@en ;
    rdfs:comment "Target position used in the TimeToCollisionCondition. Can be defined as either an explicit position, or the position of a reference entity."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:EntityRef ;
                                    owl:onProperty osc:TimeToCollisionConditionTarget.entityRef ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TimeToCollisionConditionTarget.position ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TimeToCollisionConditionTarget.entityRef ] [ a owl:Restriction ;
                                    owl:onClass osc:Position ;
                                    owl:onProperty osc:TimeToCollisionConditionTarget.position ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Target position used in the TimeToCollisionCondition. Can be defined as either an explicit position, or the position of a reference entity."@en .

osc:TrafficArea a owl:Class ;
    rdfs:label "TrafficArea"@en ;
    rdfs:comment "Defines the area, where the traffic shall be spawned."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:RoadRange ;
            owl:onProperty osc:TrafficArea.roadRange ],
        [ a owl:Restriction ;
            owl:onClass osc:Polygon ;
            owl:onProperty osc:TrafficArea.polygon ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines the area, where the traffic shall be spawned."@en .

osc:TrafficSignalAction a owl:Class ;
    rdfs:label "TrafficSignalAction"@en ;
    rdfs:comment "Action used to change the state of a traffic signal."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSignalControllerAction ;
                                    owl:onProperty osc:TrafficSignalAction.trafficSignalControllerAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficSignalAction.trafficSignalStateAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficSignalAction.trafficSignalControllerAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSignalStateAction ;
                                    owl:onProperty osc:TrafficSignalAction.trafficSignalStateAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Action used to change the state of a traffic signal."@en .

osc:TrafficSignalCondition a owl:Class ;
    rdfs:label "TrafficSignalCondition"@en ;
    rdfs:comment "Considered true if a referenced traffic signal (e.g. from an OpenDRIVE file) reaches a specific observable state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalCondition.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalCondition.state ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Considered true if a referenced traffic signal (e.g. from an OpenDRIVE file) reaches a specific observable state."@en .

osc:TrafficSignalStateAction a owl:Class ;
    rdfs:label "TrafficSignalStateAction"@en ;
    rdfs:comment "Controls the observable state of a traffic signal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalStateAction.state ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalStateAction.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Controls the observable state of a traffic signal."@en .

osc:Trailer a owl:Class ;
    rdfs:label "Trailer"@en ;
    rdfs:comment "Definition of a trailer to be towed. The included or referred ScenarioObject must include an EntityObject of type Vehicle. The Vehicle must have a trailerCoupler in order for the connection to be complete."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ScenarioObject ;
            owl:onProperty osc:Trailer.trailer ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:EntityRef ;
            owl:onProperty osc:Trailer.trailerRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of a trailer to be towed. The included or referred ScenarioObject must include an EntityObject of type Vehicle. The Vehicle must have a trailerCoupler in order for the connection to be complete."@en .

osc:TrailerAction a owl:Class ;
    rdfs:label "TrailerAction"@en ;
    rdfs:comment "Action to connect or disconnect trailer. Applied to the towing vehicle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:DisconnectTrailerAction ;
            owl:onProperty osc:TrailerAction.disconnectTrailerAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:ConnectTrailerAction ;
            owl:onProperty osc:TrailerAction.connectTrailerAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Action to connect or disconnect trailer. Applied to the towing vehicle."@en .

osc:TrailerCoupler a owl:Class ;
    rdfs:label "TrailerCoupler"@en ;
    rdfs:comment "Definition of the mounting point for connecting the trailer to a towing vehicle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrailerCoupler.dz ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrailerCoupler.dx ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of the mounting point for connecting the trailer to a towing vehicle."@en .

osc:TrailerHitch a owl:Class ;
    rdfs:label "TrailerHitch"@en ;
    rdfs:comment "Definition of the mounting point for connecting a trailer to the vehicle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrailerHitch.dz ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrailerHitch.dx ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of the mounting point for connecting a trailer to the vehicle."@en .

osc:TriggeringEntities a owl:Class ;
    rdfs:label "TriggeringEntities"@en ;
    rdfs:comment "A collection of entities evaluated for an EntityCondition to be triggered. It is optional whether the condition must be fulfilled any or all of the objects."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:EntityRef ;
            owl:onProperty osc:TriggeringEntities.entityRefs ],
        [ a owl:Restriction ;
            owl:onDataRange osc:TriggeringEntitiesRule ;
            owl:onProperty osc:TriggeringEntities.triggeringEntitiesRule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A collection of entities evaluated for an EntityCondition to be triggered. It is optional whether the condition must be fulfilled any or all of the objects."@en .

osc:UserDefinedAction a owl:Class ;
    rdfs:label "UserDefinedAction"@en ;
    rdfs:comment "Used to either issue a command to the simulation environment (e.g. test software, system under test, simulation models) or start an external script. Allows the user to activate custom actions in their simulation user software."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:CustomCommandAction ;
            owl:onProperty osc:UserDefinedAction.customCommandAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Used to either issue a command to the simulation environment (e.g. test software, system under test, simulation models) or start an external script. Allows the user to activate custom actions in their simulation user software."@en .

osc:ValueConstraint a owl:Class ;
    rdfs:label "ValueConstraint"@en ;
    rdfs:comment "Value constraints represent a single rule to a given parameter in a parameter declaration. Note that value must match the type of the enclosing parameter declaration. A ValueConstraint for  parameter declaration of type \"string\" must use either \"equalTo\" or \"notEqualTo\" for the rule property."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:ValueConstraint.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ValueConstraint.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Value constraints represent a single rule to a given parameter in a parameter declaration. Note that value must match the type of the enclosing parameter declaration. A ValueConstraint for  parameter declaration of type \"string\" must use either \"equalTo\" or \"notEqualTo\" for the rule property."@en .

osc:VariableModifyRule a owl:Class ;
    rdfs:label "VariableModifyRule"@en ;
    rdfs:comment "Enclosing type for either adding a value to a variable or multiply the variable by a value. Has to be match the variable type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:VariableMultiplyByValueRule ;
                                    owl:onProperty osc:VariableModifyRule.multiplyByValue ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableModifyRule.addValue ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableModifyRule.multiplyByValue ] [ a owl:Restriction ;
                                    owl:onClass osc:VariableAddValueRule ;
                                    owl:onProperty osc:VariableModifyRule.addValue ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Enclosing type for either adding a value to a variable or multiply the variable by a value. Has to be match the variable type."@en .

osc:VehicleCategory a rdfs:Datatype ;
    rdfs:label "VehicleCategory"@en ;
    rdfs:comment """Categories for entity objects of type vehicle.\r
It is recommended to use the most specific literal that fits whenever possible (e.g. 'heavyTruck' instead of 'car'). \r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en ;
    owl:oneOf ( "aircraft" "bicycle" "bus" "car" "heavyTruck" "landVehicle" "micromobilityDevice" "motorbike" "motorcycle" "other" "semitractor" "semitrailer" "standupScooter" "trailer" "train" "tram" "truck" "van" "watercraft" "wheelchair" "workMachine" ) ;
    skos:definition """Categories for entity objects of type vehicle.\r
It is recommended to use the most specific literal that fits whenever possible (e.g. 'heavyTruck' instead of 'car'). \r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en .

osc:VehicleCategoryDistributionEntry a owl:Class ;
    rdfs:label "VehicleCategoryDistributionEntry"@en ;
    rdfs:comment "Represents the weight of a given vehicle category within a traffic definition. The relative probability for the occurence of this category is defined by the weight devided by the sum of all weights of this distribution. "@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:VehicleCategory ;
            owl:onProperty osc:VehicleCategoryDistributionEntry.category ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:VehicleCategoryDistributionEntry.weight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Represents the weight of a given vehicle category within a traffic definition. The relative probability for the occurence of this category is defined by the weight devided by the sum of all weights of this distribution."@en .

osc:VehicleRoleDistributionEntry a owl:Class ;
    rdfs:label "VehicleRoleDistributionEntry"@en ;
    rdfs:comment "Represents the weight of a given vehicle role within a traffic definition. The relative probability for the occurrence of this role is defined by the weight divided by the sum of all weights of this distribution. "@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:Role ;
            owl:onProperty osc:VehicleRoleDistributionEntry.role ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:VehicleRoleDistributionEntry.weight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Represents the weight of a given vehicle role within a traffic definition. The relative probability for the occurrence of this role is defined by the weight divided by the sum of all weights of this distribution."@en .

osc:Waypoint a owl:Class ;
    rdfs:label "Waypoint"@en ;
    rdfs:comment "Reference position used to form a route."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:Waypoint.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:RouteStrategy ;
            owl:onProperty osc:Waypoint.routeStrategy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Reference position used to form a route."@en .

osc:Wind a owl:Class ;
    rdfs:label "Wind"@en ;
    rdfs:comment "Defines wind properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Wind.direction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Wind.speed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines wind properties."@en .

osc:AccelerationCondition a owl:Class ;
    rdfs:label "AccelerationCondition"@en ;
    rdfs:comment "Compares the entity's acceleration to a reference value. The logical operator used for comparison is defined by the rule attribute (less, greater, equal). If direction is used, only the projection to that direction is used in the comparison."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:AccelerationCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AccelerationCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:DirectionalDimension ;
            owl:onProperty osc:AccelerationCondition.direction ] ;
    skos:definition "Compares the entity's acceleration to a reference value. The logical operator used for comparison is defined by the rule attribute (less, greater, equal). If direction is used, only the projection to that direction is used in the comparison."@en .

osc:Axles a owl:Class ;
    rdfs:label "Axles"@en ;
    rdfs:comment "A set of the axles of a vehicle. A vehicle must have a front axle and a rear axle except for trailers which may also only have a rear axle. It might have additional axles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Axle ;
            owl:onProperty osc:Axles.rearAxle ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Axle ;
            owl:onProperty osc:Axles.frontAxle ] ;
    skos:definition "A set of the axles of a vehicle. A vehicle must have a front axle and a rear axle except for trailers which may also only have a rear axle. It might have additional axles."@en .

osc:Center a owl:Class ;
    rdfs:label "Center"@en ;
    rdfs:comment "Represents the geometrical center of the bounding box expressed in coordinates that refer to the coordinate system of the entity (e.g. the vehicle coordinate system)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Center.y ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Center.x ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Center.z ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Represents the geometrical center of the bounding box expressed in coordinates that refer to the coordinate system of the entity (e.g. the vehicle coordinate system)."@en .

osc:ClothoidSpline a owl:Class ;
    rdfs:label "ClothoidSpline"@en ;
    rdfs:comment "A shape specification which consists of one or multiple concatenated clothoids (clothoid spline)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ClothoidSplineSegment ;
            owl:onProperty osc:ClothoidSpline.segments ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Motion ;
            owl:onProperty osc:ClothoidSpline.motionEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ClothoidSpline.timeEnd ] ;
    skos:definition "A shape specification which consists of one or multiple concatenated clothoids (clothoid spline)."@en .

osc:Color a owl:Class ;
    rdfs:label "Color"@en ;
    rdfs:comment "Color description with a semantic color value and an optional detailed value for visualization."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onDataRange osc:ColorType ;
                                    owl:onProperty osc:Color.colorType ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Color.colorRgb ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Color.colorCmyk ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Color.colorType ] [ a owl:Restriction ;
                                    owl:onClass osc:ColorRgb ;
                                    owl:onProperty osc:Color.colorRgb ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Color.colorCmyk ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Color.colorType ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Color.colorRgb ] [ a owl:Restriction ;
                                    owl:onClass osc:ColorCmyk ;
                                    owl:onProperty osc:Color.colorCmyk ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Color description with a semantic color value and an optional detailed value for visualization."@en .

osc:ColorRgb a owl:Class ;
    rdfs:label "ColorRgb"@en ;
    rdfs:comment "Color description in RGB schema."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorRgb.blue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorRgb.red ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorRgb.green ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Color description in RGB schema."@en .

osc:Condition.byEntityCondition a owl:ObjectProperty ;
    rdfs:label "byEntityCondition"@en ;
    rdfs:domain osc:Condition ;
    rdfs:range osc:ByEntityCondition .

osc:Condition.byValueCondition a owl:ObjectProperty ;
    rdfs:label "byValueCondition"@en ;
    rdfs:domain osc:Condition ;
    rdfs:range osc:ByValueCondition .

osc:Condition.conditionEdge a owl:DatatypeProperty ;
    rdfs:label "conditionEdge"@en ;
    rdfs:comment "Specifies the edge when the condition is evaluated to true (rising, falling, risingOrFalling, none)."@en ;
    rdfs:domain osc:Condition ;
    rdfs:range osc:ConditionEdge ;
    skos:definition "Specifies the edge when the condition is evaluated to true (rising, falling, risingOrFalling, none)."@en .

osc:Condition.delay a owl:DatatypeProperty ;
    rdfs:label "delay"@en ;
    rdfs:comment "Time elapsed after the edge condition is verified, until the condition returns true to the scenario. Unit: [s]. Range: [0..inf[."@en ;
    rdfs:domain osc:Condition ;
    rdfs:range xsd:double ;
    skos:definition "Time elapsed after the edge condition is verified, until the condition returns true to the scenario. Unit: [s]. Range: [0..inf[."@en .

osc:Condition.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "Name of the condition."@en ;
    rdfs:domain osc:Condition ;
    rdfs:range xsd:string ;
    skos:definition "Name of the condition."@en .

osc:ControlPoint a owl:Class ;
    rdfs:label "ControlPoint"@en ;
    rdfs:comment "Specification of one control point of a NURBS trajectory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ControlPoint.time ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ControlPoint.weight ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:ControlPoint.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Specification of one control point of a NURBS trajectory."@en .

osc:ControllerAction a owl:Class ;
    rdfs:label "ControllerAction"@en ;
    rdfs:comment "Action that either assigns a new controller, overrides an existing one or activates a controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ActivateControllerAction ;
            owl:onProperty osc:ControllerAction.activateControllerAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:AssignControllerAction ;
            owl:onProperty osc:ControllerAction.assignControllerAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:OverrideControllerValueAction ;
            owl:onProperty osc:ControllerAction.overrideControllerValueAction ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Action that either assigns a new controller, overrides an existing one or activates a controller."@en .

osc:ControllerDistributionEntry a owl:Class ;
    rdfs:label "ControllerDistributionEntry"@en ;
    rdfs:comment "Defines that weight in a controller distribution, for the given controller type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onDataRange xsd:double ;
                                    owl:onProperty osc:ControllerDistributionEntry.weight ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ControllerDistributionEntry.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ControllerDistributionEntry.catalogReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ControllerDistributionEntry.weight ] [ a owl:Restriction ;
                                    owl:onClass osc:Controller ;
                                    owl:onProperty osc:ControllerDistributionEntry.controller ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ControllerDistributionEntry.catalogReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ControllerDistributionEntry.weight ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ControllerDistributionEntry.controller ] [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:ControllerDistributionEntry.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines that weight in a controller distribution, for the given controller type."@en .

osc:DeterministicSingleParameterDistributionType a owl:Class ;
    rdfs:label "DeterministicSingleParameterDistributionType"@en ;
    rdfs:comment "A deterministic distribution type which can be applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedDistribution ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.userDefinedDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.distributionSet ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.distributionRange ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.userDefinedDistribution ] [ a owl:Restriction ;
                                    owl:onClass osc:DistributionSet ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.distributionSet ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.distributionRange ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.userDefinedDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.distributionSet ] [ a owl:Restriction ;
                                    owl:onClass osc:DistributionRange ;
                                    owl:onProperty osc:DeterministicSingleParameterDistributionType.distributionRange ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "A deterministic distribution type which can be applied to a single parameter."@en .

osc:Dimensions a owl:Class ;
    rdfs:label "Dimensions"@en ;
    rdfs:comment "Dimensions for a three dimensional box. Width, length and height are the absolute extensions in the (y,x,z) coordinate system of the entity's local coordinate system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Dimensions.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Dimensions.width ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Dimensions.height ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Dimensions for a three dimensional box. Width, length and height are the absolute extensions in the (y,x,z) coordinate system of the entity's local coordinate system."@en .

osc:EntityAction a owl:Class ;
    rdfs:label "EntityAction"@en ;
    rdfs:comment """Defines an action that adds or deletes a referred entity.\r
Entities to be added or deleted must be defined in the Entities section.\r
An entity can only exist in one copy. Adding an already active entity will have no effect, neither will deleting an already inactive entity."""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:DeleteEntityAction ;
                                    owl:onProperty osc:EntityAction.deleteEntityAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityAction.addEntityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityAction.entityRef ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityAction.deleteEntityAction ] [ a owl:Restriction ;
                                    owl:onClass osc:AddEntityAction ;
                                    owl:onProperty osc:EntityAction.addEntityAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityAction.entityRef ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityAction.deleteEntityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityAction.addEntityAction ] [ a owl:Restriction ;
                                    owl:onClass osc:Entity ;
                                    owl:onProperty osc:EntityAction.entityRef ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition """Defines an action that adds or deletes a referred entity.\r
Entities to be added or deleted must be defined in the Entities section.\r
An entity can only exist in one copy. Adding an already active entity will have no effect, neither will deleting an already inactive entity."""@en .

osc:EntityObject.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:EntityObject ;
    rdfs:range osc:CatalogReference .

osc:EntityObject.externalObjectReference a owl:ObjectProperty ;
    rdfs:label "externalObjectReference"@en ;
    rdfs:domain osc:EntityObject ;
    rdfs:range osc:ExternalObjectReference .

osc:EntityObject.miscObject a owl:ObjectProperty ;
    rdfs:label "miscObject"@en ;
    rdfs:domain osc:EntityObject ;
    rdfs:range osc:MiscObject .

osc:EntityObject.pedestrian a owl:ObjectProperty ;
    rdfs:label "pedestrian"@en ;
    rdfs:domain osc:EntityObject ;
    rdfs:range osc:Pedestrian .

osc:EntityObject.vehicle a owl:ObjectProperty ;
    rdfs:label "vehicle"@en ;
    rdfs:domain osc:EntityObject ;
    rdfs:range osc:Vehicle .

osc:InRoutePosition a owl:Class ;
    rdfs:label "InRoutePosition"@en ;
    rdfs:comment "Defines the current position in a given route, either through a position in the lane coordinate system, a position in a road coordinate system or through the current position of an entity."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:PositionInRoadCoordinates ;
                                    owl:onProperty osc:InRoutePosition.fromRoadCoordinates ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:InRoutePosition.fromCurrentEntity ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:InRoutePosition.fromLaneCoordinates ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:InRoutePosition.fromRoadCoordinates ] [ a owl:Restriction ;
                                    owl:onClass osc:PositionOfCurrentEntity ;
                                    owl:onProperty osc:InRoutePosition.fromCurrentEntity ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:InRoutePosition.fromLaneCoordinates ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:InRoutePosition.fromRoadCoordinates ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:InRoutePosition.fromCurrentEntity ] [ a owl:Restriction ;
                                    owl:onClass osc:PositionInLaneCoordinates ;
                                    owl:onProperty osc:InRoutePosition.fromLaneCoordinates ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines the current position in a given route, either through a position in the lane coordinate system, a position in a road coordinate system or through the current position of an entity."@en .

osc:InitActions a owl:Class ;
    rdfs:label "InitActions"@en ;
    rdfs:comment "A list of action instances (GlobalAction, UserDefinedAction, PrivateAction instances) which are executed during the initialization phase of a scenario."@en ;
    skos:definition "A list of action instances (GlobalAction, UserDefinedAction, PrivateAction instances) which are executed during the initialization phase of a scenario."@en .

osc:LaneChangeAction a owl:Class ;
    rdfs:label "LaneChangeAction"@en ;
    rdfs:comment "This action describes the transition between an entity's current lane and its target lane. The target lane may be given in absolute or relative terms. The dynamics of the transition may be given either by providing the time or the distance required for performing the transition. Time and distance are measured between the start position and the end position of the action. The transition starts at the current lane position, including the current lane offset and ends at the target lane position, optionally including a targetLaneOffset. If no targetLaneOffset is specified, it shall be zero after completing the action, so that any previous offset is not taken into account."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:TransitionDynamics ;
            owl:onProperty osc:LaneChangeAction.laneChangeActionDynamics ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LaneChangeAction.targetLaneOffset ],
        [ a owl:Restriction ;
            owl:onClass osc:LaneChangeTarget ;
            owl:onProperty osc:LaneChangeAction.laneChangeTarget ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "This action describes the transition between an entity's current lane and its target lane. The target lane may be given in absolute or relative terms. The dynamics of the transition may be given either by providing the time or the distance required for performing the transition. Time and distance are measured between the start position and the end position of the action. The transition starts at the current lane position, including the current lane offset and ends at the target lane position, optionally including a targetLaneOffset. If no targetLaneOffset is specified, it shall be zero after completing the action, so that any previous offset is not taken into account."@en .

osc:LaneOffsetAction a owl:Class ;
    rdfs:label "LaneOffsetAction"@en ;
    rdfs:comment "This action describes the transition to a defined lane offset of an entity. The lane offset will be kept if the action is set as continuous. The lane offset may be given in absolute or relative terms. The dynamics are specified by providing the maxLateralAcc used to keep the lane offset. Lane offset keeping starts immediately at start of the action and ends after the given duration. Different shapes can be used for the initial transition. Step defines an immediate transition, i.e. a jump from the current lane offset to the target lane offset. Usage of time and distance does not make any sense in combination with step; linear will result in a linear movement between the start and target lane offset; cubic and sinusoidal will result in smooth transitions (basically s-shaped) between start and end state. A smooth transition is only given with cubic and sinusoidal shape."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:LaneOffsetAction.continuous ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:LaneOffsetTarget ;
            owl:onProperty osc:LaneOffsetAction.laneOffsetTarget ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:LaneOffsetActionDynamics ;
            owl:onProperty osc:LaneOffsetAction.laneOffsetActionDynamics ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "This action describes the transition to a defined lane offset of an entity. The lane offset will be kept if the action is set as continuous. The lane offset may be given in absolute or relative terms. The dynamics are specified by providing the maxLateralAcc used to keep the lane offset. Lane offset keeping starts immediately at start of the action and ends after the given duration. Different shapes can be used for the initial transition. Step defines an immediate transition, i.e. a jump from the current lane offset to the target lane offset. Usage of time and distance does not make any sense in combination with step; linear will result in a linear movement between the start and target lane offset; cubic and sinusoidal will result in smooth transitions (basically s-shaped) between start and end state. A smooth transition is only given with cubic and sinusoidal shape."@en .

osc:LateralAction a owl:Class ;
    rdfs:label "LateralAction"@en ;
    rdfs:comment "Controls the lateral behavior of an entity."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:LaneChangeAction ;
                                    owl:onProperty osc:LateralAction.laneChangeAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LateralAction.lateralDistanceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LateralAction.laneOffsetAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LateralAction.laneChangeAction ] [ a owl:Restriction ;
                                    owl:onClass osc:LateralDistanceAction ;
                                    owl:onProperty osc:LateralAction.lateralDistanceAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LateralAction.laneOffsetAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LateralAction.laneChangeAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LateralAction.lateralDistanceAction ] [ a owl:Restriction ;
                                    owl:onClass osc:LaneOffsetAction ;
                                    owl:onProperty osc:LateralAction.laneOffsetAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Controls the lateral behavior of an entity."@en .

osc:LightStateAction a owl:Class ;
    rdfs:label "LightStateAction"@en ;
    rdfs:comment "This action describes the transition of a current light state to the target light state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LightStateAction.transitionTime ],
        [ a owl:Restriction ;
            owl:onClass osc:LightType ;
            owl:onProperty osc:LightStateAction.lightType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:LightState ;
            owl:onProperty osc:LightStateAction.lightState ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "This action describes the transition of a current light state to the target light state."@en .

osc:LogNormalDistribution a owl:Class ;
    rdfs:label "LogNormalDistribution"@en ;
    rdfs:comment "Defines a log normal distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LogNormalDistribution.expectedValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Range ;
            owl:onProperty osc:LogNormalDistribution.range ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LogNormalDistribution.variance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a log normal distribution."@en .

osc:LongitudinalAction a owl:Class ;
    rdfs:label "LongitudinalAction"@en ;
    rdfs:comment "Controls the longitudinal behavior of an entity."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:SpeedProfileAction ;
                                    owl:onProperty osc:LongitudinalAction.speedProfileAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LongitudinalAction.longitudinalDistanceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LongitudinalAction.speedAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LongitudinalAction.speedProfileAction ] [ a owl:Restriction ;
                                    owl:onClass osc:LongitudinalDistanceAction ;
                                    owl:onProperty osc:LongitudinalAction.longitudinalDistanceAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LongitudinalAction.speedAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LongitudinalAction.speedProfileAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:LongitudinalAction.longitudinalDistanceAction ] [ a owl:Restriction ;
                                    owl:onClass osc:SpeedAction ;
                                    owl:onProperty osc:LongitudinalAction.speedAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Controls the longitudinal behavior of an entity."@en .

osc:Maneuver a owl:Class ;
    rdfs:label "Maneuver"@en ;
    rdfs:comment "A container for Events. Can be stored in a maneuver catalog. Allows declaration of parameters within its scope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Event ;
            owl:onProperty osc:Maneuver.events ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Maneuver.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A container for Events. Can be stored in a maneuver catalog. Allows declaration of parameters within its scope."@en .

osc:MonitorDeclaration a owl:Class ;
    rdfs:label "MonitorDeclaration"@en ;
    rdfs:comment "Declaration of a monitor that keeps track of the scenario execution. Monitors are of type Boolean and can be initialized as true or false and set during the scenario execution using the SetMonitorAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:MonitorDeclaration.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:MonitorDeclaration.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Declaration of a monitor that keeps track of the scenario execution. Monitors are of type Boolean and can be initialized as true or false and set during the scenario execution using the SetMonitorAction."@en .

osc:NormalDistribution a owl:Class ;
    rdfs:label "NormalDistribution"@en ;
    rdfs:comment "Normal distribution which can be applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:NormalDistribution.variance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Range ;
            owl:onProperty osc:NormalDistribution.range ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:NormalDistribution.expectedValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Normal distribution which can be applied to a single parameter."@en .

osc:Nurbs a owl:Class ;
    rdfs:label "Nurbs"@en ;
    rdfs:comment "Non-uniform rational b-spline (NURBS) trajectory specification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ControlPoint ;
            owl:onProperty osc:Nurbs.controlPoints ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Knot ;
            owl:onProperty osc:Nurbs.knots ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedInt ;
            owl:onProperty osc:Nurbs.order ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Non-uniform rational b-spline (NURBS) trajectory specification."@en .

osc:OpenScenarioCategory a owl:Class ;
    rdfs:label "OpenScenarioCategory"@en ;
    rdfs:comment "Indicates if the following content defines a scenario or a catalog."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:CatalogDefinition ;
                                    owl:onProperty osc:OpenScenarioCategory.catalogDefinition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:OpenScenarioCategory.parameterValueDistributionDefinition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:OpenScenarioCategory.scenarioDefinition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:OpenScenarioCategory.catalogDefinition ] [ a owl:Restriction ;
                                    owl:onClass osc:ParameterValueDistributionDefinition ;
                                    owl:onProperty osc:OpenScenarioCategory.parameterValueDistributionDefinition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:OpenScenarioCategory.scenarioDefinition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:OpenScenarioCategory.catalogDefinition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:OpenScenarioCategory.parameterValueDistributionDefinition ] [ a owl:Restriction ;
                                    owl:onClass osc:ScenarioDefinition ;
                                    owl:onProperty osc:OpenScenarioCategory.scenarioDefinition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Indicates if the following content defines a scenario or a catalog."@en .

osc:OverrideBrakeAction a owl:Class ;
    rdfs:label "OverrideBrakeAction"@en ;
    rdfs:comment "Defines the state of the brake of a vehicle, when overriding a brake value in a ControllerAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:OverrideBrakeAction.active ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideBrakeAction.value ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:BrakeInput ;
            owl:onProperty osc:OverrideBrakeAction.brakeInput ] ;
    skos:definition "Defines the state of the brake of a vehicle, when overriding a brake value in a ControllerAction."@en .

osc:OverrideClutchAction a owl:Class ;
    rdfs:label "OverrideClutchAction"@en ;
    rdfs:comment "Defines the state of the clutch of a vehicle, when overriding a clutch value in a ControllerAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideClutchAction.maxRate ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideClutchAction.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:OverrideClutchAction.active ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines the state of the clutch of a vehicle, when overriding a clutch value in a ControllerAction."@en .

osc:OverrideGearAction a owl:Class ;
    rdfs:label "OverrideGearAction"@en ;
    rdfs:comment "Defines the state of the gear of a vehicle, when overriding a gear value in a ControllerAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Gear ;
            owl:onProperty osc:OverrideGearAction.gear ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:OverrideGearAction.active ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideGearAction.number ] ;
    skos:definition "Defines the state of the gear of a vehicle, when overriding a gear value in a ControllerAction."@en .

osc:OverrideParkingBrakeAction a owl:Class ;
    rdfs:label "OverrideParkingBrakeAction"@en ;
    rdfs:comment "Defines the state of the parking brake of a vehicle, when overriding a parking brake value in a ControllerAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:BrakeInput ;
            owl:onProperty osc:OverrideParkingBrakeAction.brakeInput ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:OverrideParkingBrakeAction.active ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideParkingBrakeAction.value ] ;
    skos:definition "Defines the state of the parking brake of a vehicle, when overriding a parking brake value in a ControllerAction."@en .

osc:OverrideThrottleAction a owl:Class ;
    rdfs:label "OverrideThrottleAction"@en ;
    rdfs:comment "Defines the state of the throttle of a vehicle, when overriding a throttle value in a ControllerAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:OverrideThrottleAction.active ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideThrottleAction.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideThrottleAction.maxRate ] ;
    skos:definition "Defines the state of the throttle of a vehicle, when overriding a throttle value in a ControllerAction."@en .

osc:ParameterAction a owl:Class ;
    rdfs:label "ParameterAction"@en ;
    rdfs:comment "Set or modify a named parameter. (Be aware of the data type)."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:ParameterSetAction ;
                                    owl:onProperty osc:ParameterAction.setAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ParameterAction.parameterRef ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ParameterAction.modifyAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ParameterAction.setAction ] [ a owl:Restriction ;
                                    owl:onClass osc:ParameterDeclaration ;
                                    owl:onProperty osc:ParameterAction.parameterRef ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ParameterAction.modifyAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ParameterAction.setAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ParameterAction.parameterRef ] [ a owl:Restriction ;
                                    owl:onClass osc:ParameterModifyAction ;
                                    owl:onProperty osc:ParameterAction.modifyAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Set or modify a named parameter. (Be aware of the data type)."@en .

osc:ParameterAssignment a owl:Class ;
    rdfs:label "ParameterAssignment"@en ;
    rdfs:comment "Assignment of a value to a named parameter. It is either used when importing types of vehicles, controllers etc. from a catalog during startup of a simulator. It is also used when generating concrete scenarios from logical scenarios with ParameterValueSets during runtime of a scenario generator."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ParameterDeclaration ;
            owl:onProperty osc:ParameterAssignment.parameterRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ParameterAssignment.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Assignment of a value to a named parameter. It is either used when importing types of vehicles, controllers etc. from a catalog during startup of a simulator. It is also used when generating concrete scenarios from logical scenarios with ParameterValueSets during runtime of a scenario generator."@en .

osc:ParameterCondition a owl:Class ;
    rdfs:label "ParameterCondition"@en ;
    rdfs:comment "Compares a named parameter's value to a reference value. The logical operator used for comparison is defined by the rule attribute Less and greater operator will only be supported if the value given as string can unambiguously be converted into a scalar value (e.g. value=5, value=16.667)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ParameterDeclaration ;
            owl:onProperty osc:ParameterCondition.parameterRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:ParameterCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ParameterCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Compares a named parameter's value to a reference value. The logical operator used for comparison is defined by the rule attribute Less and greater operator will only be supported if the value given as string can unambiguously be converted into a scalar value (e.g. value=5, value=16.667)."@en .

osc:PedestrianAnimation a owl:Class ;
    rdfs:label "PedestrianAnimation"@en ;
    rdfs:comment "Defines a pedestrian's motion and gestures. A motion will override a currently active motion. A conflicting gesture will override currently active gestures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:PedestrianMotionType ;
            owl:onProperty osc:PedestrianAnimation.motion ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:PedestrianAnimation.userDefinedPedestrianAnimation ] ;
    skos:definition "Defines a pedestrian's motion and gestures. A motion will override a currently active motion. A conflicting gesture will override currently active gestures."@en .

osc:PositionInLaneCoordinates a owl:Class ;
    rdfs:label "PositionInLaneCoordinates"@en ;
    rdfs:comment "Defines a coordinate along a lane with a given s coordinate and lane ID."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:PositionInLaneCoordinates.laneOffset ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:PositionInLaneCoordinates.pathS ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:PositionInLaneCoordinates.laneId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a coordinate along a lane with a given s coordinate and lane ID."@en .

osc:Precipitation a owl:Class ;
    rdfs:label "Precipitation"@en ;
    rdfs:comment "Defines a precipitation by type and value of a weather."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Precipitation.precipitationIntensity ],
        [ a owl:Restriction ;
            owl:onDataRange osc:PrecipitationType ;
            owl:onProperty osc:Precipitation.precipitationType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Precipitation.intensity ] ;
    skos:definition "Defines a precipitation by type and value of a weather."@en .

osc:RelativeSpeedToMaster a owl:Class ;
    rdfs:label "RelativeSpeedToMaster"@en ;
    rdfs:comment "Speed definition relative to the master entity's speed within a SynchronizeAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:SteadyState ;
            owl:onProperty osc:RelativeSpeedToMaster.steadyState ],
        [ a owl:Restriction ;
            owl:onDataRange osc:SpeedTargetValueType ;
            owl:onProperty osc:RelativeSpeedToMaster.speedTargetValueType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeSpeedToMaster.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Speed definition relative to the master entity's speed within a SynchronizeAction."@en .

osc:RelativeTargetLane a owl:Class ;
    rdfs:label "RelativeTargetLane"@en ;
    rdfs:comment """Target lane defined as difference compared to the reference entity's current lane evaluated in the reference entity's coordinate system. I.e. positive values refer to lanes in the positive y-axis of the reference entity's coordinate system, negative values refer to lanes in the negative y-axis respectively. For ASAM OpenDRIVE maps, the road center lane is not counted as a lane and thus omitted.\r
When the attribute layer is not provided, check on the reference entity's lane layer.\r
Otherwise, determine the target lane as follows:\r
\r
	1. Determine the world position of the reference entity\r
	2. Determine the lane on the specified lane layer\r
	3. Find the target lane relative to the determined lane on the specified lane layer"""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:RelativeTargetLane.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:LaneLayerType ;
            owl:onProperty osc:RelativeTargetLane.layer ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeTargetLane.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Target lane defined as difference compared to the reference entity's current lane evaluated in the reference entity's coordinate system. I.e. positive values refer to lanes in the positive y-axis of the reference entity's coordinate system, negative values refer to lanes in the negative y-axis respectively. For ASAM OpenDRIVE maps, the road center lane is not counted as a lane and thus omitted.\r
When the attribute layer is not provided, check on the reference entity's lane layer.\r
Otherwise, determine the target lane as follows:\r
\r
	1. Determine the world position of the reference entity\r
	2. Determine the lane on the specified lane layer\r
	3. Find the target lane relative to the determined lane on the specified lane layer"""@en .

osc:RoadCondition a owl:Class ;
    rdfs:label "RoadCondition"@en ;
    rdfs:comment "Definition of the road friction scale factor. Can be augmented with the addition of optional road properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:Wetness ;
            owl:onProperty osc:RoadCondition.wetness ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RoadCondition.frictionScaleFactor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:RoadCondition.properties ] ;
    skos:definition "Definition of the road friction scale factor. Can be augmented with the addition of optional road properties."@en .

osc:RoadCursor a owl:Class ;
    rdfs:label "RoadCursor"@en ;
    rdfs:comment "Defines a cross-section across lanes on a road with respect to the road reference line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RoadCursor.s ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:RoadCursor.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a cross-section across lanes on a road with respect to the road reference line."@en .

osc:RoutePosition a owl:Class ;
    rdfs:label "RoutePosition"@en ;
    rdfs:comment "Position along a route defined in terms of PositionInRoadCoordinates, PositionInLaneCoordinates or current position of a reference object. Orientation definition is optional."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:InRoutePosition ;
            owl:onProperty osc:RoutePosition.inRoutePosition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:RouteRef ;
            owl:onProperty osc:RoutePosition.routeRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:RoutePosition.orientation ] ;
    skos:definition "Position along a route defined in terms of PositionInRoadCoordinates, PositionInLaneCoordinates or current position of a reference object. Orientation definition is optional."@en .

osc:RoutingAction.acquirePositionAction a owl:ObjectProperty ;
    rdfs:label "acquirePositionAction"@en ;
    rdfs:domain osc:RoutingAction ;
    rdfs:range osc:AcquirePositionAction .

osc:RoutingAction.assignRouteAction a owl:ObjectProperty ;
    rdfs:label "assignRouteAction"@en ;
    rdfs:domain osc:RoutingAction ;
    rdfs:range osc:AssignRouteAction .

osc:RoutingAction.followTrajectoryAction a owl:ObjectProperty ;
    rdfs:label "followTrajectoryAction"@en ;
    rdfs:domain osc:RoutingAction ;
    rdfs:range osc:FollowTrajectoryAction .

osc:RoutingAction.preferredLaneLayerAction a owl:ObjectProperty ;
    rdfs:label "preferredLaneLayerAction"@en ;
    rdfs:domain osc:RoutingAction ;
    rdfs:range osc:PreferredLaneLayerAction .

osc:RoutingAction.randomRouteAction a owl:ObjectProperty ;
    rdfs:label "randomRouteAction"@en ;
    rdfs:domain osc:RoutingAction ;
    rdfs:range osc:RandomRouteAction .

osc:SpeedCondition a owl:Class ;
    rdfs:label "SpeedCondition"@en ;
    rdfs:comment "Compares a triggering entity's/entities' speed to a target speed. The logical operator for the comparison is given by the rule attribute. If direction is used, only the projection to that direction is used in the comparison."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:DirectionalDimension ;
            owl:onProperty osc:SpeedCondition.direction ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:SpeedCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:SpeedCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Compares a triggering entity's/entities' speed to a target speed. The logical operator for the comparison is given by the rule attribute. If direction is used, only the projection to that direction is used in the comparison."@en .

osc:Stochastic a owl:Class ;
    rdfs:label "Stochastic"@en ;
    rdfs:comment "Top level container for all stochastic distribution elements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedInt ;
            owl:onProperty osc:Stochastic.numberOfTestRuns ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:StochasticDistribution ;
            owl:onProperty osc:Stochastic.stochasticDistributions ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Stochastic.randomSeed ] ;
    skos:definition "Top level container for all stochastic distribution elements."@en .

osc:Storyboard a owl:Class ;
    rdfs:label "Storyboard"@en ;
    rdfs:comment "Top container for the dynamic content of a scenario."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Init ;
            owl:onProperty osc:Storyboard.init ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Trigger ;
            owl:onProperty osc:Storyboard.stopTrigger ] ;
    skos:definition "Top container for the dynamic content of a scenario."@en .

osc:StoryboardElementStateCondition a owl:Class ;
    rdfs:label "StoryboardElementStateCondition"@en ;
    rdfs:comment "Considered true if a referenced storyboard element has reached a given runtime state (standbyState, runningState, completeState) or if the referenced storyboard element undergoes a specific transition (startTransition, stopTransition, endTransition, skipTransition) at a discrete time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:StoryboardElementType ;
            owl:onProperty osc:StoryboardElementStateCondition.storyboardElementType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:StoryboardElementState ;
            owl:onProperty osc:StoryboardElementStateCondition.state ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:StoryboardElement ;
            owl:onProperty osc:StoryboardElementStateCondition.storyboardElementRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Considered true if a referenced storyboard element has reached a given runtime state (standbyState, runningState, completeState) or if the referenced storyboard element undergoes a specific transition (startTransition, stopTransition, endTransition, skipTransition) at a discrete time."@en .

osc:Timing a owl:Class ;
    rdfs:label "Timing"@en ;
    rdfs:comment "Adjust the timing within time references by scale and offset."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Timing.offset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:ReferenceContext ;
            owl:onProperty osc:Timing.domainAbsoluteRelative ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Timing.scale ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Adjust the timing within time references by scale and offset."@en .

osc:TrafficSignalControllerAction a owl:Class ;
    rdfs:label "TrafficSignalControllerAction"@en ;
    rdfs:comment "Sets a specific semantic phase of a traffic signal controller, typically affecting a signal group."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:TrafficSignalController ;
            owl:onProperty osc:TrafficSignalControllerAction.trafficSignalControllerRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalControllerAction.phase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Sets a specific semantic phase of a traffic signal controller, typically affecting a signal group."@en .

osc:TrafficSignalControllerCondition a owl:Class ;
    rdfs:label "TrafficSignalControllerCondition"@en ;
    rdfs:comment "Considered true if a given TrafficSignalController (which shall be defined within OpenSCENARIO) reaches a specific semantic phase."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalControllerCondition.phase ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:TrafficSignalController ;
            owl:onProperty osc:TrafficSignalControllerCondition.trafficSignalControllerRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Considered true if a given TrafficSignalController (which shall be defined within OpenSCENARIO) reaches a specific semantic phase."@en .

osc:UserDefinedValueCondition a owl:Class ;
    rdfs:label "UserDefinedValueCondition"@en ;
    rdfs:comment """This condition acts as a wrapper for external custom conditions which are implemented in the simulation user software. It can compare e.g. complex types, which are not covered by the primitive types of OpenSCENARIO (boolean, int, double...). This condition is considered true if the given external value verifies the specified relation rule (<, <=, ==, >=, >) relatively to the provided reference value.\r
The external value can only be set from outside the scenario. Therefore this condition creates an interface from the scenario to the simulator or other components (e.g. test software, test case, system under test or simulation models)."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedValueCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedValueCondition.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:UserDefinedValueCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """This condition acts as a wrapper for external custom conditions which are implemented in the simulation user software. It can compare e.g. complex types, which are not covered by the primitive types of OpenSCENARIO (boolean, int, double...). This condition is considered true if the given external value verifies the specified relation rule (<, <=, ==, >=, >) relatively to the provided reference value.\r
The external value can only be set from outside the scenario. Therefore this condition creates an interface from the scenario to the simulator or other components (e.g. test software, test case, system under test or simulation models)."""@en .

osc:VariableAction a owl:Class ;
    rdfs:label "VariableAction"@en ;
    rdfs:comment "Set or modify a variable. (Be aware of the data type)."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:VariableModifyAction ;
                                    owl:onProperty osc:VariableAction.modifyAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableAction.variableRef ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableAction.setAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableAction.modifyAction ] [ a owl:Restriction ;
                                    owl:onClass osc:VariableDeclaration ;
                                    owl:onProperty osc:VariableAction.variableRef ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableAction.setAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableAction.modifyAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:VariableAction.variableRef ] [ a owl:Restriction ;
                                    owl:onClass osc:VariableSetAction ;
                                    owl:onProperty osc:VariableAction.setAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Set or modify a variable. (Be aware of the data type)."@en .

osc:VariableCondition a owl:Class ;
    rdfs:label "VariableCondition"@en ;
    rdfs:comment "Compares a named variable's value to a reference value. The logical operator used for comparison is defined by the rule attribute. Less and greater operators will only be supported if the value given as string can unambiguously be converted into a scalar value (e.g. value=5, value=16.667)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:VariableCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:VariableDeclaration ;
            owl:onProperty osc:VariableCondition.variableRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:VariableCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Compares a named variable's value to a reference value. The logical operator used for comparison is defined by the rule attribute. Less and greater operators will only be supported if the value given as string can unambiguously be converted into a scalar value (e.g. value=5, value=16.667)."@en .

osc:Vertex a owl:Class ;
    rdfs:label "Vertex"@en ;
    rdfs:comment "Vertex of a polygonal chain (polyline) trajectory specification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Motion ;
            owl:onProperty osc:Vertex.motion ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:Vertex.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Vertex.time ] ;
    skos:definition "Vertex of a polygonal chain (polyline) trajectory specification."@en .

osc:Act a owl:Class ;
    rdfs:label "Act"@en ;
    rdfs:comment "A container for maneuver groups. An Act can be only executed once, whereby the included maneuver groups can be executed several times depending on the maximum execution count within the maneuver groups. New executions are only allowed to start when all contained maneuver groups are either in the complete or standby state and the start trigger evaluates to true."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ManeuverGroup ;
            owl:onProperty osc:Act.maneuverGroups ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Trigger ;
            owl:onProperty osc:Act.stopTrigger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Trigger ;
            owl:onProperty osc:Act.startTrigger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Act.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A container for maneuver groups. An Act can be only executed once, whereby the included maneuver groups can be executed several times depending on the maximum execution count within the maneuver groups. New executions are only allowed to start when all contained maneuver groups are either in the complete or standby state and the start trigger evaluates to true."@en .

osc:Action a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "An action serves to create or modify all dynamic elements of a scenario."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onDataRange xsd:string ;
                                    owl:onProperty osc:Action.name ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.globalAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.privateAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.userDefinedAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.name ] [ a owl:Restriction ;
                                    owl:onClass osc:GlobalAction ;
                                    owl:onProperty osc:Action.globalAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.privateAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.userDefinedAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.globalAction ] [ a owl:Restriction ;
                                    owl:onClass osc:PrivateAction ;
                                    owl:onProperty osc:Action.privateAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.userDefinedAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.globalAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Action.privateAction ] [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedAction ;
                                    owl:onProperty osc:Action.userDefinedAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "An action serves to create or modify all dynamic elements of a scenario."@en .

osc:AngleCondition a owl:Class ;
    rdfs:label "AngleCondition"@en ;
    rdfs:comment """Checks if a triggering entity has reached a given angle in a specific angular coordinate, within some user-specified angle tolerance.\r
\r
The angle can be measured in the global world coordinate system or in s-t coordinates like road, lane or trajectory coordinates. In case of s-t coordinates, the orientation is measured at the local s-coordinate of the triggering entity."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:AngleType ;
            owl:onProperty osc:AngleCondition.angleType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AngleCondition.angle ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:AngleCondition.coordinateSystem ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AngleCondition.angleTolerance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Checks if a triggering entity has reached a given angle in a specific angular coordinate, within some user-specified angle tolerance.\r
\r
The angle can be measured in the global world coordinate system or in s-t coordinates like road, lane or trajectory coordinates. In case of s-t coordinates, the orientation is measured at the local s-coordinate of the triggering entity."""@en .

osc:AnimationAction a owl:Class ;
    rdfs:label "AnimationAction"@en ;
    rdfs:comment "This action describes the transition of a current component state to the target component state or more complex animations like pedestrian motions and gestures as well as animations with a referenced file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:AnimationType ;
            owl:onProperty osc:AnimationAction.animationType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:AnimationState ;
            owl:onProperty osc:AnimationAction.animationState ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:AnimationAction.loop ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:AnimationAction.animationDuration ] ;
    skos:definition "This action describes the transition of a current component state to the target component state or more complex animations like pedestrian motions and gestures as well as animations with a referenced file."@en .

osc:AnimationType a owl:Class ;
    rdfs:label "AnimationType"@en ;
    rdfs:comment "Defines the type of the animation. A conflicting animation will override a currently active animation."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedAnimation ;
                                    owl:onProperty osc:AnimationType.userDefinedAnimation ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.componentAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.animationFile ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.pedestrianAnimation ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.userDefinedAnimation ] [ a owl:Restriction ;
                                    owl:onClass osc:ComponentAnimation ;
                                    owl:onProperty osc:AnimationType.componentAnimation ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.animationFile ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.pedestrianAnimation ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.userDefinedAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.componentAnimation ] [ a owl:Restriction ;
                                    owl:onClass osc:AnimationFile ;
                                    owl:onProperty osc:AnimationType.animationFile ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.pedestrianAnimation ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.userDefinedAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.componentAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AnimationType.animationFile ] [ a owl:Restriction ;
                                    owl:onClass osc:PedestrianAnimation ;
                                    owl:onProperty osc:AnimationType.pedestrianAnimation ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines the type of the animation. A conflicting animation will override a currently active animation."@en .

osc:Brake a owl:Class ;
    rdfs:label "Brake"@en ;
    rdfs:comment "Defines a brake input"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Brake.maxRate ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Brake.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a brake input"@en .

osc:BrakeInput a owl:Class ;
    rdfs:label "BrakeInput"@en ;
    rdfs:comment "An action serves to create or modify all dynamic elements of a scenario."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Brake ;
                                    owl:onProperty osc:BrakeInput.brakePercent ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:BrakeInput.brakeForce ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:BrakeInput.brakePercent ] [ a owl:Restriction ;
                                    owl:onClass osc:Brake ;
                                    owl:onProperty osc:BrakeInput.brakeForce ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "An action serves to create or modify all dynamic elements of a scenario."@en .

osc:ColorCmyk a owl:Class ;
    rdfs:label "ColorCmyk"@en ;
    rdfs:comment "Color description in CMYK schema."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorCmyk.cyan ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorCmyk.magenta ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorCmyk.key ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ColorCmyk.yellow ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Color description in CMYK schema."@en .

osc:DirectionalDimension a rdfs:Datatype ;
    rdfs:label "DirectionalDimension"@en ;
    rdfs:comment "Defines the directions in the entity coordinate system."@en ;
    owl:oneOf ( "longitudinal" "lateral" "vertical" ) ;
    skos:definition "Defines the directions in the entity coordinate system."@en .

osc:FollowingMode a rdfs:Datatype ;
    rdfs:label "FollowingMode"@en ;
    rdfs:comment "Type of control actuation when following a lateral or longitudinal trajectory, shape or profile."@en ;
    owl:oneOf ( "follow" "position" ) ;
    skos:definition "Type of control actuation when following a lateral or longitudinal trajectory, shape or profile."@en .

osc:License a owl:Class ;
    rdfs:label "License"@en ;
    rdfs:comment "Licensing information about the OpenSCENARIO file."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:License.resource ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:License.spdxId ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:License.text ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:License.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Licensing information about the OpenSCENARIO file."@en .

osc:OverrideSteeringWheelAction a owl:Class ;
    rdfs:label "OverrideSteeringWheelAction"@en ;
    rdfs:comment "Defines the state of the steering wheel of a vehicle, when overriding a steering wheel angle in a ControllerAction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideSteeringWheelAction.maxTorque ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:OverrideSteeringWheelAction.active ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideSteeringWheelAction.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:OverrideSteeringWheelAction.maxRate ] ;
    skos:definition "Defines the state of the steering wheel of a vehicle, when overriding a steering wheel angle in a ControllerAction."@en .

osc:RelativeRoadPosition a owl:Class ;
    rdfs:label "RelativeRoadPosition"@en ;
    rdfs:comment """Position defined in terms of the relative distance (ds) along the road's reference line and the relative lateral offset (dt) to the road's reference line which are derived from the position of the reference entity.\r
\r
The target position may be either on the same road segment (defined by roadId) where the reference entity is positioned or on a connecting road. In the latter case, the ds-coordinate is calculated along the road reference line of the connecting road. It is assumed that the reference line of the road of the reference entity continues seamlessly on the connecting road (even if its shape changes). It is assumed that the target position relates to the routing of the reference entity. Otherwise, the calculation of the target position cannot be interpreted within the OpenSCENARIO standard.\r
\r
The ds- and dt-coordinates should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeRoadPosition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeRoadPosition.ds ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeRoadPosition.dt ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:RelativeRoadPosition.orientation ] ;
    skos:definition """Position defined in terms of the relative distance (ds) along the road's reference line and the relative lateral offset (dt) to the road's reference line which are derived from the position of the reference entity.\r
\r
The target position may be either on the same road segment (defined by roadId) where the reference entity is positioned or on a connecting road. In the latter case, the ds-coordinate is calculated along the road reference line of the connecting road. It is assumed that the reference line of the road of the reference entity continues seamlessly on the connecting road (even if its shape changes). It is assumed that the target position relates to the routing of the reference entity. Otherwise, the calculation of the target position cannot be interpreted within the OpenSCENARIO standard.\r
\r
The ds- and dt-coordinates should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en .

osc:RelativeSpeedCondition a owl:Class ;
    rdfs:label "RelativeSpeedCondition"@en ;
    rdfs:comment "The current relative speed of a triggering entity/entities to a reference entity is compared to a given value. The logical operator used for the evaluation is defined by the rule attribute. If direction is used, only the projection to that direction is used in the comparison, with the triggering entity/entities as the reference."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:RelativeSpeedCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:DirectionalDimension ;
            owl:onProperty osc:RelativeSpeedCondition.direction ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeSpeedCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeSpeedCondition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The current relative speed of a triggering entity/entities to a reference entity is compared to a given value. The logical operator used for the evaluation is defined by the rule attribute. If direction is used, only the projection to that direction is used in the comparison, with the triggering entity/entities as the reference."@en .

osc:RelativeTargetSpeed a owl:Class ;
    rdfs:label "RelativeTargetSpeed"@en ;
    rdfs:comment "Defines a target speed relative to a reference entity's speed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:RelativeTargetSpeed.continuous ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:SpeedTargetValueType ;
            owl:onProperty osc:RelativeTargetSpeed.speedTargetValueType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeTargetSpeed.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeTargetSpeed.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a target speed relative to a reference entity's speed."@en .

osc:RoadNetwork a owl:Class ;
    rdfs:label "RoadNetwork"@en ;
    rdfs:comment "The road network which provides the base layer (and road-relative coordinate systems) for all scenario elements is defined as a reference to a road network file. This reference is optional; in case it is not specified, an infinite non-inclined plane on level z=0 shall be assumed as base layer. Additionally and optionally, a visual 3D model file can be referenced and any number of signals can be specified."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:File ;
            owl:onProperty osc:RoadNetwork.logicFile ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:UsedArea ;
            owl:onProperty osc:RoadNetwork.usedArea ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:File ;
            owl:onProperty osc:RoadNetwork.sceneGraphFile ] ;
    skos:definition "The road network which provides the base layer (and road-relative coordinate systems) for all scenario elements is defined as a reference to a road network file. This reference is optional; in case it is not specified, an infinite non-inclined plane on level z=0 shall be assumed as base layer. Additionally and optionally, a visual 3D model file can be referenced and any number of signals can be specified."@en .

osc:RoadPosition a owl:Class ;
    rdfs:label "RoadPosition"@en ;
    rdfs:comment """Position defined in terms of the road segment (roadId), the distance (s) along the road's reference line, and the lateral offset (t) to the road's reference line at that point. Orientation is optional.\r
\r
The s- and t-coordinates should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:RoadPosition.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RoadPosition.t ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RoadPosition.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:RoadPosition.orientation ] ;
    skos:definition """Position defined in terms of the road segment (roadId), the distance (s) along the road's reference line, and the lateral offset (t) to the road's reference line at that point. Orientation is optional.\r
\r
The s- and t-coordinates should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en .

osc:Role a rdfs:Datatype ;
    rdfs:label "Role"@en ;
    rdfs:comment """Roles for entity objects of type Vehicle or Pedestrian. The default role, if not specified, is None.\r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en ;
    owl:oneOf ( "none" "agriculture" "ambulance" "civil" "construction" "dangerousGoodsTransport" "fire" "fireBrigade" "freightTransport" "garbageCollection" "military" "other" "police" "publicTransport" "roadAssistance" "roadsideAssistance" "specialTransport" "trafficControl" ) ;
    skos:definition """Roles for entity objects of type Vehicle or Pedestrian. The default role, if not specified, is None.\r
The enum literals have been harmonized between ASAM OpenX standards. The latest details about the harmonization can be found under https://publications.pages.asam.net/standards/ASAM_TrafficParticipants_Specification/ASAM_TrafficParticipants_Specification/latest/specification/index.html."""@en .

osc:ScenarioObject a owl:Class ;
    rdfs:label "ScenarioObject"@en ;
    rdfs:comment "A scenario object represents a runtime object that is created from an EntityObject (vehicle type, pedestrian type, miscellaneous object type and external object reference type) and Controllers. Miscellaneous objects and external object references must not have controllers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:EntityObject ;
            owl:onProperty osc:ScenarioObject.entityObject ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ScenarioObject.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A scenario object represents a runtime object that is created from an EntityObject (vehicle type, pedestrian type, miscellaneous object type and external object reference type) and Controllers. Miscellaneous objects and external object references must not have controllers."@en .

osc:Shape a owl:Class ;
    rdfs:label "Shape"@en ;
    rdfs:comment "Shape for use in trajectories. Supported types: Polyline (line segments), Clothoid, Nurbs."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Clothoid ;
                                    owl:onProperty osc:Shape.clothoid ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.clothoidSpline ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.polyline ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.nurbs ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.clothoid ] [ a owl:Restriction ;
                                    owl:onClass osc:ClothoidSpline ;
                                    owl:onProperty osc:Shape.clothoidSpline ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.polyline ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.nurbs ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.clothoid ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.clothoidSpline ] [ a owl:Restriction ;
                                    owl:onClass osc:Polyline ;
                                    owl:onProperty osc:Shape.polyline ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.nurbs ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.clothoid ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.clothoidSpline ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Shape.polyline ] [ a owl:Restriction ;
                                    owl:onClass osc:Nurbs ;
                                    owl:onProperty osc:Shape.nurbs ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Shape for use in trajectories. Supported types: Polyline (line segments), Clothoid, Nurbs."@en .

osc:SpeedProfileAction a owl:Class ;
    rdfs:label "SpeedProfileAction"@en ;
    rdfs:comment "This action describes the change of speed in terms of a series of speed targets over time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:FollowingMode ;
            owl:onProperty osc:SpeedProfileAction.followingMode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:DynamicConstraints ;
            owl:onProperty osc:SpeedProfileAction.dynamicConstraints ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:SpeedProfileEntry ;
            owl:onProperty osc:SpeedProfileAction.speedProfileEntry ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:SpeedProfileAction.entityRef ] ;
    skos:definition "This action describes the change of speed in terms of a series of speed targets over time."@en .

osc:SteadyState a owl:Class ;
    rdfs:label "SteadyState"@en ;
    rdfs:comment "Final phase of constant (final) speed, start of which defined by distance or time."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:TargetDistanceSteadyState ;
                                    owl:onProperty osc:SteadyState.targetDistanceSteadyState ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:SteadyState.targetTimeSteadyState ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:SteadyState.targetDistanceSteadyState ] [ a owl:Restriction ;
                                    owl:onClass osc:TargetTimeSteadyState ;
                                    owl:onProperty osc:SteadyState.targetTimeSteadyState ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Final phase of constant (final) speed, start of which defined by distance or time."@en .

osc:Sun a owl:Class ;
    rdfs:label "Sun"@en ;
    rdfs:comment "Specification of sun properties."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Sun.illuminance ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Sun.intensity ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Sun.elevation ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Sun.azimuth ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Specification of sun properties."@en .

osc:TrafficAction.trafficAreaAction a owl:ObjectProperty ;
    rdfs:label "trafficAreaAction"@en ;
    rdfs:domain osc:TrafficAction ;
    rdfs:range osc:TrafficAreaAction .

osc:TrafficAction.trafficName a owl:DatatypeProperty ;
    rdfs:label "trafficName"@en ;
    rdfs:comment "Name of the traffic that is created. This name can be referenced when stopping the traffic with StopTrafficAction."@en ;
    rdfs:domain osc:TrafficAction ;
    rdfs:range xsd:string ;
    skos:definition "Name of the traffic that is created. This name can be referenced when stopping the traffic with StopTrafficAction."@en .

osc:TrafficAction.trafficSinkAction a owl:ObjectProperty ;
    rdfs:label "trafficSinkAction"@en ;
    rdfs:domain osc:TrafficAction ;
    rdfs:range osc:TrafficSinkAction .

osc:TrafficAction.trafficSourceAction a owl:ObjectProperty ;
    rdfs:label "trafficSourceAction"@en ;
    rdfs:domain osc:TrafficAction ;
    rdfs:range osc:TrafficSourceAction .

osc:TrafficAction.trafficStopAction a owl:ObjectProperty ;
    rdfs:label "trafficStopAction"@en ;
    rdfs:domain osc:TrafficAction ;
    rdfs:range osc:TrafficStopAction .

osc:TrafficAction.trafficSwarmAction a owl:ObjectProperty ;
    rdfs:label "trafficSwarmAction"@en ;
    rdfs:domain osc:TrafficAction ;
    rdfs:range osc:TrafficSwarmAction .

osc:TrafficAreaAction a owl:Class ;
    rdfs:label "TrafficAreaAction"@en ;
    rdfs:comment "Defines traffic in a specific area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedInt ;
            owl:onProperty osc:TrafficAreaAction.numberOfEntities ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:TrafficArea ;
            owl:onProperty osc:TrafficAreaAction.trafficArea ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:TrafficAreaAction.continuous ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:TrafficDistribution ;
            owl:onProperty osc:TrafficAreaAction.trafficDistribution ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines traffic in a specific area."@en .

osc:TrafficSinkAction a owl:Class ;
    rdfs:label "TrafficSinkAction"@en ;
    rdfs:comment "Defines a sink of traffic at a specific position."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSinkAction.rate ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSinkAction.radius ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:TrafficSinkAction.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDefinition ;
            owl:onProperty osc:TrafficSinkAction.trafficDefinition ] ;
    skos:definition "Defines a sink of traffic at a specific position."@en .

osc:TrajectoryPosition a owl:Class ;
    rdfs:label "TrajectoryPosition"@en ;
    rdfs:comment "Definition of a trajectory type in terms of shape and optional time domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrajectoryPosition.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:TrajectoryRef ;
            owl:onProperty osc:TrajectoryPosition.trajectoryRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:TrajectoryPosition.orientation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrajectoryPosition.t ] ;
    skos:definition "Definition of a trajectory type in terms of shape and optional time domain."@en .

osc:TrajectoryRef a owl:Class ;
    rdfs:label "TrajectoryRef"@en ;
    rdfs:comment "Defines a reference to a trajectory. Either an inline definition of a trajectory or a trajectory in a catalog."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:TrajectoryRef.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrajectoryRef.trajectory ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrajectoryRef.catalogReference ] [ a owl:Restriction ;
                                    owl:onClass osc:Trajectory ;
                                    owl:onProperty osc:TrajectoryRef.trajectory ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Defines a reference to a trajectory. Either an inline definition of a trajectory or a trajectory in a catalog."@en .

osc:UserDefinedDistribution a owl:Class ;
    rdfs:label "UserDefinedDistribution"@en ;
    rdfs:comment "Indicates a user defined distribution which can be deterministic or stochastic. This distribution contains a property with the name type and some user defined content."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedDistribution.type ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:UserDefinedDistribution.content ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Indicates a user defined distribution which can be deterministic or stochastic. This distribution contains a property with the name type and some user defined content."@en .

osc:VisibilityAction a owl:Class ;
    rdfs:label "VisibilityAction"@en ;
    rdfs:comment "Action that toggles (on or off) an entity's visibility attributes, with respect to sensors, other traffic or the graphics engine. The default for entities is that they are visible everywhere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:SensorReferenceSet ;
            owl:onProperty osc:VisibilityAction.sensorReferenceSet ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:VisibilityAction.sensors ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:VisibilityAction.traffic ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:VisibilityAction.graphics ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Action that toggles (on or off) an entity's visibility attributes, with respect to sensors, other traffic or the graphics engine. The default for entities is that they are visible everywhere."@en .

osc:AssignControllerAction.activateAnimation a owl:DatatypeProperty ;
    rdfs:label "activateAnimation"@en ;
    rdfs:comment "True: The assigned controller gets activated the animation domain. False: the assigned animation controller gets deactivated. If not specified: No change for controlling the animation domain is applied."@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "True: The assigned controller gets activated the animation domain. False: the assigned animation controller gets deactivated. If not specified: No change for controlling the animation domain is applied."@en .

osc:AssignControllerAction.activateLateral a owl:DatatypeProperty ;
    rdfs:label "activateLateral"@en ;
    rdfs:comment "True: The assigned controller gets activated for the lateral dimension. False: the assigned controller gets deactivated for the lateral dimension. If not specified: No change for controlling the lateral dimension is applied."@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "True: The assigned controller gets activated for the lateral dimension. False: the assigned controller gets deactivated for the lateral dimension. If not specified: No change for controlling the lateral dimension is applied."@en .

osc:AssignControllerAction.activateLighting a owl:DatatypeProperty ;
    rdfs:label "activateLighting"@en ;
    rdfs:comment "True: The assigned controller gets activated the lighting domain. False: the assigned lighting controller gets deactivated. If not specified: No change for controlling the lighting domain is applied."@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "True: The assigned controller gets activated the lighting domain. False: the assigned lighting controller gets deactivated. If not specified: No change for controlling the lighting domain is applied."@en .

osc:AssignControllerAction.activateLongitudinal a owl:DatatypeProperty ;
    rdfs:label "activateLongitudinal"@en ;
    rdfs:comment "True: The assigned controller gets activated for the longitudinal dimension. False: the assigned controller gets deactivated for the longitudinal dimension. If not specified: No change for controlling the longitudinal  dimension is applied."@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "True: The assigned controller gets activated for the longitudinal dimension. False: the assigned controller gets deactivated for the longitudinal dimension. If not specified: No change for controlling the longitudinal  dimension is applied."@en .

osc:AssignControllerAction.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range osc:CatalogReference .

osc:AssignControllerAction.controller a owl:ObjectProperty ;
    rdfs:label "controller"@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range osc:Controller .

osc:AssignControllerAction.objectController a owl:ObjectProperty ;
    rdfs:label "objectController"@en ;
    rdfs:domain osc:AssignControllerAction ;
    rdfs:range osc:ObjectController .

osc:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A condition represents a set of logical expressions that evaluate the relationship of values provided by the user. These values may be entity states, scenario properties, scenario states or external signals. Conditions are the main components in triggers."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onDataRange osc:ConditionEdge ;
                                    owl:onProperty osc:Condition.conditionEdge ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.delay ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byEntityCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byValueCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.conditionEdge ] [ a owl:Restriction ;
                                    owl:onDataRange xsd:double ;
                                    owl:onProperty osc:Condition.delay ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byEntityCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byValueCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.conditionEdge ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.delay ] [ a owl:Restriction ;
                                    owl:onDataRange xsd:string ;
                                    owl:onProperty osc:Condition.name ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byEntityCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byValueCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.conditionEdge ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.delay ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.name ] [ a owl:Restriction ;
                                    owl:onClass osc:ByEntityCondition ;
                                    owl:onProperty osc:Condition.byEntityCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byValueCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.conditionEdge ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.delay ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:Condition.byEntityCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:ByValueCondition ;
                                    owl:onProperty osc:Condition.byValueCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "A condition represents a set of logical expressions that evaluate the relationship of values provided by the user. These values may be entity states, scenario properties, scenario states or external signals. Conditions are the main components in triggers."@en .

osc:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "Container for Actions. Its priority settings determine how to interact with other events within the same scope (maneuver)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Action ;
            owl:onProperty osc:Event.actions ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Priority ;
            owl:onProperty osc:Event.priority ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Trigger ;
            owl:onProperty osc:Event.startTrigger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:unsignedInt ;
            owl:onProperty osc:Event.maximumExecutionCount ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Event.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Container for Actions. Its priority settings determine how to interact with other events within the same scope (maneuver)."@en .

osc:GlobalAction.entityAction a owl:ObjectProperty ;
    rdfs:label "entityAction"@en ;
    rdfs:domain osc:GlobalAction ;
    rdfs:range osc:EntityAction .

osc:GlobalAction.environmentAction a owl:ObjectProperty ;
    rdfs:label "environmentAction"@en ;
    rdfs:domain osc:GlobalAction ;
    rdfs:range osc:EnvironmentAction .

osc:GlobalAction.infrastructureAction a owl:ObjectProperty ;
    rdfs:label "infrastructureAction"@en ;
    rdfs:domain osc:GlobalAction ;
    rdfs:range osc:InfrastructureAction .

osc:GlobalAction.parameterAction a owl:ObjectProperty ;
    rdfs:label "parameterAction"@en ;
    rdfs:domain osc:GlobalAction ;
    rdfs:range osc:ParameterAction .

osc:GlobalAction.setMonitorAction a owl:ObjectProperty ;
    rdfs:label "setMonitorAction"@en ;
    rdfs:domain osc:GlobalAction ;
    rdfs:range osc:SetMonitorAction .

osc:GlobalAction.trafficAction a owl:ObjectProperty ;
    rdfs:label "trafficAction"@en ;
