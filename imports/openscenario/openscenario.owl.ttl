<http://code.asam.net/simulation/standard/openscenario> a owl:Ontology ;
    rdfs:label "OpenSCENARIO"@en ;
    rdfs:comment "The identifier of the license from the SPDX license list. Can also be an SPDX License Expression, which is also applicable to custom licenses (LicenseRef-...)."@en ;
