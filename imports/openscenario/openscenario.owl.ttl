osc:Weather.atmosphericPressure a owl:DatatypeProperty ;
    rdfs:label "atmosphericPressure"@en ;
    rdfs:comment "Reference atmospheric pressure at z=0.0 in world coordinate system. Unit: [Pa]. Range: [80000..120000]. The actual atmospheric pressure around the entities of the scenario has to be calculated depending on their z position. See also the Standard Atmosphere as defined in ISO2533."@en ;
    rdfs:domain osc:Weather ;
    rdfs:range xsd:double ;
    skos:definition "Reference atmospheric pressure at z=0.0 in world coordinate system. Unit: [Pa]. Range: [80000..120000]. The actual atmospheric pressure around the entities of the scenario has to be calculated depending on their z position. See also the Standard Atmosphere as defined in ISO2533."@en .

