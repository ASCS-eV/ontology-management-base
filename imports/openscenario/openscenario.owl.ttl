osc:TimeHeadwayCondition a owl:Class ;
    rdfs:label "TimeHeadwayCondition"@en ;
    rdfs:comment "Condition based on the headway time between a triggering entity and a reference entity. The reference entity is assumed to be leading/ahead, so the triggering entity is trailing. TimeHeadway is calculated similar to TimeToCollision (distance divided by relative speed, no acceleration) with the following exception: For the relative speed only the speed of the triggering entity is considered but not the speed of the reference entity. This is because it doesn't matter where the reference entity moves, only the time it takes for the triggering entity to reach the current position of the reference entity is calculated. The logical operator used for comparison is defined by the rule attribute. The property \"alongRoute\" is deprecated. If \"coordinateSystem\" or \"relativeDistanceType\" are set, \"alongRoute\" is ignored."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:TimeHeadwayCondition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:TimeHeadwayCondition.coordinateSystem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RoutingAlgorithm ;
            owl:onProperty osc:TimeHeadwayCondition.routingAlgorithm ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:TimeHeadwayCondition.freespace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TimeHeadwayCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:TimeHeadwayCondition.alongRoute ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RelativeDistanceType ;
            owl:onProperty osc:TimeHeadwayCondition.relativeDistanceType ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:TimeHeadwayCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Condition based on the headway time between a triggering entity and a reference entity. The reference entity is assumed to be leading/ahead, so the triggering entity is trailing. TimeHeadway is calculated similar to TimeToCollision (distance divided by relative speed, no acceleration) with the following exception: For the relative speed only the speed of the triggering entity is considered but not the speed of the reference entity. This is because it doesn't matter where the reference entity moves, only the time it takes for the triggering entity to reach the current position of the reference entity is calculated. The logical operator used for comparison is defined by the rule attribute. The property \"alongRoute\" is deprecated. If \"coordinateSystem\" or \"relativeDistanceType\" are set, \"alongRoute\" is ignored."@en .

osc:TimeToCollisionCondition a owl:Class ;
    rdfs:label "TimeToCollisionCondition"@en ;
    rdfs:comment "The currently predicted time to collision of a triggering entity/entities and either a reference entity or an explicit position is compared to a given time value. Time to collision is calculated as the distance divided by the relative speed. Acceleration of entities is not taken into consideration. For the relative speed calculation the same coordinate system and relative distance type applies as for the distance calculation. If the relative speed is negative, which means the entity is moving away from the position / the entities are moving away from each other, then the time to collision cannot be predicted and the condition evaluates to false. The logical operator for comparison is defined by the rule attribute. The property \"alongRoute\" is deprecated. If \"coordinateSystem\" or \"relativeDistanceType\" are set, \"alongRoute\" is ignored."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:TimeToCollisionCondition.freespace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:TimeToCollisionCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RoutingAlgorithm ;
            owl:onProperty osc:TimeToCollisionCondition.routingAlgorithm ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:TimeToCollisionCondition.coordinateSystem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RelativeDistanceType ;
            owl:onProperty osc:TimeToCollisionCondition.relativeDistanceType ],
        [ a owl:Restriction ;
            owl:onClass osc:TimeToCollisionConditionTarget ;
            owl:onProperty osc:TimeToCollisionCondition.timeToCollisionConditionTarget ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:TimeToCollisionCondition.alongRoute ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TimeToCollisionCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The currently predicted time to collision of a triggering entity/entities and either a reference entity or an explicit position is compared to a given time value. Time to collision is calculated as the distance divided by the relative speed. Acceleration of entities is not taken into consideration. For the relative speed calculation the same coordinate system and relative distance type applies as for the distance calculation. If the relative speed is negative, which means the entity is moving away from the position / the entities are moving away from each other, then the time to collision cannot be predicted and the condition evaluates to false. The logical operator for comparison is defined by the rule attribute. The property \"alongRoute\" is deprecated. If \"coordinateSystem\" or \"relativeDistanceType\" are set, \"alongRoute\" is ignored."@en .

osc:TrafficDefinition a owl:Class ;
    rdfs:label "TrafficDefinition"@en ;
    rdfs:comment "Definition of macroscopic traffic based on vehicle and controller definitions. "@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:ControllerDistribution ;
            owl:onProperty osc:TrafficDefinition.controllerDistribution ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficDefinition.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:VehicleRoleDistribution ;
            owl:onProperty osc:TrafficDefinition.vehicleRoleDistribution ],
        [ a owl:Restriction ;
            owl:onClass osc:VehicleCategoryDistribution ;
            owl:onProperty osc:TrafficDefinition.vehicleCategoryDistribution ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of macroscopic traffic based on vehicle and controller definitions."@en .

osc:CatalogLocations a owl:Class ;
    rdfs:label "CatalogLocations"@en ;
    rdfs:comment "Set of catalogs which are referenced in a scenario."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:EnvironmentCatalogLocation ;
            owl:onProperty osc:CatalogLocations.environmentCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:VehicleCatalogLocation ;
            owl:onProperty osc:CatalogLocations.vehicleCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrajectoryCatalogLocation ;
            owl:onProperty osc:CatalogLocations.trajectoryCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:RouteCatalogLocation ;
            owl:onProperty osc:CatalogLocations.routeCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:MiscObjectCatalogLocation ;
            owl:onProperty osc:CatalogLocations.miscObjectCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:PedestrianCatalogLocation ;
            owl:onProperty osc:CatalogLocations.pedestrianCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ControllerCatalogLocation ;
            owl:onProperty osc:CatalogLocations.controllerCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ManeuverCatalogLocation ;
            owl:onProperty osc:CatalogLocations.maneuverCatalog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDistributionEntryCatalogLocation ;
            owl:onProperty osc:CatalogLocations.trafficDistributionEntryCatalog ] ;
    skos:definition "Set of catalogs which are referenced in a scenario."@en .

osc:Clothoid a owl:Class ;
    rdfs:label "Clothoid"@en ;
    rdfs:comment "A shape of the trajectory of an entity. A clothoid is a curve whose curvature changes linearly with its curve length. If curvaturePrime is 0, then the resulting trajectory is a circular arc. If curvaturePrime is 0 and additionally curvature is 0, then the resulting trajectory is a line."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Motion ;
            owl:onProperty osc:Clothoid.motionEnd ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Motion ;
            owl:onProperty osc:Clothoid.motionStart ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Clothoid.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Clothoid.curvatureDot ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Clothoid.stopTime ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Clothoid.curvature ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Clothoid.startTime ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:Clothoid.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Clothoid.curvaturePrime ] ;
    skos:definition "A shape of the trajectory of an entity. A clothoid is a curve whose curvature changes linearly with its curve length. If curvaturePrime is 0, then the resulting trajectory is a circular arc. If curvaturePrime is 0 and additionally curvature is 0, then the resulting trajectory is a line."@en .

osc:DynamicConstraints a owl:Class ;
    rdfs:label "DynamicConstraints"@en ;
    rdfs:comment "Constraints that are limiting the acceleration, the deceleration and the speed. Used in lateral or longitudinal actions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DynamicConstraints.maxSpeed ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DynamicConstraints.maxDeceleration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DynamicConstraints.maxAcceleration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DynamicConstraints.maxAccelerationRate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DynamicConstraints.maxDecelerationRate ] ;
    skos:definition "Constraints that are limiting the acceleration, the deceleration and the speed. Used in lateral or longitudinal actions."@en .

osc:Weather a owl:Class ;
    rdfs:label "Weather"@en ;
    rdfs:comment "Defines the weather conditions in terms of light, fog, precipitation, cloud, temperature and atmospheric pressure states. If one of the conditions is missing it means that it doesn't change."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:FractionalCloudCover ;
            owl:onProperty osc:Weather.fractionalCloudCover ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:DomeImage ;
            owl:onProperty osc:Weather.domeImage ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Weather.atmosphericPressure ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Sun ;
            owl:onProperty osc:Weather.sun ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Precipitation ;
            owl:onProperty osc:Weather.precipitation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Weather.temperature ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Fog ;
            owl:onProperty osc:Weather.fog ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Wind ;
            owl:onProperty osc:Weather.wind ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CloudState ;
            owl:onProperty osc:Weather.cloudState ] ;
    skos:definition "Defines the weather conditions in terms of light, fog, precipitation, cloud, temperature and atmospheric pressure states. If one of the conditions is missing it means that it doesn't change."@en .

osc:Catalog a owl:Class ;
    rdfs:label "Catalog"@en ;
    rdfs:comment "A catalog may be used to make certain OpenSCENARIO elements reusable. In a catalog parameterizable types are maintained and can be referenced to create runtime instances of those types."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Catalog.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A catalog may be used to make certain OpenSCENARIO elements reusable. In a catalog parameterizable types are maintained and can be referenced to create runtime instances of those types."@en .

osc:File a owl:Class ;
    rdfs:label "File"@en ;
    rdfs:comment "File on the file system, including its file path."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:File.filepath ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "File on the file system, including its file path."@en .

osc:Motion a owl:Class ;
    rdfs:label "Motion"@en ;
    rdfs:comment """Specifies motion information at a given point in space and, if defined, time, for example: speed and acceleration.\r
May not be empty. At least one of its attributes shall be provided."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Motion.acceleration_longitudinal ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Motion.speed_longitudinal ] ;
    skos:definition """Specifies motion information at a given point in space and, if defined, time, for example: speed and acceleration.\r
May not be empty. At least one of its attributes shall be provided."""@en .

osc:Pedestrian a owl:Class ;
    rdfs:label "Pedestrian"@en ;
    rdfs:comment "Definition of a pedestrian type in a scenario or in a catalog."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Pedestrian.model ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:Pedestrian.properties ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:Role ;
            owl:onProperty osc:Pedestrian.role ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Pedestrian.mass ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Pedestrian.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:PedestrianCategory ;
            owl:onProperty osc:Pedestrian.pedestrianCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Pedestrian.model3d ],
        [ a owl:Restriction ;
            owl:onClass osc:BoundingBox ;
            owl:onProperty osc:Pedestrian.boundingBox ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of a pedestrian type in a scenario or in a catalog."@en .

osc:Controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "Defines a controller type and parameters for the controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:Controller.properties ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:ControllerType ;
            owl:onProperty osc:Controller.controllerType ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Controller.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a controller type and parameters for the controller."@en .

osc:EntityRef a owl:Class ;
    rdfs:label "EntityRef"@en ;
    rdfs:comment "Unambiguous reference to an entity represented as its name."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:EntityRef.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Unambiguous reference to an entity represented as its name."@en .

osc:TrafficSwarmAction a owl:Class ;
    rdfs:label "TrafficSwarmAction"@en ;
    rdfs:comment "Defines swarm traffic within an elliptical planview around a given central entity. The innerRadius defines the minimum distance between the central vehicle and swarm traffic. The latter is set up in the free space between the circular area defined by innerRadius and the outline of the ellipsis defined by the two semi axis attributes. While vehicles are created in this area, they are removed if they leave it crossing the it ellipsis’ outline. Within the innerRadius, vehicles are neither set up nor removed. Optionally, the swarm area can be longitudinally offset to the central scenario object."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDistribution ;
            owl:onProperty osc:TrafficSwarmAction.trafficDistribution ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSwarmAction.velocity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:DirectionOfTravelDistribution ;
            owl:onProperty osc:TrafficSwarmAction.directionOfTravelDistribution ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSwarmAction.semiMinorAxis ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:CentralSwarmObject ;
            owl:onProperty osc:TrafficSwarmAction.centralObject ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSwarmAction.semiMajorAxis ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSwarmAction.innerRadius ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedInt ;
            owl:onProperty osc:TrafficSwarmAction.numberOfVehicles ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDefinition ;
            owl:onProperty osc:TrafficSwarmAction.trafficDefinition ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Range ;
            owl:onProperty osc:TrafficSwarmAction.initialSpeedRange ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSwarmAction.offset ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines swarm traffic within an elliptical planview around a given central entity. The innerRadius defines the minimum distance between the central vehicle and swarm traffic. The latter is set up in the free space between the circular area defined by innerRadius and the outline of the ellipsis defined by the two semi axis attributes. While vehicles are created in this area, they are removed if they leave it crossing the it ellipsis’ outline. Within the innerRadius, vehicles are neither set up nor removed. Optionally, the swarm area can be longitudinally offset to the central scenario object."@en .

osc:PrivateAction a owl:Class ;
    rdfs:label "PrivateAction"@en ;
    rdfs:comment "Actions applied to one or multiple entities. Either the entities are referenced in the actors of the enclosing maneuver group or the single entity is referenced in the enclosing Private instance."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:ControllerAction ;
                                    owl:onProperty osc:PrivateAction.controllerAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.activateControllerAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.appearanceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.longitudinalAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.lateralAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.teleportAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.visibilityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.routingAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.synchronizeAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.trailerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.controllerAction ] [ a owl:Restriction ;
                                    owl:onClass osc:ActivateControllerAction ;
                                    owl:onProperty osc:PrivateAction.activateControllerAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.appearanceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.longitudinalAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.lateralAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.teleportAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.visibilityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.routingAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.synchronizeAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.trailerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.controllerAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.activateControllerAction ] [ a owl:Restriction ;
                                    owl:onClass osc:AppearanceAction ;
                                    owl:onProperty osc:PrivateAction.appearanceAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.longitudinalAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.lateralAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.teleportAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.visibilityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.routingAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.synchronizeAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.trailerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.controllerAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.activateControllerAction ] [ a owl:Restriction ;
