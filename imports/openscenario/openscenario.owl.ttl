osc:ConditionGroup a owl:Class ;
    rdfs:label "ConditionGroup"@en ;
    rdfs:comment "A condition group is an association of conditions that is assessed during simulation time and signals true when all associated conditions are evaluated to true."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Condition ;
            owl:onProperty osc:ConditionGroup.conditions ] ;
    skos:definition "A condition group is an association of conditions that is assessed during simulation time and signals true when all associated conditions are evaluated to true."@en .

osc:ControllerType a rdfs:Datatype ;
