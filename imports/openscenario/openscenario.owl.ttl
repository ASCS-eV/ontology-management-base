osc:RelativeClearanceCondition.distanceBackward a owl:DatatypeProperty ;
    rdfs:label "distanceBackward"@en ;
    rdfs:comment "Longitudinal distance behind reference point of the entity to be checked along lane centerline of the current lane of the triggering entity. Orientation of entity towards lane determines backward direction. Velocity of entity is irrelevant. Unit: [m]. Range: [0..inf[. Default if omitted: 0"@en ;
    rdfs:domain osc:RelativeClearanceCondition ;
    rdfs:range xsd:double ;
    skos:definition "Longitudinal distance behind reference point of the entity to be checked along lane centerline of the current lane of the triggering entity. Orientation of entity towards lane determines backward direction. Velocity of entity is irrelevant. Unit: [m]. Range: [0..inf[. Default if omitted: 0"@en .

osc:RelativeClearanceCondition.distanceForward a owl:DatatypeProperty ;
    rdfs:label "distanceForward"@en ;
    rdfs:comment "Longitudinal distance in front of reference point of the entity to be checked along lane centerline of the current lane of the triggering entity. Orientation of entity towards lane determines forward direction. Velocity of entity is irrelevant. Unit: [m]. Range: [0..inf[. Default if omitted: 0"@en ;
    rdfs:domain osc:RelativeClearanceCondition ;
    rdfs:range xsd:double ;
    skos:definition "Longitudinal distance in front of reference point of the entity to be checked along lane centerline of the current lane of the triggering entity. Orientation of entity towards lane determines forward direction. Velocity of entity is irrelevant. Unit: [m]. Range: [0..inf[. Default if omitted: 0"@en .

osc:RelativeClearanceCondition.freeSpace a owl:DatatypeProperty ;
    rdfs:label "freeSpace"@en ;
    rdfs:comment "If false, then entityRefs are only considered to be on the lane if their reference point is within the checked area; otherwise the whole bounding box is considered."@en ;
    rdfs:domain osc:RelativeClearanceCondition ;
    rdfs:range xsd:boolean ;
    skos:definition "If false, then entityRefs are only considered to be on the lane if their reference point is within the checked area; otherwise the whole bounding box is considered."@en .

