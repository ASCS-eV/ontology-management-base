    owl:oneOf ( "lateral" "longitudinal" "lighting" "animation" "movement" "appearance" "all" ) ;
    skos:definition "Type of operational domains for a Controller"@en .

osc:CustomContent a owl:Class ;
    rdfs:label "CustomContent"@en ;
    rdfs:comment "The semantic is subject of a contract between the provider of a simulation environment and the author of a scenario."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:CustomContent.content ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The semantic is subject of a contract between the provider of a simulation environment and the author of a scenario."@en .

