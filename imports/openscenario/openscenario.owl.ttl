osc:TrafficSignalController.delay a owl:DatatypeProperty ;
    rdfs:label "delay"@en ;
    rdfs:comment "The delay to the controller in the reference property. A controller having a delay to another one means that its first phase virtually starts delaytime seconds after the start of the reference's first phase. This can be used to define a progressive signal system, but only makes sense, if the total times of all connected controllers are the same. If delay is set, reference is required. Unit: [s]. Range: [0..inf[. "@en ;
    rdfs:domain osc:TrafficSignalController ;
    rdfs:range xsd:double ;
    skos:definition "The delay to the controller in the reference property. A controller having a delay to another one means that its first phase virtually starts delaytime seconds after the start of the reference's first phase. This can be used to define a progressive signal system, but only makes sense, if the total times of all connected controllers are the same. If delay is set, reference is required. Unit: [s]. Range: [0..inf[."@en .

osc:TrafficSignalController.name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "ID of the TrafficSignalController for reference within the scenario and the reference to an OpenDRIVE signal group ID."@en ;
    rdfs:domain osc:TrafficSignalController ;
    rdfs:range xsd:string ;
    skos:definition "ID of the TrafficSignalController for reference within the scenario and the reference to an OpenDRIVE signal group ID."@en .

osc:TrafficSignalController.reference a owl:DatatypeProperty ;
    rdfs:label "reference"@en ;
    rdfs:comment "A name of another TrafficSignalController to reference. If this reference is set, specifying the delay is required."@en ;
    rdfs:domain osc:TrafficSignalController ;
    rdfs:range xsd:string ;
    skos:definition "A name of another TrafficSignalController to reference. If this reference is set, specifying the delay is required."@en .

osc:TrafficSignalControllerAction.phase a owl:DatatypeProperty ;
    rdfs:label "phase"@en ;
    rdfs:comment "Name of the targeted phase of the signal controller."@en ;
    rdfs:domain osc:TrafficSignalControllerAction ;
    rdfs:range xsd:string ;
    skos:definition "Name of the targeted phase of the signal controller."@en .

osc:TrafficSignalControllerAction.trafficSignalControllerRef a owl:ObjectProperty ;
