                                    owl:onProperty osc:PrivateAction.synchronizeAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrailerAction ;
                                    owl:onProperty osc:PrivateAction.trailerAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Actions applied to one or multiple entities. Either the entities are referenced in the actors of the enclosing maneuver group or the single entity is referenced in the enclosing Private instance."@en .

osc:CoordinateSystem a rdfs:Datatype ;
    rdfs:label "CoordinateSystem"@en ;
    rdfs:comment "Definition of the coordinate system to be used for calculations. If used in a condition, then the coordinate system relates to the triggering entity. If used in an action, the coordinate system relates to the actor."@en ;
    owl:oneOf ( "entity" "lane" "road" "trajectory" "world" ) ;
    skos:definition "Definition of the coordinate system to be used for calculations. If used in a condition, then the coordinate system relates to the triggering entity. If used in an action, the coordinate system relates to the actor."@en .

