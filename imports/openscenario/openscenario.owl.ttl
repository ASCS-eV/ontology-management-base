osc:FollowTrajectoryAction.catalogReference a owl:ObjectProperty ;
    rdfs:label "catalogReference"@en ;
    rdfs:domain osc:FollowTrajectoryAction ;
    rdfs:range osc:CatalogReference .

osc:FollowTrajectoryAction.initialDistanceOffset a owl:DatatypeProperty ;
    rdfs:label "initialDistanceOffset"@en ;
    rdfs:comment "An offset into the trajectory.  This has the effect of logically truncating the trajectory, so the resulting new trajectory starts at that distance offset.  Where a timing TimeReference fields is provided, the time that would be taken to reach this point is deducted from all calculated waypoint time values.  Unit: [m]. Range: [0..arclength of the trajectory]."@en ;
    rdfs:domain osc:FollowTrajectoryAction ;
    rdfs:range xsd:double ;
    skos:definition "An offset into the trajectory.  This has the effect of logically truncating the trajectory, so the resulting new trajectory starts at that distance offset.  Where a timing TimeReference fields is provided, the time that would be taken to reach this point is deducted from all calculated waypoint time values.  Unit: [m]. Range: [0..arclength of the trajectory]."@en .

osc:FollowTrajectoryAction.timeReference a owl:ObjectProperty ;
    rdfs:label "timeReference"@en ;
    rdfs:domain osc:FollowTrajectoryAction ;
    rdfs:range osc:TimeReference .

osc:FollowTrajectoryAction.trajectory a owl:ObjectProperty ;
    rdfs:label "trajectory"@en ;
    rdfs:domain osc:FollowTrajectoryAction ;
    rdfs:range osc:Trajectory .

osc:FollowTrajectoryAction.trajectoryFollowingMode a owl:ObjectProperty ;
    rdfs:label "trajectoryFollowingMode"@en ;
    rdfs:domain osc:FollowTrajectoryAction ;
    rdfs:range osc:TrajectoryFollowingMode .

osc:FollowTrajectoryAction.trajectoryRef a owl:ObjectProperty ;
    rdfs:label "trajectoryRef"@en ;
    rdfs:domain osc:FollowTrajectoryAction ;
    rdfs:range osc:TrajectoryRef .

osc:GeoPosition.altitude a owl:DatatypeProperty ;
    rdfs:label "altitude"@en ;
    rdfs:comment "Altitude is the Earth gravity-related vertical distance along the z-axis above the road surface, specified horizontally by its Longitude/Latitude coordinates and vertically by the verticalRoadSelection attribute. When calculating the road surface, it is accounted for an elevation of the road, an entire road super-elevation, or, in more complex cases, a road lateral shape profile that are specified in the road network definition (external to the OpenSCENARIO). Missing value is interpreted as altitude=0. Unit: [m]. Range: [0..inf[."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:double ;
    skos:definition "Altitude is the Earth gravity-related vertical distance along the z-axis above the road surface, specified horizontally by its Longitude/Latitude coordinates and vertically by the verticalRoadSelection attribute. When calculating the road surface, it is accounted for an elevation of the road, an entire road super-elevation, or, in more complex cases, a road lateral shape profile that are specified in the road network definition (external to the OpenSCENARIO). Missing value is interpreted as altitude=0. Unit: [m]. Range: [0..inf[."@en .

osc:GeoPosition.height a owl:DatatypeProperty ;
    rdfs:label "height"@en ;
    rdfs:comment "Height above a reference surface (e.g. sea level, earth surface). Unit: [m]. If the value is omitted, height is interpreted as 0."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:double ;
    skos:definition "Height above a reference surface (e.g. sea level, earth surface). Unit: [m]. If the value is omitted, height is interpreted as 0."@en .

osc:GeoPosition.latitude a owl:DatatypeProperty ;
    rdfs:label "latitude"@en ;
    rdfs:comment "The latitude  of a point on earth's surface is the angle between the equatorial plane and the straight line that passes through that point and through the center of the earth. Unit: [rad]. Range: [-PI..PI]."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:double ;
    skos:definition "The latitude  of a point on earth's surface is the angle between the equatorial plane and the straight line that passes through that point and through the center of the earth. Unit: [rad]. Range: [-PI..PI]."@en .

osc:GeoPosition.latitudeDeg a owl:DatatypeProperty ;
    rdfs:label "latitudeDeg"@en ;
    rdfs:comment "The latitude of a point on earth's surface is the angle between the equatorial plane and the straight line that passes through that point and through the center of the earth. Unit: [°]. Range: [-90..90]. Missing value is interpreted as 0."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:double ;
    skos:definition "The latitude of a point on earth's surface is the angle between the equatorial plane and the straight line that passes through that point and through the center of the earth. Unit: [°]. Range: [-90..90]. Missing value is interpreted as 0."@en .

osc:GeoPosition.longitude a owl:DatatypeProperty ;
    rdfs:label "longitude"@en ;
    rdfs:comment "The longitude of a point on earth's surface is the angle east or west of a reference meridian to another meridian that passes through that point. Unit: [rad]. Range: [-PI/2..PI/2]."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:double ;
    skos:definition "The longitude of a point on earth's surface is the angle east or west of a reference meridian to another meridian that passes through that point. Unit: [rad]. Range: [-PI/2..PI/2]."@en .

osc:GeoPosition.longitudeDeg a owl:DatatypeProperty ;
    rdfs:label "longitudeDeg"@en ;
    rdfs:comment "The longitude of a point on earth's surface is the angle east or west of a reference meridian to another meridian that passes through that point. Unit: [°]. Range: [-180..180]. Missing value is interpreted as 0."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:double ;
    skos:definition "The longitude of a point on earth's surface is the angle east or west of a reference meridian to another meridian that passes through that point. Unit: [°]. Range: [-180..180]. Missing value is interpreted as 0."@en .

osc:GeoPosition.orientation a owl:ObjectProperty ;
    rdfs:label "orientation"@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range osc:Orientation .

osc:GeoPosition.verticalRoadSelection a owl:DatatypeProperty ;
    rdfs:label "verticalRoadSelection"@en ;
    rdfs:comment "Selection of a road for determining the correct z-value of the position if multiple roads are located at the specified lat/lon coordinate. Value 0 is interpreted as the top-most road. The value decreases by one for every road below. If several roads are located on the same z-value (e.g. junctions), they are treated interchangeably with the same value (e.g. junction at top with two roads = value 0, next road below has value -1). Default if omitted: 0. Range: ]-inf, 0]."@en ;
    rdfs:domain osc:GeoPosition ;
    rdfs:range xsd:int ;
    skos:definition "Selection of a road for determining the correct z-value of the position if multiple roads are located at the specified lat/lon coordinate. Value 0 is interpreted as the top-most road. The value decreases by one for every road below. If several roads are located on the same z-value (e.g. junctions), they are treated interchangeably with the same value (e.g. junction at top with two roads = value 0, next road below has value -1). Default if omitted: 0. Range: ]-inf, 0]."@en .

osc:Histogram.bins a owl:ObjectProperty ;
    rdfs:label "bins"@en ;
    rdfs:domain osc:Histogram ;
    rdfs:range osc:HistogramBin .

osc:HistogramBin.range a owl:ObjectProperty ;
    rdfs:label "range"@en ;
    rdfs:domain osc:HistogramBin ;
    rdfs:range osc:Range .

osc:HistogramBin.weight a owl:DatatypeProperty ;
    rdfs:label "weight"@en ;
    rdfs:comment "This is used to define a probability for a value to end up in a specific interval represented by range. Instead of a probability a defined count or weight has to be defined. The probability can be calculated by the (1/sum(all weights from histogram bins)) * weight."@en ;
    rdfs:domain osc:HistogramBin ;
    rdfs:range xsd:double ;
    skos:definition "This is used to define a probability for a value to end up in a specific interval represented by range. Instead of a probability a defined count or weight has to be defined. The probability can be calculated by the (1/sum(all weights from histogram bins)) * weight."@en .

