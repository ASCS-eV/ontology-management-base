    rdfs:comment "Name of the referenced TrafficSignalController."@en ;
    rdfs:domain osc:TrafficSignalControllerAction ;
    rdfs:range osc:TrafficSignalController ;
    skos:definition "Name of the referenced TrafficSignalController."@en .

osc:TrafficSignalControllerCondition.phase a owl:DatatypeProperty ;
    rdfs:label "phase"@en ;
