    rdfs:label "state"@en ;
    rdfs:comment "Observable state of the signal, e.g. \"off;off;on\". The number of values in the state depends on the traffic signal in the roadnetwork , e.g. type and subtype in OpenDRIVE"@en ;
    rdfs:domain osc:TrafficSignalState ;
    rdfs:range xsd:string ;
    skos:definition "Observable state of the signal, e.g. \"off;off;on\". The number of values in the state depends on the traffic signal in the roadnetwork , e.g. type and subtype in OpenDRIVE"@en .

