    skos:definition "Offset in longitudinal direction related to the x-axis of the central entity. Unit: [m]."@en .

osc:TrafficSwarmAction.semiMajorAxis a owl:DatatypeProperty ;
    rdfs:label "semiMajorAxis"@en ;
    rdfs:comment "Shape of the swarm traffic distribution area is given as an ellipsis around a central entity. SemiMajorAxis defines the half length of the major axis of this ellipsis. Unit: [m]. Range: [0..inf[."@en ;
    rdfs:domain osc:TrafficSwarmAction ;
    rdfs:range xsd:double ;
    skos:definition "Shape of the swarm traffic distribution area is given as an ellipsis around a central entity. SemiMajorAxis defines the half length of the major axis of this ellipsis. Unit: [m]. Range: [0..inf[."@en .

