                                    owl:onClass osc:SynchronizeAction ;
                                    owl:onProperty osc:PrivateAction.synchronizeAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.trailerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.controllerAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.activateControllerAction ] [ a owl:Restriction ;
