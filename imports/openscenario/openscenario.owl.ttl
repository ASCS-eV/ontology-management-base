osc:Directory a owl:Class ;
    rdfs:label "Directory"@en ;
    rdfs:comment "Specifies the path to a directory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Directory.path ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Specifies the path to a directory."@en .

osc:ParameterDeclaration a owl:Class ;
    rdfs:label "ParameterDeclaration"@en ;
    rdfs:comment """Declaration of a typed parameter with a name and a default value. It is used for creating variations of the same scenario by using the ParameterValueDistributionDefinition in an additional file.\r
There are two options for applying ParameterValueDistributions:\r
\r
* Pre-startup: Copy the scenario file and change/override the default value\r
* On startup: Keep the scenario file but on startup of the OSC Director inject parameter values e.g. through the command line.\r
\r
The value of a parameter cannot change after startup during runtime."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ParameterDeclaration.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:ParameterType ;
            owl:onProperty osc:ParameterDeclaration.parameterType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ParameterDeclaration.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Declaration of a typed parameter with a name and a default value. It is used for creating variations of the same scenario by using the ParameterValueDistributionDefinition in an additional file.\r
There are two options for applying ParameterValueDistributions:\r
\r
* Pre-startup: Copy the scenario file and change/override the default value\r
* On startup: Keep the scenario file but on startup of the OSC Director inject parameter values e.g. through the command line.\r
\r
The value of a parameter cannot change after startup during runtime."""@en .

osc:Orientation a owl:Class ;
    rdfs:label "Orientation"@en ;
    rdfs:comment """Orientation is defined in terms of the Heading/Pitch/Roll orientation angles in the Cartesian coordinate system and considered in the absolute or relative reference context.\r
The absolute reference context refers to the orientation with respect to the World coordinate system.\r
If more than one orientation angle are specified at the same time, rotations are applied in the order: about Z-axis (Heading), then Y-axis (Pitch), then X-axis (Roll), assumed the positive rotation to be counter-clockwise. Heading=Pitch=Roll=0 means the orientation is aligned with coordinate axes (no rotation).\r
The relative reference context refers to the orientation with respect to a reference coordinate system. In the case of referencing to the road- or lane coordinate system, Pitch and Roll angles are determined by a surface tilt of an underlying road and therefore cannot be meaningfully interpreted within the OpenSCENARIO standard. As well, the Heading=0 means the Heading is aligned with the direction of the reference lane or road s-axis. In other cases, Heading=Pitch=Roll=0 means the orientation is identical to the reference orientation."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:ReferenceContext ;
            owl:onProperty osc:Orientation.type ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Orientation.p ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Orientation.h ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Orientation.r ] ;
    skos:definition """Orientation is defined in terms of the Heading/Pitch/Roll orientation angles in the Cartesian coordinate system and considered in the absolute or relative reference context.\r
The absolute reference context refers to the orientation with respect to the World coordinate system.\r
If more than one orientation angle are specified at the same time, rotations are applied in the order: about Z-axis (Heading), then Y-axis (Pitch), then X-axis (Roll), assumed the positive rotation to be counter-clockwise. Heading=Pitch=Roll=0 means the orientation is aligned with coordinate axes (no rotation).\r
The relative reference context refers to the orientation with respect to a reference coordinate system. In the case of referencing to the road- or lane coordinate system, Pitch and Roll angles are determined by a surface tilt of an underlying road and therefore cannot be meaningfully interpreted within the OpenSCENARIO standard. As well, the Heading=0 means the Heading is aligned with the direction of the reference lane or road s-axis. In other cases, Heading=Pitch=Roll=0 means the orientation is identical to the reference orientation."""@en .

osc:CatalogReference a owl:Class ;
    rdfs:label "CatalogReference"@en ;
    rdfs:comment "A reference to type in a catalog. It is used when importing the type in a scenario. Furthermore, it hands over additional parameter values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:CatalogReference.entryName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:CatalogReference.catalogName ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:CatalogElement ;
            owl:onProperty osc:CatalogReference.ref ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A reference to type in a catalog. It is used when importing the type in a scenario. Furthermore, it hands over additional parameter values."@en .

osc:Rule a rdfs:Datatype ;
    rdfs:label "Rule"@en ;
    rdfs:comment "Rules (operators) used to compare quantitative variables or signals."@en ;
    owl:oneOf ( "equalTo" "greaterThan" "lessThan" "greaterOrEqual" "lessOrEqual" "notEqualTo" ) ;
    skos:definition "Rules (operators) used to compare quantitative variables or signals."@en .

osc:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    rdfs:comment "Instances of the types ScenarioObject, ScenarioObjectTemplate, EntitySelection and SpawnedObject are considered to be instances of type Entity. Or less formal: scenario objects and entity selections are both entities. An entity is either a scenario object or an entity selection."@en ;
    skos:definition "Instances of the types ScenarioObject, ScenarioObjectTemplate, EntitySelection and SpawnedObject are considered to be instances of type Entity. Or less formal: scenario objects and entity selections are both entities. An entity is either a scenario object or an entity selection."@en .

