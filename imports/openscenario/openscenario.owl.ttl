    rdfs:label "freespace"@en ;
    rdfs:comment "True: distance is measured between closest bounding box points. False: reference point distance is used."@en ;
    rdfs:domain osc:RelativeDistanceCondition ;
    rdfs:range xsd:boolean ;
    skos:definition "True: distance is measured between closest bounding box points. False: reference point distance is used."@en .

osc:RelativeDistanceCondition.relativeDistanceType a owl:DatatypeProperty ;
    rdfs:label "relativeDistanceType"@en ;
    rdfs:comment "Definition of the coordinate system dimension(s) to be used for calculating distances."@en ;
    rdfs:domain osc:RelativeDistanceCondition ;
    rdfs:range osc:RelativeDistanceType ;
    skos:definition "Definition of the coordinate system dimension(s) to be used for calculating distances."@en .

osc:RelativeDistanceCondition.routingAlgorithm a owl:DatatypeProperty ;
    rdfs:label "routingAlgorithm"@en ;
    rdfs:comment "Algorithm for path selection/calculation between two positions across roads. Only relevant, if CoordinateSystem is \"road\"/\"lane\". Default value if omitted: \"undefined\"."@en ;
    rdfs:domain osc:RelativeDistanceCondition ;
    rdfs:range osc:RoutingAlgorithm ;
    skos:definition "Algorithm for path selection/calculation between two positions across roads. Only relevant, if CoordinateSystem is \"road\"/\"lane\". Default value if omitted: \"undefined\"."@en .

osc:RelativeDistanceCondition.rule a owl:DatatypeProperty ;
    rdfs:label "rule"@en ;
    rdfs:comment "The operator (less, greater, equal)."@en ;
    rdfs:domain osc:RelativeDistanceCondition ;
