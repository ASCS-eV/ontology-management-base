                                    owl:onProperty osc:PrivateAction.longitudinalAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:PrivateAction.lateralAction ] [ a owl:Restriction ;
