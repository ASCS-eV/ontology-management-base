osc:RelativeLanePosition.offset a owl:DatatypeProperty ;
    rdfs:label "offset"@en ;
    rdfs:comment "The lateral offset to the center line of the target lane (along the t-axis of the target lane center line). Missing value is interpreted as 0. The positive value means the offset is applied in the direction of the t-axis being imagined at the target s-position. Unit: [m]."@en ;
    rdfs:domain osc:RelativeLanePosition ;
    rdfs:range xsd:double ;
    skos:definition "The lateral offset to the center line of the target lane (along the t-axis of the target lane center line). Missing value is interpreted as 0. The positive value means the offset is applied in the direction of the t-axis being imagined at the target s-position. Unit: [m]."@en .

osc:RelativeLanePosition.orientation a owl:ObjectProperty ;
