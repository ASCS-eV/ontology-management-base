    rdfs:domain osc:WorldPosition ;
    rdfs:range xsd:double ;
    skos:definition "The y coordinate value. Missing value is interpreted as 0. Unit: [m]."@en .

osc:WorldPosition.z a owl:DatatypeProperty ;
