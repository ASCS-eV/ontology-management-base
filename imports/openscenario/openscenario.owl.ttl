    rdfs:label "stopTrigger"@en ;
    rdfs:domain osc:Act ;
    rdfs:range osc:Trigger .

osc:ActivateControllerAction.animation a owl:DatatypeProperty ;
    rdfs:label "animation"@en ;
    rdfs:comment "In animation domain: Activate or deactivate an animation. If not specified: No change for controlling the animation domain is applied."@en ;
    rdfs:domain osc:ActivateControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "In animation domain: Activate or deactivate an animation. If not specified: No change for controlling the animation domain is applied."@en .

osc:ActivateControllerAction.controllerRef a owl:ObjectProperty ;
    rdfs:label "controllerRef"@en ;
    rdfs:comment "Reference to a controller assigned to the entity."@en ;
    rdfs:domain osc:ActivateControllerAction ;
    rdfs:range osc:Controller ;
    skos:definition "Reference to a controller assigned to the entity."@en .

osc:ActivateControllerAction.lateral a owl:DatatypeProperty ;
    rdfs:label "lateral"@en ;
    rdfs:comment "In lateral domain: Activate or deactivate controller defined (e.g. automated, autonomous) behavior. If not specified: No change for controlling the lateral domain is applied."@en ;
    rdfs:domain osc:ActivateControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "In lateral domain: Activate or deactivate controller defined (e.g. automated, autonomous) behavior. If not specified: No change for controlling the lateral domain is applied."@en .

osc:ActivateControllerAction.lighting a owl:DatatypeProperty ;
    rdfs:label "lighting"@en ;
    rdfs:comment "In lighting domain: Activate or deactivate lights. If not specified: No change for controlling the lighting domain is applied."@en ;
    rdfs:domain osc:ActivateControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "In lighting domain: Activate or deactivate lights. If not specified: No change for controlling the lighting domain is applied."@en .

osc:ActivateControllerAction.longitudinal a owl:DatatypeProperty ;
    rdfs:label "longitudinal"@en ;
    rdfs:comment "In longitudinal domain: Activate or deactivate autonomous behavior. If not specified: No change for controlling the longitudinal domain is applied."@en ;
    rdfs:domain osc:ActivateControllerAction ;
    rdfs:range xsd:boolean ;
    skos:definition "In longitudinal domain: Activate or deactivate autonomous behavior. If not specified: No change for controlling the longitudinal domain is applied."@en .

osc:ActivateControllerAction.objectControllerRef a owl:ObjectProperty ;
    rdfs:label "objectControllerRef"@en ;
    rdfs:comment "Reference to an object controller which is assigned to the entity."@en ;
    rdfs:domain osc:ActivateControllerAction ;
    rdfs:range osc:ObjectController ;
    skos:definition "Reference to an object controller which is assigned to the entity."@en .

osc:Actors.selectTriggeringEntities a owl:DatatypeProperty ;
    rdfs:label "selectTriggeringEntities"@en ;
    rdfs:comment "Indicates whether the triggering entities are considered actors."@en ;
    rdfs:domain osc:Actors ;
    rdfs:range xsd:boolean ;
    skos:definition "Indicates whether the triggering entities are considered actors."@en .

osc:AddEntityAction.position a owl:ObjectProperty ;
    rdfs:label "position"@en ;
    rdfs:domain osc:AddEntityAction ;
    rdfs:range osc:Position .

osc:AngleCondition.angle a owl:DatatypeProperty ;
    rdfs:label "angle"@en ;
    rdfs:comment "The angle value that will be compared to the triggering entity's orientation. Unit: [rad]. Range: [-pi..pi]."@en ;
    rdfs:domain osc:AngleCondition ;
    rdfs:range xsd:double ;
    skos:definition "The angle value that will be compared to the triggering entity's orientation. Unit: [rad]. Range: [-pi..pi]."@en .

osc:AngleCondition.angleTolerance a owl:DatatypeProperty ;
    rdfs:label "angleTolerance"@en ;
    rdfs:comment "Tolerance around the given angle value. Unit: [rad]. Range: [0..pi]."@en ;
    rdfs:domain osc:AngleCondition ;
    rdfs:range xsd:double ;
    skos:definition "Tolerance around the given angle value. Unit: [rad]. Range: [0..pi]."@en .

osc:AngleCondition.angleType a owl:DatatypeProperty ;
    rdfs:label "angleType"@en ;
    rdfs:comment "The angular coordinate to be used for the condition."@en ;
    rdfs:domain osc:AngleCondition ;
    rdfs:range osc:AngleType ;
    skos:definition "The angular coordinate to be used for the condition."@en .

osc:AngleCondition.coordinateSystem a owl:DatatypeProperty ;
    rdfs:label "coordinateSystem"@en ;
    rdfs:comment "Define which coordinate system is used to measure the angle of the triggering entity. Note that using the value entity would always result in measuring an angle of zero. Default: world."@en ;
    rdfs:domain osc:AngleCondition ;
    rdfs:range osc:CoordinateSystem ;
    skos:definition "Define which coordinate system is used to measure the angle of the triggering entity. Note that using the value entity would always result in measuring an angle of zero. Default: world."@en .

osc:AnimationAction.animationDuration a owl:DatatypeProperty ;
    rdfs:label "animationDuration"@en ;
    rdfs:comment "Duration of an animation. Default if omitted: depending on the animation itself and the implementation of the simulator. Unit: [s]."@en ;
    rdfs:domain osc:AnimationAction ;
    rdfs:range xsd:double ;
    skos:definition "Duration of an animation. Default if omitted: depending on the animation itself and the implementation of the simulator. Unit: [s]."@en .

osc:AnimationAction.animationState a owl:ObjectProperty ;
    rdfs:label "animationState"@en ;
    rdfs:domain osc:AnimationAction ;
    rdfs:range osc:AnimationState .

osc:AnimationAction.animationType a owl:ObjectProperty ;
    rdfs:label "animationType"@en ;
    rdfs:domain osc:AnimationAction ;
    rdfs:range osc:AnimationType .

osc:AnimationAction.loop a owl:DatatypeProperty ;
    rdfs:label "loop"@en ;
    rdfs:comment "If set to true, the animation will be looped. Default if omitted: false."@en ;
    rdfs:domain osc:AnimationAction ;
    rdfs:range xsd:boolean ;
    skos:definition "If set to true, the animation will be looped. Default if omitted: false."@en .

osc:AnimationFile.file a owl:ObjectProperty ;
    rdfs:label "file"@en ;
    rdfs:domain osc:AnimationFile ;
    rdfs:range osc:File .

osc:AnimationFile.timeOffset a owl:DatatypeProperty ;
    rdfs:label "timeOffset"@en ;
    rdfs:comment "Time offset from beginning of animation. Unit: [s]. Range: [0..inf[. Default, if omitted is 0 (start from beginning of animation)."@en ;
    rdfs:domain osc:AnimationFile ;
    rdfs:range xsd:double ;
    skos:definition "Time offset from beginning of animation. Unit: [s]. Range: [0..inf[. Default, if omitted is 0 (start from beginning of animation)."@en .

osc:AnimationState.state a owl:DatatypeProperty ;
    rdfs:label "state"@en ;
    rdfs:comment "The goal state of a component after the AnimationStateAction is executed (rotation: 0% -> lower limiting angle / 100% -> upper limiting angle; translation: 0% -> lower limiting position on movement axis / 100% -> upper limiting position on movement axis). Range: [0..1]."@en ;
    rdfs:domain osc:AnimationState ;
    rdfs:range xsd:double ;
    skos:definition "The goal state of a component after the AnimationStateAction is executed (rotation: 0% -> lower limiting angle / 100% -> upper limiting angle; translation: 0% -> lower limiting position on movement axis / 100% -> upper limiting position on movement axis). Range: [0..1]."@en .

osc:AutomaticGear.gear a owl:DatatypeProperty ;
    rdfs:label "gear"@en ;
    rdfs:comment "Gear type."@en ;
    rdfs:domain osc:AutomaticGear ;
    rdfs:range osc:AutomaticGearType ;
    skos:definition "Gear type."@en .

osc:Axle.maxSteering a owl:DatatypeProperty ;
    rdfs:label "maxSteering"@en ;
    rdfs:comment "Maximum steering angle which can be performed by the wheels on this axle. Unit: [rad]. Range: [0..PI], symmetrical."@en ;
    rdfs:domain osc:Axle ;
    rdfs:range xsd:double ;
    skos:definition "Maximum steering angle which can be performed by the wheels on this axle. Unit: [rad]. Range: [0..PI], symmetrical."@en .

osc:Axle.positionX a owl:DatatypeProperty ;
    rdfs:label "positionX"@en ;
    rdfs:comment "Longitudinal position of the axle with respect to the vehicles reference point. Unit: [m]. Range: [0..inf[."@en ;
    rdfs:domain osc:Axle ;
    rdfs:range xsd:double ;
    skos:definition "Longitudinal position of the axle with respect to the vehicles reference point. Unit: [m]. Range: [0..inf[."@en .

osc:Axle.positionZ a owl:DatatypeProperty ;
    rdfs:label "positionZ"@en ;
    rdfs:comment "Z-position of the axle with respect to the vehicles reference point. Usually this is half of wheel diameter. Unit: [m]. Range: [0..inf[."@en ;
    rdfs:domain osc:Axle ;
    rdfs:range xsd:double ;
    skos:definition "Z-position of the axle with respect to the vehicles reference point. Usually this is half of wheel diameter. Unit: [m]. Range: [0..inf[."@en .

osc:Axle.trackWidth a owl:DatatypeProperty ;
    rdfs:label "trackWidth"@en ;
    rdfs:comment "Distance of the wheels center lines at zero steering. Unit: [m]. Range: [0..inf[."@en ;
    rdfs:domain osc:Axle ;
    rdfs:range xsd:double ;
    skos:definition "Distance of the wheels center lines at zero steering. Unit: [m]. Range: [0..inf[."@en .

osc:Axle.wheelDiameter a owl:DatatypeProperty ;
    rdfs:label "wheelDiameter"@en ;
    rdfs:comment "Diameter of the wheels on this axle. Unit: [m]. Range: ]0..inf[."@en ;
    rdfs:domain osc:Axle ;
    rdfs:range xsd:double ;
    skos:definition "Diameter of the wheels on this axle. Unit: [m]. Range: ]0..inf[."@en .

osc:Axles.frontAxle a owl:ObjectProperty ;
    rdfs:label "frontAxle"@en ;
    rdfs:domain osc:Axles ;
    rdfs:range osc:Axle .

osc:Axles.rearAxle a owl:ObjectProperty ;
    rdfs:label "rearAxle"@en ;
    rdfs:domain osc:Axles ;
    rdfs:range osc:Axle .

osc:BoundingBox.center a owl:ObjectProperty ;
    rdfs:label "center"@en ;
    rdfs:domain osc:BoundingBox ;
    rdfs:range osc:Center .

osc:BoundingBox.dimensions a owl:ObjectProperty ;
    rdfs:label "dimensions"@en ;
    rdfs:domain osc:BoundingBox ;
    rdfs:range osc:Dimensions .

