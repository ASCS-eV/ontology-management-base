osc:DistanceCondition.alongRoute a owl:DatatypeProperty ;
    rdfs:label "alongRoute"@en ;
    rdfs:comment "True: routing is taken into account, e.g. turns will increase distance. False: straight line distance is used."@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range xsd:boolean ;
    skos:definition "True: routing is taken into account, e.g. turns will increase distance. False: straight line distance is used."@en .

osc:DistanceCondition.coordinateSystem a owl:DatatypeProperty ;
    rdfs:label "coordinateSystem"@en ;
    rdfs:comment "Definition of the coordinate system to be used for calculations. If not provided the value is interpreted as \"entity\". If set, \"alongRoute\" is ignored."@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range osc:CoordinateSystem ;
    skos:definition "Definition of the coordinate system to be used for calculations. If not provided the value is interpreted as \"entity\". If set, \"alongRoute\" is ignored."@en .

osc:DistanceCondition.freespace a owl:DatatypeProperty ;
    rdfs:label "freespace"@en ;
    rdfs:comment "True: distance is measured between closest bounding box points. False: reference point distance is used."@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range xsd:boolean ;
    skos:definition "True: distance is measured between closest bounding box points. False: reference point distance is used."@en .

osc:DistanceCondition.position a owl:ObjectProperty ;
    rdfs:label "position"@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range osc:Position .

osc:DistanceCondition.relativeDistanceType a owl:DatatypeProperty ;
    rdfs:label "relativeDistanceType"@en ;
    rdfs:comment "Definition of the coordinate system dimension(s) to be used for calculating distances. If set, \"alongRoute\" is ignored. If not provided, value is interpreted as \"euclideanDistance\"."@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range osc:RelativeDistanceType ;
    skos:definition "Definition of the coordinate system dimension(s) to be used for calculating distances. If set, \"alongRoute\" is ignored. If not provided, value is interpreted as \"euclideanDistance\"."@en .

osc:DistanceCondition.routingAlgorithm a owl:DatatypeProperty ;
    rdfs:label "routingAlgorithm"@en ;
    rdfs:comment "Algorithm for path selection/calculation between two positions across roads. Only relevant, if CoordinateSystem is \"road\"/\"lane\". Default value if omitted: \"undefined\"."@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range osc:RoutingAlgorithm ;
    skos:definition "Algorithm for path selection/calculation between two positions across roads. Only relevant, if CoordinateSystem is \"road\"/\"lane\". Default value if omitted: \"undefined\"."@en .

osc:DistanceCondition.rule a owl:DatatypeProperty ;
    rdfs:label "rule"@en ;
    rdfs:comment "The operator (less, greater, equal)."@en ;
    rdfs:domain osc:DistanceCondition ;
    rdfs:range osc:Rule ;
    skos:definition "The operator (less, greater, equal)."@en .

