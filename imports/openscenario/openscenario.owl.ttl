osc:Range a owl:Class ;
    rdfs:label "Range"@en ;
    rdfs:comment "Indicates a range for a distribution where the following rule applies: lowerLimit <= value <= upperLimit."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Range.lowerLimit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Range.upperLimit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Indicates a range for a distribution where the following rule applies: lowerLimit <= value <= upperLimit."@en .

osc:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:comment "Definition of a vehicle type in a scenario or in a catalog."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:Vehicle.properties ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Vehicle.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:Role ;
            owl:onProperty osc:Vehicle.role ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Vehicle.mass ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrailerCoupler ;
            owl:onProperty osc:Vehicle.trailerCoupler ],
        [ a owl:Restriction ;
            owl:onClass osc:Performance ;
            owl:onProperty osc:Vehicle.performance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrailerHitch ;
            owl:onProperty osc:Vehicle.trailerHitch ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Trailer ;
            owl:onProperty osc:Vehicle.trailer ],
        [ a owl:Restriction ;
            owl:onDataRange osc:VehicleCategory ;
            owl:onProperty osc:Vehicle.vehicleCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:BoundingBox ;
            owl:onProperty osc:Vehicle.boundingBox ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Axles ;
            owl:onProperty osc:Vehicle.axles ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Vehicle.model3d ] ;
    skos:definition "Definition of a vehicle type in a scenario or in a catalog."@en .

osc:Properties a owl:Class ;
    rdfs:label "Properties"@en ;
    rdfs:comment "Container for one or more properties. Properties encloses multiple property instances and/or multiple file references."@en ;
    skos:definition "Container for one or more properties. Properties encloses multiple property instances and/or multiple file references."@en .

