    rdfs:domain osc:LaneChangeAction ;
    rdfs:range xsd:double ;
    skos:definition "Lane offset to be reached at the target lane; the action will end there. Missing value is interpreted as 0. Unit: [m]."@en .

osc:LaneOffsetAction.continuous a owl:DatatypeProperty ;
    rdfs:label "continuous"@en ;
    rdfs:comment "If false, the action ends when the target lane-offset is reached. If true it does not end but has to be stopped."@en ;
    rdfs:domain osc:LaneOffsetAction ;
    rdfs:range xsd:boolean ;
    skos:definition "If false, the action ends when the target lane-offset is reached. If true it does not end but has to be stopped."@en .

osc:LaneOffsetAction.laneOffsetActionDynamics a owl:ObjectProperty ;
    rdfs:label "laneOffsetActionDynamics"@en ;
    rdfs:domain osc:LaneOffsetAction ;
    rdfs:range osc:LaneOffsetActionDynamics .

osc:LaneOffsetAction.laneOffsetTarget a owl:ObjectProperty ;
    rdfs:label "laneOffsetTarget"@en ;
    rdfs:domain osc:LaneOffsetAction ;
    rdfs:range osc:LaneOffsetTarget .

osc:LaneOffsetActionDynamics.dynamicsShape a owl:DatatypeProperty ;
    rdfs:label "dynamicsShape"@en ;
    rdfs:comment "Geometrical shape of the LaneOffsetAction's dynamics."@en ;
    rdfs:domain osc:LaneOffsetActionDynamics ;
    rdfs:range osc:DynamicsShape ;
    skos:definition "Geometrical shape of the LaneOffsetAction's dynamics."@en .

osc:LaneOffsetActionDynamics.maxLateralAcc a owl:DatatypeProperty ;
    rdfs:label "maxLateralAcc"@en ;
    rdfs:comment "Maximum lateral acceleration used to initially reach and afterwards keep the lane offset. Missing value is interpreted as 'inf'. Unit: [m/s²]. Range: [0..inf[."@en ;
    rdfs:domain osc:LaneOffsetActionDynamics ;
    rdfs:range xsd:double ;
    skos:definition "Maximum lateral acceleration used to initially reach and afterwards keep the lane offset. Missing value is interpreted as 'inf'. Unit: [m/s²]. Range: [0..inf[."@en .

osc:LanePosition.laneId a owl:DatatypeProperty ;
    rdfs:label "laneId"@en ;
    rdfs:comment "The ID of the target lane belonging to the target road (taken from the respective road network definition file). If a temporary lane layer is present (e.g. in roadworks sections), this shall be interpreted as the ID on the temporary lane layer."@en ;
    rdfs:domain osc:LanePosition ;
    rdfs:range xsd:string ;
    skos:definition "The ID of the target lane belonging to the target road (taken from the respective road network definition file). If a temporary lane layer is present (e.g. in roadworks sections), this shall be interpreted as the ID on the temporary lane layer."@en .

osc:LanePosition.layer a owl:DatatypeProperty ;
    rdfs:label "layer"@en ;
    rdfs:comment """Which layer to consider: "permanent" or "temporary".\r
Default: "temporary".\r
If temporary layer is not found, fall back to permanent."""@en ;
    rdfs:domain osc:LanePosition ;
    rdfs:range osc:LaneLayerType ;
    skos:definition """Which layer to consider: "permanent" or "temporary".\r
Default: "temporary".\r
If temporary layer is not found, fall back to permanent."""@en .

osc:LanePosition.offset a owl:DatatypeProperty ;
    rdfs:label "offset"@en ;
    rdfs:comment "The lateral offset to the center line of the target lane (along the t-axis of the target lane center line). Missing value is interpreted as 0. The positive value means the offset is applied in the direction of the t-axis being imagined at the target s-position. Unit: [m]."@en ;
    rdfs:domain osc:LanePosition ;
    rdfs:range xsd:double ;
    skos:definition "The lateral offset to the center line of the target lane (along the t-axis of the target lane center line). Missing value is interpreted as 0. The positive value means the offset is applied in the direction of the t-axis being imagined at the target s-position. Unit: [m]."@en .

osc:LanePosition.orientation a owl:ObjectProperty ;
    rdfs:label "orientation"@en ;
    rdfs:domain osc:LanePosition ;
    rdfs:range osc:Orientation .

osc:LanePosition.roadId a owl:DatatypeProperty ;
    rdfs:label "roadId"@en ;
    rdfs:comment "The ID of the target road taken from the respective road network definition file."@en ;
    rdfs:domain osc:LanePosition ;
    rdfs:range xsd:string ;
    skos:definition "The ID of the target road taken from the respective road network definition file."@en .

osc:LanePosition.s a owl:DatatypeProperty ;
    rdfs:label "s"@en ;
    rdfs:comment "The s-coordinate taken along the road's reference line from the start point of the target road. Unit: [m]. Range: [0..inf[."@en ;
    rdfs:domain osc:LanePosition ;
    rdfs:range xsd:double ;
