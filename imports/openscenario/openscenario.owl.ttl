osc:LightState a owl:Class ;
    rdfs:label "LightState"@en ;
    rdfs:comment "Definition of the light state."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LightState.flashingOffDuration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Color ;
            owl:onProperty osc:LightState.color ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LightState.flashingOnDuration ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LightState.luminousIntensity ],
        [ a owl:Restriction ;
            owl:onDataRange osc:LightMode ;
            owl:onProperty osc:LightState.mode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of the light state."@en .

osc:ManeuverGroup a owl:Class ;
    rdfs:label "ManeuverGroup"@en ;
    rdfs:comment "Grouping element connecting a set of actors to a set maneuvers. Multiple maneuver groups can run independently in parallel. Maneuvers can be defined or instantiated from a maneuver type in a catalog."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Actors ;
            owl:onProperty osc:ManeuverGroup.actors ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedInt ;
            owl:onProperty osc:ManeuverGroup.maximumExecutionCount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:ManeuverGroup.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Grouping element connecting a set of actors to a set maneuvers. Multiple maneuver groups can run independently in parallel. Maneuvers can be defined or instantiated from a maneuver type in a catalog."@en .

osc:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    rdfs:comment "Container for Performance values of a vehicle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Performance.maxSpeed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Performance.maxDeceleration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Performance.maxDecelerationRate ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Performance.maxAccelerationRate ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Performance.maxAcceleration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Container for Performance values of a vehicle."@en .

osc:RelativeAngleCondition a owl:Class ;
    rdfs:label "RelativeAngleCondition"@en ;
    rdfs:comment """Checks if the relative angle of the triggering entity, measured with respect to the reference entity, has reached a given value, within some user-specified angle tolerance.\r
\r
The relative angle is generally measured as angle of the triggering entity minus angle of the reference entity.\r
Both angles must be measured in the same coordinate system, as specified by the user.\r
\r
When the entity value is used, the angles are measured in the local coordinate system of the reference entity.\r
Note that for the s-t coordinate systems the orientation is measured at the local s-coordinate of each entity."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeAngleCondition.angleTolerance ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeAngleCondition.angle ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeAngleCondition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:AngleType ;
            owl:onProperty osc:RelativeAngleCondition.angleType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:RelativeAngleCondition.coordinateSystem ] ;
    skos:definition """Checks if the relative angle of the triggering entity, measured with respect to the reference entity, has reached a given value, within some user-specified angle tolerance.\r
\r
The relative angle is generally measured as angle of the triggering entity minus angle of the reference entity.\r
Both angles must be measured in the same coordinate system, as specified by the user.\r
\r
When the entity value is used, the angles are measured in the local coordinate system of the reference entity.\r
Note that for the s-t coordinate systems the orientation is measured at the local s-coordinate of each entity."""@en .

osc:RelativeObjectPosition a owl:Class ;
    rdfs:label "RelativeObjectPosition"@en ;
    rdfs:comment "Defines a position derived from coordinates (dx, dy and dz) relative to a reference entity. The coordinate system for the relative coordinates is the reference entity's coordinate system (taking the orientation of the entity into account)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeObjectPosition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeObjectPosition.dz ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeObjectPosition.dx ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:RelativeObjectPosition.orientation ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeObjectPosition.dy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a position derived from coordinates (dx, dy and dz) relative to a reference entity. The coordinate system for the relative coordinates is the reference entity's coordinate system (taking the orientation of the entity into account)."@en .

osc:RelativeWorldPosition a owl:Class ;
    rdfs:label "RelativeWorldPosition"@en ;
    rdfs:comment "Position defined in terms of delta x, y, (z) relative to a reference entity's position in world coordinate space. Optionally, an orientation can be defined in either absolute or relative values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeWorldPosition.dx ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeWorldPosition.dy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeWorldPosition.dz ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeWorldPosition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:RelativeWorldPosition.orientation ] ;
    skos:definition "Position defined in terms of delta x, y, (z) relative to a reference entity's position in world coordinate space. Optionally, an orientation can be defined in either absolute or relative values."@en .

osc:RoutingAction a owl:Class ;
    rdfs:label "RoutingAction"@en ;
    rdfs:comment """Controls entity routing, either by following a predefined route or trajectory, alternatively by specifying a destination position which the entity should aim to reach.\r
Further, it can be enforced that an entity selects its routing at each junction randomly."""@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:FollowTrajectoryAction ;
                                    owl:onProperty osc:RoutingAction.followTrajectoryAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.assignRouteAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.acquirePositionAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.randomRouteAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.preferredLaneLayerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.followTrajectoryAction ] [ a owl:Restriction ;
                                    owl:onClass osc:AssignRouteAction ;
                                    owl:onProperty osc:RoutingAction.assignRouteAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.acquirePositionAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.randomRouteAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.preferredLaneLayerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.followTrajectoryAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.assignRouteAction ] [ a owl:Restriction ;
                                    owl:onClass osc:AcquirePositionAction ;
                                    owl:onProperty osc:RoutingAction.acquirePositionAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.randomRouteAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.preferredLaneLayerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.followTrajectoryAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.assignRouteAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.acquirePositionAction ] [ a owl:Restriction ;
                                    owl:onClass osc:RandomRouteAction ;
                                    owl:onProperty osc:RoutingAction.randomRouteAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.preferredLaneLayerAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.followTrajectoryAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.assignRouteAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.acquirePositionAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:RoutingAction.randomRouteAction ] [ a owl:Restriction ;
                                    owl:onClass osc:PreferredLaneLayerAction ;
                                    owl:onProperty osc:RoutingAction.preferredLaneLayerAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition """Controls entity routing, either by following a predefined route or trajectory, alternatively by specifying a destination position which the entity should aim to reach.\r
Further, it can be enforced that an entity selects its routing at each junction randomly."""@en .

osc:StochasticDistributionType.histogram a owl:ObjectProperty ;
    rdfs:label "histogram"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:Histogram .

osc:StochasticDistributionType.logNormalDistribution a owl:ObjectProperty ;
    rdfs:label "logNormalDistribution"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:LogNormalDistribution .

osc:StochasticDistributionType.normalDistribution a owl:ObjectProperty ;
    rdfs:label "normalDistribution"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:NormalDistribution .

osc:StochasticDistributionType.poissonDistribution a owl:ObjectProperty ;
    rdfs:label "poissonDistribution"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:PoissonDistribution .

osc:StochasticDistributionType.probabilityDistributionSet a owl:ObjectProperty ;
    rdfs:label "probabilityDistributionSet"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:ProbabilityDistributionSet .

osc:StochasticDistributionType.uniformDistribution a owl:ObjectProperty ;
    rdfs:label "uniformDistribution"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:UniformDistribution .

osc:StochasticDistributionType.userDefinedDistribution a owl:ObjectProperty ;
    rdfs:label "userDefinedDistribution"@en ;
    rdfs:domain osc:StochasticDistributionType ;
    rdfs:range osc:UserDefinedDistribution .

osc:ByValueCondition.parameterCondition a owl:ObjectProperty ;
    rdfs:label "parameterCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:ParameterCondition .

osc:ByValueCondition.simulationTimeCondition a owl:ObjectProperty ;
    rdfs:label "simulationTimeCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:SimulationTimeCondition .

osc:ByValueCondition.storyboardElementStateCondition a owl:ObjectProperty ;
    rdfs:label "storyboardElementStateCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:StoryboardElementStateCondition .

osc:ByValueCondition.timeOfDayCondition a owl:ObjectProperty ;
    rdfs:label "timeOfDayCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:TimeOfDayCondition .

osc:ByValueCondition.trafficSignalCondition a owl:ObjectProperty ;
    rdfs:label "trafficSignalCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:TrafficSignalCondition .

osc:ByValueCondition.trafficSignalControllerCondition a owl:ObjectProperty ;
    rdfs:label "trafficSignalControllerCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:TrafficSignalControllerCondition .

osc:ByValueCondition.userDefinedValueCondition a owl:ObjectProperty ;
    rdfs:label "userDefinedValueCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:UserDefinedValueCondition .

osc:ByValueCondition.variableCondition a owl:ObjectProperty ;
    rdfs:label "variableCondition"@en ;
    rdfs:domain osc:ByValueCondition ;
    rdfs:range osc:VariableCondition .

osc:Environment a owl:Class ;
    rdfs:label "Environment"@en ;
    rdfs:comment "Defines the environment conditions of a scenario, e.g. time of day, weather and road condition. If one of the conditions is missing it means that it doesn't change."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TimeOfDay ;
            owl:onProperty osc:Environment.timeOfDay ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Weather ;
            owl:onProperty osc:Environment.weather ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Environment.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:RoadCondition ;
            owl:onProperty osc:Environment.roadCondition ] ;
    skos:definition "Defines the environment conditions of a scenario, e.g. time of day, weather and road condition. If one of the conditions is missing it means that it doesn't change."@en .

osc:FollowTrajectoryAction a owl:Class ;
    rdfs:label "FollowTrajectoryAction"@en ;
    rdfs:comment "Controls an entity to follow a trajectory using vertices, timings (optionally) and a corresponding interpolation strategy. The trajectory can be instantiated from a catalog type, or defined within this declaration. Use trajectoryRef to define a trajectory."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrajectoryRef ;
            owl:onProperty osc:FollowTrajectoryAction.trajectoryRef ],
        [ a owl:Restriction ;
            owl:onClass osc:TrajectoryFollowingMode ;
            owl:onProperty osc:FollowTrajectoryAction.trajectoryFollowingMode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:TimeReference ;
            owl:onProperty osc:FollowTrajectoryAction.timeReference ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:FollowTrajectoryAction.initialDistanceOffset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Trajectory ;
            owl:onProperty osc:FollowTrajectoryAction.trajectory ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:CatalogReference ;
            owl:onProperty osc:FollowTrajectoryAction.catalogReference ] ;
    skos:definition "Controls an entity to follow a trajectory using vertices, timings (optionally) and a corresponding interpolation strategy. The trajectory can be instantiated from a catalog type, or defined within this declaration. Use trajectoryRef to define a trajectory."@en .

osc:LaneLayerType a rdfs:Datatype ;
    rdfs:label "LaneLayerType"@en ;
    rdfs:comment "Types of layers for lanes."@en ;
    owl:oneOf ( "permanent" "temporary" ) ;
    skos:definition "Types of layers for lanes."@en .

osc:LanePosition a owl:Class ;
    rdfs:label "LanePosition"@en ;
    rdfs:comment """Position defined in terms of the road segment (roadId), the lane (laneId) of the road, the distance (s) along the road's reference line, and the lateral offset to the lane's center line along the lane center line's t-axis. Orientation is optional.\r
The s-coordinate and the offset should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LanePosition.offset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:LanePosition.orientation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:LaneLayerType ;
            owl:onProperty osc:LanePosition.layer ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:LanePosition.laneId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:LanePosition.roadId ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LanePosition.s ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition """Position defined in terms of the road segment (roadId), the lane (laneId) of the road, the distance (s) along the road's reference line, and the lateral offset to the lane's center line along the lane center line's t-axis. Orientation is optional.\r
The s-coordinate and the offset should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en .

osc:OverrideControllerValueAction a owl:Class ;
    rdfs:label "OverrideControllerValueAction"@en ;
    rdfs:comment """Overrides entity controller values. Mostly suited for motor vehicles.\r
It is assumed that a respective user-defined Controller is assigned to the entity, defined in the "movement" domain, and activated."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:OverrideThrottleAction ;
            owl:onProperty osc:OverrideControllerValueAction.throttle ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:OverrideSteeringWheelAction ;
            owl:onProperty osc:OverrideControllerValueAction.steeringWheel ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:OverrideClutchAction ;
            owl:onProperty osc:OverrideControllerValueAction.clutch ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:OverrideBrakeAction ;
            owl:onProperty osc:OverrideControllerValueAction.brake ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:OverrideGearAction ;
            owl:onProperty osc:OverrideControllerValueAction.gear ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:OverrideParkingBrakeAction ;
            owl:onProperty osc:OverrideControllerValueAction.parkingBrake ] ;
    skos:definition """Overrides entity controller values. Mostly suited for motor vehicles.\r
It is assumed that a respective user-defined Controller is assigned to the entity, defined in the "movement" domain, and activated."""@en .

osc:Phase a owl:Class ;
    rdfs:label "Phase"@en ;
    rdfs:comment "Phase of a TrafficSignalController. A TrafficSignalController has sequential semantic phases, forming the signal cycle. Each semantic phase can have multiple TrafficSignalStates or one TrafficSignalGroupState (mutually exclusive). When TrafficSignalStates are used to model the observable states of a traffic signal individually, exactly one TrafficSignalState has to be defined for every traffic signal controlled by this TrafficSignalController. The semantic phase information like go, attention, stop, etc. is set in Phase attribute semantics and the observable state like the visual information \"off;off;on\" in trafficSignalStates or trafficSignalGroupState."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Phase.duration ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:TrafficSignalSemantics ;
            owl:onProperty osc:Phase.semantics ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficSignalGroupState ;
            owl:onProperty osc:Phase.trafficSignalGroupState ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Phase.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Phase of a TrafficSignalController. A TrafficSignalController has sequential semantic phases, forming the signal cycle. Each semantic phase can have multiple TrafficSignalStates or one TrafficSignalGroupState (mutually exclusive). When TrafficSignalStates are used to model the observable states of a traffic signal individually, exactly one TrafficSignalState has to be defined for every traffic signal controlled by this TrafficSignalController. The semantic phase information like go, attention, stop, etc. is set in Phase attribute semantics and the observable state like the visual information \"off;off;on\" in trafficSignalStates or trafficSignalGroupState."@en .

osc:RelativeClearanceCondition a owl:Class ;
    rdfs:label "RelativeClearanceCondition"@en ;
    rdfs:comment "Checks if an amount of lanes next to the triggering entity is free from other entities. Evaluates to true, if the specified area exists and is free, otherwise evaluates to false. The longitudinal distance to be checked is defined in the lane coordinate system of the current lane of the triggering entity. In lateral direction the checked area is defined by the lane boundaries."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeClearanceCondition.distanceBackward ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:RelativeClearanceCondition.freeSpace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeClearanceCondition.distanceForward ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:RelativeClearanceCondition.oppositeLanes ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Checks if an amount of lanes next to the triggering entity is free from other entities. Evaluates to true, if the specified area exists and is free, otherwise evaluates to false. The longitudinal distance to be checked is defined in the lane coordinate system of the current lane of the triggering entity. In lateral direction the checked area is defined by the lane boundaries."@en .

osc:RelativeDistanceType a rdfs:Datatype ;
    rdfs:label "RelativeDistanceType"@en ;
    rdfs:comment "Definition of the coordinate system dimension(s) to be used for calculating distances."@en ;
    owl:oneOf ( "lateral" "longitudinal" "cartesianDistance" "euclidianDistance" ) ;
    skos:definition "Definition of the coordinate system dimension(s) to be used for calculating distances."@en .

osc:RelativeLanePosition a owl:Class ;
    rdfs:label "RelativeLanePosition"@en ;
    rdfs:comment """Defines a position derived from relative lane coordinates (dLane, ds / dsLane and offset) to a reference entity.\r
Where ds is provided, the position is computed by the following process:\r
\r
\r
	1. Find the closest road reference line point to the reference entity. Travel the road reference line difference ds from the position of the reference entity.\r
	2. Find the target lane by adding dLane to that of the reference entity and the intersection of the road reference line's normal with its center lane.\r
	3. Apply offset as a lateral offset.\r
\r
\r
Alternatively where dsLane is provided, the following process is used:\r
\r
\r
	1. Find the closest lane center line point to the reference entity. Travel the lane center line difference dsLane from the position of the reference entity in the direction the reference entity is facing.\r
	2. Find the target lane by adding dLane to that of the reference entity's and the intersection of the source lane's center lane normal with its center lane.\r
	3. Apply offset as a lateral offset.\r
\r
\r
The target position may be either on the same road segment (defined by roadId), where the reference entity is positioned, or on a connecting road. In the latter case, the ds-coordinate is calculated assuming that the reference line of the road of the reference entity continues seamlessly on the connecting road (even if its shape changes). It is also assumed that the lane, where the reference entity is located, continues seamlessly on the connecting road (provided the lane's center line is unbroken between roads). It is assumed that the target position relates to the routing of the reference entity. Otherwise, the calculation of the target position cannot be interpreted within the OpenSCENARIO standard.\r
\r
The relative lane coordinates (dLane, ds/dsLane, and offset) should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:RelativeLanePosition.dLane ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeLanePosition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:RelativeLanePosition.orientation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeLanePosition.ds ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeLanePosition.offset ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeLanePosition.dsLane ] ;
    skos:definition """Defines a position derived from relative lane coordinates (dLane, ds / dsLane and offset) to a reference entity.\r
Where ds is provided, the position is computed by the following process:\r
\r
\r
	1. Find the closest road reference line point to the reference entity. Travel the road reference line difference ds from the position of the reference entity.\r
	2. Find the target lane by adding dLane to that of the reference entity and the intersection of the road reference line's normal with its center lane.\r
	3. Apply offset as a lateral offset.\r
\r
\r
Alternatively where dsLane is provided, the following process is used:\r
\r
\r
	1. Find the closest lane center line point to the reference entity. Travel the lane center line difference dsLane from the position of the reference entity in the direction the reference entity is facing.\r
	2. Find the target lane by adding dLane to that of the reference entity's and the intersection of the source lane's center lane normal with its center lane.\r
	3. Apply offset as a lateral offset.\r
\r
\r
The target position may be either on the same road segment (defined by roadId), where the reference entity is positioned, or on a connecting road. In the latter case, the ds-coordinate is calculated assuming that the reference line of the road of the reference entity continues seamlessly on the connecting road (even if its shape changes). It is also assumed that the lane, where the reference entity is located, continues seamlessly on the connecting road (provided the lane's center line is unbroken between roads). It is assumed that the target position relates to the routing of the reference entity. Otherwise, the calculation of the target position cannot be interpreted within the OpenSCENARIO standard.\r
\r
The relative lane coordinates (dLane, ds/dsLane, and offset) should be specified so that the target position is within a road defined by roadId taken from the respective road network definition file (external to the ASAM OpenSCENARIO). If the target position would be outside the road boundaries, the z-coordinate of the position is undefined."""@en .

osc:RoutingAlgorithm a rdfs:Datatype ;
    rdfs:label "RoutingAlgorithm"@en ;
    rdfs:comment "Algorithm for path selection/calculation between two positions across roads. To be used for distance calculations in road/lane coordinates during runtime."@en ;
    owl:oneOf ( "assignedRoute" "fastest" "leastIntersections" "shortest" "undefined" ) ;
    skos:definition "Algorithm for path selection/calculation between two positions across roads. To be used for distance calculations in road/lane coordinates during runtime."@en .

osc:SynchronizeAction a owl:Class ;
    rdfs:label "SynchronizeAction"@en ;
    rdfs:comment "Synchronizes an entity's arrival at a destination with a master entity. Both entities are provided with their own reference position which shall be reached at the same time. Final speed can be specified. Note that the reference positions can be different or identical."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:SynchronizeAction.targetTolerance ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:FinalSpeed ;
            owl:onProperty osc:SynchronizeAction.finalSpeed ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:SynchronizeAction.targetPositionMaster ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:SynchronizeAction.targetPosition ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:SynchronizeAction.targetToleranceMaster ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:SynchronizeAction.masterEntityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Synchronizes an entity's arrival at a destination with a master entity. Both entities are provided with their own reference position which shall be reached at the same time. Final speed can be specified. Note that the reference positions can be different or identical."@en .

osc:TrafficAction a owl:Class ;
    rdfs:label "TrafficAction"@en ;
    rdfs:comment "Actions defining macroscopic traffic flow and behavior."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string ;
                                    owl:onProperty osc:TrafficAction.trafficName ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSinkAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSourceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSwarmAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficStopAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficAreaAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficName ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSinkAction ;
                                    owl:onProperty osc:TrafficAction.trafficSinkAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSourceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSwarmAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficStopAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficAreaAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficName ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSinkAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSourceAction ;
                                    owl:onProperty osc:TrafficAction.trafficSourceAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSwarmAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficStopAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficAreaAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficName ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSinkAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSourceAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSwarmAction ;
                                    owl:onProperty osc:TrafficAction.trafficSwarmAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficStopAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficAreaAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficName ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSinkAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSourceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSwarmAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficStopAction ;
                                    owl:onProperty osc:TrafficAction.trafficStopAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficAreaAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficName ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSinkAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSourceAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficSwarmAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:TrafficAction.trafficStopAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficAreaAction ;
                                    owl:onProperty osc:TrafficAction.trafficAreaAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Actions defining macroscopic traffic flow and behavior."@en .

osc:TrafficDistribution a owl:Class ;
    rdfs:label "TrafficDistribution"@en ;
    rdfs:comment "Defines the vehicle/pedestrian distribution of a traffic source/swarm including their controllers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDistributionEntry ;
            owl:onProperty osc:TrafficDistribution.trafficDistributionEntry ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:CatalogReference ;
            owl:onProperty osc:TrafficDistribution.catalogReferences ] ;
    skos:definition "Defines the vehicle/pedestrian distribution of a traffic source/swarm including their controllers."@en .

osc:TrafficDistributionEntry a owl:Class ;
    rdfs:label "TrafficDistributionEntry"@en ;
    rdfs:comment "Defines one weighted vehicle/pedestrian entity group as part of the traffic."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficDistributionEntry.weight ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:TrafficDistributionEntry.properties ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficDistributionEntry.name ],
        [ a owl:Restriction ;
            owl:onClass osc:EntityDistribution ;
            owl:onProperty osc:TrafficDistributionEntry.entityDistribution ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines one weighted vehicle/pedestrian entity group as part of the traffic."@en .

osc:TransitionDynamics a owl:Class ;
    rdfs:label "TransitionDynamics"@en ;
    rdfs:comment "Specifies the dynamics of a value transition and defines how the value changes over time or distance. Different shapes can be used for the transition. Step is an immediate transition, i.e. a jump from the current current value to the target value. In this case value for time or distance must be 0. Linear will result in a linear transition between the start and end value. A smooth transition is only given with cubic and sinusoidal shape."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:FollowingMode ;
            owl:onProperty osc:TransitionDynamics.followingMode ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TransitionDynamics.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:DynamicsDimension ;
            owl:onProperty osc:TransitionDynamics.dynamicsDimension ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:DynamicsShape ;
            owl:onProperty osc:TransitionDynamics.dynamicsShape ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Specifies the dynamics of a value transition and defines how the value changes over time or distance. Different shapes can be used for the transition. Step is an immediate transition, i.e. a jump from the current current value to the target value. In this case value for time or distance must be 0. Linear will result in a linear transition between the start and end value. A smooth transition is only given with cubic and sinusoidal shape."@en .

osc:VariableDeclaration a owl:Class ;
    rdfs:label "VariableDeclaration"@en ;
    rdfs:comment "Declaration of a typed variable with a name and a default value. Its value can change during runtime either from within the scenario (OSC Model instance) by using a VariableAction or can be also set from external side, e.g. by a test software. For this the Simulator Core needs to provide an interface to change variable values. The value can be used to either trigger Events in the scenario with VariableConditions or it can be used on external side, e.g. a test software to trigger test steps. For this the Simulator Core needs to provide an interface to read the variable values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:VariableDeclaration.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:ParameterType ;
            owl:onProperty osc:VariableDeclaration.variableType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:VariableDeclaration.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Declaration of a typed variable with a name and a default value. Its value can change during runtime either from within the scenario (OSC Model instance) by using a VariableAction or can be also set from external side, e.g. by a test software. For this the Simulator Core needs to provide an interface to change variable values. The value can be used to either trigger Events in the scenario with VariableConditions or it can be used on external side, e.g. a test software to trigger test steps. For this the Simulator Core needs to provide an interface to read the variable values."@en .

osc:WorldPosition a owl:Class ;
    rdfs:label "WorldPosition"@en ;
    rdfs:comment "A position which is fixed in the inertial reference frame of the simulation environment, the so-called world coordinate system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:WorldPosition.h ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:WorldPosition.y ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:WorldPosition.x ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:WorldPosition.p ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:WorldPosition.r ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:WorldPosition.z ] ;
    skos:definition "A position which is fixed in the inertial reference frame of the simulation environment, the so-called world coordinate system."@en .

osc:AssignControllerAction a owl:Class ;
    rdfs:label "AssignControllerAction"@en ;
    rdfs:comment "This action assigns an object controller to the given entity defined in the enclosing PrivateAction. "@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass osc:Controller ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLateral ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLongitudinal ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateAnimation ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.activateLighting ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:AssignControllerAction.controller ] [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass osc:ObjectController ;
                                    owl:onProperty osc:AssignControllerAction.objectController ] ) ] ) ] ;
    skos:definition "This action assigns an object controller to the given entity defined in the enclosing PrivateAction."@en .

osc:ClothoidSplineSegment a owl:Class ;
    rdfs:label "ClothoidSplineSegment"@en ;
    rdfs:comment "One segment of a clothoid spline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Motion ;
            owl:onProperty osc:ClothoidSplineSegment.motionStart ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ClothoidSplineSegment.timeStart ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ClothoidSplineSegment.hOffset ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ClothoidSplineSegment.curvatureStart ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ClothoidSplineSegment.curvatureEnd ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Position ;
            owl:onProperty osc:ClothoidSplineSegment.positionStart ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:ClothoidSplineSegment.length ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "One segment of a clothoid spline."@en .

osc:EntityObject a owl:Class ;
    rdfs:label "EntityObject"@en ;
    rdfs:comment "A vehicle type, pedestrian type or miscellaneous object type."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:Vehicle ;
                                    owl:onProperty osc:EntityObject.vehicle ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.miscObject ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.pedestrian ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.externalObjectReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.vehicle ] [ a owl:Restriction ;
                                    owl:onClass osc:MiscObject ;
                                    owl:onProperty osc:EntityObject.miscObject ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.pedestrian ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.externalObjectReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.vehicle ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.miscObject ] [ a owl:Restriction ;
                                    owl:onClass osc:Pedestrian ;
                                    owl:onProperty osc:EntityObject.pedestrian ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.catalogReference ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.externalObjectReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.vehicle ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.miscObject ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.pedestrian ] [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:EntityObject.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.externalObjectReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.vehicle ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.miscObject ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.pedestrian ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:EntityObject.catalogReference ] [ a owl:Restriction ;
                                    owl:onClass osc:ExternalObjectReference ;
                                    owl:onProperty osc:EntityObject.externalObjectReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "A vehicle type, pedestrian type or miscellaneous object type."@en .

osc:FileHeader a owl:Class ;
    rdfs:label "FileHeader"@en ;
    rdfs:comment "File header used in OpenSCENARIO files, e.g. scenario file or catalog files."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:dateTime ;
            owl:onProperty osc:FileHeader.date ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:License ;
            owl:onProperty osc:FileHeader.license ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedShort ;
            owl:onProperty osc:FileHeader.revMajor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:FileHeader.properties ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:FileHeader.description ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:FileHeader.author ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:unsignedShort ;
            owl:onProperty osc:FileHeader.revMinor ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "File header used in OpenSCENARIO files, e.g. scenario file or catalog files."@en .

osc:LateralDistanceAction a owl:Class ;
    rdfs:label "LateralDistanceAction"@en ;
    rdfs:comment "This action describes a continuously kept lateral distance of an entity with respect to a reference entity. The distance can be maintained by using a controller, requiring limiting values for lateral acceleration, lateral deceleration and lateral speed. Without this limiting parameters lateral distance is kept rigid. Distance measurement could either be calculated from the distance between the entities' reference points or from the free space between the entities' bounding boxes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LateralDistanceAction.distance ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:DynamicConstraints ;
            owl:onProperty osc:LateralDistanceAction.dynamicConstraints ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:LateralDistanceAction.freespace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:LateralDistanceAction.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:LateralDistanceAction.continuous ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:LateralDistanceAction.coordinateSystem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:LateralDisplacement ;
            owl:onProperty osc:LateralDistanceAction.displacement ] ;
    skos:definition "This action describes a continuously kept lateral distance of an entity with respect to a reference entity. The distance can be maintained by using a controller, requiring limiting values for lateral acceleration, lateral deceleration and lateral speed. Without this limiting parameters lateral distance is kept rigid. Distance measurement could either be calculated from the distance between the entities' reference points or from the free space between the entities' bounding boxes."@en .

osc:ObjectController a owl:Class ;
    rdfs:label "ObjectController"@en ;
    rdfs:comment "Definition of a controller for a scenario object. Either an inline definition or a catalog reference to a controller."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string ;
                                    owl:onProperty osc:ObjectController.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ObjectController.controller ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ObjectController.catalogReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ObjectController.name ] [ a owl:Restriction ;
                                    owl:onClass osc:Controller ;
                                    owl:onProperty osc:ObjectController.controller ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ObjectController.catalogReference ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ObjectController.name ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ObjectController.controller ] [ a owl:Restriction ;
                                    owl:onClass osc:CatalogReference ;
                                    owl:onProperty osc:ObjectController.catalogReference ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Definition of a controller for a scenario object. Either an inline definition or a catalog reference to a controller."@en .

osc:RelativeDistanceCondition a owl:Class ;
    rdfs:label "RelativeDistanceCondition"@en ;
    rdfs:comment "The current relative distance of a triggering entity/entities to a reference entity is compared to a given value. The logical operator used for comparison is defined in the rule attribute."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:RelativeDistanceCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:RelativeDistanceCondition.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:RelativeDistanceCondition.coordinateSystem ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:RelativeDistanceCondition.freespace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:RelativeDistanceCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RoutingAlgorithm ;
            owl:onProperty osc:RelativeDistanceCondition.routingAlgorithm ],
        [ a owl:Restriction ;
            owl:onDataRange osc:RelativeDistanceType ;
            owl:onProperty osc:RelativeDistanceCondition.relativeDistanceType ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The current relative distance of a triggering entity/entities to a reference entity is compared to a given value. The logical operator used for comparison is defined in the rule attribute."@en .

osc:Route a owl:Class ;
    rdfs:label "Route"@en ;
    rdfs:comment "A route is defined in a scenario or in a catalog. It represents a continuous path throughout the road network, defined by a series of waypoints."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Route.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Waypoint ;
            owl:onProperty osc:Route.waypoints ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:Route.closed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "A route is defined in a scenario or in a catalog. It represents a continuous path throughout the road network, defined by a series of waypoints."@en .

osc:ScenarioDefinition a owl:Class ;
    rdfs:label "ScenarioDefinition"@en ;
    rdfs:comment "Top level container containing all scenario elements."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:CatalogLocations ;
            owl:onProperty osc:ScenarioDefinition.catalogLocations ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:RoadNetwork ;
            owl:onProperty osc:ScenarioDefinition.roadNetwork ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Entities ;
            owl:onProperty osc:ScenarioDefinition.entities ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Storyboard ;
            owl:onProperty osc:ScenarioDefinition.storyboard ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Top level container containing all scenario elements."@en .

osc:StochasticDistributionType a owl:Class ;
    rdfs:label "StochasticDistributionType"@en ;
    rdfs:comment "Container for a stochastic distribution type which can be applied to a single parameter."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:ProbabilityDistributionSet ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ] [ a owl:Restriction ;
                                    owl:onClass osc:UniformDistribution ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ] [ a owl:Restriction ;
                                    owl:onClass osc:Histogram ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ] [ a owl:Restriction ;
                                    owl:onClass osc:NormalDistribution ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ] [ a owl:Restriction ;
                                    owl:onClass osc:PoissonDistribution ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ] [ a owl:Restriction ;
                                    owl:onClass osc:LogNormalDistribution ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.probabilityDistributionSet ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.uniformDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.histogram ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.normalDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.poissonDistribution ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:StochasticDistributionType.logNormalDistribution ] [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedDistribution ;
                                    owl:onProperty osc:StochasticDistributionType.userDefinedDistribution ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Container for a stochastic distribution type which can be applied to a single parameter."@en .

osc:TrafficSignalController a owl:Class ;
    rdfs:label "TrafficSignalController"@en ;
    rdfs:comment "The TrafficSignalController provides a signal cycle to a single signal or a signal group."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalController.reference ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:TrafficSignalController.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSignalController.delay ] ;
    skos:definition "The TrafficSignalController provides a signal cycle to a single signal or a signal group."@en .

osc:TrafficSourceAction a owl:Class ;
    rdfs:label "TrafficSourceAction"@en ;
    rdfs:comment "Defines a source of traffic at a specific position."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSourceAction.radius ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSourceAction.velocity ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSourceAction.speed ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDefinition ;
            owl:onProperty osc:TrafficSourceAction.trafficDefinition ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:TrafficDistribution ;
            owl:onProperty osc:TrafficSourceAction.trafficDistribution ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:TrafficSourceAction.rate ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:TrafficSourceAction.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines a source of traffic at a specific position."@en .

osc:Trajectory a owl:Class ;
    rdfs:label "Trajectory"@en ;
    rdfs:comment "Definition of a trajectory type in terms of shape and optional time domain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:Trajectory.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:Trajectory.closed ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Shape ;
            owl:onProperty osc:Trajectory.shape ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of a trajectory type in terms of shape and optional time domain."@en .

osc:Trigger a owl:Class ;
    rdfs:label "Trigger"@en ;
    rdfs:comment "A trigger is defined as an association of condition groups. A trigger evaluates to true if at least one of the associated condition groups evaluates to true, otherwise it evaluates to false (OR operation)."@en ;
    skos:definition "A trigger is defined as an association of condition groups. A trigger evaluates to true if at least one of the associated condition groups evaluates to true, otherwise it evaluates to false (OR operation)."@en .

osc:ActivateControllerAction a owl:Class ;
    rdfs:label "ActivateControllerAction"@en ;
    rdfs:comment """This action activates or deactivates a user-defined controller which must be assigned to the specified entity. A controller cannot be activated in a domain in which it is not defined.\r
\r
Note: Although it is allowed to omit the objectControllerRef attribute for the sake of a backward compatibility if only a single user-defined controller is assigned to the concerned Entity, it is considered unmeaningful in case of multiple controllers are assigned. This is expected to be addressed in one of the follow-up major versions, where the attribute shall be defined as mandatory to exclude an ambiguity in specifying the reference controller."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Controller ;
            owl:onProperty osc:ActivateControllerAction.controllerRef ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:ActivateControllerAction.lighting ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:ObjectController ;
            owl:onProperty osc:ActivateControllerAction.objectControllerRef ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:ActivateControllerAction.animation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:ActivateControllerAction.longitudinal ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:ActivateControllerAction.lateral ] ;
    skos:definition """This action activates or deactivates a user-defined controller which must be assigned to the specified entity. A controller cannot be activated in a domain in which it is not defined.\r
\r
Note: Although it is allowed to omit the objectControllerRef attribute for the sake of a backward compatibility if only a single user-defined controller is assigned to the concerned Entity, it is considered unmeaningful in case of multiple controllers are assigned. This is expected to be addressed in one of the follow-up major versions, where the attribute shall be defined as mandatory to exclude an ambiguity in specifying the reference controller."""@en .

osc:Axle a owl:Class ;
    rdfs:label "Axle"@en ;
    rdfs:comment "The definition of vehicle axle."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Axle.wheelDiameter ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Axle.trackWidth ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Axle.maxSteering ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Axle.positionZ ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:Axle.positionX ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "The definition of vehicle axle."@en .

osc:BoundingBox a owl:Class ;
    rdfs:label "BoundingBox"@en ;
    rdfs:comment "Defines geometric properties of the entities as a simplified three dimensional bounding box."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass osc:Dimensions ;
            owl:onProperty osc:BoundingBox.dimensions ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Center ;
            owl:onProperty osc:BoundingBox.center ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Defines geometric properties of the entities as a simplified three dimensional bounding box."@en .

osc:ByValueCondition a owl:Class ;
    rdfs:label "ByValueCondition"@en ;
    rdfs:comment "Conditions referring a runtime value."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:VariableCondition ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSignalControllerCondition ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:TimeOfDayCondition ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:StoryboardElementStateCondition ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:UserDefinedValueCondition ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:SimulationTimeCondition ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:ParameterCondition ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.variableCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalControllerCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.timeOfDayCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.storyboardElementStateCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.userDefinedValueCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.simulationTimeCondition ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:ByValueCondition.parameterCondition ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficSignalCondition ;
                                    owl:onProperty osc:ByValueCondition.trafficSignalCondition ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Conditions referring a runtime value."@en .

osc:DistanceCondition a owl:Class ;
    rdfs:label "DistanceCondition"@en ;
    rdfs:comment "The current distance between an entity and a position is compared to a given distance (less, greater, equal). Several additional parameters like free space etc. can be defined. The property \"alongRoute\" is deprecated. If \"coordinateSystem\" or \"relativeDistanceType\" are set, \"alongRoute\" is ignored."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:DistanceCondition.value ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:Position ;
            owl:onProperty osc:DistanceCondition.position ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange osc:Rule ;
            owl:onProperty osc:DistanceCondition.rule ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:DistanceCondition.coordinateSystem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RoutingAlgorithm ;
            owl:onProperty osc:DistanceCondition.routingAlgorithm ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:DistanceCondition.alongRoute ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:DistanceCondition.freespace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:RelativeDistanceType ;
            owl:onProperty osc:DistanceCondition.relativeDistanceType ] ;
    skos:definition "The current distance between an entity and a position is compared to a given distance (less, greater, equal). Several additional parameters like free space etc. can be defined. The property \"alongRoute\" is deprecated. If \"coordinateSystem\" or \"relativeDistanceType\" are set, \"alongRoute\" is ignored."@en .

osc:GeoPosition a owl:Class ;
    rdfs:label "GeoPosition"@en ;
    rdfs:comment """Position defined in terms of the spherical geographic coordinates (angular Longitude and Latitude) derived from the geodetic datum specified in the respective road network definition file (external to the ASAM OpenSCENARIO). Optionally, the orientation of the position can be specified.\r
In the general case, the altitude of the target position above a conventional reference level (e.g., the mean sea level on the Earth) is determined by the surface of the underlying road, which is derived from the Longitude/Latitude-coordinates of the position. However, optionally, the altitude of the target position with respect to the road surface can be specified.\r
The orientation of the road in the inertial (X,Y,Z)-coordinate system, in turn, is specified in the respective road network definition file too.\r
The transformation of angular geographic coordinates into the flat (X,Y)-projection in the World coordinate system is entrusted to a simulation environment. However, if the target position would be outside the road boundaries, the Z-coordinate of the position is undefined by the OpenSCENARIO standard."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:GeoPosition.longitudeDeg ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:GeoPosition.altitude ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Orientation ;
            owl:onProperty osc:GeoPosition.orientation ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:GeoPosition.latitudeDeg ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:GeoPosition.longitude ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:GeoPosition.latitude ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:GeoPosition.height ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:int ;
            owl:onProperty osc:GeoPosition.verticalRoadSelection ] ;
    skos:definition """Position defined in terms of the spherical geographic coordinates (angular Longitude and Latitude) derived from the geodetic datum specified in the respective road network definition file (external to the ASAM OpenSCENARIO). Optionally, the orientation of the position can be specified.\r
In the general case, the altitude of the target position above a conventional reference level (e.g., the mean sea level on the Earth) is determined by the surface of the underlying road, which is derived from the Longitude/Latitude-coordinates of the position. However, optionally, the altitude of the target position with respect to the road surface can be specified.\r
The orientation of the road in the inertial (X,Y,Z)-coordinate system, in turn, is specified in the respective road network definition file too.\r
The transformation of angular geographic coordinates into the flat (X,Y)-projection in the World coordinate system is entrusted to a simulation environment. However, if the target position would be outside the road boundaries, the Z-coordinate of the position is undefined by the OpenSCENARIO standard."""@en .

osc:GlobalAction a owl:Class ;
    rdfs:label "GlobalAction"@en ;
    rdfs:comment "Actions that does not explicitly target an entity’s state."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:onClass osc:ParameterAction ;
                                    owl:onProperty osc:GlobalAction.parameterAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.environmentAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.trafficAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.variableAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.entityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.parameterAction ] [ a owl:Restriction ;
                                    owl:onClass osc:InfrastructureAction ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.environmentAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.trafficAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.variableAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.entityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.parameterAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ] [ a owl:Restriction ;
                                    owl:onClass osc:EnvironmentAction ;
                                    owl:onProperty osc:GlobalAction.environmentAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.trafficAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.variableAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.entityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.parameterAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.environmentAction ] [ a owl:Restriction ;
                                    owl:onClass osc:TrafficAction ;
                                    owl:onProperty osc:GlobalAction.trafficAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.variableAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.entityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.parameterAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.environmentAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.trafficAction ] [ a owl:Restriction ;
                                    owl:onClass osc:VariableAction ;
                                    owl:onProperty osc:GlobalAction.variableAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.entityAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.parameterAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.environmentAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.trafficAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.variableAction ] [ a owl:Restriction ;
                                    owl:onClass osc:EntityAction ;
                                    owl:onProperty osc:GlobalAction.entityAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ] ) ] [ a owl:Class ;
                        owl:intersectionOf ( [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.parameterAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.infrastructureAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.environmentAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.trafficAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.variableAction ] [ a owl:Restriction ;
                                    owl:cardinality "0"^^xsd:nonNegativeInteger ;
                                    owl:onProperty osc:GlobalAction.entityAction ] [ a owl:Restriction ;
                                    owl:onClass osc:SetMonitorAction ;
                                    owl:onProperty osc:GlobalAction.setMonitorAction ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] ) ] ;
    skos:definition "Actions that does not explicitly target an entity’s state."@en .

osc:LongitudinalDistanceAction a owl:Class ;
    rdfs:label "LongitudinalDistanceAction"@en ;
    rdfs:comment """This action activates a controller for the longitudinal behavior of an entity in a way that a given distance or time gap to the reference entity is maintained.\r
The target position may be either on the same road segment where the reference entity is positioned or on a connecting road. In the latter case for coordinate systems lane and road, the distance or time gap is calculated along the road reference line / lane centerline of the connecting road. It is assumed that the reference line of the road / lane centerline of the reference entity continues seamlessly on the connecting road (even if its shape changes). It is assumed that the target position relates to the routing of the reference entity. Otherwise, the calculation of the target position cannot be interpreted within the OpenSCENARIO standard."""@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:LongitudinalDisplacement ;
            owl:onProperty osc:LongitudinalDistanceAction.displacement ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:LongitudinalDistanceAction.freespace ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty osc:LongitudinalDistanceAction.continuous ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LongitudinalDistanceAction.distance ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:LongitudinalDistanceAction.timeGap ],
        [ a owl:Restriction ;
            owl:onClass osc:Entity ;
            owl:onProperty osc:LongitudinalDistanceAction.entityRef ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange osc:CoordinateSystem ;
            owl:onProperty osc:LongitudinalDistanceAction.coordinateSystem ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:DynamicConstraints ;
            owl:onProperty osc:LongitudinalDistanceAction.dynamicConstraints ] ;
    skos:definition """This action activates a controller for the longitudinal behavior of an entity in a way that a given distance or time gap to the reference entity is maintained.\r
The target position may be either on the same road segment where the reference entity is positioned or on a connecting road. In the latter case for coordinate systems lane and road, the distance or time gap is calculated along the road reference line / lane centerline of the connecting road. It is assumed that the reference line of the road / lane centerline of the reference entity continues seamlessly on the connecting road (even if its shape changes). It is assumed that the target position relates to the routing of the reference entity. Otherwise, the calculation of the target position cannot be interpreted within the OpenSCENARIO standard."""@en .

osc:MiscObject a owl:Class ;
    rdfs:label "MiscObject"@en ;
    rdfs:comment "Definition of a miscellaneous object type. A miscellaneous object has no controller."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange osc:MiscObjectCategory ;
            owl:onProperty osc:MiscObject.miscObjectCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:MiscObject.name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass osc:BoundingBox ;
            owl:onProperty osc:MiscObject.boundingBox ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass osc:Properties ;
            owl:onProperty osc:MiscObject.properties ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty osc:MiscObject.model3d ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:double ;
            owl:onProperty osc:MiscObject.mass ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "Definition of a miscellaneous object type. A miscellaneous object has no controller."@en .

