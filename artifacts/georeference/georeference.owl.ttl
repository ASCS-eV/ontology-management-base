georeference:BoundingBox a owl:Class ;
	rdfs:comment "Bounding box of the asset in world coordinates."@en ;
	rdfs:label "BoundingBox"@en ;
	rdfs:subClassOf _:b149db98057f7 , _:b3b98bb110f7e , _:b4eabee38d395 , _:b5089d6824f2b , _:b547c92d63500 , _:b6534a694469e , _:b67dd569d935f , _:b7beb5694e77e , _:bae6fdb98451a , _:bb5cf5d61fe7b , _:be7deb8ad17b2 , _:beba645842b1c ;
	skos:exactMatch georeference:BoundingBox ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:GeodeticReferenceSystem a owl:Class ;
	rdfs:comment "Positions (origin and viewpoint), projection and height system of the asset."@en ;
	rdfs:label "GeodeticReferenceSystem"@en ;
	rdfs:subClassOf _:b082c7fac1eeb , _:b0e12c609b0e7 , _:b23af1d4525bd , _:b2dc96810a18a , _:b3708849928ed , _:b5d6ec46a4c31 , _:b696296fa3daa , _:b6b3037f398f8 , _:b7d7735374f0b , _:b85d300bfad42 , _:ba1fc777284e7 , _:ba4cecde3ef3b , _:bb1086e591c7f , _:bcb2a4a3c878d , _:bd38bf2a6789d , _:bf9b41c8198d1 ;
	skos:exactMatch georeference:GeodeticReferenceSystem ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:Georeference a owl:Class ;
	rdfs:comment "A georeferencing dataset that defines the coordinate system, location, and spatial properties of a simulation asset. This class serves as an optional metadata extension and does not function as a standalone data resource."@en ;
	rdfs:label "Georeference"@en ;
	rdfs:subClassOf _:b16309eeb509b , _:b2989d3793611 , _:b6fd75c665664 , _:bc480c3b179e8 , _:bda647818b43a , _:bee55ead258c2 ;
	skos:exactMatch georeference:Georeference ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:HeightSystemEnum\#Ellipsoidal\%20height a owl:Class ;
	rdfs:label "Ellipsoidal height"@en ;
	rdfs:subClassOf georeference:HeightSystemEnum .
georeference:HeightSystemEnum\#Local\%20height a owl:Class ;
	rdfs:label "Local height"@en ;
	rdfs:subClassOf georeference:HeightSystemEnum .
georeference:HeightSystemEnum\#Orthometric\%20height a owl:Class ;
	rdfs:label "Orthometric height"@en ;
	rdfs:subClassOf georeference:HeightSystemEnum .
georeference:HeightSystemEnum a owl:Class ;
	rdfs:label "HeightSystemEnum"@en ;
	owl:unionOf _:bee6e25af22bc ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> ;
	linkml:permissible_values georeference:HeightSystemEnum\#Ellipsoidal\%20height , georeference:HeightSystemEnum\#Local\%20height , georeference:HeightSystemEnum\#Orthometric\%20height .
georeference:LatLonCoordinate a owl:Class ;
	rdfs:comment "A position in world coordinates."@en ;
	rdfs:label "LatLonCoordinate"@en ;
	rdfs:subClassOf _:b050c9a6e2126 , _:b40480c37b123 , _:b6300f8e50750 , _:b88b21cdd09a7 , _:b95915be88ba3 , _:ba82e975b8f05 ;
	skos:exactMatch georeference:LatLonCoordinate ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:ProjectLocation a owl:Class ;
	rdfs:comment "Describes where the asset is located."@en ;
	rdfs:label "ProjectLocation"@en ;
	rdfs:subClassOf _:b2412e6e29aef , _:b25abae3bfe4a , _:b2d037a8e3e7a , _:b342fd412a877 , _:b6132495d1ad0 , _:b738163a3987b , _:b7b6bf7be9809 , _:b8160c2325ed5 , _:b8f0a38791768 , _:b9ced8e1a9c77 , _:ba2ab10152014 , _:bb4f7202cd387 , _:bbb5785f75b7d , _:bc9ad426074d3 , _:bd83d1e928e68 , _:bde2a403086fc , _:bec00aa24fd60 , _:bf0d025a616e5 ;
	skos:exactMatch georeference:ProjectLocation ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:city a owl:DatatypeProperty ;
	rdfs:comment "Specifies the name of the city in which the asset's centre is located."@en ;
	rdfs:label "city"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:codeEPSG a owl:DatatypeProperty ;
	rdfs:comment "Defines the projection EPSG code for the asset."@en ;
	rdfs:label "codeEPSG"@en ;
	rdfs:range xsd:integer ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:coordinateSystemName a owl:DatatypeProperty ;
	rdfs:comment "Describes the coordinate system name of the asset as an alternative to the EPSG code."@en ;
	rdfs:label "coordinateSystemName"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:country a owl:DatatypeProperty ;
	rdfs:comment "Defines an ISO 3166-1, alpha-2 code for the country in which the asset centre is located."@en ;
	rdfs:label "georeferenceCountry"@en ;
	rdfs:range _:beba1b3bf1c9d ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> ;
	skos:prefLabel "country"@en .
georeference:hasBoundingBox a owl:ObjectProperty ;
	rdfs:comment "Defines the bounding box in world coordinates of the asset."@en ;
	rdfs:label "hasBoundingBox"@en ;
	rdfs:range georeference:BoundingBox ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:hasGeodeticReferenceSystem a owl:ObjectProperty ;
	rdfs:comment "Properties for positions (e.g., origin and viewpoint), projection type and height system of the asset."@en ;
	rdfs:label "hasGeodeticReferenceSystem"@en ;
	rdfs:range georeference:GeodeticReferenceSystem ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:hasOrigin a owl:ObjectProperty ;
	rdfs:comment "Defines the center position of the asset in world coordinates."@en ;
	rdfs:label "hasOrigin"@en ;
	rdfs:range georeference:LatLonCoordinate ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:hasProjectLocation a owl:ObjectProperty ;
	rdfs:comment "Contains properties (state, city, region, country, bounding) to describe the location of the asset."@en ;
	rdfs:label "hasProjectLocation"@en ;
	rdfs:range georeference:ProjectLocation ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:hasViewPoint a owl:ObjectProperty ;
	rdfs:comment "Defines the imported viewpoint position of the asset in world coordinates."@en ;
	rdfs:label "hasViewPoint"@en ;
	rdfs:range georeference:LatLonCoordinate ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:heightSystem a owl:ObjectProperty ;
	rdfs:comment "Defines the height system type of the asset."@en ;
	rdfs:label "heightSystem"@en ;
	rdfs:range georeference:HeightSystemEnum ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:lat a owl:DatatypeProperty ;
	rdfs:comment "Defines a world latitude value (on the y-axis) in degrees."@en ;
	rdfs:label "lat"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:lon a owl:DatatypeProperty ;
	rdfs:comment "Defines a world longitude value (on the x-axis) in degrees."@en ;
	rdfs:label "lon"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:region a owl:DatatypeProperty ;
	rdfs:comment "Specifies the name of the region in which the asset's centre is located."@en ;
	rdfs:label "georeferenceRegion"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> ;
	skos:prefLabel "region"@en .
georeference:relationOrArea a owl:DatatypeProperty ;
	rdfs:comment "Describes the area in which the asset is located, such as the name of the main street or the greater area."@en ;
	rdfs:label "relationOrArea"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:state a owl:DatatypeProperty ;
	rdfs:comment "Defines an ISO 3166-2 code for the state or province in which the asset centre is located."@en ;
	rdfs:label "state"@en ;
	rdfs:range _:b9ae74ab3aad9 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:xMax a owl:DatatypeProperty ;
	rdfs:comment "Defines the maximum bounding box value along the x-axis."@en ;
	rdfs:label "xMax"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:xMin a owl:DatatypeProperty ;
	rdfs:comment "Defines the minimum bounding box value along the x-axis."@en ;
	rdfs:label "xMin"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:yMax a owl:DatatypeProperty ;
	rdfs:comment "Defines the maximum bounding box value along the y-axis."@en ;
	rdfs:label "yMax"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
georeference:yMin a owl:DatatypeProperty ;
	rdfs:comment "Defines the minimum bounding box value along the y-axis."@en ;
	rdfs:label "yMin"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/georeference/v6> .
