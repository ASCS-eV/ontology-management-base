{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "dcterms": "http://purl.org/dc/terms/",
      "georeference": "https://w3id.org/ascs-ev/envited-x/georeference/v6/",
      "linkml": "https://w3id.org/linkml/",
      "owl": "http://www.w3.org/2002/07/owl#",
      "prov": "http://www.w3.org/ns/prov#",
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "@vocab": "https://w3id.org/ascs-ev/envited-x/georeference/v6/",
      "city": {
         "@id": "city"
      },
      "codeEPSG": {
         "@type": "xsd:integer",
         "@id": "codeEPSG"
      },
      "coordinateSystemName": {
         "@id": "coordinateSystemName"
      },
      "country": {
         "@id": "country"
      },
      "region": {
         "@id": "region"
      },
      "hasBoundingBox": {
         "@type": "@id",
         "@id": "hasBoundingBox"
      },
      "hasGeodeticReferenceSystem": {
         "@type": "@id",
         "@id": "hasGeodeticReferenceSystem"
      },
      "hasOrigin": {
         "@type": "@id",
         "@id": "hasOrigin"
      },
      "hasProjectLocation": {
         "@type": "@id",
         "@id": "hasProjectLocation"
      },
      "hasViewPoint": {
         "@type": "@id",
         "@id": "hasViewPoint"
      },
      "heightSystem": {
         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "heightSystem"
      },
      "lat": {
         "@type": "xsd:float",
         "@id": "lat"
      },
      "lon": {
         "@type": "xsd:float",
         "@id": "lon"
      },
      "relationOrArea": {
         "@id": "relationOrArea"
      },
      "state": {
         "@id": "state"
      },
      "xMax": {
         "@type": "xsd:float",
         "@id": "xMax"
      },
      "xMin": {
         "@type": "xsd:float",
         "@id": "xMin"
      },
      "yMax": {
         "@type": "xsd:float",
         "@id": "yMax"
      },
      "yMin": {
         "@type": "xsd:float",
         "@id": "yMin"
      },
      "BoundingBox": {
         "@id": "BoundingBox"
      },
      "GeodeticReferenceSystem": {
         "@id": "GeodeticReferenceSystem"
      },
      "Georeference": {
         "@id": "Georeference"
      },
      "LatLonCoordinate": {
         "@id": "LatLonCoordinate"
      },
      "ProjectLocation": {
         "@id": "ProjectLocation"
      }
   }
}
