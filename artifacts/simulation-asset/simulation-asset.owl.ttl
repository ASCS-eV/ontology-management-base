	rdfs:comment "A name given to the resource."@en ;
	rdfs:label "title"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:type a owl:ObjectProperty ;
	rdfs:comment "The role the dataset plays in a simulation."@en ;
	rdfs:label "type"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
spdx:Checksum a owl:Class ;
	rdfs:comment "The result of applying a hash algorithm to a file (SPDX 2.3), as DCAT 3 recommends for distributions."@en ;
	rdfs:label "Checksum"@en ;
	rdfs:subClassOf _:b0ca788c990a4 , _:b282edcc6d543 , _:bb3c6e3a1afaa , _:bba599883fb07 , _:bcf73163f2650 ;
	skos:exactMatch simulation-asset:Checksum ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
spdx:ChecksumAlgorithm a owl:Class .
spdx:algorithm a owl:ObjectProperty ;
	rdfs:comment "The hash algorithm used to compute the checksum."@en ;
	rdfs:label "algorithm"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
spdx:checksum a owl:ObjectProperty ;
	rdfs:comment "A checksum of the file."@en ;
	rdfs:label "checksum"@en ;
	rdfs:range spdx:Checksum ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
spdx:checksumAlgorithm_sha256 a spdx:ChecksumAlgorithm , owl:NamedIndividual , simulation-asset:ChecksumAlgorithm ;
	rdfs:label "checksumAlgorithm_sha256"@en .
