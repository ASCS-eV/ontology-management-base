	rdfs:label "RESTRICTED"@en .
dcterms:RightsStatement a owl:Class .
dcterms:accessRights a owl:ObjectProperty ;
	rdfs:comment "Who may access the resource, from the EU access-right authority table (public, restricted, non-public) that DCAT-AP uses."@en ;
	rdfs:label "accessRights"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:conformsTo a owl:ObjectProperty ;
	rdfs:comment "An established standard the file conforms to, e.g. ASAM OpenSCENARIO XML."@en ;
	rdfs:label "conformsTo"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:contributor a owl:AnnotationProperty .
