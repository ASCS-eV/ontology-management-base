	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:isVersionOf a owl:ObjectProperty ;
	rdfs:comment "The resource of which this one is a version: links a content-addressed edition to the stable, version-independent identity of the resource. DCAT 3's inverse dcat:isVersionOf may only be stated in addition to dcat:hasVersion on the logical resource, never in its place (DCAT 3 section 7); the DCMI property carries the back link on its own."@en ;
	rdfs:label "isVersionOf"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:issued a owl:DatatypeProperty ;
	rdfs:comment "Date and time of formal issuance (publication) of the resource."@en ;
	rdfs:label "issued"@en ;
	rdfs:range xsd:dateTime ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:license a owl:ObjectProperty ;
	rdfs:comment "A legal document giving permission to use the resource, e.g. an SPDX license IRI."@en ;
	rdfs:label "license"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:publisher a owl:AnnotationProperty .
dcterms:references a owl:AnnotationProperty .
dcterms:requires a owl:ObjectProperty ;
	rdfs:comment "A separately published dataset the described one needs but does not include, e.g. a road network offered as an asset of its own."@en ;
	rdfs:label "requires"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcterms:source a owl:AnnotationProperty .
