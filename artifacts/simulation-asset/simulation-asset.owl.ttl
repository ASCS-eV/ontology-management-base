	rdfs:label "checksumAlgorithm_sha384"@en .
spdx:checksumAlgorithm_sha512 a spdx:ChecksumAlgorithm , owl:NamedIndividual , simulation-asset:ChecksumAlgorithm ;
	rdfs:label "checksumAlgorithm_sha512"@en .
spdx:checksumValue a owl:DatatypeProperty ;
	rdfs:comment "The checksum value, in lower-case hexadecimal as SPDX 2.3 requires."@en ;
	rdfs:label "checksumValue"@en ;
	rdfs:range xsd:hexBinary ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
xsd:hexBinary a rdfs:Datatype .
skos:Concept a owl:Class .
skos:exactMatch a owl:AnnotationProperty .
skos:inScheme a owl:AnnotationProperty .
dcat:Catalog a owl:Class ;
	rdfs:comment "A curated collection of dataset descriptions (W3C DCAT 3), e.g. every simulation asset of one source-repository revision. As in DCAT 3, a catalog is itself a dataset."@en ;
	rdfs:label "Catalog"@en ;
	rdfs:subClassOf dcat:Dataset , _:b36b28b18ac7e , _:b65335d5a969f , _:bf1951c5f0883 ;
	skos:exactMatch simulation-asset:Catalog ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:Dataset a owl:Class ;
	rdfs:comment "A collection of data published or curated by a single agent (W3C DCAT 3). Every resource a simulation needs or produces is one: a scenario, a road network, a 3D model, an OSI trace."@en ;
	rdfs:label "Dataset"@en ;
	rdfs:subClassOf _:b1be2a04ea3aa , _:b2b163e8007ef , _:b42410b308753 , _:b49e8e50e2803 , _:b50ccfed91619 , _:b601125a3fc38 , _:b6c8dfcb2f04a , _:b73b6f0cb4191 , _:b7ea966e7ee66 , _:bb027510ce292 , _:bbd32173b336e , _:bc6a599995029 , _:bc6ce5fce6835 , _:bde1ccd9bf6b9 , _:bea9332330244 , _:bf648d7e478cd ;
	skos:exactMatch simulation-asset:Dataset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:Distribution a owl:Class ;
	rdfs:comment "A specific representation of a dataset (W3C DCAT 3), typically a file, identified by its checksum and reachable through an access or download URL."@en ;
	rdfs:label "Distribution"@en ;
	rdfs:subClassOf _:b0faed37663cc , _:b44be8e3a66d4 , _:b5bc91aa5615d , _:b6c834f4dab92 , _:b86bc9c5b735c , _:b87b515d3c184 , _:bd0f0fcf49007 ;
	skos:exactMatch simulation-asset:Distribution ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:accessURL a owl:ObjectProperty ;
	rdfs:comment "A URL of a resource that gives access to the file, e.g. a repository browser page."@en ;
	rdfs:label "accessURL"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:byteSize a owl:DatatypeProperty ;
	rdfs:comment "The size of the file in bytes."@en ;
	rdfs:label "byteSize"@en ;
	rdfs:range _:bac4aafcad941 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:dataset a owl:ObjectProperty ;
	rdfs:comment "A dataset listed in the catalog."@en ;
	rdfs:label "dataset"@en ;
	rdfs:range dcat:Dataset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:distribution a owl:ObjectProperty ;
	rdfs:comment "An available representation of the dataset, e.g. its file or a packaged archive."@en ;
	rdfs:label "distribution"@en ;
	rdfs:range dcat:Distribution ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:downloadURL a owl:ObjectProperty ;
	rdfs:comment "The URL of the downloadable file."@en ;
	rdfs:label "downloadURL"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:keyword a owl:DatatypeProperty ;
	rdfs:comment "A keyword or tag describing the resource."@en ;
	rdfs:label "keyword"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:mediaType a owl:ObjectProperty ;
	rdfs:comment "The media type of the file, as an IANA media-type IRI (https://www.iana.org/assignments/media-types/<type>/<subtype>)."@en ;
	rdfs:label "mediaType"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
dcat:version a owl:DatatypeProperty ;
	rdfs:comment "The version indicator of this edition of the resource, e.g. a content digest or a release number."@en ;
	rdfs:label "version"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:Activity a owl:Class ;
	rdfs:comment "Something that occurs over a period of time and acts upon or with entities (W3C PROV-O), e.g. a build, a conversion or a simulation run."@en ;
	rdfs:label "Activity"@en ;
	rdfs:subClassOf _:b0c095ca0b5ef , _:b742325f3431b , _:b922ce9406300 , _:b95eca8b978d5 , _:ba0b29dfa6945 , _:bf0a589a31cbc ;
	skos:exactMatch simulation-asset:Activity ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:SoftwareAgent a owl:Class ;
	rdfs:comment "Running software that bears responsibility for an activity (W3C PROV-O), e.g. a simulator or a converter in a given version."@en ;
	rdfs:label "SoftwareAgent"@en ;
	rdfs:subClassOf _:b26ebe52a6386 , _:b5ce3e466324d , _:bfab798043969 ;
	skos:exactMatch simulation-asset:SoftwareAgent ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:endedAtTime a owl:DatatypeProperty ;
	rdfs:comment "When the activity ended."@en ;
	rdfs:label "endedAtTime"@en ;
	rdfs:range xsd:dateTime ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:startedAtTime a owl:DatatypeProperty ;
	rdfs:comment "When the activity started."@en ;
	rdfs:label "startedAtTime"@en ;
	rdfs:range xsd:dateTime ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:used a owl:ObjectProperty ;
	rdfs:comment "A dataset the activity used, e.g. the simulation asset a run executed."@en ;
	rdfs:label "used"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:wasAssociatedWith a owl:ObjectProperty ;
	rdfs:comment "The software that carried out the activity."@en ;
	rdfs:label "wasAssociatedWith"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:wasDerivedFrom a owl:ObjectProperty ;
	rdfs:comment "A dataset this one was derived from by transformation or modification, e.g. the base scenario of a weather variant."@en ;
	rdfs:label "wasDerivedFrom"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
prov:wasGeneratedBy a owl:ObjectProperty ;
	rdfs:comment "The activity that produced the dataset, e.g. a simulation run."@en ;
	rdfs:label "wasGeneratedBy"@en ;
	rdfs:range prov:Activity ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
foaf:name a owl:DatatypeProperty ;
	rdfs:comment "The name of the agent."@en ;
	rdfs:label "name"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
schema:about a owl:ObjectProperty ;
	rdfs:comment "The subject matter of the content: a structured content description, such as a scenario description in a domain ontology or a set of ASAM OpenLABEL tags, referenced by IRI."@en ;
	rdfs:label "about"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
schema:softwareVersion a owl:DatatypeProperty ;
	rdfs:comment "The version of the software."@en ;
	rdfs:label "softwareVersion"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
ontology-header:OntologyHeader a owl:Class .
simulation-asset:AccessRight a owl:Class ;
	rdfs:comment "Access rights from the EU access-right authority table."@en ;
	rdfs:label "AccessRight"@en ;
	owl:oneOf _:b6e32dc4d2dbf ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> ;
	linkml:permissible_values access-right:NON_PUBLIC , access-right:PUBLIC , access-right:RESTRICTED .
simulation-asset:ChecksumAlgorithm a owl:Class ;
	rdfs:comment "Hash algorithms, as SPDX 2.3 checksum-algorithm individuals."@en ;
	rdfs:label "ChecksumAlgorithm"@en ;
	owl:oneOf _:b44b2fa98ece7 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> ;
	linkml:permissible_values spdx:checksumAlgorithm_sha256 , spdx:checksumAlgorithm_sha384 , spdx:checksumAlgorithm_sha512 .
simulation-asset:ResourceType a owl:Class ;
	rdfs:comment "The role a dataset plays in a simulation."@en ;
	rdfs:label "ResourceType"@en ;
	owl:oneOf _:bdc757b59c8ce ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> ;
	linkml:permissible_values simulation-asset:objectModel , simulation-asset:roadNetwork , simulation-asset:scenarioDescription , simulation-asset:sceneryModel , simulation-asset:simulationTrace , simulation-asset:simulatorResource .
simulation-asset:SimulationAsset a owl:Class ;
	rdfs:comment "A self-contained set of data that lets a simulator execute one simulation: a scenario together with the datasets it needs (road network, 3D models, simulator resources), listed as its parts. It is the unit a build system or data platform manages internally and the unit a marketplace offers externally. Its content is described by reference (about), not by subclassing."@en ;
	rdfs:label "SimulationAsset"@en ;
	rdfs:subClassOf dcat:Dataset , _:b16670e38c764 , _:b197e94ad91f3 , _:bd7be434fdcc0 ;
	skos:exactMatch simulation-asset:SimulationAsset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
simulation-asset:SimulationRun a owl:Class ;
	rdfs:comment "One execution of a simulator. It used a simulation asset (and possibly further configuration datasets) and was carried out by a simulator; the results it produced point back to it with prov:wasGeneratedBy."@en ;
	rdfs:label "SimulationRun"@en ;
	rdfs:subClassOf prov:Activity , _:b30b9259f05f6 , _:b7f874e145ad4 ;
	skos:exactMatch simulation-asset:SimulationRun ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> .
simulation-asset:objectModel dcterms:title "Object model"@en ;
	a owl:NamedIndividual , skos:Concept , simulation-asset:ResourceType ;
	rdfs:comment "A 3D model of a road user or another movable object, e.g. in glTF."@en ;
	rdfs:label "objectModel"@en .
simulation-asset:roadNetwork dcterms:title "Road network"@en ;
	a owl:NamedIndividual , skos:Concept , simulation-asset:ResourceType ;
	rdfs:comment "A road network or map, e.g. in ASAM OpenDRIVE or NDS."@en ;
	rdfs:label "roadNetwork"@en .
simulation-asset:scenarioDescription dcterms:title "Scenario description"@en ;
	a owl:NamedIndividual , skos:Concept , simulation-asset:ResourceType ;
	rdfs:comment "A description of the dynamic content of a simulation, e.g. in ASAM OpenSCENARIO XML."@en ;
	rdfs:label "scenarioDescription"@en .
simulation-asset:sceneryModel dcterms:title "Scenery model"@en ;
	a owl:NamedIndividual , skos:Concept , simulation-asset:ResourceType ;
	rdfs:comment "A 3D model of the static environment, e.g. in glTF."@en ;
	rdfs:label "sceneryModel"@en .
simulation-asset:simulationTrace dcterms:title "Simulation trace"@en ;
	a owl:NamedIndividual , skos:Concept , simulation-asset:ResourceType ;
	rdfs:comment "A recording of a simulation run, e.g. an ASAM OSI trace."@en ;
	rdfs:label "simulationTrace"@en .
simulation-asset:simulatorResource dcterms:title "Simulator resource"@en ;
	a owl:NamedIndividual , skos:Concept , simulation-asset:ResourceType ;
	rdfs:comment "A resource the simulator needs to execute the content, e.g. a sensor lookup table or a material definition."@en ;
	rdfs:label "simulatorResource"@en .
<https://w3id.org/ascs-ev/envited-x/simulation-asset/v1> dcterms:conformsTo "https://w3id.org/ascs-ev/envited-x/simulation-asset/v1/shapes"@en ;
	dcterms:contributor <https://github.com/jdsika> ;
	dcterms:creator "The GAIA-X 4 PLC AAD Project Team"@en ;
	dcterms:identifier "https://w3id.org/ascs-ev/envited-x/simulation-asset"@en ;
	dcterms:license "https://www.eclipse.org/legal/epl-2.0/"@en ;
	dcterms:publisher <https://www.asc-s.de/> ;
	dcterms:references <https://www.w3.org/TR/vocab-dcat-3/> ;
	dcterms:source <https://github.com/ASCS-eV/ontology-management-base/releases/tag/v0.6.0> ;
	dcterms:title "Ontology definition for simulation-asset"@en ;
	a owl:Ontology , ontology-header:OntologyHeader ;
	rdfs:comment "A marketplace-neutral core for describing simulation assets (scenarios, road networks, 3D models, simulation results) and their lineage. It is a profile of W3C DCAT 3, PROV-O, DCMI Terms and SPDX 2.3: the classes and properties are the standard terms; the profile only adds the constraints needed to reproduce a simulation from its description."@en ;
	rdfs:label "simulation-asset"@en ;
	rdfs:seeAlso <https://spdx.github.io/spdx-spec/v2.3/> , <https://www.w3.org/TR/prov-o/> , <https://www.w3.org/TR/vocab-dcat-3/> ;
	owl:imports ontologyheader_ontology:v1 ;
	owl:versionInfo "v1"@en .
