	owl:unionOf _:b92284306708a ;
	skos:definition "Types of communication behaviours by road users."@en ;
	skos:editorialNote "Communication signals are not covered by ISO 34504 action tags. These are ASAM OpenLABEL-specific extensions for scenario description fidelity."@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v1.1.0-alpha> ;
	skos:note "ASAM OpenLABEL V1.0.0"@en ;
	linkml:permissible_values openlabel_tagging:CommunicationHeadlightFlash , openlabel_tagging:CommunicationHorn , openlabel_tagging:CommunicationSignalEmergency , openlabel_tagging:CommunicationSignalHazard , openlabel_tagging:CommunicationSignalLeft , openlabel_tagging:CommunicationSignalRight , openlabel_tagging:CommunicationSignalSlowing , openlabel_tagging:CommunicationWave .
