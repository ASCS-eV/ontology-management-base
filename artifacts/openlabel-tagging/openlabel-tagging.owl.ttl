openlabel_tagging:MotionUTurn a owl:DatatypeProperty ;
	rdfs:label "MotionUTurn"@en ;
	rdfs:range xsd:boolean ;
	skos:definition "Subject performs a turn resulting in heading in the opposite direction."@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v1.1.0-alpha> ;
	skos:note "ISO 34504:2023, 4.4.4.3 (Lateral action — turning, left U-turn / right U-turn)"@en .
