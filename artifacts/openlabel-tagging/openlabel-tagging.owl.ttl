	rdfs:label "MotionTurn"@en ;
	rdfs:range xsd:boolean ;
	skos:definition "An activity where the road user changes their heading."@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v1.1.0-alpha> ;
	skos:note "ISO 34504:2023, 4.4.4.3 (Lateral action — turning)"@en .
