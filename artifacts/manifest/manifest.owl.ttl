manifest:LicenseCategory a owl:Class ;
	rdfs:label "LicenseCategory"@en ;
	rdfs:subClassOf manifest:Category ;
	skos:exactMatch manifest:LicenseCategory ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:LicenseLink a owl:Class ;
	rdfs:comment "A Link used for the license of a manifest."@en ;
	rdfs:label "LicenseLink"@en ;
	rdfs:subClassOf manifest:ArtifactLink , _:b19cd7dd2e7c0 , _:b853a39ca0c59 , _:b89a63a3ba50b ;
	skos:exactMatch manifest:LicenseLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:Link a owl:Class ;
	rdfs:comment "Defines a Link instance that connects to data and mandatory metadata within an asset or related published simulation assets; can include web references."@en ;
	rdfs:label "Link"@en ;
