	dcterms:title "Ontology definition for manifest"@en ;
	a owl:Ontology , ontology-header:OntologyHeader ;
	rdfs:comment "An ontology with common classes to describe the structure as list of contents of a domain specific asset using a manifest.json e.g. in an archive."@en ;
	rdfs:label "manifest"@en ;
	rdfs:seeAlso <https://ascs-ev.github.io/EVES/> ;
	owl:imports ontologyheader_ontology:v1 ;
	owl:priorVersion <https://w3id.org/ascs-ev/envited-x/manifest/v5> ;
	owl:versionInfo "v6"@en .
