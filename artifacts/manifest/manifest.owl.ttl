	skos:exactMatch manifest:Link ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:Manifest a owl:Class ;
	rdfs:comment "Defines the structure of an asset (e.g. simulation asset) as list of contents using a manifest.json, listing explicitely included artifacts, referenced artifacts and license information as linked properties. Typically used for archives."@en ;
	rdfs:label "Manifest"@en ;
	rdfs:subClassOf _:b33ae5e324589 , _:b3f9250ca66ac , _:b474820ecf552 , _:b5e57bc604643 , _:b70e10ff21fbd , _:bb10cdc601494 , _:bb1175918cb1b , _:bc868ccc0f919 , _:bdc7c589164ca , _:bf6bab40038a0 ;
