	rdfs:label "AccessRole"@en ;
	rdfs:subClassOf _:b2213b5dada92 , _:becb563f47c2c , _:bf1c00e5806f5 ;
	skos:exactMatch manifest:AccessRole ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:ArtifactLink a owl:Class ;
	rdfs:comment "A Link to an artifact of a manifest: its content, license or a referenced artifact."@en ;
	rdfs:label "ArtifactLink"@en ;
	rdfs:subClassOf manifest:Link ;
	skos:exactMatch manifest:ArtifactLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:Category a owl:Class ;
	rdfs:comment "A class representing different categories of artifacts in a manifest."@en ;
	rdfs:label "Category"@en ;
	rdfs:subClassOf _:b196a71add24e , _:b41e4ba9a55ff , _:be32e101423ff ;
	skos:exactMatch manifest:Category ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:Dimensions a owl:Class ;
	rdfs:comment "General class for defining the dimensions of a data file, e.g., of type image or video, referenced inside a manifest:FileMetadata."@en ;
	rdfs:label "Dimensions"@en ;
