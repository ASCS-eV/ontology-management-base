	rdfs:comment "The access roles manifest defines."@en ;
	rdfs:label "ManifestAccessRoleEnum"@en ;
	owl:oneOf _:b15f4e2c197cf ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> ;
	linkml:permissible_values manifest:isPublic .
manifest:ManifestCategory a owl:Class ;
	rdfs:label "ManifestCategory"@en ;
	rdfs:subClassOf manifest:Category ;
	skos:exactMatch manifest:ManifestCategory ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:ManifestCategoryEnum a owl:Class ;
	rdfs:comment "The artifact categories manifest defines."@en ;
	rdfs:label "ManifestCategoryEnum"@en ;
	owl:oneOf _:bea6423767c00 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> ;
	linkml:permissible_values manifest:isLicense , manifest:isManifest , manifest:isMiscellaneous .
manifest:ManifestLink a owl:Class ;
	rdfs:comment "A Link used for the self-reference of a manifest."@en ;
	rdfs:label "ManifestLink"@en ;
	rdfs:subClassOf manifest:Link , _:b0d23e1a24d5f , _:bbba00972f0bf , _:be560109d0489 ;
	skos:exactMatch manifest:ManifestLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:MiscellaneousCategory a owl:Class ;
	rdfs:label "MiscellaneousCategory"@en ;
	rdfs:subClassOf manifest:Category ;
	skos:exactMatch manifest:MiscellaneousCategory ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:UnitEnum\#inches a owl:Class ;
	rdfs:label "inches"@en ;
	rdfs:subClassOf manifest:UnitEnum .
manifest:UnitEnum\#metres a owl:Class ;
	rdfs:label "metres"@en ;
	rdfs:subClassOf manifest:UnitEnum .
manifest:UnitEnum\#pixels a owl:Class ;
	rdfs:label "pixels"@en ;
	rdfs:subClassOf manifest:UnitEnum .
manifest:UnitEnum a owl:Class ;
	rdfs:label "UnitEnum"@en ;
	owl:unionOf _:b371e4c455744 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> ;
	linkml:permissible_values manifest:UnitEnum\#inches , manifest:UnitEnum\#metres , manifest:UnitEnum\#pixels .
manifest:cid a owl:DatatypeProperty ;
	rdfs:comment "Defines the IPFS CIDv1 identifier of the file."@en ;
	rdfs:label "cid"@en ;
	rdfs:range _:be470300e01fc ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:depth a owl:DatatypeProperty ;
	rdfs:comment "Specifies the depth (z-axis) of the item in appropriate units."@en ;
	rdfs:label "depth"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:filePath a owl:DatatypeProperty ;
	rdfs:comment "A local or remote path/URL from which the file can be retrieved (e.g. './manifest_reference.json', 'ipfs://...', 's3://...', 'https://...')."@en ;
	rdfs:label "filePath"@en ;
	rdfs:range xsd:anyURI ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:fileSize a owl:DatatypeProperty ;
	rdfs:comment "Specifies the file size in bytes."@en ;
	rdfs:label "manifestFileSize"@en ;
	rdfs:range xsd:integer ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> ;
	skos:prefLabel "fileSize"@en .
manifest:filename a owl:DatatypeProperty ;
	rdfs:comment "Specifies the file name (excluding the path) along with its extension."@en ;
	rdfs:label "filename"@en ;
	rdfs:range _:bbc211196a2b4 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasAccessRole a owl:ObjectProperty ;
	rdfs:comment "General property to indicate the access role of an artifact."@en ;
	rdfs:label "hasAccessRole"@en ;
	rdfs:range manifest:AccessRole ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasArtifacts a owl:ObjectProperty ;
	rdfs:comment "Associates a Manifest instance with its artifacts, represented as Link instances; only applicable within Manifest instances."@en ;
	rdfs:label "hasArtifacts"@en ;
	rdfs:range manifest:ArtifactLink ;
	rdfs:subPropertyOf manifest:hasLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasCategory a owl:ObjectProperty ;
	rdfs:comment "General property to indicate the category of an artifact."@en ;
	rdfs:label "hasCategory"@en ;
	rdfs:range manifest:Category ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasDimensions a owl:ObjectProperty ;
	rdfs:comment "Links a Dimensions instance to its associated FileMetadata, defining the size and scale of the data file; applicable only within FileMetadata instances."@en ;
	rdfs:label "hasDimensions"@en ;
	rdfs:range manifest:Dimensions ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasFileMetadata a owl:ObjectProperty ;
	rdfs:comment "Associates a FileMetadata instance with its corresponding Link; only applicable within Link instances."@en ;
	rdfs:label "hasFileMetadata"@en ;
	rdfs:range manifest:FileMetadata ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasLicense a owl:ObjectProperty ;
	rdfs:comment "Associates a Manifest instance with its corresponding license; only applicable within Manifest instances."@en ;
	rdfs:label "hasLicense"@en ;
	rdfs:range manifest:LicenseLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasLink a owl:ObjectProperty ;
	rdfs:comment "States that a subject has a Link instance."@en ;
	rdfs:label "hasLink"@en ;
	rdfs:range manifest:Link ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasManifestReference a owl:ObjectProperty ;
	rdfs:comment "Links a Manifest to its corresponding manifest reference file, defining the structure and contents of a digital asset; only applicable within Manifest instances."@en ;
	rdfs:label "hasManifestReference"@en ;
	rdfs:range manifest:ManifestLink ;
	rdfs:subPropertyOf manifest:hasLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:hasReferencedArtifacts a owl:ObjectProperty ;
	rdfs:comment "Associates a Manifest instance with its referenced artifacts, represented as Link instances; only applicable within Manifest instances."@en ;
	rdfs:label "hasReferencedArtifacts"@en ;
	rdfs:range manifest:ArtifactLink ;
	rdfs:subPropertyOf manifest:hasLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:height a owl:DatatypeProperty ;
	rdfs:comment "Specifies the height (y-axis) of the item in appropriate units."@en ;
	rdfs:label "height"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:id a owl:ObjectProperty ;
	rdfs:comment "The IRI of a named individual."@en ;
	rdfs:label "id"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:iri a owl:ObjectProperty ;
	rdfs:comment "IRI required if the file is RDF/JSON-LD."@en ;
	rdfs:label "iri"@en ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:isLicense dcterms:title "License Category"@en ;
	a owl:NamedIndividual , manifest:LicenseCategory , manifest:ManifestCategoryEnum ;
	rdfs:comment "Indicates that the artifact category is a license."@en ;
	rdfs:label "isLicense"@en .
manifest:isManifest dcterms:title "Manifest Category"@en ;
	a owl:NamedIndividual , manifest:ManifestCategory , manifest:ManifestCategoryEnum ;
	rdfs:comment "Indicates that the artifact category is a manifest."@en ;
	rdfs:label "isManifest"@en .
manifest:isMiscellaneous dcterms:title "Miscellaneous Category"@en ;
	a owl:NamedIndividual , manifest:ManifestCategoryEnum , manifest:MiscellaneousCategory ;
	rdfs:comment "Indicates that the artifact category is miscellaneous."@en ;
	rdfs:label "isMiscellaneous"@en .
manifest:isPublic dcterms:title "Public Access Role"@en ;
	a owl:NamedIndividual , manifest:AccessRole , manifest:ManifestAccessRoleEnum ;
	rdfs:comment "Indicates that the artifact access role is public."@en ;
	rdfs:label "isPublic"@en .
manifest:mimeType a owl:DatatypeProperty ;
	rdfs:comment "Defines the MIME type of the file."@en ;
	rdfs:label "mimeType"@en ;
	rdfs:range _:b915d9c64b981 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:timestamp a owl:DatatypeProperty ;
	rdfs:comment "Represents a date or time associated with the file, such as recording time or creation time."@en ;
	rdfs:label "timestamp"@en ;
	rdfs:range xsd:dateTime ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:unit a owl:ObjectProperty ;
	rdfs:comment "Specifies the unit of measurement (e.g., metres, inches)."@en ;
	rdfs:label "unit"@en ;
	rdfs:range manifest:UnitEnum ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
manifest:width a owl:DatatypeProperty ;
	rdfs:comment "Specifies the width (x-axis) of the item in appropriate units."@en ;
	rdfs:label "width"@en ;
	rdfs:range xsd:float ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
