xsd:anyURI a rdfs:Datatype ;
	owl:equivalentClass xsd:string .
skos:note a owl:DatatypeProperty ;
	rdfs:comment "Additional information about the linked artifact."@en ;
	rdfs:label "note"@en ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/manifest/v6> .
sh:conformsTo a owl:ObjectProperty ;
