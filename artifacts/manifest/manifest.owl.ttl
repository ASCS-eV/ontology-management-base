manifest:isLicense dcterms:title "License Category"@en ;
	a owl:NamedIndividual , manifest:LicenseCategory , manifest:ManifestCategoryEnum ;
	rdfs:comment "Indicates that the artifact category is a license."@en ;
	rdfs:label "isLicense"@en .
manifest:isManifest dcterms:title "Manifest Category"@en ;
	a owl:NamedIndividual , manifest:ManifestCategory , manifest:ManifestCategoryEnum ;
	rdfs:comment "Indicates that the artifact category is a manifest."@en ;
	rdfs:label "isManifest"@en .
manifest:isMiscellaneous dcterms:title "Miscellaneous Category"@en ;
	a owl:NamedIndividual , manifest:ManifestCategoryEnum , manifest:MiscellaneousCategory ;
	rdfs:comment "Indicates that the artifact category is miscellaneous."@en ;
	rdfs:label "isMiscellaneous"@en .
manifest:isPublic dcterms:title "Public Access Role"@en ;
	a owl:NamedIndividual , manifest:AccessRole , manifest:ManifestAccessRoleEnum ;
