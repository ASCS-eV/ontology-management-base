{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "dcterms": "http://purl.org/dc/terms/",
      "linkml": "https://w3id.org/linkml/",
      "manifest": "https://w3id.org/ascs-ev/envited-x/manifest/v6/",
      "owl": "http://www.w3.org/2002/07/owl#",
      "prov": "http://www.w3.org/ns/prov#",
      "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
      "sh": "http://www.w3.org/ns/shacl#",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "@vocab": "https://w3id.org/ascs-ev/envited-x/manifest/v6/",
      "cid": {
         "@id": "cid"
      },
      "depth": {
         "@type": "xsd:float",
         "@id": "depth"
      },
      "filename": {
         "@id": "filename"
      },
      "filePath": {
         "@type": "xsd:anyURI",
         "@id": "filePath"
      },
      "hasAccessRole": {
         "@type": "@id",
         "@id": "hasAccessRole"
      },
      "hasArtifacts": {
         "@type": "@id",
         "@id": "hasArtifacts"
      },
      "hasCategory": {
         "@type": "@id",
         "@id": "hasCategory"
      },
      "hasDimensions": {
         "@type": "@id",
         "@id": "hasDimensions"
      },
      "hasFileMetadata": {
         "@type": "@id",
         "@id": "hasFileMetadata"
      },
      "hasLicense": {
         "@type": "@id",
         "@id": "hasLicense"
      },
      "hasLink": {
         "@type": "@id",
         "@id": "hasLink"
      },
      "hasManifestReference": {
         "@type": "@id",
         "@id": "hasManifestReference"
      },
      "hasReferencedArtifacts": {
         "@type": "@id",
         "@id": "hasReferencedArtifacts"
      },
      "height": {
         "@type": "xsd:float",
         "@id": "height"
      },
      "id": "@id",
      "iri": {
         "@type": "@id",
         "@id": "iri"
      },
      "fileSize": {
         "@type": "xsd:integer",
         "@id": "fileSize"
      },
      "mimeType": {
         "@id": "mimeType"
      },
      "note": {
         "@id": "skos:note"
      },
      "conformsTo": {
         "@type": "@id",
         "@id": "sh:conformsTo"
      },
      "timestamp": {
         "@type": "xsd:dateTime",
         "@id": "timestamp"
      },
      "unit": {
         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "unit"
      },
      "width": {
         "@type": "xsd:float",
         "@id": "width"
      },
      "AccessRole": {
         "@id": "AccessRole"
      },
      "ArtifactLink": {
         "@id": "ArtifactLink"
      },
      "Category": {
         "@id": "Category"
      },
      "Dimensions": {
         "@id": "Dimensions"
      },
      "FileMetadata": {
         "@id": "FileMetadata"
      },
      "LicenseCategory": {
         "@id": "LicenseCategory"
      },
      "LicenseLink": {
         "@id": "LicenseLink"
      },
      "Link": {
         "@id": "Link"
      },
      "Manifest": {
         "@id": "Manifest"
      },
      "ManifestCategory": {
         "@id": "ManifestCategory"
      },
      "ManifestLink": {
         "@id": "ManifestLink"
      },
      "MiscellaneousCategory": {
         "@id": "MiscellaneousCategory"
      }
   }
}
