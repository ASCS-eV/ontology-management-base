	dcterms:title "Ontology definition for envited-x"@en ;
	a owl:Ontology ;
	rdfs:comment "ENVITED-X Data Space ontology with common classes for defining a digital asset in the simulation domain."@en ;
	rdfs:label "envited-x"@en ;
	rdfs:seeAlso <https://ascs-ev.github.io/EVES/> ;
	owl:imports <https://w3id.org/ascs-ev/envited-x/manifest/v6> , gx: ;
	owl:priorVersion <https://w3id.org/ascs-ev/envited-x/envited-x/v3> ;
	owl:versionIRI <https://w3id.org/ascs-ev/envited-x/envited-x/v4> ;
	owl:versionInfo "v4"@en ;
	prov:wasDerivedFrom <https://github.com/ASCS-eV/ontology-management-base/releases/tag/v0.6.0> .
_:b000cb0306dca a owl:Restriction ;
	owl:minCardinality 0 ;
	owl:onProperty envited-x:hasDomainSpecification .
_:b018b984c3019 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty schema:name .
_:b02a89172d6d4 a owl:Restriction ;
	owl:minCardinality 0 ;
	owl:onProperty envited-x:hasDomainSpecification .
_:b04dc38d1c4e7 a owl:Restriction ;
	owl:maxCardinality 1 ;
	owl:onProperty envited-x:hasSoftwareResource .
_:b04e3db3b29a5 a owl:Restriction ;
	owl:allValuesFrom xsd:string ;
	owl:onProperty schema:description .
_:b052589077a09 a owl:Restriction ;
	owl:minCardinality 1 ;
	owl:onProperty schema:name .
_:b05a15c1ffaa0 a owl:Restriction ;
