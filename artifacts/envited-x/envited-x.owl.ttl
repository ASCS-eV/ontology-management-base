@prefix schema: <https://schema.org/> .
envited-x:CodeArtifactBase a owl:Class ;
	rdfs:comment "Base class coupling ENVITED-X code assets to gx:CodeArtifact."@en ;
	rdfs:label "CodeArtifactBase"@en ;
	rdfs:subClassOf gx:CodeArtifact , _:b04e3db3b29a5 , _:b0baebe70df60 , _:b0fa2ef1b0d1f , _:b10d97f052f7e , _:b14f311180904 , _:b1536eac4f7d9 , _:b7b3fda3fba87 , _:b93310cb0d9f3 , _:ba248fdb58033 , _:bc5750221e694 , _:bdf4b7a9ef085 , _:bf456b25b0d1a ;
	skos:exactMatch envited-x:CodeArtifactBase ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:CodeAsset a owl:Class ;
	rdfs:comment "A structured digital asset in the ENVITED-X Data Space representing a code artifact. Carries domain-specific metadata while delegating GX compliance to the linked CodeArtifactBase node."@en ;
	rdfs:label "CodeAsset"@en ;
	rdfs:subClassOf _:b02a89172d6d4 , _:b34da523b73ea , _:b605fc30d80e5 , _:b94212e06a08d , _:b98b5542dbbfd , _:b9ffb8b66e3c7 , _:bbea9051facae , _:bc7ef2d724d83 ;
	skos:exactMatch envited-x:CodeAsset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:Content a owl:Class ;
	rdfs:comment "Defines the content that can be extended for specific asset types."@en ;
	rdfs:label "EnvitedXContent"@en ;
	skos:exactMatch envited-x:EnvitedXContent ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:DataSource a owl:Class ;
	rdfs:comment "Defines which data resources or measurement systems were used that can be extended for specific asset types."@en ;
	rdfs:label "EnvitedXDataSource"@en ;
	skos:exactMatch envited-x:EnvitedXDataSource ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:DomainSpecification a owl:Class ;
	rdfs:comment "A metadata extension that enriches an asset with additional structured information. Unlike envited-x:ResourceDescription, extensions do not represent standalone retrievable data assets but serve as auxiliary metadata linked to an asset."@en ;
	rdfs:label "EnvitedXDomainSpecification"@en ;
	rdfs:subClassOf _:b1cfcd7a0fad6 , _:b20fc724bde52 , _:b280803f2d172 , _:b2bdc4dbe89d2 , _:b539eb17e9d4a , _:b7319ce5ea186 , _:b88b92c69ba75 , _:b9c9110962db8 , _:ba7c4b43c1065 , _:bcce7e407df3e , _:be01c8ce410b3 , _:bf27c5d784273 , _:bf2a040a59b8a ;
	skos:exactMatch envited-x:EnvitedXDomainSpecification ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:EnvitedXAccessRoleEnum a owl:Class ;
	rdfs:comment "The access roles an ENVITED-X link can have."@en ;
	rdfs:label "EnvitedXAccessRoleEnum"@en ;
	owl:oneOf _:baf5e16f82266 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> ;
	linkml:permissible_values envited-x:isOwner , envited-x:isPublic , envited-x:isRegistered .
envited-x:EnvitedXCategoryEnum a owl:Class ;
	rdfs:comment "The categories an ENVITED-X link can have."@en ;
	rdfs:label "EnvitedXCategoryEnum"@en ;
	owl:oneOf _:b1b9bbaa17a3b ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> ;
	linkml:permissible_values envited-x:isDocumentation , envited-x:isLicense , envited-x:isManifest , envited-x:isMedia , envited-x:isMetadata , envited-x:isMiscellaneous , envited-x:isSimulationData , envited-x:isValidationReport .
envited-x:EnvitedXLicenseCategoryEnum a owl:Class ;
	rdfs:comment "The category of a license link."@en ;
	rdfs:label "EnvitedXLicenseCategoryEnum"@en ;
	owl:oneOf _:beb5f61eee88c ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> ;
	linkml:permissible_values envited-x:isLicense .
envited-x:EnvitedXLinkVocabulary a owl:Class ;
	rdfs:comment "The access role and category of a link come from the ENVITED-X vocabulary."@en ;
	rdfs:label "EnvitedXLinkVocabulary"@en ;
	rdfs:subClassOf _:b1886e1c6ad90 , _:b5448fbbbb3c7 , _:b8336fc49e0e8 , _:b91987136fc9e , _:bbdc96be89168 , _:bf10606980694 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:EnvitedXManifestCategoryEnum a owl:Class ;
	rdfs:comment "The category of a link to a manifest."@en ;
	rdfs:label "EnvitedXManifestCategoryEnum"@en ;
	owl:oneOf _:b924cd32243b6 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> ;
	linkml:permissible_values envited-x:isManifest .
envited-x:ExtendedLink a owl:Class ;
	rdfs:comment "A manifest link whose access role and category come from the ENVITED-X vocabulary."@en ;
	rdfs:label "ExtendedLink"@en ;
	rdfs:subClassOf envited-x:EnvitedXLinkVocabulary , manifest:ArtifactLink ;
	skos:exactMatch envited-x:ExtendedLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:Format a owl:Class ;
	rdfs:comment "Contains properties to describe the format that can be extended for specific asset types."@en ;
	rdfs:label "EnvitedXFormat"@en ;
	skos:exactMatch envited-x:EnvitedXFormat ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:LicenseLinkReference a owl:Class ;
	rdfs:comment "The license link of an ENVITED-X manifest. The license itself is stated by gx:license on the resource description."@en ;
	rdfs:label "LicenseLinkReference"@en ;
	rdfs:subClassOf envited-x:EnvitedXLinkVocabulary , manifest:LicenseLink , _:b243926348b3e , _:b3141f6e81fda , _:bc57b2db49a55 ;
	skos:exactMatch envited-x:LicenseLinkReference ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:Manifest a owl:Class ;
	rdfs:comment "Defines a general manifest structure that can be extended for specific asset types, such as HD maps or vehicle models. Every link it lists uses the ENVITED-X access roles and categories."@en ;
	rdfs:label "EnvitedXManifest"@en ;
	rdfs:subClassOf manifest:Manifest , _:b05a15c1ffaa0 , _:b1e50c1f2682d , _:b20859d5ee5fa , _:b447644076095 , _:b53cf23cb6128 , _:b5b131e840a98 , _:b86293c95cb47 , _:b9848d92d11c2 , _:bbca9b5ffc15e , _:bc8be22698db3 , _:bd012db74feff , _:be0eb0513d201 ;
	skos:exactMatch envited-x:EnvitedXManifest ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:ManifestLink a owl:Class ;
	rdfs:comment "The self-reference of an ENVITED-X manifest."@en ;
	rdfs:label "EnvitedXManifestLink"@en ;
	rdfs:subClassOf envited-x:EnvitedXLinkVocabulary , manifest:ManifestLink , _:b2cf485270c11 , _:bd68b0bf4e710 , _:bf1e1a4aeb8b5 ;
	skos:exactMatch envited-x:EnvitedXManifestLink ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:ManifestLinkReference a owl:Class ;
	rdfs:comment "A link to an asset's manifest held elsewhere: it has the category envited-x:isManifest and names the manifest by its IRI, typically a DID."@en ;
	rdfs:label "ManifestLinkReference"@en ;
	rdfs:subClassOf envited-x:ExtendedLink , _:b1c8e549da1d3 , _:b4e6b0ff523a2 , _:b5c10c306ef4a , _:b66c2df880c78 , _:b9c8afffde540 , _:bf38888853359 ;
	skos:exactMatch envited-x:ManifestLinkReference ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:Quality a owl:Class ;
	rdfs:comment "Contains properties to describe general quality criteria that can be extended for specific asset types."@en ;
	rdfs:label "EnvitedXQuality"@en ;
	skos:exactMatch envited-x:EnvitedXQuality ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:Quantity a owl:Class ;
	rdfs:comment "Contains properties to describe the quantity related criteria that can be extended for specific asset types."@en ;
	rdfs:label "EnvitedXQuantity"@en ;
	skos:exactMatch envited-x:EnvitedXQuantity ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:ResourceDescription a owl:Class ;
	rdfs:comment "A base class for ENVITED-X resource descriptions, containing common metadata such as name and description of the simulation asset."@en ;
	rdfs:label "ResourceDescription"@en ;
	rdfs:subClassOf gx:VirtualResource , _:b1af79d072993 , _:b31443fe5dd31 , _:b3b28a38d72e5 , _:b71e7fcfdc4d7 , _:b8ea2a08cf77c , _:bc3153d08ae75 , _:bf99f73e0c312 , _:bfcc6415dd42c ;
	skos:exactMatch envited-x:ResourceDescription ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:ServiceAsset a owl:Class ;
	rdfs:comment "A structured digital asset in the ENVITED-X Data Space representing a service offering. Carries domain-specific metadata while delegating GX compliance to the linked ServiceOfferingBase node."@en ;
	rdfs:label "ServiceAsset"@en ;
	rdfs:subClassOf _:b1e56264a40f1 , _:b39e85c3c1f30 , _:b5d710e843c31 , _:b64ea8fd4ce5e , _:b7d78654aacc8 , _:be7c0e4451ee6 , _:bea0e7ba6003c , _:beba49831736d ;
	skos:exactMatch envited-x:ServiceAsset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:ServiceOfferingBase a owl:Class ;
	rdfs:comment "Base class coupling ENVITED-X service assets to gx:ServiceOffering."@en ;
	rdfs:label "ServiceOfferingBase"@en ;
	rdfs:subClassOf gx:ServiceOffering , _:b018b984c3019 , _:b052589077a09 , _:b12c0674d76ac , _:b22be16123ca1 , _:b2acdd3c2a44e , _:b7a9eb2c784fe , _:b8ef0bc647da8 , _:b8fb3aa38e21a , _:ba82d8c887e7c , _:bb4d9af98fd24 , _:bef6401c0f4b0 ;
	skos:exactMatch envited-x:ServiceOfferingBase ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:SimulationAsset a owl:Class ;
	rdfs:comment "A structured digital asset in the ENVITED-X Data Space that aggregates metadata and a structured manifest. Every SimulationAsset is linked to a ResourceDescription, which provides essential metadata, and a Manifest, which defines its internal structure and licensing information."@en ;
	rdfs:label "SimulationAsset"@en ;
	rdfs:subClassOf _:b153c22f4cbdb , _:b21e74b4eed8d , _:b54892e775f2e , _:b94ff9d7661a1 , _:ba18003019cd3 , _:bafdb8900e94b , _:bc46d58a6cabb , _:bfc4c13eb44fe ;
	skos:exactMatch envited-x:SimulationAsset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:SimulationManifest a owl:Class ;
	rdfs:comment "The manifest of a simulation asset: among its artifacts it has at least one link each of category simulation data, documentation, metadata and media."@en ;
	rdfs:label "SimulationManifest"@en ;
	rdfs:subClassOf envited-x:Manifest , _:b7334167017d6 , _:b7334167017d6_1 , _:b7334167017d6_2 , _:b7334167017d6_3 ;
	skos:exactMatch envited-x:SimulationManifest ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:SoftwareAsset a owl:Class ;
	rdfs:comment "A structured digital asset in the ENVITED-X Data Space representing a software resource. Carries domain-specific metadata while delegating GX compliance to the linked SoftwareResourceBase node."@en ;
	rdfs:label "SoftwareAsset"@en ;
	rdfs:subClassOf _:b000cb0306dca , _:b04dc38d1c4e7 , _:b318ff89e26e9 , _:b348689b73130 , _:b534140b81b7e , _:b6b5b26efbb61 , _:ba9fb6a074adc , _:bf55e24130dba ;
	skos:exactMatch envited-x:SoftwareAsset ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:SoftwareResourceBase a owl:Class ;
	rdfs:comment "Base class coupling ENVITED-X software assets to gx:SoftwareResource."@en ;
	rdfs:label "SoftwareResourceBase"@en ;
	rdfs:subClassOf gx:SoftwareResource , _:b1628655121ff , _:b32269d1d086e , _:b3d8bca7a1c12 , _:b87945318a2cd , _:b978b90988f58 , _:ba452f31b5874 , _:bce7d9d8f46be , _:bd2a12c233322 , _:be7cd1f35c937 , _:bef4cc163832c , _:bf5204a8de90e , _:bff5bdf792211 ;
	skos:exactMatch envited-x:SoftwareResourceBase ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasCodeArtifact a owl:DatatypeProperty ;
	rdfs:comment "Links a CodeAsset to its GX-compliant CodeArtifactBase."@en ;
	rdfs:label "hasCodeArtifact"@en ;
	rdfs:range _:bc8634e009ac6 ;
	rdfs:subPropertyOf envited-x:hasResourceDescription ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasContent a owl:ObjectProperty ;
	rdfs:comment "Links a DomainSpecification to the content of the asset."@en ;
	rdfs:label "hasContent"@en ;
	rdfs:range envited-x:Content ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasDataSource a owl:ObjectProperty ;
	rdfs:comment "Links a DomainSpecification to how the asset was created."@en ;
	rdfs:label "hasDataSource"@en ;
	rdfs:range envited-x:DataSource ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasDomainSpecification a owl:ObjectProperty ;
	rdfs:comment "Links an asset to one or more metadata extensions (e.g., georeference metadata, sensor calibration) that provide additional structured information."@en ;
	rdfs:label "hasDomainSpecification"@en ;
	rdfs:range envited-x:DomainSpecification ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasFormat a owl:ObjectProperty ;
	rdfs:comment "Links a DomainSpecification to the format details of the asset."@en ;
	rdfs:label "hasFormat"@en ;
	rdfs:range envited-x:Format ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasManifest a owl:DatatypeProperty ;
	rdfs:comment "Links an asset to its manifest: an inline envited-x:Manifest, or a link that names an external manifest by its IRI, typically a DID."@en ;
	rdfs:label "hasManifest"@en ;
	rdfs:range _:bf84866605c56 ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasQuality a owl:ObjectProperty ;
	rdfs:comment "Links a DomainSpecification to the quality or accuracy aspects of the asset."@en ;
	rdfs:label "hasQuality"@en ;
	rdfs:range envited-x:Quality ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasQuantity a owl:ObjectProperty ;
	rdfs:comment "Links a DomainSpecification to the quantity of the asset."@en ;
	rdfs:label "hasQuantity"@en ;
	rdfs:range envited-x:Quantity ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasResourceDescription a owl:DatatypeProperty ;
	rdfs:comment "Links an asset or its subclass to its associated ResourceDescription, which provides essential metadata such as name and description, inline or as a link."@en ;
	rdfs:label "hasResourceDescription"@en ;
	rdfs:range _:b2cf3a68a42bf ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasServiceOffering a owl:DatatypeProperty ;
	rdfs:comment "Links a ServiceAsset to its GX-compliant ServiceOfferingBase."@en ;
	rdfs:label "hasServiceOffering"@en ;
	rdfs:range _:b9ba3915195f7 ;
	rdfs:subPropertyOf envited-x:hasResourceDescription ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:hasSoftwareResource a owl:DatatypeProperty ;
	rdfs:comment "Links a SoftwareAsset to its GX-compliant SoftwareResourceBase."@en ;
	rdfs:label "hasSoftwareResource"@en ;
	rdfs:range _:b0f370546976a ;
	rdfs:subPropertyOf envited-x:hasResourceDescription ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/envited-x/v4> .
envited-x:isDocumentation dcterms:title "Documentation Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , manifest:Category ;
	rdfs:comment "Indicates that the artifact category is documentation in the envited-x context."@en ;
	rdfs:label "isDocumentation"@en .
envited-x:isLicense dcterms:title "License Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , envited-x:EnvitedXLicenseCategoryEnum , manifest:LicenseCategory ;
	rdfs:comment "Indicates that the artifact category is a license file in the envited-x context."@en ;
	rdfs:label "isLicense"@en .
envited-x:isManifest dcterms:title "Manifest Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , envited-x:EnvitedXManifestCategoryEnum , manifest:ManifestCategory ;
	rdfs:comment "Indicates that the artifact category is a manifest in the envited-x context."@en ;
	rdfs:label "isManifest"@en .
envited-x:isMedia dcterms:title "Media Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , manifest:Category ;
	rdfs:comment "Indicates that the artifact category is media content in the envited-x context."@en ;
	rdfs:label "isMedia"@en .
envited-x:isMetadata dcterms:title "Metadata Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , manifest:Category ;
	rdfs:comment "Indicates that the artifact category is metadata in the envited-x context."@en ;
	rdfs:label "isMetadata"@en .
envited-x:isMiscellaneous dcterms:title "Miscellaneous Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , manifest:MiscellaneousCategory ;
	rdfs:comment "Indicates that the artifact category is miscellaneous in the envited-x context."@en ;
	rdfs:label "isMiscellaneous"@en .
envited-x:isOwner dcterms:title "Owner Access Role"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXAccessRoleEnum , manifest:AccessRole ;
	rdfs:comment "Indicates that the artifact access role is owner in the envited-x context."@en ;
	rdfs:label "isOwner"@en .
envited-x:isPublic dcterms:title "Public Access Role"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXAccessRoleEnum , manifest:AccessRole ;
	rdfs:comment "Indicates that the artifact access role is public in the envited-x context."@en ;
	rdfs:label "isPublic"@en .
envited-x:isRegistered dcterms:title "Registered Access Role"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXAccessRoleEnum , manifest:AccessRole ;
	rdfs:comment "Indicates that the artifact access role is registered user in the envited-x context."@en ;
	rdfs:label "isRegistered"@en .
envited-x:isSimulationData dcterms:title "Simulation Data Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , manifest:Category ;
	rdfs:comment "Indicates that the artifact category is simulation data."@en ;
	rdfs:label "isSimulationData"@en .
envited-x:isValidationReport dcterms:title "Validation Report Category"@en ;
	a owl:NamedIndividual , envited-x:EnvitedXCategoryEnum , manifest:Category ;
	rdfs:comment "Indicates that the artifact category is a validation report in the envited-x context."@en ;
	rdfs:label "isValidationReport"@en .
<https://w3id.org/ascs-ev/envited-x/envited-x/v4> dcterms:conformsTo envited-x:shapes ;
	dcterms:creator "The GAIA-X 4 PLC AAD Project Team"@en ;
