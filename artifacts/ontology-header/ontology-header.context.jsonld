         "@type": "shex:nonLiteral",
         "@id": "prov:wasDerivedFrom"
      },
      "ontologyPriorVersion": {
         "@type": "shex:nonLiteral",
         "@id": "owl:priorVersion"
      },
      "ontologyPublisher": {
         "@type": "shex:nonLiteral",
         "@id": "dcterms:publisher"
      },
      "ontologyReferences": {
         "@type": "shex:nonLiteral",
         "@id": "dcterms:references"
      },
      "OntologyHeader": {
         "@id": "OntologyHeader"
      }
   }
