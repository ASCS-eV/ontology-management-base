_:bff440325df4a a sh:SPARQLConstraint ;
	sh:message "If trafficVolumeValue is provided, TrafficVolume must be true."@en ;
	sh:select "SELECT DISTINCT $this (<https://w3id.org/ascs-ev/envited-x/openlabel/v2/TrafficVolume> AS ?path) ?value WHERE {\n    $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/trafficVolumeValue> ?guard .\n    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/TrafficVolume> ?value . }\n    FILTER ( !BOUND(?value) || !COALESCE( ?value = true, false ) )\n}" .
