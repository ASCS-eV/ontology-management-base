            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path openlabel_v2:longitudinalDownSlopeValue ],
        [ sh:description "Communication connectivity attributes: communication type, technology, and downlink/uplink characteristics."@en ;
            sh:in ( openlabel_v2:CommunicationDownlinkLatency openlabel_v2:CommunicationDownlinkThroughput openlabel_v2:CommunicationTechnologyCellular openlabel_v2:CommunicationTechnologyDSRC openlabel_v2:CommunicationTechnologyITSG5 openlabel_v2:CommunicationTechnologySatellite openlabel_v2:CommunicationTechnologySidelinkPC5 openlabel_v2:CommunicationTechnologyWLAN openlabel_v2:CommunicationTypeFleetManagement openlabel_v2:CommunicationTypeTrafficManagement openlabel_v2:CommunicationTypeV2X openlabel_v2:CommunicationUplinkLatency openlabel_v2:CommunicationUplinkThroughput openlabel_v2:CommunicationV2N openlabel_v2:CommunicationV2P openlabel_v2:CommunicationV2i openlabel_v2:CommunicationV2v ) ;
            sh:maxCount 0 ;
            sh:message "ConnectivityCommunication (OddDynamicElements): Communication connectivity attributes: communication type, technology, and downlink/uplink characteristics. ISO 34503:2023, 10.5 a)"@en ;
            sh:order 0 ;
            sh:path openlabel_v2:ConnectivityCommunication ],
        [ sh:datatype xsd:decimal ;
            sh:description "Wind speed in metres per second."@en ;
