_:bffc6d19bde97 a sh:SPARQLConstraint ;
	sh:message "EdgeNone is mutually exclusive with other drivable area edge types. If DrivableAreaEdge includes EdgeNone, no other edge values are allowed."@en ;
	sh:select "SELECT DISTINCT $this (<https://w3id.org/ascs-ev/envited-x/openlabel/v2/DrivableAreaEdge> AS ?path) (?other AS ?value) WHERE {\n    $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/DrivableAreaEdge> ?exclusive .\n    $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/DrivableAreaEdge> ?other .\n    FILTER ( COALESCE( ?exclusive = <https://w3id.org/ascs-ev/envited-x/openlabel/v2/EdgeNone>, false ) && !COALESCE( ?other = <https://w3id.org/ascs-ev/envited-x/openlabel/v2/EdgeNone>, false ) )\n}" .
