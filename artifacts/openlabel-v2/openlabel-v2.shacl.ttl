    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "If subjectVehicleSpeedValue is provided, SubjectVehicleSpeed must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/SubjectVehicleSpeed> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/subjectVehicleSpeedValue> ?value . }
    FILTER (
        ( !BOUND(?flag) || ?flag != true ) &&
        BOUND(?value)
    )
}""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "If DimensionShoulderWidth is provided, SpecialStructuresDimensionShoulderWidth must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/SpecialStructuresDimensionShoulderWidth> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/DimensionShoulderWidth> ?value . }
    FILTER (
        ( !BOUND(?flag) || ?flag != true ) &&
        BOUND(?value)
    )
}""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "If DimensionLength is provided, SpecialStructuresDimensionLength must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/SpecialStructuresDimensionLength> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/DimensionLength> ?value . }
    FILTER (
