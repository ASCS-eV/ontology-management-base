            sh:order 12 ;
            sh:path openlabel_v2:DrivableAreaSurfaceFeature ],
        [ sh:datatype xsd:decimal ;
            sh:description "Special structure width in metres."@en ;
            sh:maxCount 0 ;
            sh:message "DimensionWidth (OddDynamicElements): Special structure width in metres. ISO 34503:2023, 9.6 b)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path openlabel_v2:DimensionWidth ],
        [ sh:datatype xsd:boolean ;
