            sh:maxCount 0 ;
            sh:message "weatherRainValue (OddDynamicElements): Rainfall intensity in millimetres per hour. ISO 34503:2023, 10.2.4"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 78 ;
            sh:path openlabel_v2:weatherRainValue ],
        [ sh:datatype xsd:decimal ;
