openlabel_v2:Scenario a sh:NodeShape ;
    rdfs:comment "A scenario that can be tagged with OpenLABEL tags."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class openlabel_v2:Tag ;
            sh:description "A tag associated with a scenario."@en ;
            sh:maxCount 1 ;
            sh:message "hasTag (Scenario): A tag associated with a scenario."@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path openlabel_v2:hasTag ] ;
    sh:targetClass openlabel_v2:Scenario .

openlabel_v2:Tag a sh:NodeShape ;
    rdfs:comment "The base tag."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class openlabel_v2:AdminTag ;
            sh:description "Administration tag."@en ;
            sh:maxCount 1 ;
            sh:message "AdminTag (Tag): Administration tag."@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path openlabel_v2:AdminTag ],
        [ sh:class openlabel_v2:Behaviour ;
            sh:description "Behaviour tag."@en ;
            sh:maxCount 1 ;
            sh:message "Behaviour (Tag): Behaviour tag."@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path openlabel_v2:Behaviour ],
        [ sh:class openlabel_v2:Odd ;
            sh:description "Operational Design Domain tag."@en ;
            sh:maxCount 1 ;
            sh:message "Odd (Tag): Operational Design Domain tag."@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path openlabel_v2:Odd ] ;
    sh:targetClass openlabel_v2:Tag .

openlabel_v2:AdminTag a sh:NodeShape ;
    rdfs:comment "The base tag to use when extending the Administration tags with new classes."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "The date that the scenario was created/published."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioCreatedDate (AdminTag): The date that the scenario was created/published."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path openlabel_v2:scenarioCreatedDate ],
        [ sh:datatype xsd:string ;
            sh:description "URI of SDL language used for the definition of the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioDefinitionLanguageURI (AdminTag): URI of SDL language used for the definition of the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path openlabel_v2:scenarioDefinitionLanguageURI ],
        [ sh:datatype xsd:string ;
            sh:description "SDL definition of the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioDefinition (AdminTag): SDL definition of the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path openlabel_v2:scenarioDefinition ],
        [ sh:datatype xsd:string ;
            sh:description "Universally unique identifier (UUID) which identifies the scenario which this one has been derived from."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioParentReference (AdminTag): Universally unique identifier (UUID) which identifies the scenario which this one has been derived from."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path openlabel_v2:scenarioParentReference ],
        [ sh:datatype xsd:string ;
            sh:description "A description of the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioDescription (AdminTag): A description of the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path openlabel_v2:scenarioDescription ],
        [ sh:datatype xsd:string ;
            sh:description "The email address of the legal entity who owns the rights to the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "ownerEmail (AdminTag): The email address of the legal entity who owns the rights to the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path openlabel_v2:ownerEmail ],
        [ sh:datatype xsd:string ;
            sh:description "Universally unique identifier (UUID) assigned to the scenario which allows the scenario to be identified."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioUniqueReference (AdminTag): Universally unique identifier (UUID) assigned to the scenario which allows the scenario to be identified."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path openlabel_v2:scenarioUniqueReference ],
        [ sh:datatype xsd:string ;
            sh:description "The type of license which governs usage of the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "licenseURI (AdminTag): The type of license which governs usage of the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path openlabel_v2:licenseURI ],
        [ sh:datatype xsd:string ;
            sh:description "Relative or absolute URL of a static image or animation of the scenario to allow users to easily see what the scenario represents."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioVisualisationURL (AdminTag): Relative or absolute URL of a static image or animation of the scenario to allow users to easily see what the scenario represents."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path openlabel_v2:scenarioVisualisationURL ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the legal entity who owns the rights to the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "ownerName (AdminTag): The name of the legal entity who owns the rights to the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path openlabel_v2:ownerName ],
        [ sh:datatype xsd:string ;
            sh:description "The version number of the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioVersion (AdminTag): The version number of the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path openlabel_v2:scenarioVersion ],
        [ sh:datatype xsd:string ;
            sh:description "The URL of the legal entity who owns the rights to the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "ownerURL (AdminTag): The URL of the legal entity who owns the rights to the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path openlabel_v2:ownerURL ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the scenario."@en ;
            sh:maxCount 1 ;
            sh:message "scenarioName (AdminTag): The name of the scenario."@en ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path openlabel_v2:scenarioName ] ;
    sh:targetClass openlabel_v2:AdminTag .

openlabel_v2:Behaviour a sh:NodeShape ;
    rdfs:comment "Act that changes the state or position of an on-road actor, classified into signalling, positioning and manoeuvre behaviours."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Pass; the subject vehicle moves in front of another actor in an adjacent lane."@en ;
            sh:maxCount 1 ;
            sh:message "MotionPass (Behaviour): Pass; the subject vehicle moves in front of another actor in an adjacent lane. BSI Flex 1891 v1.0:2025-01, 5.4.3.7"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path openlabel_v2:MotionPass ],
        [ sh:datatype xsd:boolean ;
            sh:description "Turn left; the vehicle's trajectory changes its forward direction toward the left where the road layout allows a turn."@en ;
            sh:maxCount 1 ;
            sh:message "MotionTurnLeft (Behaviour): Turn left; the vehicle's trajectory changes its forward direction toward the left where the road layout allows a turn. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.4"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path openlabel_v2:MotionTurnLeft ],
        [ sh:datatype xsd:boolean ;
            sh:description "Reverse; the vehicle moves in the reverse or opposite direction."@en ;
            sh:maxCount 1 ;
            sh:message "MotionReverse (Behaviour): Reverse; the vehicle moves in the reverse or opposite direction. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.6"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path openlabel_v2:MotionReverse ],
        [ sh:description "Positioning of the subject vehicle before or after the execution of a manoeuvre."@en ;
            sh:in ( openlabel_v2:PostmanoeuvrePositioning openlabel_v2:PremanoeuvrePositioning ) ;
            sh:message "BehaviourPositioning (Behaviour): Positioning of the subject vehicle before or after the execution of a manoeuvre. BSI Flex 1891 v1.0:2025-01, 5.3"@en ;
            sh:order 0 ;
            sh:path openlabel_v2:BehaviourPositioning ],
        [ sh:description "Rate of deceleration (m/s²)."@en ;
            sh:maxCount 1 ;
            sh:message "motionDecelerateValue (Behaviour): Rate of deceleration (m/s²). BSI Flex 1891 v1.0:2025-01, 5.4.2.3.3"@en ;
            sh:or ( [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:class schema:QuantitativeValue ] ) ;
            sh:order 12 ;
            sh:path openlabel_v2:motionDecelerateValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Run or fast speed (over 6 km/h)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionRun (Behaviour): Run or fast speed (over 6 km/h). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 c)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path openlabel_v2:MotionRun ],
        [ sh:datatype xsd:boolean ;
            sh:description "Turn right by a non-vehicle actor (e.g. pedestrian, animal)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionNonVehicleTurnRight (Behaviour): Turn right by a non-vehicle actor (e.g. pedestrian, animal). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 a)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path openlabel_v2:MotionNonVehicleTurnRight ],
        [ sh:datatype xsd:boolean ;
            sh:description "Walk or slow speed (under 4 km/h)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionWalk (Behaviour): Walk or slow speed (under 4 km/h). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 a)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path openlabel_v2:MotionWalk ],
        [ sh:datatype xsd:boolean ;
            sh:description "Cross the road at a demarcated or non-demarcated point (non-vehicle actor)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionCross (Behaviour): Cross the road at a demarcated or non-demarcated point (non-vehicle actor). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 c)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path openlabel_v2:MotionCross ],
        [ sh:datatype xsd:boolean ;
            sh:description "Acceleration of a traffic agent."@en ;
            sh:maxCount 1 ;
            sh:message "MotionAccelerateTrafficAgent (Behaviour): Acceleration of a traffic agent. BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path openlabel_v2:MotionAccelerateTrafficAgent ],
        [ sh:datatype xsd:boolean ;
            sh:description "Slide; unintentional movement such as tripping, falling or skidding."@en ;
            sh:maxCount 1 ;
            sh:message "MotionSlide (Behaviour): Slide; unintentional movement such as tripping, falling or skidding. BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 d)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path openlabel_v2:MotionSlide ],
        [ sh:description "Signalling behaviour indicating the current or future intent of an actor."@en ;
            sh:in ( openlabel_v2:ExternalEmergencySignalling openlabel_v2:ExternalIntentSignalling openlabel_v2:ExternalSignalling openlabel_v2:ExternalWarningSignalling openlabel_v2:InternalEmergencySignalling openlabel_v2:InternalIntentSignalling openlabel_v2:InternalSignalling openlabel_v2:InternalWarningSignalling ) ;
            sh:message "BehaviourSignalling (Behaviour): Signalling behaviour indicating the current or future intent of an actor. BSI Flex 1891 v1.0:2025-01, 5.2"@en ;
            sh:order 1 ;
            sh:path openlabel_v2:BehaviourSignalling ],
        [ sh:datatype xsd:boolean ;
            sh:description "Accelerate; the vehicle's velocity gradient is positive."@en ;
            sh:maxCount 1 ;
            sh:message "MotionAccelerate (Behaviour): Accelerate; the vehicle's velocity gradient is positive. BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path openlabel_v2:MotionAccelerate ],
        [ sh:description "Rate of acceleration of a traffic agent (m/s²)."@en ;
            sh:maxCount 1 ;
            sh:message "motionAccelerateTrafficAgentValue (Behaviour): Rate of acceleration of a traffic agent (m/s²). BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en ;
            sh:or ( [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:class schema:QuantitativeValue ] ) ;
            sh:order 6 ;
            sh:path openlabel_v2:motionAccelerateTrafficAgentValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Cut-out; the subject vehicle changes lane to move away from an actor it is in front of."@en ;
            sh:maxCount 1 ;
            sh:message "MotionCutOut (Behaviour): Cut-out; the subject vehicle changes lane to move away from an actor it is in front of. BSI Flex 1891 v1.0:2025-01, 5.4.3.4"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path openlabel_v2:MotionCutOut ],
        [ sh:datatype xsd:boolean ;
            sh:description "Overtake; the subject vehicle moves from behind to in front of another actor in the same lane."@en ;
            sh:maxCount 1 ;
            sh:message "MotionOvertake (Behaviour): Overtake; the subject vehicle moves from behind to in front of another actor in the same lane. BSI Flex 1891 v1.0:2025-01, 5.4.3.2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path openlabel_v2:MotionOvertake ],
        [ sh:datatype xsd:boolean ;
            sh:description "Wait (non-vehicle actor)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionNonVehicleWait (Behaviour): Wait (non-vehicle actor). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 d)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path openlabel_v2:MotionNonVehicleWait ],
        [ sh:datatype xsd:boolean ;
            sh:description "Cut-in; the subject vehicle moves in front of another actor by a lane change."@en ;
            sh:maxCount 1 ;
            sh:message "MotionCutIn (Behaviour): Cut-in; the subject vehicle moves in front of another actor by a lane change. BSI Flex 1891 v1.0:2025-01, 5.4.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path openlabel_v2:MotionCutIn ],
        [ sh:datatype xsd:boolean ;
            sh:description "Jog or moderate speed (over 4 km/h but under 6 km/h)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionNonVehicleJog (Behaviour): Jog or moderate speed (over 4 km/h but under 6 km/h). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 b)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path openlabel_v2:MotionNonVehicleJog ],
        [ sh:datatype xsd:boolean ;
            sh:description "Lane change to the right."@en ;
            sh:maxCount 1 ;
            sh:message "MotionLaneChangeRight (Behaviour): Lane change to the right. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.5 NOTE 2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path openlabel_v2:MotionLaneChangeRight ],
        [ sh:datatype xsd:boolean ;
            sh:description "Acceleration of the ego (subject) vehicle."@en ;
            sh:maxCount 1 ;
            sh:message "MotionAccelerateEgo (Behaviour): Acceleration of the ego (subject) vehicle. BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path openlabel_v2:MotionAccelerateEgo ],
        [ sh:description "Rate of acceleration of the ego vehicle (m/s²)."@en ;
            sh:maxCount 1 ;
            sh:message "motionAccelerateEgoValue (Behaviour): Rate of acceleration of the ego vehicle (m/s²). BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en ;
            sh:or ( [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:class schema:QuantitativeValue ] ) ;
            sh:order 4 ;
            sh:path openlabel_v2:motionAccelerateEgoValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Cut across; the subject vehicle's trajectory is perpendicular to another actor's trajectory."@en ;
            sh:maxCount 1 ;
            sh:message "MotionCutAcross (Behaviour): Cut across; the subject vehicle's trajectory is perpendicular to another actor's trajectory. BSI Flex 1891 v1.0:2025-01, 5.4.3.5"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path openlabel_v2:MotionCutAcross ],
        [ sh:datatype xsd:boolean ;
            sh:description "Turn right; the vehicle's trajectory changes its forward direction toward the right where the road layout allows a turn."@en ;
            sh:maxCount 1 ;
            sh:message "MotionTurnRight (Behaviour): Turn right; the vehicle's trajectory changes its forward direction toward the right where the road layout allows a turn. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path openlabel_v2:MotionTurnRight ],
        [ sh:datatype xsd:boolean ;
            sh:description "Turnabout; the vehicle changes its direction of travel by 180 degrees (e.g. U-turn, three-point turn)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionUTurn (Behaviour): Turnabout; the vehicle changes its direction of travel by 180 degrees (e.g. U-turn, three-point turn). BSI Flex 1891 v1.0:2025-01, 5.4.2.2.8"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path openlabel_v2:MotionUTurn ],
        [ sh:description "Speed (km/h)."@en ;
            sh:maxCount 1 ;
            sh:message "motionDriveValue (Behaviour): Speed (km/h). BSI Flex 1891 v1.0:2025-01, 5.4.2.2.2"@en ;
            sh:or ( [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:class schema:QuantitativeValue ] ) ;
            sh:order 14 ;
            sh:path openlabel_v2:motionDriveValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Stop position; the vehicle reaches zero velocity and maintains its position."@en ;
            sh:maxCount 1 ;
            sh:message "MotionStop (Behaviour): Stop position; the vehicle reaches zero velocity and maintains its position. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.7"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path openlabel_v2:MotionStop ],
        [ sh:datatype xsd:boolean ;
            sh:description "Lane change to the left."@en ;
            sh:maxCount 1 ;
            sh:message "MotionLaneChangeLeft (Behaviour): Lane change to the left. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.5 NOTE 2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path openlabel_v2:MotionLaneChangeLeft ],
        [ sh:datatype xsd:boolean ;
            sh:description "Drive in-lane; the vehicle remains in its lane (physically demarcated or virtual lanes)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionDrive (Behaviour): Drive in-lane; the vehicle remains in its lane (physically demarcated or virtual lanes). BSI Flex 1891 v1.0:2025-01, 5.4.2.2.2"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path openlabel_v2:MotionDrive ],
        [ sh:datatype xsd:boolean ;
            sh:description "Parking manoeuvre; the vehicle moves into a demarcated or non-demarcated parking area, ending stopped."@en ;
            sh:maxCount 1 ;
            sh:message "MotionParkingManoeuvre (Behaviour): Parking manoeuvre; the vehicle moves into a demarcated or non-demarcated parking area, ending stopped. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.9"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path openlabel_v2:MotionParkingManoeuvre ],
        [ sh:datatype xsd:boolean ;
            sh:description "Decelerate; the vehicle's velocity gradient is negative."@en ;
            sh:maxCount 1 ;
            sh:message "MotionDecelerate (Behaviour): Decelerate; the vehicle's velocity gradient is negative. BSI Flex 1891 v1.0:2025-01, 5.4.2.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path openlabel_v2:MotionDecelerate ],
        [ sh:datatype xsd:boolean ;
            sh:description "Yield; the subject vehicle stops and waits in reaction to another actor or road feature."@en ;
            sh:maxCount 1 ;
            sh:message "MotionYield (Behaviour): Yield; the subject vehicle stops and waits in reaction to another actor or road feature. BSI Flex 1891 v1.0:2025-01, 5.4.3.6"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path openlabel_v2:MotionYield ],
        [ sh:datatype xsd:boolean ;
            sh:description "Lane change; the vehicle moves from its current lane of travel to an adjacent lane."@en ;
            sh:maxCount 1 ;
            sh:message "MotionLaneChange (Behaviour): Lane change; the vehicle moves from its current lane of travel to an adjacent lane. BSI Flex 1891 v1.0:2025-01, 5.4.2.2.5"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path openlabel_v2:MotionLaneChange ],
        [ sh:datatype xsd:boolean ;
            sh:description "Turn left by a non-vehicle actor (e.g. pedestrian, animal)."@en ;
            sh:maxCount 1 ;
            sh:message "MotionNonVehicleTurnLeft (Behaviour): Turn left by a non-vehicle actor (e.g. pedestrian, animal). BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 b)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path openlabel_v2:MotionNonVehicleTurnLeft ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "If motionAccelerateEgoValue is provided, MotionAccelerateEgo must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/MotionAccelerateEgo> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/motionAccelerateEgoValue> ?value . }
    FILTER (
        ( !BOUND(?flag) || ?flag != true ) &&
        BOUND(?value)
    )
}""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "If motionAccelerateTrafficAgentValue is provided, MotionAccelerateTrafficAgent must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/MotionAccelerateTrafficAgent> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/motionAccelerateTrafficAgentValue> ?value . }
    FILTER (
        ( !BOUND(?flag) || ?flag != true ) &&
        BOUND(?value)
    )
}""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "If motionDecelerateValue is provided, MotionDecelerate must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/MotionDecelerate> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/motionDecelerateValue> ?value . }
    FILTER (
        ( !BOUND(?flag) || ?flag != true ) &&
        BOUND(?value)
    )
}""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "If motionDriveValue is provided, MotionDrive must be true." ;
            sh:select """SELECT $this WHERE {
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/MotionDrive> ?flag . }
    OPTIONAL { $this <https://w3id.org/ascs-ev/envited-x/openlabel/v2/motionDriveValue> ?value . }
    FILTER (
        ( !BOUND(?flag) || ?flag != true ) &&
        BOUND(?value)
    )
}""" ] ;
    sh:targetClass openlabel_v2:Behaviour .

openlabel_v2:Odd a sh:NodeShape ;
    rdfs:comment "Operational design domain."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Type of particulates present in the environment."@en ;
            sh:in ( openlabel_v2:ParticulatesBlowingDebris openlabel_v2:ParticulatesDust openlabel_v2:ParticulatesInsectSwarms openlabel_v2:ParticulatesPollution openlabel_v2:ParticulatesSand openlabel_v2:ParticulatesVolcanic openlabel_v2:ParticulatesWater ) ;
            sh:maxCount 1 ;
            sh:message "EnvironmentParticulates (Odd): Type of particulates present in the environment. ISO 34503:2023, 10.3"@en ;
            sh:order 15 ;
            sh:path openlabel_v2:EnvironmentParticulates ],
        [ sh:description "Sign feature (fixed or movable)."@en ;
            sh:in ( openlabel_v2:FixedSigns openlabel_v2:MovableSigns ) ;
            sh:message "SignFeature (Odd): Sign feature (fixed or movable). ISO 34503:2023, 9.3.5 b)"@en ;
            sh:order 55 ;
            sh:path openlabel_v2:SignFeature ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of wind."@en ;
            sh:maxCount 1 ;
            sh:message "WeatherWind (Odd): Presence of wind. ISO 34503:2023, 10.2.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 81 ;
            sh:path openlabel_v2:WeatherWind ],
        [ sh:description "Communication connectivity attributes: communication type, technology, and downlink/uplink characteristics."@en ;
            sh:in ( openlabel_v2:CommunicationDownlinkLatency openlabel_v2:CommunicationDownlinkThroughput openlabel_v2:CommunicationTechnologyCellular openlabel_v2:CommunicationTechnologyDSRC openlabel_v2:CommunicationTechnologyITSG5 openlabel_v2:CommunicationTechnologySatellite openlabel_v2:CommunicationTechnologySidelinkPC5 openlabel_v2:CommunicationTechnologyWLAN openlabel_v2:CommunicationTypeFleetManagement openlabel_v2:CommunicationTypeTrafficManagement openlabel_v2:CommunicationTypeV2X openlabel_v2:CommunicationUplinkLatency openlabel_v2:CommunicationUplinkThroughput openlabel_v2:CommunicationV2N openlabel_v2:CommunicationV2P openlabel_v2:CommunicationV2i openlabel_v2:CommunicationV2v ) ;
            sh:message "ConnectivityCommunication (Odd): Communication connectivity attributes: communication type, technology, and downlink/uplink characteristics. ISO 34503:2023, 10.5 a)"@en ;
            sh:order 0 ;
            sh:path openlabel_v2:ConnectivityCommunication ],
        [ sh:description "Position of the sun relative to the direction of travel."@en ;
            sh:in ( openlabel_v2:SunPositionBehind openlabel_v2:SunPositionFront openlabel_v2:SunPositionLeft openlabel_v2:SunPositionRight ) ;
            sh:maxCount 1 ;
            sh:message "DaySunPosition (Odd): Position of the sun relative to the direction of travel. ISO 34503:2023, 10.4 a) 1)"@en ;
            sh:order 5 ;
            sh:path openlabel_v2:DaySunPosition ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of straight roadway geometry."@en ;
            sh:maxCount 1 ;
            sh:message "HorizontalStraights (Odd): Presence of straight roadway geometry. ISO 34503:2023, 9.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path openlabel_v2:HorizontalStraights ],
        [ sh:description "Type of drivable area."@en ;
            sh:in ( openlabel_v2:DistributorRoadsManaged openlabel_v2:DistributorRoadsUnmanaged openlabel_v2:MinorRoadsManaged openlabel_v2:MinorRoadsUnmanaged openlabel_v2:MotorwayManaged openlabel_v2:MotorwayUnmanaged openlabel_v2:ParkingManaged openlabel_v2:ParkingUnmanaged openlabel_v2:PrimaryRoadsManaged openlabel_v2:PrimaryRoadsUnmanaged openlabel_v2:RadialRoadsManaged openlabel_v2:RadialRoadsUnmanaged openlabel_v2:RoadTypeDistributor openlabel_v2:RoadTypeMinor openlabel_v2:RoadTypeMotorway openlabel_v2:RoadTypeParking openlabel_v2:RoadTypePrimary openlabel_v2:RoadTypeRadial openlabel_v2:RoadTypeShared openlabel_v2:RoadTypeSlip openlabel_v2:SharedSpaceManaged openlabel_v2:SharedSpaceUnmanaged openlabel_v2:SlipRoadsManaged openlabel_v2:SlipRoadsUnmanaged ) ;
            sh:maxCount 1 ;
            sh:message "DrivableAreaType (Odd): Type of drivable area. ISO 34503:2023, 9.3.2"@en ;
            sh:order 14 ;
            sh:path openlabel_v2:DrivableAreaType ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of a specified sun elevation above the horizon."@en ;
            sh:maxCount 1 ;
            sh:message "DaySunElevation (Odd): Presence of a specified sun elevation above the horizon. ISO 34503:2023, 10.4 d)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path openlabel_v2:DaySunElevation ],
        [ sh:datatype xsd:decimal ;
            sh:description "Particulates size."@en ;
            sh:maxCount 1 ;
            sh:message "ParticulatesSize (Odd): Particulates size. ISO 34503:2023, 10.3 c)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 46 ;
            sh:path openlabel_v2:ParticulatesSize ],
        [ sh:description "How the special structure is used by the vehicle (driving on or under it)."@en ;
            sh:in ( openlabel_v2:SpecialStructuresUsageDrivingOn openlabel_v2:SpecialStructuresUsageDrivingUnder ) ;
            sh:message "SpecialStructuresUsage (Odd): How the special structure is used by the vehicle (driving on or under it). ISO 34503:2023, 9.6 c)"@en ;
            sh:order 63 ;
            sh:path openlabel_v2:SpecialStructuresUsage ],
        [ sh:datatype xsd:decimal ;
            sh:description "Meteorological optical range in metres."@en ;
            sh:maxCount 1 ;
            sh:message "particulatesWaterValue (Odd): Meteorological optical range in metres. ISO 34503:2023, 10.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 49 ;
            sh:path openlabel_v2:particulatesWaterValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of dust particulates."@en ;
            sh:maxCount 1 ;
            sh:message "ParticulatesDust (Odd): Presence of dust particulates. ISO 34503:2023, 10.3 a)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path openlabel_v2:ParticulatesDust ],
        [ sh:datatype xsd:decimal ;
            sh:description "Upward gradient as a percentage."@en ;
            sh:maxCount 1 ;
            sh:message "longitudinalUpSlopeValue (Odd): Upward gradient as a percentage. ISO 34503:2023, 9.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path openlabel_v2:longitudinalUpSlopeValue ],
        [ sh:description "Types of traffic agents present."@en ;
            sh:in ( openlabel_v2:HumanAnimalRider openlabel_v2:HumanCyclist openlabel_v2:HumanEscooter openlabel_v2:HumanMotorcycle openlabel_v2:HumanPedestrian openlabel_v2:HumanStroller openlabel_v2:HumanTransporter openlabel_v2:TrafficAgentTypeAnimal openlabel_v2:TrafficAgentTypeHuman openlabel_v2:TrafficAgentTypeNonMotor openlabel_v2:TrafficAgentTypeVehicle openlabel_v2:VehicleAgricultural openlabel_v2:VehicleBus openlabel_v2:VehicleCar openlabel_v2:VehicleConstruction openlabel_v2:VehicleEmergency openlabel_v2:VehicleTram openlabel_v2:VehicleTruck openlabel_v2:VehicleVan openlabel_v2:VehicleWheelchair ) ;
            sh:message "trafficAgentTypeValue (Odd): Types of traffic agents present. ISO 34503:2023, 11.1 a)"@en ;
            sh:order 70 ;
            sh:path openlabel_v2:trafficAgentTypeValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of a level longitudinal plane."@en ;
            sh:maxCount 1 ;
            sh:message "LongitudinalLevelPlane (Odd): Presence of a level longitudinal plane. ISO 34503:2023, 9.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path openlabel_v2:LongitudinalLevelPlane ],
        [ sh:description "Type of special structure present in the scenery."@en ;
            sh:in ( openlabel_v2:SpecialStructureAutoAccess openlabel_v2:SpecialStructureBridge openlabel_v2:SpecialStructurePedestrianCrossing openlabel_v2:SpecialStructureRailCrossing openlabel_v2:SpecialStructureTollPlaza openlabel_v2:SpecialStructureTunnel ) ;
            sh:maxCount 1 ;
            sh:message "ScenerySpecialStructure (Odd): Type of special structure present in the scenery. ISO 34503:2023, 9.6"@en ;
            sh:order 52 ;
            sh:path openlabel_v2:ScenerySpecialStructure ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of a downhill gradient."@en ;
            sh:maxCount 1 ;
            sh:message "LongitudinalDownSlope (Odd): Presence of a downhill gradient. ISO 34503:2023, 9.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path openlabel_v2:LongitudinalDownSlope ],
        [ sh:description "Type of zone."@en ;
            sh:in ( openlabel_v2:DynamicZone openlabel_v2:EnviromentalZone openlabel_v2:FixedZone openlabel_v2:FreightDistributionCentre openlabel_v2:IndustrialZone openlabel_v2:ParkingLot openlabel_v2:ZoneDenseFoliage openlabel_v2:ZoneGeoFenced openlabel_v2:ZoneInterference openlabel_v2:ZoneMobileWork openlabel_v2:ZoneOverheadWires openlabel_v2:ZonePort openlabel_v2:ZoneRegion openlabel_v2:ZoneSchool openlabel_v2:ZoneTrafficManagement openlabel_v2:ZoneUrbanCanyon ) ;
            sh:maxCount 1 ;
            sh:message "SceneryZone (Odd): Type of zone. ISO 34503:2023, 9.2"@en ;
            sh:order 54 ;
            sh:path openlabel_v2:SceneryZone ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of rainfall."@en ;
            sh:maxCount 1 ;
            sh:message "WeatherRain (Odd): Presence of rainfall. ISO 34503:2023, 10.2.4"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 77 ;
            sh:path openlabel_v2:WeatherRain ],
        [ sh:description "Type of warning sign."@en ;
            sh:in ( openlabel_v2:WarningSignsUniform openlabel_v2:WarningSignsUniformFullTime openlabel_v2:WarningSignsUniformTemporary openlabel_v2:WarningSignsVariable openlabel_v2:WarningSignsVariableFullTime openlabel_v2:WarningSignsVariableTemporary ) ;
            sh:maxCount 1 ;
            sh:message "SignsWarning (Odd): Type of warning sign. ISO 34503:2023, 9.3.5"@en ;
            sh:order 58 ;
            sh:path openlabel_v2:SignsWarning ],
        [ sh:description "Type of drivable area surface feature."@en ;
            sh:in ( openlabel_v2:SurfaceFeatureCrack openlabel_v2:SurfaceFeatureCut openlabel_v2:SurfaceFeatureEarthquake openlabel_v2:SurfaceFeatureEarthquakeHorizontal openlabel_v2:SurfaceFeatureEarthquakeVertical openlabel_v2:SurfaceFeaturePothole openlabel_v2:SurfaceFeatureRut openlabel_v2:SurfaceFeatureSwell ) ;
            sh:maxCount 1 ;
            sh:message "DrivableAreaSurfaceFeature (Odd): Type of drivable area surface feature. ISO 34503:2023, 9.3.7"@en ;
            sh:order 12 ;
            sh:path openlabel_v2:DrivableAreaSurfaceFeature ],
        [ sh:datatype xsd:decimal ;
            sh:description "Visibility in kilometres."@en ;
            sh:maxCount 1 ;
            sh:message "weatherSnowValue (Odd): Visibility in kilometres. ISO 34503:2023, 10.2.5"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 80 ;
            sh:path openlabel_v2:weatherSnowValue ],
        [ sh:description "Type of lane."@en ;
            sh:in ( openlabel_v2:LaneTypeBus openlabel_v2:LaneTypeCycle openlabel_v2:LaneTypeEmergency openlabel_v2:LaneTypeSpecial openlabel_v2:LaneTypeTraffic openlabel_v2:LaneTypeTram ) ;
            sh:message "LaneSpecificationType (Odd): Type of lane. ISO 34503:2023, 9.3.4"@en ;
            sh:order 33 ;
            sh:path openlabel_v2:LaneSpecificationType ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of insect swarms."@en ;
            sh:maxCount 1 ;
            sh:message "ParticulatesInsectSwarms (Odd): Presence of insect swarms. PAS 1883:2025, 5.4 (extends ISO 34503:2023, 10.3)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path openlabel_v2:ParticulatesInsectSwarms ],
        [ sh:description "Type of drivable area edge."@en ;
            sh:in ( openlabel_v2:EdgeBurningMaterials openlabel_v2:EdgeLineMarkers openlabel_v2:EdgeNone openlabel_v2:EdgeSheerDrop openlabel_v2:EdgeShoulder openlabel_v2:EdgeShoulderGrass openlabel_v2:EdgeShoulderPavedOrGravel openlabel_v2:EdgeSnowbanks openlabel_v2:EdgeSolidBarriers openlabel_v2:EdgeTemporaryLineMarkers openlabel_v2:EdgeWaterOnRoadside ) ;
            sh:message "DrivableAreaEdge (Odd): Type of drivable area edge. ISO 34503:2023, 9.3.6"@en ;
            sh:order 10 ;
            sh:path openlabel_v2:DrivableAreaEdge ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of a specified traffic flow rate."@en ;
            sh:maxCount 1 ;
            sh:message "TrafficFlowRate (Odd): Presence of a specified traffic flow rate. ISO 34503:2023, 11.1"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 71 ;
            sh:path openlabel_v2:TrafficFlowRate ],
        [ sh:description "Type of rainfall."@en ;
            sh:in ( openlabel_v2:RainTypeConvective openlabel_v2:RainTypeDynamic openlabel_v2:RainTypeOrographic ) ;
            sh:maxCount 1 ;
            sh:message "RainType (Odd): Type of rainfall. ISO 34503:2023, 10.2.4"@en ;
            sh:order 50 ;
            sh:path openlabel_v2:RainType ],
        [ sh:datatype xsd:decimal ;
            sh:description "Curve radius in metres."@en ;
            sh:maxCount 1 ;
            sh:message "horizontalCurvesValue (Odd): Curve radius in metres. ISO 34503:2023, 9.3.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path openlabel_v2:horizontalCurvesValue ],
        [ sh:description "Type of lane marking."@en ;
            sh:in ( openlabel_v2:BlurredLaneMarking openlabel_v2:ClearLaneMarking openlabel_v2:LaneMarkingNoLine openlabel_v2:TemporaryLaneMarking ) ;
            sh:message "LaneSpecificationMarking (Odd): Type of lane marking. ISO 34503:2023, 9.3.4 b)"@en ;
            sh:order 30 ;
