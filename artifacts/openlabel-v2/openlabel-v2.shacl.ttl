@prefix cmns-q: <https://www.omg.org/spec/Commons/Quantities/> .
@prefix openlabel_v2: <https://w3id.org/ascs-ev/envited-x/openlabel/v2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

openlabel_v2:OddDynamicElements a sh:NodeShape ;
    rdfs:comment "Dynamic elements subset of the operational design domain."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Traffic volume in vehicle kilometres."@en ;
            sh:maxCount 1 ;
            sh:message "trafficVolumeValue (OddDynamicElements): Traffic volume in vehicle kilometres. ISO 34503:2023, 11.1"@en ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 76 ;
            sh:path openlabel_v2:trafficVolumeValue ],
        [ sh:description "Lane width in metres."@en ;
            sh:maxCount 0 ;
            sh:message "laneSpecificationDimensionsValue (OddDynamicElements): Lane width in metres. ISO 34503:2023, 9.3.4"@en ;
            sh:or ( [ sh:datatype xsd:decimal ;
                        sh:nodeKind sh:Literal ] [ sh:class schema:QuantitativeValue ] ) ;
            sh:order 27 ;
            sh:path openlabel_v2:laneSpecificationDimensionsValue ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of non-precipitating water droplets or ice crystals."@en ;
            sh:maxCount 0 ;
            sh:message "ParticulatesWater (OddDynamicElements): Presence of non-precipitating water droplets or ice crystals. ISO 34503:2023, 10.3"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 48 ;
            sh:path openlabel_v2:ParticulatesWater ],
        [ sh:description "Type of roundabout."@en ;
            sh:in ( openlabel_v2:MultipleNonSignalised openlabel_v2:MultipleSignalised openlabel_v2:RoundaboutCompact openlabel_v2:RoundaboutCompactNosignal openlabel_v2:RoundaboutCompactSignal openlabel_v2:RoundaboutDouble openlabel_v2:RoundaboutDoubleNosignal openlabel_v2:RoundaboutDoubleSignal openlabel_v2:RoundaboutLarge openlabel_v2:RoundaboutLargeNosignal openlabel_v2:RoundaboutLargeSignal openlabel_v2:RoundaboutMini openlabel_v2:RoundaboutMiniNosignal openlabel_v2:RoundaboutMiniSignal openlabel_v2:RoundaboutMultiple openlabel_v2:RoundaboutNormal openlabel_v2:RoundaboutNormalNosignal openlabel_v2:RoundaboutNormalSignal ) ;
            sh:maxCount 0 ;
            sh:message "JunctionRoundabout (OddDynamicElements): Type of roundabout. ISO 34503:2023, 9.4.2"@en ;
            sh:order 25 ;
            sh:path openlabel_v2:JunctionRoundabout ],
        [ sh:datatype xsd:decimal ;
            sh:description "Special structure shoulder width in metres."@en ;
            sh:maxCount 0 ;
            sh:message "DimensionShoulderWidth (OddDynamicElements): Special structure shoulder width in metres. ISO 34503:2023, 9.6 b)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path openlabel_v2:DimensionShoulderWidth ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of a specified lane count."@en ;
            sh:maxCount 0 ;
            sh:message "LaneSpecificationLaneCount (OddDynamicElements): Presence of a specified lane count. ISO 34503:2023, 9.3.4"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path openlabel_v2:LaneSpecificationLaneCount ],
        [ sh:description "Type of drivable area edge."@en ;
            sh:in ( openlabel_v2:EdgeBurningMaterials openlabel_v2:EdgeLineMarkers openlabel_v2:EdgeNone openlabel_v2:EdgeSheerDrop openlabel_v2:EdgeShoulder openlabel_v2:EdgeShoulderGrass openlabel_v2:EdgeShoulderPavedOrGravel openlabel_v2:EdgeSnowbanks openlabel_v2:EdgeSolidBarriers openlabel_v2:EdgeTemporaryLineMarkers openlabel_v2:EdgeWaterOnRoadside ) ;
            sh:maxCount 0 ;
            sh:message "DrivableAreaEdge (OddDynamicElements): Type of drivable area edge. ISO 34503:2023, 9.3.6"@en ;
            sh:order 10 ;
            sh:path openlabel_v2:DrivableAreaEdge ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of specified lane dimensions."@en ;
            sh:maxCount 0 ;
            sh:message "LaneSpecificationDimensions (OddDynamicElements): Presence of specified lane dimensions. ISO 34503:2023, 9.3.4"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path openlabel_v2:LaneSpecificationDimensions ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of a specified special structure shoulder width."@en ;
            sh:maxCount 0 ;
            sh:message "SpecialStructuresDimensionShoulderWidth (OddDynamicElements): Presence of a specified special structure shoulder width. ISO 34503:2023, 9.6 b)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 61 ;
            sh:path openlabel_v2:SpecialStructuresDimensionShoulderWidth ],
        [ sh:description "Type of transverse geometry."@en ;
            sh:in ( openlabel_v2:TransverseBarriers openlabel_v2:TransverseDivided openlabel_v2:TransverseLanesTogether openlabel_v2:TransversePavements openlabel_v2:TransverseSuperelevationBanking openlabel_v2:TransverseUndivided ) ;
            sh:maxCount 0 ;
            sh:message "GeometryTransverse (OddDynamicElements): Type of transverse geometry. ISO 34503:2023, 9.3.3"@en ;
            sh:order 16 ;
            sh:path openlabel_v2:GeometryTransverse ],
        [ sh:datatype xsd:boolean ;
            sh:description "Presence of snowfall."@en ;
            sh:maxCount 0 ;
            sh:message "WeatherSnow (OddDynamicElements): Presence of snowfall. ISO 34503:2023, 10.2.5"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 79 ;
            sh:path openlabel_v2:WeatherSnow ],
        [ sh:datatype xsd:integer ;
            sh:description "Traffic agent density in vehicles per kilometre."@en ;
            sh:maxCount 1 ;
            sh:message "trafficAgentDensityValue (OddDynamicElements): Traffic agent density in vehicles per kilometre. ISO 34503:2023, 11.1"@en ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 68 ;
            sh:path openlabel_v2:trafficAgentDensityValue ],
        [ sh:datatype xsd:decimal ;
            sh:description "Special structure height in metres."@en ;
            sh:maxCount 0 ;
            sh:message "DimensionHeight (OddDynamicElements): Special structure height in metres. ISO 34503:2023, 9.6 b)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path openlabel_v2:DimensionHeight ],
        [ sh:description "Type of temporary drivable area structure present in the scenery."@en ;
            sh:in ( openlabel_v2:TemporaryStructureConstructionDetour openlabel_v2:TemporaryStructureRefuseCollection openlabel_v2:TemporaryStructureRoadSignage openlabel_v2:TemporaryStructureRoadWorks ) ;
            sh:maxCount 0 ;
            sh:message "SceneryTemporaryStructure (OddDynamicElements): Type of temporary drivable area structure present in the scenery. ISO 34503:2023, 9.7"@en ;
            sh:order 53 ;
            sh:path openlabel_v2:SceneryTemporaryStructure ],
        [ sh:description "Type of lane marking."@en ;
            sh:in ( openlabel_v2:BlurredLaneMarking openlabel_v2:ClearLaneMarking openlabel_v2:LaneMarkingNoLine openlabel_v2:TemporaryLaneMarking ) ;
            sh:maxCount 0 ;
            sh:message "LaneSpecificationMarking (OddDynamicElements): Type of lane marking. ISO 34503:2023, 9.3.4 b)"@en ;
            sh:order 30 ;
            sh:path openlabel_v2:LaneSpecificationMarking ],
        [ sh:description "How the special structure is used by the vehicle (driving on or under it)."@en ;
            sh:in ( openlabel_v2:SpecialStructuresUsageDrivingOn openlabel_v2:SpecialStructuresUsageDrivingUnder ) ;
            sh:maxCount 0 ;
            sh:message "SpecialStructuresUsage (OddDynamicElements): How the special structure is used by the vehicle (driving on or under it). ISO 34503:2023, 9.6 c)"@en ;
            sh:order 63 ;
            sh:path openlabel_v2:SpecialStructuresUsage ],
        [ sh:description "Type of drivable area."@en ;
            sh:in ( openlabel_v2:DistributorRoadsManaged openlabel_v2:DistributorRoadsUnmanaged openlabel_v2:MinorRoadsManaged openlabel_v2:MinorRoadsUnmanaged openlabel_v2:MotorwayManaged openlabel_v2:MotorwayUnmanaged openlabel_v2:ParkingManaged openlabel_v2:ParkingUnmanaged openlabel_v2:PrimaryRoadsManaged openlabel_v2:PrimaryRoadsUnmanaged openlabel_v2:RadialRoadsManaged openlabel_v2:RadialRoadsUnmanaged openlabel_v2:RoadTypeDistributor openlabel_v2:RoadTypeMinor openlabel_v2:RoadTypeMotorway openlabel_v2:RoadTypeParking openlabel_v2:RoadTypePrimary openlabel_v2:RoadTypeRadial openlabel_v2:RoadTypeShared openlabel_v2:RoadTypeSlip openlabel_v2:SharedSpaceManaged openlabel_v2:SharedSpaceUnmanaged openlabel_v2:SlipRoadsManaged openlabel_v2:SlipRoadsUnmanaged ) ;
            sh:maxCount 0 ;
            sh:message "DrivableAreaType (OddDynamicElements): Type of drivable area. ISO 34503:2023, 9.3.2"@en ;
            sh:order 14 ;
            sh:path openlabel_v2:DrivableAreaType ],
        [ sh:description "Type of lane."@en ;
            sh:in ( openlabel_v2:LaneTypeBus openlabel_v2:LaneTypeCycle openlabel_v2:LaneTypeEmergency openlabel_v2:LaneTypeSpecial openlabel_v2:LaneTypeTraffic openlabel_v2:LaneTypeTram ) ;
            sh:maxCount 0 ;
            sh:message "LaneSpecificationType (OddDynamicElements): Type of lane. ISO 34503:2023, 9.3.4"@en ;
            sh:order 33 ;
            sh:path openlabel_v2:LaneSpecificationType ],
        [ sh:datatype xsd:boolean ;
