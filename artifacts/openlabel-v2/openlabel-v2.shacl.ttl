            sh:maxCount 0 ;
            sh:message "LaneSpecificationUsage (OddDynamicElements): Presence of a specified lane usage. ISO 34503:2023, 9.3.4 f)"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path openlabel_v2:LaneSpecificationUsage ],
        [ sh:description "Types of traffic agents present."@en ;
