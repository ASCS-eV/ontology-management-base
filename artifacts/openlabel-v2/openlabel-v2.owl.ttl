openlabel_v2:ZoneUrbanCanyon a owl:Class ;
    rdfs:label "ZoneUrbanCanyon"@en ;
    rdfs:subClassOf openlabel_v2:SceneryZoneEnum ;
    skos:definition "Urban canyon."@en .

openlabel_v2:MotionAccelerate a owl:DatatypeProperty ;
    rdfs:label "MotionAccelerate"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Accelerate"@en ;
    skos:definition "Accelerate; the vehicle's velocity gradient is positive."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en .

openlabel_v2:MotionCross a owl:DatatypeProperty ;
    rdfs:label "MotionCross"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Cross (non-vehicle)"@en ;
    skos:definition "Cross the road at a demarcated or non-demarcated point (non-vehicle actor)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 c)"@en .

openlabel_v2:MotionCutAcross a owl:DatatypeProperty ;
    rdfs:label "MotionCutAcross"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Cut across"@en ;
    skos:definition "Cut across; the subject vehicle's trajectory is perpendicular to another actor's trajectory."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.3.5"@en .

openlabel_v2:MotionCutIn a owl:DatatypeProperty ;
    rdfs:label "MotionCutIn"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Cut-in"@en ;
    skos:definition "Cut-in; the subject vehicle moves in front of another actor by a lane change."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.3.3"@en .

openlabel_v2:MotionCutOut a owl:DatatypeProperty ;
    rdfs:label "MotionCutOut"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Cut-out"@en ;
    skos:definition "Cut-out; the subject vehicle changes lane to move away from an actor it is in front of."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.3.4"@en .

openlabel_v2:MotionLaneChange a owl:DatatypeProperty ;
    rdfs:label "MotionLaneChange"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Lane change"@en ;
    skos:definition "Lane change; the vehicle moves from its current lane of travel to an adjacent lane."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.5"@en .

openlabel_v2:MotionLaneChangeLeft a owl:DatatypeProperty ;
    rdfs:label "MotionLaneChangeLeft"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Lane change to the left."@en ;
    skos:editorialNote "Not in the internal ontology; kept because BSI Flex 1891, 5.4.2.2.5 NOTE 2 allows lane change to be further classified into left and right."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.5 NOTE 2"@en .

openlabel_v2:MotionLaneChangeRight a owl:DatatypeProperty ;
    rdfs:label "MotionLaneChangeRight"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Lane change to the right."@en ;
    skos:editorialNote "Not in the internal ontology; kept because BSI Flex 1891, 5.4.2.2.5 NOTE 2 allows lane change to be further classified into left and right."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.5 NOTE 2"@en .

openlabel_v2:MotionNonVehicleJog a owl:DatatypeProperty ;
    rdfs:label "MotionNonVehicleJog"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Jog"@en ;
    skos:definition "Jog or moderate speed (over 4 km/h but under 6 km/h)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 b)"@en .

openlabel_v2:MotionNonVehicleTurnLeft a owl:DatatypeProperty ;
    rdfs:label "MotionNonVehicleTurnLeft"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Turn left (non-vehicle)"@en ;
    skos:definition "Turn left by a non-vehicle actor (e.g. pedestrian, animal)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 b)"@en .

openlabel_v2:MotionNonVehicleTurnRight a owl:DatatypeProperty ;
    rdfs:label "MotionNonVehicleTurnRight"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Turn right (non-vehicle)"@en ;
    skos:definition "Turn right by a non-vehicle actor (e.g. pedestrian, animal)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 a)"@en .

openlabel_v2:MotionNonVehicleWait a owl:DatatypeProperty ;
    rdfs:label "MotionNonVehicleWait"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Wait"@en ;
    skos:definition "Wait (non-vehicle actor)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.2 d)"@en .

openlabel_v2:MotionOvertake a owl:DatatypeProperty ;
    rdfs:label "MotionOvertake"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Overtake"@en ;
    skos:definition "Overtake; the subject vehicle moves from behind to in front of another actor in the same lane."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.3.2"@en .

openlabel_v2:MotionParkingManoeuvre a owl:DatatypeProperty ;
    rdfs:label "MotionParkingManoeuvre"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Parking manoeuvre"@en ;
    skos:definition "Parking manoeuvre; the vehicle moves into a demarcated or non-demarcated parking area, ending stopped."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.9"@en .

openlabel_v2:MotionPass a owl:DatatypeProperty ;
    rdfs:label "MotionPass"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Pass"@en ;
    skos:definition "Pass; the subject vehicle moves in front of another actor in an adjacent lane."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.3.7"@en .

openlabel_v2:MotionReverse a owl:DatatypeProperty ;
    rdfs:label "MotionReverse"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Reverse"@en ;
    skos:definition "Reverse; the vehicle moves in the reverse or opposite direction."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.6"@en .

openlabel_v2:MotionRun a owl:DatatypeProperty ;
    rdfs:label "MotionRun"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Run"@en ;
    skos:definition "Run or fast speed (over 6 km/h)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 c)"@en .

openlabel_v2:MotionSlide a owl:DatatypeProperty ;
    rdfs:label "MotionSlide"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Slide"@en ;
    skos:definition "Slide; unintentional movement such as tripping, falling or skidding."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 d)"@en .

openlabel_v2:MotionStop a owl:DatatypeProperty ;
    rdfs:label "MotionStop"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Stop position"@en ;
    skos:definition "Stop position; the vehicle reaches zero velocity and maintains its position."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.7"@en .

openlabel_v2:MotionTurnLeft a owl:DatatypeProperty ;
    rdfs:label "MotionTurnLeft"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Turn left"@en ;
    skos:definition "Turn left; the vehicle's trajectory changes its forward direction toward the left where the road layout allows a turn."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.4"@en .

openlabel_v2:MotionTurnRight a owl:DatatypeProperty ;
    rdfs:label "MotionTurnRight"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Turn right"@en ;
    skos:definition "Turn right; the vehicle's trajectory changes its forward direction toward the right where the road layout allows a turn."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.3"@en .

openlabel_v2:MotionUTurn a owl:DatatypeProperty ;
    rdfs:label "MotionUTurn"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Turnabout"@en ;
    skos:definition "Turnabout; the vehicle changes its direction of travel by 180 degrees (e.g. U-turn, three-point turn)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.8"@en .

openlabel_v2:MotionWalk a owl:DatatypeProperty ;
    rdfs:label "MotionWalk"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Walk"@en ;
    skos:definition "Walk or slow speed (under 4 km/h)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.4.3 a)"@en .

openlabel_v2:MotionYield a owl:DatatypeProperty ;
    rdfs:label "MotionYield"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Yield"@en ;
    skos:definition "Yield; the subject vehicle stops and waits in reaction to another actor or road feature."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.3.6"@en .

openlabel_v2:Tag a owl:Class ;
    rdfs:label "Tag"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:AdminTag ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:Behaviour ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:Odd ],
        [ a owl:Restriction ;
            owl:allValuesFrom openlabel_v2:AdminTag ;
            owl:onProperty openlabel_v2:AdminTag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:Behaviour ],
        [ a owl:Restriction ;
            owl:allValuesFrom openlabel_v2:Behaviour ;
            owl:onProperty openlabel_v2:Behaviour ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:AdminTag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:Odd ],
        [ a owl:Restriction ;
            owl:allValuesFrom openlabel_v2:Odd ;
            owl:onProperty openlabel_v2:Odd ] ;
    skos:definition "The base tag."@en ;
    skos:exactMatch openlabel_v2:Tag ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:hasLowerBound a owl:DatatypeProperty ;
    rdfs:label "hasLowerBound"@en ;
    rdfs:range xsd:decimal ;
    skos:definition "Lower bound inferred via RDFS from schema:minValue being a subPropertyOf cmns-q:hasLowerBound in schema.org OWL."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:hasTag a owl:ObjectProperty ;
    rdfs:label "hasTag"@en ;
    rdfs:range openlabel_v2:Tag ;
    skos:definition "A tag associated with a scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:hasUpperBound a owl:DatatypeProperty ;
    rdfs:label "hasUpperBound"@en ;
    rdfs:range xsd:decimal ;
    skos:definition "Upper bound inferred via RDFS from schema:maxValue being a subPropertyOf cmns-q:hasUpperBound in schema.org OWL."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:licenseURI a owl:DatatypeProperty ;
    rdfs:label "licenseURI"@en ;
    rdfs:range xsd:string ;
    skos:definition "The type of license which governs usage of the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:maxValue a owl:DatatypeProperty ;
    rdfs:label "maxValue"@en ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum value of the range."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:minValue a owl:DatatypeProperty ;
    rdfs:label "minValue"@en ;
    rdfs:range xsd:decimal ;
    skos:definition "Minimum value of the range."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:ownerEmail a owl:DatatypeProperty ;
    rdfs:label "ownerEmail"@en ;
    rdfs:range xsd:string ;
    skos:definition "The email address of the legal entity who owns the rights to the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:ownerName a owl:DatatypeProperty ;
    rdfs:label "ownerName"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the legal entity who owns the rights to the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:ownerURL a owl:DatatypeProperty ;
    rdfs:label "ownerURL"@en ;
    rdfs:range xsd:string ;
    skos:definition "The URL of the legal entity who owns the rights to the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioCreatedDate a owl:DatatypeProperty ;
    rdfs:label "scenarioCreatedDate"@en ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date that the scenario was created/published."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioDefinition a owl:DatatypeProperty ;
    rdfs:label "scenarioDefinition"@en ;
    rdfs:range xsd:string ;
    skos:definition "SDL definition of the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioDefinitionLanguageURI a owl:DatatypeProperty ;
    rdfs:label "scenarioDefinitionLanguageURI"@en ;
    rdfs:range xsd:string ;
    skos:definition "URI of SDL language used for the definition of the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioDescription a owl:DatatypeProperty ;
    rdfs:label "scenarioDescription"@en ;
    rdfs:range xsd:string ;
    skos:definition "A description of the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioName a owl:DatatypeProperty ;
    rdfs:label "scenarioName"@en ;
    rdfs:range xsd:string ;
    skos:definition "The name of the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioParentReference a owl:DatatypeProperty ;
    rdfs:label "scenarioParentReference"@en ;
    rdfs:range xsd:string ;
    skos:definition "Universally unique identifier (UUID) which identifies the scenario which this one has been derived from."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioUniqueReference a owl:DatatypeProperty ;
    rdfs:label "scenarioUniqueReference"@en ;
    rdfs:range xsd:string ;
    skos:definition "Universally unique identifier (UUID) assigned to the scenario which allows the scenario to be identified."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioVersion a owl:DatatypeProperty ;
    rdfs:label "scenarioVersion"@en ;
    rdfs:range xsd:string ;
    skos:definition "The version number of the scenario."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:scenarioVisualisationURL a owl:DatatypeProperty ;
    rdfs:label "scenarioVisualisationURL"@en ;
    rdfs:range xsd:string ;
    skos:definition "Relative or absolute URL of a static image or animation of the scenario to allow users to easily see what the scenario represents."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> .

openlabel_v2:BehaviourPositioningEnum a owl:Class ;
    rdfs:label "BehaviourPositioningEnum"@en ;
    owl:unionOf ( openlabel_v2:PostmanoeuvrePositioning openlabel_v2:PremanoeuvrePositioning ) ;
    skos:definition "Types of positioning behaviour."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.3"@en ;
    linkml:permissible_values openlabel_v2:PostmanoeuvrePositioning,
        openlabel_v2:PremanoeuvrePositioning .

openlabel_v2:LaneSpecificationTravelDirectionEnum a owl:Class ;
    rdfs:label "LaneSpecificationTravelDirectionEnum"@en ;
    owl:unionOf ( openlabel_v2:TravelDirectionLeft openlabel_v2:TravelDirectionRight ) ;
    skos:altLabel "Direction of travel"@en ;
    skos:definition "Directions of travel."@en ;
    skos:editorialNote "v1 label: \"Direction of travel\" (PAS 1883:2020, Section 5.2.3.4.e)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "ISO 34503:2023, 9.3.4"@en ;
    linkml:permissible_values openlabel_v2:TravelDirectionLeft,
        openlabel_v2:TravelDirectionRight .

openlabel_v2:MotionAccelerateEgo a owl:DatatypeProperty ;
    rdfs:label "MotionAccelerateEgo"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Acceleration of the ego (subject) vehicle."@en ;
    skos:editorialNote "Internal ontology extension: acceleration is distinguished for the ego vehicle and for traffic agents."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en .

openlabel_v2:MotionAccelerateTrafficAgent a owl:DatatypeProperty ;
    rdfs:label "MotionAccelerateTrafficAgent"@en ;
    rdfs:range xsd:boolean ;
    skos:definition "Acceleration of a traffic agent."@en ;
    skos:editorialNote "Internal ontology extension: acceleration is distinguished for the ego vehicle and for traffic agents."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.3.2"@en .

openlabel_v2:MotionDecelerate a owl:DatatypeProperty ;
    rdfs:label "MotionDecelerate"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Decelerate"@en ;
    skos:definition "Decelerate; the vehicle's velocity gradient is negative."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.3.3"@en .

openlabel_v2:MotionDrive a owl:DatatypeProperty ;
    rdfs:label "MotionDrive"@en ;
    rdfs:range xsd:boolean ;
    skos:altLabel "Drive in-lane"@en ;
    skos:definition "Drive in-lane; the vehicle remains in its lane (physically demarcated or virtual lanes)."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.4.2.2.2"@en .

openlabel_v2:SignFeatureEnum a owl:Class ;
    rdfs:label "SignFeatureEnum"@en ;
    owl:unionOf ( openlabel_v2:FixedSigns openlabel_v2:MovableSigns ) ;
    skos:altLabel "Sign feature"@en ;
    skos:definition "Sign features."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "ISO 34503:2023, 9.3.5 b)"@en ;
