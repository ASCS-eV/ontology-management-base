openlabel_v2:Behaviour a owl:Class,
        owl:ObjectProperty ;
    rdfs:label "Behaviour"@en ;
    rdfs:range openlabel_v2:Behaviour ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:MotionNonVehicleTurnLeft ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionTurnRight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:motionDecelerateValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:MotionAccelerateEgo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:MotionCutOut ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:motionDriveValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:MotionNonVehicleJog ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionOvertake ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionUTurn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:MotionYield ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:motionAccelerateEgoValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionAccelerate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty openlabel_v2:MotionParkingManoeuvre ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionDecelerate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionNonVehicleTurnRight ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:MotionNonVehicleTurnRight ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionNonVehicleTurnLeft ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty openlabel_v2:MotionCutIn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty openlabel_v2:MotionSlide ],
        [ a owl:Restriction ;
