    skos:definition "Operational Design Domain tag."@en,
        "Operational design domain."@en ;
    skos:editorialNote "Conditional rules (boolean+value co-occurrence) are ontology integrity constraints motivated by ISO 34503:2023, 12.4 (conditional attribute dependencies in ODD specifications)."@en,
        "v1 label: \"ODD\"."@en ;
    skos:exactMatch openlabel_v2:Odd ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "ISO 34503:2023, Clauses 8–11"@en .

<https://w3id.org/ascs-ev/envited-x/openlabel/v2> a owl:Ontology ;
    rdfs:label "openlabel-v2"@en ;
    dcterms:license "https://www.eclipse.org/legal/epl-2.0/"@en ;
    dcterms:title "ASAM OpenLABEL Scenario Tagging Ontology"@en ;
    pav:version "2.0.0"@en ;
    skos:definition "Ontology for scenario tagging based on the ASAM OpenLABEL standard and ISO 34503:2023 Operational Design Domain taxonomy."@en .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty openlabel_v2:HorizontalCurves ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "true" ] ) ] ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty openlabel_v2:horizontalCurvesValue ;
                owl:someValuesFrom xsd:string ] openlabel_v2:Odd ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty openlabel_v2:SpecialStructuresDimensionShoulderWidth ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "true" ] ) ] ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty openlabel_v2:DimensionShoulderWidth ;
                owl:someValuesFrom xsd:string ] openlabel_v2:Odd ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty openlabel_v2:SpecialStructuresDimensionHeight ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "true" ] ) ] ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty openlabel_v2:DimensionHeight ;
                owl:someValuesFrom xsd:string ] openlabel_v2:Odd ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty openlabel_v2:SpecialStructuresDimensionWidth ;
            owl:someValuesFrom [ a rdfs:Datatype ;
