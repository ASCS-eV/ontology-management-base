    skos:definition "Act that changes the state or position of an on-road actor, classified into signalling, positioning and manoeuvre behaviours."@en,
        "Behaviour tag."@en ;
    skos:editorialNote "Aligned with the internal OpenLABEL ontology, which follows BSI Flex 1891. Previously referenced ISO 34504:2023, 4.4.4."@en,
        "Conditional rules (boolean+value co-occurrence) are ontology integrity constraints motivated by ISO 34503:2023, 12.4 (conditional attribute dependencies in ODD specifications)."@en,
        "Internal hierarchy: BehaviourSignalling (5.2); BehaviourPositioning (5.3); BehaviourMotion (manoeuvre, 5.4) with AbsoluteManoeuvre (vehicle tactical, vehicle operational, non-vehicle tactical, non-vehicle operational) and RelativeManoeuvre. Manoeuvres are modelled as boolean flags."@en ;
    skos:exactMatch openlabel_v2:Behaviour ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, Clause 5"@en .

openlabel_v2:BehaviourSignallingEnum a owl:Class ;
    rdfs:label "BehaviourSignallingEnum"@en ;
    owl:unionOf ( openlabel_v2:ExternalEmergencySignalling openlabel_v2:ExternalIntentSignalling openlabel_v2:ExternalSignalling openlabel_v2:ExternalWarningSignalling openlabel_v2:InternalEmergencySignalling openlabel_v2:InternalIntentSignalling openlabel_v2:InternalSignalling openlabel_v2:InternalWarningSignalling ) ;
    skos:definition "Types of signalling behaviour."@en ;
    skos:editorialNote "Replaces BehaviourCommunicationEnum. Former values map as: CommunicationHorn, CommunicationHeadlightFlash, CommunicationSignalHazard → ExternalWarningSignalling; CommunicationSignalLeft, CommunicationSignalRight, CommunicationSignalSlowing, CommunicationWave → ExternalIntentSignalling; CommunicationSignalEmergency → ExternalEmergencySignalling."@en ;
    skos:inScheme <https://w3id.org/ascs-ev/envited-x/openlabel/v2> ;
    skos:note "BSI Flex 1891 v1.0:2025-01, 5.2"@en ;
    linkml:permissible_values openlabel_v2:ExternalEmergencySignalling,
        openlabel_v2:ExternalIntentSignalling,
        openlabel_v2:ExternalSignalling,
        openlabel_v2:ExternalWarningSignalling,
        openlabel_v2:InternalEmergencySignalling,
        openlabel_v2:InternalIntentSignalling,
        openlabel_v2:InternalSignalling,
        openlabel_v2:InternalWarningSignalling .

