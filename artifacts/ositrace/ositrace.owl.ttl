	dcterms:title "Ontology definition for ositrace"@en ;
	a owl:Ontology ;
	rdfs:comment "An ontology with common classes to describe ASAM OSI trace files, including single-channel .osi and multi-channel .mcap formats."@en ;
	rdfs:label "ositrace"@en ;
	rdfs:seeAlso <https://ascs-ev.github.io/EVES/> ;
	owl:imports envitedx_ontology:v4 , georeference_ontology:v6 ;
