	rdfs:range _:b54fa5d14a0ea ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:stopTime a owl:DatatypeProperty ;
	rdfs:comment "Exact stop timestamp of the recorded trace"@en ;
	rdfs:label "stopTime"@en ;
	rdfs:range _:b266a9ca1eb5a ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:tag a owl:DatatypeProperty ;
	rdfs:comment "Unique tag of the event in trace file."@en ;
	rdfs:label "tag"@en ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:time a owl:DatatypeProperty ;
	rdfs:comment "Exact timestamp of the event in the recorded trace."@en ;
	rdfs:label "time"@en ;
	rdfs:range _:bcf90e2aebfdf ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:topic a owl:DatatypeProperty ;
	rdfs:comment "Unique MCAP topic name identifying this channel."@en ;
	rdfs:label "topic"@en ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:trafficDirection a owl:ObjectProperty ;
	rdfs:comment "Traffic direction, i.e. right-hand or left-hand traffic"@en ;
	rdfs:label "trafficDirection"@en ;
