	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:usedDataSources a owl:DatatypeProperty ;
	rdfs:comment "Basic data for the creation of the trace."@en ;
	rdfs:label "usedDataSources"@en ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:validationReport a owl:DatatypeProperty ;
	rdfs:comment "Link to OSI trace file validation report, if any exists. The report should be of type 'vv-report:VvReport' according to https://w3id.org/gaia-x4plcaad/ontologies/vv-report/v2."@en ;
	rdfs:label "validationReport"@en ;
	rdfs:range xsd:anyURI ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:validationReportType a owl:DatatypeProperty ;
	rdfs:comment "Type of OSI trace validation report, if any exists. As mime-type."@en ;
	rdfs:label "validationReportType"@en ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
ositrace:version a owl:DatatypeProperty ;
	rdfs:comment "Version of data format (OSI version / protobuf version)."@en ;
	rdfs:label "ositraceVersion"@en ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> ;
	skos:prefLabel "version"@en .
ositrace:zeroTime a owl:DatatypeProperty ;
	rdfs:comment "Zero-time reference point for the MCAP recording."@en ;
	rdfs:label "zeroTime"@en ;
	rdfs:range xsd:dateTime ;
	skos:inScheme <https://w3id.org/ascs-ev/envited-x/ositrace/v7> .
<https://w3id.org/ascs-ev/envited-x/ositrace/v7> dcterms:conformsTo ositrace:shapes ;
